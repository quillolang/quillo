// Rust in a Quillo program.
//
//   quillo run examples/rust.qwe --watch     then open http://localhost:8080
//
// rust.qwer, next to this file, is Rust. `use` builds it the first time (a few
// seconds; it needs Rust installed, or `quillo build examples/rust.qwe` done
// somewhere it is) and loads it, and its `pub fn`s are called like any other
// function: numbers, text, lists and maps go in and come back, a `Result`'s
// error is an error value, and a panic is an error in that request alone.
// The checker knows their types from the Rust. A call runs off the event loop,
// so a long one holds up no one. Change rust.qwer and --watch builds it again.

use "rust.qwer"

server fn count_primes(n: int) -> map {
    let started = now()
    let r = primes(n)
    merge(r, { ms: now() - started })
}

server fn collatz(n: int) -> map ! str {
    let started = now()
    let [number, length] = longest_collatz(n)?
    { number, length, ms: now() - started }
}

component Lab() {
    state n = 10000000
    state primes_found = null
    state chain = null
    state problem = ""

    <section.lab>
        <label>Up to <input type="number" bind:value={n} min="2"/></label>
        <div.buttons>
            <button @click={() => { primes_found = count_primes(int(n)) }}>Count primes</button>
            <button @click={() => {
                let r = collatz(int(n))
                problem = is_err(r) ? r.error : ""
                chain = is_err(r) ? null : r
            }}>Longest Collatz chain</button>
        </div>
        {primes_found != null && <p>
            <b>{primes_found.count}</b> primes below {n}, the largest <b>{primes_found.largest}</b> ({primes_found.ms} ms)
        </p>}
        {chain != null && <p>
            Below {n}, <b>{chain.number}</b> takes the most steps to reach 1: <b>{chain.length}</b> ({chain.ms} ms)
        </p>}
        {problem != "" && <p.problem>{problem}</p>}
    </section>
}

let style = css`
body { font: 16px/1.5 system-ui, sans-serif; max-width: 40rem; margin: 3rem auto; padding: 0 1rem; color: #1f2328; }
input { font: inherit; width: 10rem; margin-left: .5rem; padding: .3rem .5rem; }
.buttons { display: flex; gap: .5rem; margin: 1rem 0; }
button { font: inherit; padding: .4rem .9rem; border-radius: 6px; border: 1px solid #d0d7de; background: #f6f8fa; cursor: pointer; }
.problem { color: #cf222e; }
`

route GET / =
    <html>
        <head><meta charset="utf-8"/><title>Rust in Quillo</title><style>{style}</style></head>
        <body><h1>Rust in Quillo</h1><Lab/></body>
    </html>
