// Demo data, for STAYS_DEMO=1: hosts and their places in five cities (Kyoto's
// in yen), two guests, past stays with reviews, stays to come, a request
// waiting for Ana, and activities with times for the next four weeks. The
// same every time (no random): tests count on it. Only an empty site is filled.
// Every demo password is "password".

// A number from 0 to 1, the same for the same seed.
fn wobble(seed: int) -> float {
    let x = math.sin(seed * 12.9898) * 43758.5453
    x - floor(x)
}

let SEED_HOSTS = [
    ["ana@stays.test", "Ana Ribeiro", 1], ["jordi@stays.test", "Jordi Puig", 1], ["aoife@stays.test", "Aoife Byrne", 1],
    ["kenji@stays.test", "Kenji Mori", 1], ["sam@stays.test", "Sam Taylor", 0], ["lee@stays.test", "Lee Park", 0],
