// Calendar days, on Quillo's `date` module: a day is its "YYYY-MM-DD" text,
// as forms, the database, the UI kit's pickers and the module give it. What
// is the app's: the nights of a stay, its labels, and each city's time zone,
// which refunds turn on (check-in at 15:00 is a different moment in winter
// and in summer). Pure functions: the pages use them in the browser too.

let DAY_MS = 86400000

fn two(n: int) -> str = n < 10 ? `0${n}` : str(n)

// A day as forms give it: "2026-02-30" is not one.
fn is_day(text) -> bool = type_of(text) == "str" && len(text) == 10 && date.valid(text)

// The nights of a stay from `start` to the day they leave: ["2026-11-02", ...].
fn nights_of(start: str, end: str) -> list = range(0, max([date.days_between(start, end), 0])) | map((i) => date.add_days(start, i))

// Friday and Saturday nights cost the weekend price.
fn weekend_night(text: str) -> bool = date.weekday(text) >= 5 && date.weekday(text) <= 6

// "Mon 2 Nov".
fn day_label(text: str) -> str = is_day(text) ? date.format(text, "ddd D MMM") : text

// "5–9 Nov 2026", or "28 Nov – 3 Dec 2026".
fn range_label(start: str, end: str) -> str {
    if !is_day(start) || !is_day(end) { return "" }
    slice(start, 0, 7) == slice(end, 0, 7)
        ? `${date.format(start, "D")}–${date.format(end, "D MMM YYYY")}`
        : `${date.format(start, "D MMM")} – ${date.format(end, "D MMM YYYY")}`
}

fn plural(n: int, word: str, words: str = "") -> str = n == 1 ? `1 ${word}` : `${n} ${words != "" ? words : word + "s"}`

// ---- the cities' time zones ------------------------------------------------------

let CITY_ZONES = {
    Lisbon: "Europe/Lisbon",
    Porto: "Europe/Lisbon",
    Barcelona: "Europe/Madrid",
    Dublin: "Europe/Dublin",
    Kyoto: "Asia/Tokyo",
}

fn zone_of(city: str) -> str = get(CITY_ZONES, city) ?? "UTC"

// The moment (ms, as now() gives) it is `clock` ("15:00") on `day` in `city`.
fn local_moment(city: str, day: str, clock: str) -> int = date.ms(date.at(day, clock, zone_of(city)))

// The day it is in `city` at `ms`.
fn local_day(city: str, ms: int) -> str = date.date_in(date.from_ms(ms), zone_of(city))
