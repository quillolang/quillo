// The frame of every page: the kit's theme and components' styles, this
// app's own, Leaflet for maps (from cdnjs), and the bar at the top.

let LEAFLET = "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4"

let stays_css = css`
:root { --ui-accent: #e0484f; --ui-accent-soft: #fde8e9; --ui-radius: 12px; }
body.ui-root { min-height: 100vh; }
a { color: inherit; }
.page { max-width: 1240px; margin: 0 auto; padding: 20px 16px 64px; }
.page.wide { max-width: none; padding: 0; }
.muted { color: var(--ui-muted); }
.small { font-size: 13px; }
.row { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
.spread { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
.stack { display: grid; gap: 12px; }
h1 { font-size: 26px; margin: 0 0 4px; }
h2 { font-size: 20px; margin: 28px 0 12px; }
h3 { font-size: 16px; margin: 0 0 6px; }
.problem { color: var(--ui-danger); }

.nav-actions { display: flex; gap: 6px; align-items: center; margin: 0; white-space: nowrap; }
.brand-mark { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; background: var(--ui-accent); color: #fff; font-weight: 800; }

/* home */
.hero { padding: 56px 16px 40px; text-align: center; background: linear-gradient(160deg, var(--ui-accent-soft), transparent 70%); }
.hero h1 { font-size: clamp(28px, 5vw, 44px); }
.search-bar { display: grid; grid-template-columns: 2fr 2fr 1fr auto; gap: 10px; align-items: end; max-width: 960px; margin: 24px auto 0; padding: 14px; background: var(--ui-surface); border: 1px solid var(--ui-border); border-radius: 18px; box-shadow: var(--ui-shadow); text-align: left; }
@media (max-width: 760px) { .search-bar { grid-template-columns: 1fr; } }
.cities { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 14px; }
.city { display: block; text-decoration: none; border-radius: 14px; overflow: hidden; border: 1px solid var(--ui-border); }
.city img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
.city b, .city span { display: block; padding: 0 12px; }
.city b { padding-top: 8px; } .city span { padding-bottom: 10px; color: var(--ui-muted); font-size: 13px; }

/* search */
.search-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 44%); height: calc(100vh - 57px); }
.search-list { overflow: auto; padding: 16px; }
.search-map { position: sticky; top: 0; height: 100%; }
@media (max-width: 900px) { .search-layout { grid-template-columns: 1fr; height: auto; } .search-map { height: 320px; position: relative; order: -1; } }
.filters { display: grid; gap: 14px; padding: 14px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); margin-bottom: 16px; }
.results { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 18px; }
.result { text-decoration: none; display: block; border-radius: 14px; outline-offset: 4px; }
.result.picked { outline: 2px solid var(--ui-accent); }
.result img { display: block; width: 100%; aspect-ratio: 20 / 19; object-fit: cover; border-radius: 14px; }
.result .line { display: flex; justify-content: space-between; gap: 8px; margin-top: 8px; }
.result .price b { font-size: 15px; }
.map { width: 100%; height: 100%; min-height: 280px; z-index: 0; }
.price-pin { background: var(--ui-surface); color: var(--ui-fg); border: 1px solid var(--ui-border); border-radius: 999px; padding: 3px 8px; font: 600 12px/1.2 var(--ui-font); box-shadow: var(--ui-shadow); white-space: nowrap; width: auto !important; height: auto !important; }
.price-pin.on { background: var(--ui-fg); color: var(--ui-bg); }
.place-pin { width: 12px !important; height: 12px !important; border-radius: 50%; border: 2px solid #fff; box-shadow: 0 0 0 1px #0004; }
.place-pin.food { background: #e07a2c; } .place-pin.culture { background: #6a4bd6; } .place-pin.outdoors { background: #2f9e44; } .place-pin.nightlife { background: #c2255c; }
.home-pin { width: 22px !important; height: 22px !important; border-radius: 50%; background: var(--ui-accent); border: 3px solid #fff; box-shadow: 0 0 0 1px #0006; }

/* a place */
.stay-head { margin: 8px 0 16px; }
.stay-grid { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 40px; align-items: start; }
@media (max-width: 960px) { .stay-grid { grid-template-columns: 1fr; } }
.photo { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--ui-radius); }
.widget { position: sticky; top: 76px; padding: 20px; border: 1px solid var(--ui-border); border-radius: 16px; box-shadow: var(--ui-shadow-lg); display: grid; gap: 14px; background: var(--ui-surface); }
.widget .big { font-size: 22px; font-weight: 700; }
.lines { display: grid; gap: 6px; margin: 0; padding: 0; list-style: none; }
.lines li { display: flex; justify-content: space-between; gap: 8px; }
.lines li.total { border-top: 1px solid var(--ui-border); padding-top: 8px; font-weight: 700; }
.lines li.discount { color: var(--ui-success); }
.amenities { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 8px 16px; padding: 0; list-style: none; }
.months { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 24px; }
.month h4 { margin: 0 0 8px; }
.month .grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; text-align: center; font-size: 13px; }
.month .wd { color: var(--ui-muted); font-size: 11px; }
.month .d { padding: 6px 0; border-radius: 8px; }
.month .d.taken, .month .d.closed { color: var(--ui-muted); text-decoration: line-through; }
.month .d.past { color: var(--ui-subtle); }
.month .d.in { background: var(--ui-accent-soft); }
.month .d.edge { background: var(--ui-accent); color: var(--ui-accent-fg); }
.month .d.clash { background: var(--ui-danger-soft); color: var(--ui-danger); text-decoration: line-through; }
.weather { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 6px; }
.weather .day { flex: 0 0 auto; min-width: 84px; text-align: center; padding: 10px 8px; border: 1px solid var(--ui-border); border-radius: 12px; }
.weather .icon { font-size: 26px; }
.places { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; }
@media (max-width: 700px) { .places { grid-template-columns: 1fr; } }
.places ul { list-style: none; padding: 0; margin: 0; max-height: 340px; overflow: auto; }
.places li { display: flex; justify-content: space-between; gap: 8px; padding: 8px 0; border-bottom: 1px solid var(--ui-border); }
.places .map { height: 340px; border-radius: var(--ui-radius); }
.activities { display: grid; gap: 14px; }
.slots { display: flex; gap: 8px; flex-wrap: wrap; }
.slot { border: 1px solid var(--ui-border); background: var(--ui-surface); border-radius: 10px; padding: 6px 10px; font: inherit; font-size: 13px; cursor: pointer; text-align: left; }
.slot[disabled] { opacity: .45; cursor: not-allowed; }
.slot.wet { border-color: var(--ui-warning); }
.slot.on { border-color: var(--ui-accent); box-shadow: 0 0 0 2px var(--ui-accent-soft); }
.reviews { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }

/* checkout, trips */
.checkout { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 32px; align-items: start; }
@media (max-width: 860px) { .checkout { grid-template-columns: 1fr; } }
.trip { display: grid; grid-template-columns: 120px minmax(0, 1fr) auto; gap: 14px; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--ui-border); }
.trip img { width: 120px; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 10px; }
@media (max-width: 600px) { .trip { grid-template-columns: 80px 1fr; } .trip img { width: 80px; } .trip .actions { grid-column: 1 / -1; } }

/* hosting */
.stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; }
.request { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); }
.cal { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; }
.cal .wd { font-size: 12px; color: var(--ui-muted); text-align: center; }
.cal button { min-height: 64px; display: grid; align-content: space-between; text-align: left; padding: 6px; border: 1px solid var(--ui-border); border-radius: 8px; background: var(--ui-surface); font: inherit; font-size: 12px; cursor: pointer; color: var(--ui-fg); }
.cal button b { font-size: 14px; }
.cal button.custom .p { color: var(--ui-accent); font-weight: 600; }
.cal button.closed { background: repeating-linear-gradient(45deg, var(--ui-bg), var(--ui-bg) 6px, var(--ui-border) 6px, var(--ui-border) 7px); }
.cal button.booked { background: var(--ui-success-soft); }
.cal button.held, .cal button.requested { background: var(--ui-warning-soft); }
.cal button.sel { outline: 2px solid var(--ui-accent); outline-offset: -2px; }
.cal button.past { opacity: .5; }
.new-form { display: grid; gap: 14px; max-width: 720px; }
.new-form .two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
table.plain { width: 100%; border-collapse: collapse; font-size: 13px; }
table.plain th, table.plain td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--ui-border); }
table.plain td.url { max-width: 420px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
`

view Head(title: str, maps: bool = false) =
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>{title} · Quillo Stays</title>
        <link rel="icon" href="/pics/icon.svg" type="image/svg+xml"/>
        {maps ? <link rel="stylesheet" href={`${LEAFLET}/leaflet.min.css`}/> : null}
        {maps ? <script src={`${LEAFLET}/leaflet.min.js`}></script> : null}
        <style>{kit_css + stays_css}</style>
    </head>

view Shell(me, title: str, here: str = "", maps: bool = false, wide: bool = false, children) =
    <html lang="en">
        <Head {title} {maps}/>
        <body class="ui-root" data-notices="dialog-center toasts-bottom-center">
            <Navbar brand="Quillo Stays" logo={<span.brand-mark aria-hidden="true">Q</span>} sticky={true} current={here}
                links={me == null
                    ? [{ href: "/s?where=Lisbon", label: "Explore" }, { href: "/status", label: "Status" }]
                    : [{ href: "/s?where=Lisbon", label: "Explore" }, { href: "/trips", label: "Trips" }, { href: "/saved", label: "Saved" }, { href: "/host", label: me.hosts == 1 ? "Hosting" : "Host a place" }, { href: "/status", label: "Status" }]}>
                {me == null
                    ? <div.nav-actions><Button variant="ghost" size="sm" href="/login">Sign in</Button><Button size="sm" href="/signup">Sign up</Button></div>
                    : <form.nav-actions method="post" action="/logout">
                        <Avatar name={me.name} size="sm"/>
                        <Button variant="ghost" size="sm" type="submit">Sign out</Button>
                    </form>}
            </Navbar>
            <main class={wide ? "page wide" : "page"}>{children}</main>
        </body>
    </html>

view NotFound(me, what: str) =
    <Shell {me} title="Not found">
        <EmptyState title="Not here" icon="search" actions={<Button href="/">Home</Button>}>{what}</EmptyState>
    </Shell>

// A picture for a place, drawn: no photos are stored. Its hue is the place's,
// and each of its pictures is a different scene.
fn picture_svg(hue: int, n: int, label: str) -> str {
    let sky = `hsl(${hue}, 60%, ${78 - n * 4}%)`
    let ground = `hsl(${(hue + 40) % 360}, 35%, ${42 + n * 3}%)`
    let sun_x = 80 + n * 90
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 360"><rect width="640" height="360" fill="${sky}"/><circle cx="${sun_x}" cy="90" r="38" fill="hsl(45, 95%, 70%)"/><path d="M0 260 Q 160 ${200 + n * 12} 320 250 T 640 ${230 + n * 6} V 360 H 0 Z" fill="${ground}"/><rect x="${230 + n * 20}" y="170" width="150" height="110" fill="hsl(${hue}, 25%, 96%)"/><path d="M${215 + n * 20} 175 L ${305 + n * 20} 110 L ${395 + n * 20} 175 Z" fill="hsl(${(hue + 180) % 360}, 45%, 45%)"/><rect x="${290 + n * 20}" y="220" width="32" height="60" fill="hsl(${hue}, 40%, 35%)"/><text x="20" y="340" font-family="system-ui" font-size="20" fill="#0008">${escape(label)}</text></svg>`
}
