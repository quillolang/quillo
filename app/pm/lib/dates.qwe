// Calendar days, on Quillo's `date` module. A day is an int, the days since
// 1970-01-01 (so 2026-10-28 is 20754), and is kept as 'YYYY-MM-DD' text in
// the database; the module does the calendar. All pure, so components use
// them in the browser too.

let DAY_MS = 86_400_000
let EPOCH = "1970-01-01"

// "2026-10-28" is 20754; anything else is an error value. Only real days:
// "2026-02-30" is refused, not moved on to March.
fn parse_day(text) -> int ! str {
    if type_of(text) != "str" { return err("A day is written YYYY-MM-DD") }
    let t = trim(text)
    if len(t) != 10 || !date.valid(t) { return err(`No such day: ${text}`) }
    date.days_between(EPOCH, t)
}

// The day as text, or null for null: for optional days read from the database.
fn day_or_null(text) = text == null || text == "" ? null : parse_day(text) ?? null

fn day_text(n: int) -> str = date.add_days(EPOCH, n)

// { year, month, day, weekday } of day n.
fn parts_of(n: int) = date.parts(day_text(n))

// Monday is 0.
fn weekday(n: int) -> int = date.weekday(day_text(n)) - 1

fn week_start(n: int) -> int = n - weekday(n)

fn is_weekend(n: int) -> bool = weekday(n) >= 5

// "Oct 28", or "Oct 28, 2027" in another year than `year`.
fn short_day(n: int, year: int? = null) -> str =
    date.format(day_text(n), year == null || year_of(n) == year ? "MMM D" : "MMM D, YYYY")

fn year_of(n: int) -> int = parts_of(n).year

// The day a moment falls on, in UTC shifted by `offset_min` minutes east
// (the viewer's time zone, as the browser reports it).
fn day_of(ms: int, offset_min: int = 0) -> int = floor((ms + offset_min * 60_000) / DAY_MS)

// Working days from a to b, both counted: weekends left out.
fn work_days(a: int, b: int) -> int =
    b < a ? 0 : count(range(a, b + 1), (n) => !is_weekend(n))

// "3d overdue", "due today", "due tomorrow", "due in 5d", "due Nov 30".
fn due_label(due: int, today: int) -> str {
    let d = due - today
    if d < 0 { return `${-d}d overdue` }
    if d == 0 { return "due today" }
    if d == 1 { return "due tomorrow" }
    if d < 14 { return `due in ${d}d` }
    `due ${short_day(due, year_of(today))}`
}

// "just now", "5m ago", "3h ago", "2d ago", or the day.
fn ago(t: int, now_ms: int) -> str {
    let s = floor((now_ms - t) / 1000)
    if s < 45 { return "just now" }
    if s < 3600 { return `${max([floor(s / 60), 1])}m ago` }
    if s < 86400 { return `${floor(s / 3600)}h ago` }
    if s < 86400 * 14 { return `${floor(s / 86400)}d ago` }
    short_day(day_of(t))
}
