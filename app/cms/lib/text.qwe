// Small pure helpers, on the server and in the browser: times, names, slugs,
// and the calendar days a date field holds.

let DAY_MS = 86_400_000

fn ago(t: int, now_ms: int) -> str {
    let s = floor((now_ms - t) / 1000)
    if s < 45 { return "just now" }
    if s < 3600 { return `${max([floor(s / 60), 1])}m ago` }
    if s < 86400 { return `${floor(s / 3600)}h ago` }
    `${floor(s / 86400)}d ago`
}

fn plural(n: int, word: str) -> str = n == 1 ? `1 ${word}` : `${n} ${word}s`

// "Hello, World!" is "hello-world".
fn slugify(text: str) -> str {
    let s = re.replace(lower(trim(text)), "[^a-z0-9]+", "-")
    let t = re.replace(s, "^-+|-+$", "")
    len(t) > 60 ? slice(t, 0, 60) : t
}

// "2026-10-28" back as it is if it is a real day, else an error value.
fn check_day(text) -> str ! str {
    let t = trim(str(text ?? ""))
    if !re.test(t, "^\\d{4}-\\d{2}-\\d{2}$") { return err(`Not a day: ${text}`) }
    if !date.valid(t) { return err(`No such day: ${text}`) }
    t
}

// "Oct 28, 2026".
fn day_label(text) -> str = date.valid(text) ? date.format(text, "MMM D, YYYY") : ""

// The UTC day of a moment, as text.
fn day_of_ms(ms: int) -> str = date.date_in(date.from_ms(ms), "UTC")

// JSON text from the database as a value, or `fallback` if it is not JSON.
fn from_json(text, fallback) = text == null ? fallback : json.parse(text) ?? fallback
