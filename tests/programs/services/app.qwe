// An app of two services: the shop, and the billing it calls.
//
//   quillo run tests/programs/services/app.qwe            one process
//   quillo run tests/programs/services/app.qwe --split    a process for each service
//
// Either way, open http://localhost:8080. The code does not change: in one
// process, the shop calls billing directly; split, over HTTP, signed with
// QUILLO_SERVICE_SECRET (--split makes one). To run billing on a machine of
// its own, start it alone and tell the others where it is:
//
//   QUILLO_SERVICE_SECRET=... quillo run billing.qwe --port 8081 --base /billing
//   QUILLO_SERVICE_SECRET=... quillo run app.qwe --service-url billing=http://10.0.0.5:8081

service /shop = "shop.qwe"
service /billing = "billing.qwe"

route GET / = <html>
    <head><title>Services</title></head>
    <body>
        <h1>Two services</h1>
        <p><a href="/shop">The shop</a> sells mugs; <a href="/billing">billing</a> keeps the invoices.</p>
        <p>Billed so far: {billing.total() ?? "billing is not answering"} cents.</p>
    </body>
</html>
