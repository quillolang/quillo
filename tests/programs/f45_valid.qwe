fn tot(xs: list<int>) = sum(xs)
let data = json.parse("[1, 2]")
print(tot(data | map((x) => x * 2)))
print(tot([data[0] + 1, 2]))
print(tot([len("a"), int("3") ?? 0]))
fn half(n: int) = [n / 2, n]
fn make() = () => later
let gg = make()
fn adder(n) = (x) => x + base + n
let add2 = adder(2)
fn outer() {
    fn inner(item) = item * 2
    inner(3)
}
print(outer())
fn default_n() = base_n
type Cfg = { n: int = default_n() }
fn f(x) = if x { later } else { 0 }
print(f(false))
