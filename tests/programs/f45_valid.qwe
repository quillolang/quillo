route GET /a/:id {
    let id2 = int(id) ?? 0
    id2 + 1
}
route GET /b/:n = [1, 2] | map((n) => n * 2)
route POST /c { json: body } = body
route GET /d ? { q: name } = name
view V() = <div><link rel="preload" href="/x.css" onload="this.rel='stylesheet'"/><img src="/a.png" ismap/><div x-data="{}"></div><svg><filter><feTurbulence seed="2"/><feDisplacementMap scale="3"/></filter></svg><p @changed={() => 1} @shown={() => 2}>p</p></div>
fn loops() {
    let done = false
    let set_done = () => { done = true }
    let i = 0
    while !done { i += 1; if i > 3 { set_done() } }
    i
}
