// Under a strict Content-Security-Policy (csp()), the page's components,
// prefetching and `--watch`'s reload still work: Quillo's inline scripts
// carry the answer's nonce, and the runtime needs no eval. An inline script
// without the nonce is blocked. Driven by csp.js (tests/browser.rs).

csp()

component Counter() {
    state n = 1
    <button id="count" @click={() => { n = n + 1 }}>{n}</button>
}

route GET / = <html><body>
    <a id="next" href="/next">next</a>
    <Counter/>
    <script nonce={csp_nonce()}>window.good = 1</script>
    <script>window.bad = 1</script>
</body></html>

route GET /next = <html><body><p>next</p></body></html>
