<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>org.quillolang.app</string>
    <key>CFBundleName</key><string>Quillo</string>
    <key>CFBundleDisplayName</key><string>Quillo</string>
    <key>CFBundleExecutable</key><string>Quillo</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.6.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>CFBundleSupportedPlatforms</key><array><string>iPhoneSimulator</string></array>
    <key>MinimumOSVersion</key><string>17.0</string>
    <key>UIDeviceFamily</key><array><integer>1</integer><integer>2</integer></array>
    <key>UILaunchScreen</key><dict/>
    <key>UIApplicationSceneManifest</key>
    <dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict>
    <key>QuilloMain</key><string>main.qwe</string>
    <!-- Why the app asks, shown in each system prompt. A program that does not use one
         never asks for it. -->
    <key>NSCameraUsageDescription</key><string>For photos and video the program takes.</string>
    <key>NSMicrophoneUsageDescription</key><string>For voice notes and calls the program records.</string>
    <key>NSLocationWhenInUseUsageDescription</key><string>For the places the program records.</string>
    <key>NSPhotoLibraryUsageDescription</key><string>For pictures you choose to add.</string>
    <key>NSPhotoLibraryAddUsageDescription</key><string>For pictures the program saves for you.</string>
    <key>NSMotionUsageDescription</key><string>For the compass and the device's motion.</string>
    <!-- The program is served to this app on 127.0.0.1 over plain HTTP. -->
    <key>NSAppTransportSecurity</key>
    <dict><key>NSAllowsLocalNetworking</key><true/></dict>
</dict>
</plist>
