// A small syntax highlighter for Quillo, run while the page renders.
//
// `highlight(text)` gives lines of tokens, `[{ k, text }]`: plain data, so a
// component can take it as a prop and draw it with `Code`.

let WORD = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_@~"
let QUOTES = "\"'`"
let KEYWORDS = ["route", "fn", "let", "component", "view", "server", "match", "if", "else",
    "for", "in", "return", "reply", "with", "as", "use", "mount", "service", "state", "type", "true", "false",
    "null", "GET", "POST", "PUT", "PATCH", "DELETE"]
let TYPES = ["int", "str", "float", "num", "bool", "list", "map", "html", "any"]

fn char_kind(c: str) = contains(WORD, c) ? "w" : c == " " ? "s" : "p"

// Each character with its kind, following strings and `//` comments. A
// string still open at the end of the line goes on into the next.
fn chars(line: str, mode: str = "code", q: str = "") =
    reduce(split(line, ""), { out: [], mode, q }, (st, c) =>
        st.mode == "comment" ? merge(st, { out: push(st.out, ["comment", c]) })
        : st.mode == "string" ? merge(st, { out: push(st.out, ["string", c]), mode: c == st.q ? "code" : "string" })
        : contains(QUOTES, c) ? merge(st, { out: push(st.out, ["string", c]), mode: "string", q: c })
        : c == "/" && last(st.out) == ["p", "/"]
            ? merge(st, { out: push(push(take(st.out, len(st.out) - 1), ["comment", "/"]), ["comment", "/"]), mode: "comment" })
        : merge(st, { out: push(st.out, [char_kind(c), c]) })
    )

// Runs of one kind become one token.
fn group(cs: list) =
    reduce(cs, [], (toks, ch) =>
        len(toks) > 0 && last(toks).k == ch[0]
            ? push(take(toks, len(toks) - 1), { k: ch[0], text: last(toks).text + ch[1] })
            : push(toks, { k: ch[0], text: ch[1] }))

fn is_upper(c: str) = upper(c) == c && lower(c) != c

// `declared`: the word follows `state `, so it names a component's state.
fn word_kind(t: map, prev, next, declared: bool = false) {
    let w = t.text
    let after_lt = prev != null && prev.k == "p" && (ends_with(prev.text, "<") || ends_with(prev.text, "</"))
    if starts_with(w, "@") { return "attr" }
    if starts_with(w, "~") || declared { return "state" }
    if after_lt { return is_upper(w[0]) ? "comp" : "tag" }
    // Right after a tag's `>` (not an arrow's `=>`) is text in markup.
    if prev != null && prev.k == "p" && ends_with(prev.text, ">") && !ends_with(prev.text, "=>") { return "plain" }
    if contains(KEYWORDS, w) { return "kw" }
    if contains("0123456789", w[0]) { return "num" }
    if is_upper(w[0]) { return "comp" }
    // `map(...)` and `int(...)` are calls, though `map` and `int` are also types.
    if next != null && next.k == "p" && starts_with(next.text, "(") { return "call" }
    if contains(TYPES, w) { return "type" }
    "plain"
}

fn classify(toks: list) =
    for [i, t] in enumerate(toks) =>
        t.k == "w" ? {
            let declared = i > 1 && toks[i - 1].k == "s" && toks[i - 2].text == "state"
            { k: word_kind(t, i > 0 ? toks[i - 1] : null, toks[i + 1], declared), text: t.text }
        } : t

fn highlight(text: str) =
    reduce(split(trim(text), "\n"), { lines: [], mode: "code", q: "" }, (st, line) => {
        let r = chars(line, st.mode, st.q)
        // Only backticks and double quotes go on: a `'` is as often an apostrophe in text.
        let open = r.mode == "string" && r.q != "'"
        { lines: push(st.lines, classify(group(r.out))), mode: open ? "string" : "code", q: r.q }
    }).lines

view Code(lines: list) =
    <pre.code><code>{for line in lines =>
        <span.ln>{for t in line =>
            t.k == "w" || t.k == "s" || t.k == "p" || t.k == "plain" ? t.text : <span class={`t-${t.k}`}>{t.text}</span>
        }</span>
    }</code></pre>
