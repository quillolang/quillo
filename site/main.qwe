// quillolang.org, written in Quillo.
//
//   quillo run site/main.qwe --watch      then open http://localhost:8080
//   site/export.sh                        renders it to static files in site/dist
//
// The code on the page is read from tour/ and demos/ and highlighted while the
// page renders. The demos are `use`d too, so what the page shows is what runs.

use "highlight.qwe"
use "demos/todo.qwe"
use "demos/life.qwe"

let REPO = "https://github.com/wisp-one/quillo"

let tour = [
    { name: "Routes", file: "routes.qwe",
      title: "An app reads like a list of what it answers",
      points: ["Path parameters are variables; `:id(int)` matches only digits.",
               "Query strings and JSON bodies are matched by patterns, with types and defaults.",
               "`|` pipes a request through middleware, and `reply` answers from anywhere."] },
    { name: "Components", file: "components.qwe",
      title: "Rendered on the server, resumed in the browser",
      points: ["`state` is kept between renders and re-renders when assigned. Everything else is recomputed.",
               "The server sends HTML; the browser takes over its elements instead of redrawing them.",
               "Each page loads only its own components, about 8 KB gzipped, when they are reached."] },
    { name: "Server functions", file: "server.qwe",
      title: "Call the server like a function",
      points: ["`server fn` is callable from components; there is no `async` or `await` to write.",
               "Arguments are checked against the parameter types; other sites get a 403.",
               "Failures are error values, so `??` carries on."] },
    { name: "Live data", file: "live.qwe",
      title: "State that follows the database",
      points: ["`live(load)` re-runs the loader whenever a table it read changes, for anyone.",
               "One WebSocket per page, with plain requests where it cannot open.",
               "Works the same with SQLite, PostgreSQL, MySQL and data kept in variables."] },
    { name: "Patterns", file: "patterns.qwe",
      title: "One pattern language, everywhere",
      points: ["The same patterns work in `match`, `let`, `for` and routes.",
               "Errors are values: `?` returns them, `??` replaces them.",
               "`! str` declares what a function's errors hold, and it is checked."] },
    { name: "Effects", file: "effects.qwe",
      title: "Say what a function may touch",
      points: ["`with db, http` limits a function, and everything it calls, to those effects.",
               "`quillo check` reports a stray effect before the program runs.",
               "`parallel` overlaps waits: threads on the server, `Promise.all` in the browser."] },
] | map((t) => merge(t, { lines: highlight(read_file(`tour/${t.file}`)) }))

// Python 3.9 against Quillo, on a million floats (from the README).
let bench = [
    { op: "stats.stdev", quillo: 0.65, python: 674 },
    { op: "stats.mean", quillo: 0.35, python: 214 },
    { op: "stats.describe", quillo: 1.7, python: 764, note: "by hand" },
    { op: "stats.histogram", quillo: 0.6, python: 126, note: "a loop" },
    { op: "stats.correlation", quillo: 1.4, python: 246 },
    { op: "stats.linear_regression", quillo: 1.3, python: 182 },
    { op: "stats.median", quillo: 1.3, python: 44 },
    { op: "sort", quillo: 4.6, python: 46 },
]

let features = [
    { title: "Checked before it runs", text: "`quillo check` holds the program to its types, records, list and map shapes, effects and error types, and warns about SQL built from values." },
    { title: "Safe by default", text: "Text is escaped, cross-site posts are refused, sessions are signed cookies and `javascript:` URLs are blocked." },
    { title: "SQLite built in", text: "Or PostgreSQL or MySQL, with the same functions, and several at once. Transactions nest, and migrations run in order, once." },
    { title: "Streaming", text: "`stream` and `events` send an answer as it is made, from a CSV export to a model's reply word by word." },
    { title: "Translations", text: "`t(\"cart.items\", { count })` picks plural forms by the language's rules, on the server and in components." },
    { title: "Services", text: "Split a part of an app into its own server without changing its code; calls are signed with HMAC." },
    { title: "Numbers and data", text: "`math`, `stats` and `vec` give Python's answers, on every core, in the server and the browser." },
    { title: "Desktop apps", text: "`quillo app` runs the same program in a native window, with the platform's own web view." },
]

fn inline(text: str) = markdown(text, { inline: true })

view Logo() = raw(`<svg class="logo" viewBox="0 0 32 32" aria-hidden="true">
  <defs><linearGradient id="lg" x1="0" y1="1" x2="1" y2="0">
    <stop offset="0" stop-color="#f3b54a"/><stop offset="1" stop-color="#b9a8ff"/></linearGradient></defs>
  <path d="M28 3C16 4 8.5 11.5 6.6 22.4L5 29l1.8.5 1.7-5.2C19 23.6 26.5 15 28 3z" fill="url(#lg)"/>
  <path d="M8.5 24.3C12 18 17 12.5 23.5 8" fill="none" stroke="#0b0a12" stroke-width="1.4" stroke-linecap="round"/>
</svg>`)

view Window(title: str, children) =
    <div.window>
        <div.bar><i></i><i></i><i></i><span>{title}</span></div>
        {children}
    </div>

component Tour(items: list) {
    state active = 0
    let item = items[active]
    <div.tour>
        <div.tabs role="tablist">
            {for [i, t] in enumerate(items) =>
                <button key={t.name} role="tab" aria-selected={i == active ? "true" : "false"}
                    class={i == active && "active"} @click={() => { active = i }}>{t.name}</button>}
        </div>
        <div.panel>
            <div.copy>
                <h3>{item.title}</h3>
                <ul>{for p in item.points =>
                    <li>{for [i, s] in enumerate(split(p, "`")) => i % 2 == 1 ? <code>{s}</code> : s}</li>}</ul>
            </div>
            <Window title={item.file}><Code lines={item.lines}/></Window>
        </div>
    </div>
}

view Bench(rows: list) {
    let top = math.log10(max(rows | map((r) => r.python / r.quillo)))
    <ol.bench>
        {for r in rows => {
            let x = r.python / r.quillo
            <li tabindex="0">
                <code>{r.op}</code>
                <span.track><span.fill style={`width: ${round(math.log10(x) / top * 100, 1)}%`}></span></span>
                <b>{round(x)}×</b>
                <span.tip role="tooltip">Quillo {r.quillo} ms · Python {r.python} ms{r.note ? ` (${r.note})` : ""}</span>
            </li>
        }}
    </ol>
}

let SITE = "https://quillolang.org"
let style = read_file("style.css")
let docs_style = read_file("docs.css")

use "docs.qwe"

view Head(title: str, description: str, path: str, css: str, fonts: list) =
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>{title}</title>
        <meta name="description" content={description}/>
        <meta property="og:title" content={title}/>
        <meta property="og:description" content={description}/>
        <link rel="canonical" href={SITE + path}/>
        <meta name="theme-color" content="#0b0a12"/>
        <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
        {for f in fonts => <link rel="preload" href={`/fonts/${f}.woff2`} as="font" type="font/woff2" crossorigin/>}
        <style>{css}</style>
    </head>

route GET /favicon.svg = file("public/favicon.svg", { cache: "30d" })
route GET /fonts/*path = file("public/fonts/" + path, { cache: "1y" })

// Every page, for search engines and for export.sh, which renders each one.
route GET /sitemap.txt = join(["/"] + (ordered | map((p) => p.url)) | map((u) => SITE + u), "\n") + "\n"

fn docs(slug: str) {
    let page = find(pages, (p) => p.slug == slug) ?? reply 404 "No such page"
    <html lang="en">
        <Head title={`${page.title} · Quillo docs`} path={page.url} css={style + docs_style}
            description={`${page.title}: the Quillo language documentation.`}
            fonts={["instrument-serif", "inter", "jetbrains-mono"]}/>
        <body.docs-body>
            <header.nav>
                <div.nav-left>
                    <a.brand href="/"><Logo/>Quillo</a>
                    <a.docs-label href="/docs/">Docs</a>
                </div>
                <nav.group-tabs aria-label="Sections">
                    {for g in GROUPS => {
                        let p = find(pages, (q) => q.slug == first(g.pages))
                        <a href={p.url} class={g.name == page.group && "active"}>{g.name}</a>
                    }}
                </nav>
                <nav><a.gh href={REPO}>GitHub</a></nav>
            </header>
            <DocsPage page={page}/>
        </body>
    </html>
}

route GET /docs = docs("introduction")
route GET /docs/:slug = docs(slug)
route GET /docs/examples/:name = docs(`examples/${name}`)

route GET / =
    <html lang="en">
        <Head title="Quillo — the web, as a language" path="/" css={style}
            description="Quillo is a small web programming language: routes, request patterns, pipelines, HTML and browser components are part of the syntax."
            fonts={["instrument-serif", "instrument-serif-italic", "inter"]}/>
        <body>
            <header.nav>
                <a.brand href="/"><Logo/>Quillo</a>
                <nav>
                    <a href="#tour">Tour</a>
                    <a href="#demo">Demo</a>
                    <a href="/docs/">Docs</a>
                    <a href="#start">Start</a>
                    <a.gh href={REPO}>GitHub</a>
                </nav>
            </header>

            <section.hero>
                <Life board={seeded()}/>
                <div.hero-inner>
                    <div.hero-copy>
                        <p.eyebrow>v0.5 · MIT · one binary, written in Rust</p>
                        <h1>The web, <em>as a language.</em></h1>
                        <p.lede>
                            Routes, request patterns, pipelines and HTML are part of Quillo's syntax,
                            so a web app reads like a list of what it answers. Components render on the
                            server and resume in the browser, with no build step.
                        </p>
                        <div.ctas>
                            <a.btn.primary href="#start">Get started</a>
                            <a.btn href="#tour">Take the tour →</a>
                        </div>
                    </div>
                    <Window title="app.qwe"><Code lines={tour[0].lines}/></Window>
                </div>
                <p.hint>The cells behind this page are Conway's Life: a Quillo component running in your browser. Move your pointer across them.</p>
            </section>

            <section.pillars>
                <div><b>One binary</b><span>HTTP server, static checker, component compiler, SQLite and a language server.</span></div>
                <div><b>~8 KB per page</b><span>Gzipped, for a small component, and loaded only when someone reaches for it.</span></div>
                <div><b>Expressions like JavaScript</b><span>Arrows, <code>? :</code>, template strings and JSX-style HTML, without the surprises.</span></div>
                <div><b>Live by default</b><span>Pages follow the database over one WebSocket. No broker needed.</span></div>
            </section>

            <section#tour.section>
                <p.kicker>Tour</p>
                <h2>Everything a web app needs, <em>in the syntax.</em></h2>
                <Tour items={tour}/>
            </section>

            <section#demo.section>
                <p.kicker>Demo</p>
                <h2>The code on the left <em>is</em> the list on the right.</h2>
                <p.sub>This page is a Quillo program. The component below was rendered on the server, and your browser took it over. Add an item, or click one to tick it off.</p>
                <div.demo>
                    <Window title="todo.qwe"><Code lines={highlight(read_file("demos/todo.qwe"))}/></Window>
                    <div.stage><Todo/></div>
                </div>
            </section>

            <section#speed.section>
                <p.kicker>Speed</p>
                <h2>Numbers at <em>native speed.</em></h2>
                <p.sub>
                    {inline("`math`, `stats` and `vec` give Python's exact answers, worked on by every core. How many times faster than Python 3.9, on a million floats (log scale; hover for timings):")}
                </p>
                <Bench rows={bench}/>
            </section>

            <section.section>
                <p.kicker>And more</p>
                <h2>Small language, <em>whole toolbox.</em></h2>
                <div.grid>
                    {for f in features => <article><h3>{f.title}</h3><p>{inline(f.text)}</p></article>}
                </div>
            </section>

            <section#start.section.start>
                <p.kicker>Get started</p>
                <h2>From clone to running app <em>in a minute.</em></h2>
                <Window title="terminal">
                    <pre.code.shell><code>{for line in split(trim(read_file("tour/start.sh")), "\n") =>
                        <span.ln><span.prompt>$ </span>{line}</span>}</code></pre>
                </Window>
                <p.sub>
                    {inline("Then open http://127.0.0.1:8080. `quillo check app.qwe` finds mistakes without running, `quillo repl` tries things out, and the VS Code extension (or `quillo lsp` in any editor) adds diagnostics, hover and completion.")}
                </p>
                <div.ctas>
                    <a.btn.primary href={REPO}>Quillo on GitHub</a>
                    <a.btn href={`${REPO}#language-tour`}>Read the language tour →</a>
                </div>
            </section>

            <section.section.story>
                <p.kicker>Story</p>
                <ol.timeline>
                    <li><b>2024</b><span>Conceived: what if routes, patterns and HTML were the language itself?</span></li>
                    <li><b>Late 2025</b><span>The first prototype: a tree-walking interpreter in Rust, serving its own routes.</span></li>
                    <li><b>Today</b><span>v0.5, with components that resume in the browser, a static checker, live data and a language server.</span></li>
                </ol>
            </section>

            <footer>
                <a.brand href="/"><Logo/>Quillo</a>
                <span>MIT licensed. This site is written in Quillo and served as static files.</span>
            </footer>
        </body>
    </html>
