// Conway's Game of Life, drifting behind the page's header. Moving the pointer
// over it brings cells to life; it reseeds itself when it settles down.

let LW = 48
let LH = 22

fn seeded() = range(0, LH) | map((_) => range(0, LW) | map((_) => random() < 0.22 ? 1 : 0))

fn alive(board: list, y: int, x: int) = board[(y + LH) % LH][(x + LW) % LW]

fn generation(board: list) =
    range(0, LH) | map((y) => range(0, LW) | map((x) => {
        let n = alive(board, y - 1, x - 1) + alive(board, y - 1, x) + alive(board, y - 1, x + 1) +
            alive(board, y, x - 1) + alive(board, y, x + 1) +
            alive(board, y + 1, x - 1) + alive(board, y + 1, x) + alive(board, y + 1, x + 1)
        n == 3 || (n == 2 && board[y][x] == 1) ? 1 : 0
    }))

fn touch(board: list, y: int, x: int) =
    range(0, LH) | map((r) => abs(r - y) > 1 ? board[r]
        : range(0, LW) | map((c) => abs(c - x) <= 1 && (r == y || c == x) ? 1 : board[r][c]))

component Life(board: list) {
    state cells = board
    state ticks = 0
    state still = false

    if !still {
        every(180, () => {
            cells = ticks > 600 ? seeded() : generation(cells)
            ticks = ticks > 600 ? 0 : ticks + 1
        })
    }

    <div.life aria-hidden="true" style={`grid-template-columns: repeat(${LW}, 1fr)`} @mount={(el) => {
        still = js("window.matchMedia", "(prefers-reduced-motion: reduce)").matches
    }}>
        {for y in range(0, LH) => for x in range(0, LW) =>
            <i class={cells[y][x] == 1 && "on"} @mouseenter={() => { cells = touch(cells, y, x) }}></i>}
    </div>
}
