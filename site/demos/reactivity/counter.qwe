component CounterDemo() {
    state count = 0
    let double = count * 2      // follows count
    <div.demo-box>
        <p>Count <b>{count}</b>, doubled <b>{double}</b>.</p>
        <p.muted>This sentence reads no state, so it never changes.</p>
        <button @click={() => { count += 1 }}>Add one</button>
        <button @click={() => { count = count }}>Assign the same value</button>
    </div>
}
