// The docs, made from the README so they never drift from it: each `## `
// section is a page, and its `### ` and `#### ` headings are the page's
// contents. Code fences marked `quillo` are highlighted like the home page's.
// The Examples pages show each program in examples/, whole. Both are read
// through content/, links to the repository's README.md and examples/.

let GROUPS = [
    { name: "Guide", pages: ["introduction", "language-tour", "components", "routes"] },
    { name: "Reference", pages: ["standard-library", "checking", "concurrency-and-reloading", "cached-views"] },
    { name: "Examples", pages: ["examples", "examples/hello", "examples/orders", "examples/todo",
        "examples/notes", "examples/compose", "examples/layout", "examples/spa", "examples/scroll",
        "examples/life", "examples/storm", "examples/services", "examples/index"] },
    { name: "Project", pages: ["layout", "not-built-yet"] },
]

// What each example is called here, and what it shows, in a line.
let EXAMPLES = [
    { name: "hello", title: "Hello, routes", blurb: "Path parameters, typed query patterns and JSON answers in fifteen lines." },
    { name: "orders", title: "Payload routing", blurb: "One path, several handlers, chosen by what is inside the JSON body." },
    { name: "todo", title: "Todo app", blurb: "A server-rendered app with forms, redirects and a JSON API next to it." },
    { name: "notes", title: "Notes", blurb: "SQLite on the server, a live component in the browser, in sync across tabs." },
    { name: "compose", title: "Composition", blurb: "Views and components built from each other: props down, callbacks up, slots." },
    { name: "layout", title: "JSON layout", blurb: "A page described as JSON, rendered by one view, with a live editor beside it." },
    { name: "spa", title: "Single-page app", blurb: "Client-side navigation, deep links, a cart that survives pages and live stock." },
    { name: "scroll", title: "Infinite scroll", blurb: "100,000 rows, loaded 200 at a time, with only the visible ones in the page." },
    { name: "life", title: "Game of Life", blurb: "A board in a component's state, stepped by a timer that runs in the browser." },
    { name: "storm", title: "State storm", blurb: "A dashboard under a storm of random changes, tested for leaks." },
    { name: "services", title: "Services", blurb: "A shop that bills through a billing service, in one process or split apart.",
      files: ["app.qwe", "shop.qwe", "billing.qwe"] },
    { name: "index", title: "All examples", blurb: "Every example mounted under its own path in one server, behind tabs." },
]
let RENAMED = { "layout": "Source layout", "not-built-yet": "Roadmap" }
let ALNUM = "abcdefghijklmnopqrstuvwxyz0123456789"

// As GitHub makes heading anchors: lower case, spaces to dashes, other marks dropped.
fn slug(text: str) =
    split(lower(text), "") | map((c) => contains(ALNUM, c) ? c : c == " " || c == "-" ? "-" : "") | join("")

fn page_url(s: str) = s == "introduction" ? "/docs/" : `/docs/${s}/`

// The comment a file starts with, as markdown: lines indented further than a
// list item's are commands, shown as code.
fn header_lines(lines: list) =
    reduce(lines, { out: [], done: false }, (st, l) =>
        !st.done && starts_with(l, "//") ? merge(st, { out: push(st.out, l) }) : merge(st, { done: true })).out

fn about(header: list) =
    header | map((l) => {
        let t = starts_with(l, "// ") ? slice(l, 3) : slice(l, 2)
        let line = trim(t)
        let command = starts_with(t, "  ") && (starts_with(line, "quillo ") || starts_with(line, "curl "))
        let gap = index_of(line, "  ")
        // "quillo run x.qwe --watch     then open ...": the command, then the words after it.
        command ? "\n`" + (gap != null ? slice(line, 0, gap) : line) + "`" + (gap != null ? " " + trim(slice(line, gap)) : "") + "\n" : t
    }) | join("\n")

fn shell(lines: list) = { type: "shell", lines: lines | map((l) => [{ k: "prompt", text: "$ " }, { k: "plain", text: l }]) }

fn example_page(e: map) {
    let files = e.files ? e.files | map((f) => `${e.name}/${f}`) : [`${e.name}.qwe`]
    let main = split(read_file(`content/examples/${first(files)}`), "\n")
    let head = header_lines(main)
    let sources = for [i, f] in enumerate(files) => {
        let lines = i == 0 ? drop(main, len(head)) : split(read_file(`content/examples/${f}`), "\n")
        [{ type: "h", level: 3, text: len(files) == 1 ? "Source" : f, id: len(files) == 1 ? "source" : slug(replace(f, "/", " ")) },
         { type: "code", lang: "quillo", lines, file: f }]
    }
    {
        title: e.title,
        blocks: [
            { type: "h", level: 3, text: "About", id: "about" },
            { type: "md", text: about(head) },
            { type: "h", level: 3, text: "Run it", id: "run-it" },
            shell([`./target/release/quillo run examples/${first(files)} --watch`]),
        ] + flatten(sources) + [
            { type: "md", text: `[See ${e.name}${e.files ? "/" : ".qwe"} on GitHub](${REPO}/tree/main/examples/${e.files ? e.name : `${e.name}.qwe`})` },
        ],
    }
}

let overview = {
    title: "Overview",
    blocks: [
        { type: "md", text: "Small programs, each showing one part of Quillo, with its whole source. All of them run with `quillo run examples/<name>.qwe --watch`, or together with `quillo run examples/index.qwe`." },
        { type: "cards" },
    ],
}

// The README's lines, cut at each `## ` outside a code fence.
fn cut_pages(text: str) {
    let st = reduce(split(text, "\n"), { pages: [], cur: { title: "Introduction", lines: [] }, fence: false }, (st, line) =>
        !st.fence && starts_with(line, "## ")
            ? { pages: push(st.pages, st.cur), cur: { title: slice(line, 3), lines: [] }, fence: false }
        : !st.fence && starts_with(line, "# ") ? st
        : merge(st, {
            cur: merge(st.cur, { lines: push(st.cur.lines, line) }),
            fence: starts_with(line, "```") ? !st.fence : st.fence,
        }))
    push(st.pages, st.cur)
}

fn flush(st: map) =
    len(st.md) > 0 ? merge(st, { out: push(st.out, { type: "md", text: join(st.md, "\n") }), md: [] }) : st

// A page's lines as blocks: markdown, code fences and headings.
fn blocks(lines: list) =
    flush(reduce(lines, { out: [], md: [], code: null }, (st, line) =>
        st.code != null
            ? (starts_with(line, "```")
                ? merge(st, { out: push(st.out, merge(st.code, { type: "code" })), code: null })
                : merge(st, { code: merge(st.code, { lines: push(st.code.lines, line) }) }))
        : starts_with(line, "```") ? merge(flush(st), { code: { lang: trim(slice(line, 3)), lines: [] } })
        : starts_with(line, "### ") || starts_with(line, "#### ") ? {
            let level = starts_with(line, "#### ") ? 4 : 3
            let text = trim(slice(line, level + 1))
            merge(flush(st), { out: push(flush(st).out, { type: "h", level, text, id: slug(replace(text, "`", "")) }) })
        }
        : merge(st, { md: push(st.md, line) }))).out

fn quillo_like(b: map) = b.lang == "quillo" || (b.lang == "" && any(b.lines, (l) => contains(l, "fn ") || contains(l, "route ")))

let sources = (cut_pages(read_file("content/README.md")) | map((p) => { slug: slug(p.title), title: p.title, blocks: blocks(p.lines) }))
    + [merge(overview, { slug: "examples" })]
    + (EXAMPLES | map((e) => merge(example_page(e), { slug: `examples/${e.name}` })))

let pages = sources | map((p) => {
    let s = p.slug
    let bs = p.blocks
    {
        slug: s,
        title: RENAMED[s] ?? p.title,
        url: page_url(s),
        group: find(GROUPS, (g) => contains(g.pages, s)).name,
        blocks: bs,
        toc: bs | filter((b) => b.type == "h") | map((b) => { id: b.id, text: replace(b.text, "`", ""), level: b.level }),
    }
}) | filter((p) => p.group != null)

// Pages in reading order: the groups', one after another.
let ordered = flatten(GROUPS | map((g) => g.pages)) | map((s) => find(pages, (p) => p.slug == s))

// Where each anchor lives, for the README's `](#...)` links.
let anchors = reduce(pages, {}, (acc, p) =>
    reduce(p.toc, set(acc, p.slug, p.url), (a, h) => set(a, h.id, `${p.url}#${h.id}`)))

fn fix_anchors(text: str) {
    let parts = split(text, "](#")
    first(parts) + join(drop(parts, 1) | map((part) => {
        let end = index_of(part, ")") ?? len(part)
        let id = slice(part, 0, end)
        `](${anchors[id] ?? `#${id}`}` + slice(part, end)
    }), "")
}

// Links to examples go to their pages here; to other files, to the repository.
fn fix_links(text: str) =
    fix_anchors(text)
        | replace("](examples/services)", "](/docs/examples/services/)")
        | replace("](examples/", "](/docs/examples/")
        | replace(".qwe)", "/)")
        | replace("](apps/", `](${REPO}/tree/main/apps/`)
        | replace("](editors/", `](${REPO}/tree/main/editors/`)

view Block(b: map) =
    match b.type {
        "md" => markdown(fix_links(b.text))
        "h" => b.level == 3
            ? <h3 id={b.id}><a.anchor href={`#${b.id}`}>{markdown(b.text, { inline: true })}</a></h3>
            : <h4 id={b.id}><a.anchor href={`#${b.id}`}>{markdown(b.text, { inline: true })}</a></h4>
        "shell" => <div.snippet.terminal><Code lines={b.lines}/></div>
        "cards" => <div.cards>{for e in EXAMPLES =>
            <a.card href={page_url(`examples/${e.name}`)}><b>{e.title}</b><span>{e.blurb}</span><code>{e.name}{e.files ? "/" : ".qwe"}</code></a>}</div>
        _ => <div.snippet>{b.file && <div.file>{b.file}</div>}<Code lines={quillo_like(b)
            ? highlight(join(b.lines, "\n"))
            : b.lines | map((l) => [{ k: "plain", text: l }])}/></div>
    }

// The right-hand column: this page's headings, the one being read marked as it scrolls.
component OnThisPage(items: list) {
    state active = items[0].id
    <nav.toc aria-label="On this page" @mount={(el) => {
        let seen = js_new("IntersectionObserver", (entries, _observer) => {
            let shown = entries | filter((e) => e.isIntersecting)
            if len(shown) > 0 { active = first(shown).target.id }
        }, { rootMargin: "0px 0px -75% 0px" })
        for h in items => seen.observe(js("document.getElementById", h.id))
        () => seen.disconnect()
    }}>
        <p>On this page</p>
        <ul>{for h in items =>
            <li key={h.id} class={`${h.level == 4 ? "sub" : ""} ${h.id == active ? "active" : ""}`}>
                <a href={`#${h.id}`} @click={() => { active = h.id }}>{h.text}</a>
            </li>}</ul>
    </nav>
}

view DocsPage(page: map) {
    let i = index_of(ordered | map((p) => p.slug), page.slug)
    let prev = i > 0 ? ordered[i - 1] : null
    let next = ordered[i + 1]
    <div.docs>
        <input type="checkbox" id="docs-menu" hidden/>
        <label.menu-button for="docs-menu">{page.group} · {page.title}</label>
        <aside.sidebar aria-label="Docs">
            {for g in GROUPS =>
                <div.side-group class={g.name == page.group && "current"}>
                    <p>{g.name}</p>
                    <ul>{for s in g.pages => {
                        let p = find(pages, (q) => q.slug == s)
                        <li><a href={p.url} class={p.slug == page.slug && "active"}
                            aria-current={p.slug == page.slug ? "page" : null}>{p.title}</a></li>
                    }}</ul>
                </div>}
        </aside>
        <article.prose>
            <p.kicker>{page.group}</p>
            <h1>{page.title}</h1>
            {for b in page.blocks => <Block b={b}/>}
            <nav.pager>
                {prev ? <a.prev href={prev.url}><small>Previous</small>{prev.title}</a> : <span></span>}
                {next ? <a.next href={next.url}><small>Next</small>{next.title}</a> : <span></span>}
            </nav>
            <p.edit><a href={`${REPO}/blob/main/README.md`}>Edit this page on GitHub</a> · made from the README</p>
        </article>
        {len(page.toc) > 0 ? <OnThisPage items={page.toc}/> : <div></div>}
    </div>
}
