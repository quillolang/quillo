// Q-1031 Vue's `@click.prevent` and `v-model` pass `quillo check` in silence, and do nothing
// mode: check
// open-when: /ok \(1 route, 0 functions, 2 components\)\s*$/
// fixed-when: /:16: warning/
// fixed-when: /:18: warning/
// fixed-when: /:25: warning/
// From FEEDBACK72.md §Q-1031 (found on 238dac2, 0.8.6; open on 77ffcd0, 0.8.9). In the
// browser, `@click.prevent` never fires and `v-model` follows nothing (the report's
// Playwright run); here, what `quillo check` says of the three habits (lines 16, 18, 25).

// Vue's habits: a modifier on an event, and v-model. quillo check says ok to both.
component Order() {
    state n = 0
    state name = ""
    <div>
        <button id="vue" @click.prevent={() => { n += 1 }}>Vue's way</button>
        <button id="plain" onclick={() => { n += 1 }}>Plain</button>
        <input id="model" v-model={name}/>
        <p id="out">{n}|{name}</p>
    </div>
}

component Search() {
    state sent = 0
    <form @submit.prevent={() => { sent += 1 }}><input name="q"/><button>Go</button><p>{sent}</p></form>
}
route GET / = <html><body><Order/><Search/></body></html>
