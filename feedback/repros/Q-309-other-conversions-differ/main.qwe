// Q-309 Other conversions differ between server and browser
// mode: browser
// page: /
// probe: document.getElementById("go").click(); await new Promise((r) => setTimeout(r, 300)); return { o: document.getElementById("o").textContent };
// open-when: "o": "1e+21"
// fixed-when: "o": "1000000000000000000000"
// From FEEDBACK25.md §Q-309 (found on 5f7f76c).

component P() {
    state o = ""
    <div><button id="go" @click={() => { o = str(1e21) }}>go</button><p id="o">{o}</p></div>
}

route GET / = <html><body><P/></body></html>
