// Q-038 publish() in a service reaches the app's pages in one process, and silently nobody once --split
// mode: browser
// page: /
// flags: --split
// probe: await new Promise((r) => setTimeout(r, 300)); document.getElementById("spend").click(); await new Promise((r) => setTimeout(r, 1500)); return { shown: document.getElementById("bal").textContent }
// open-when: "shown": "100"
// fixed-when: "shown": "90"
// From FEEDBACK4.md (found on 5d2e21e). Without --split the page shows 90: the service's
// publish("ledger") wakes the loader that watches it. Split, the service runs in a process of its
// own, its publish goes nowhere, and the page keeps 100 with no error. The guide says a program
// "behaves the same whichever way it runs".

service ledger = "ledger.qwe"

server fn load() -> int with http {
    watch("ledger")
    ledger.get() ?? -1
}

server fn spend() with http = ledger.spend(10)

component Balance() {
    state bal = live(load)
    <div>
        <p id="bal">{bal}</p>
        <button id="spend" @click={() => { spend() }}>spend</button>
    </div>
}

route GET / = <html><body><Balance/></body></html>
