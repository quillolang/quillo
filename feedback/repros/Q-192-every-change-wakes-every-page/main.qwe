// Q-192 Every change wakes every waiting thread, even for pages that do not follow it
// mode: script
// script: steps.sh
// open-when: no count of pages woken
// fixed-when: pages woken by what they do not follow: 0
// From FEEDBACK24.md §Q-192 (found on 57370bc, measured on 5f7f76c).

db.open("live.db")
db.exec("create table if not exists rows (id integer primary key, title text)")
db.exec("create table if not exists other (id integer primary key)")
db.exec("insert or ignore into rows (id, title) values (1, 'one'), (2, 'two')")

server fn rows() {
    print("ran")
    db.query("select * from rows order by id")
}
server fn slow() {
    print("ran")
    sleep(300)
    db.query("select * from rows order by id")
}

route GET /write = db.exec("update rows set title = ? where id = 1", str(random_int(0, 1000000)))
route GET /other = db.exec("insert into other (id) values (null)")
