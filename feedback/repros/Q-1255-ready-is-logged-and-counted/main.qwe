// Q-1255 `/_quillo/ready` is logged and counted in `quillo_requests_total`, where the guide says "Neither request is logged or counted"; a 503 from it counts as a 5xx
// mode: script
// script: steps.sh
// open-when: quillo_requests_total{status="2xx"} 2
// open-when: ready log lines: 2
// fixed-when: quillo_requests_total{status="2xx"} 0
