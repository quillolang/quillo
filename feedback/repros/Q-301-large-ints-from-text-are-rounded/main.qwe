// Q-301 `json.parse` rounds large ints in the browser, and `int()` past 64 bits gives a different number
// mode: browser
// page: /
// probe: document.getElementById("go").click(); await new Promise((r) => setTimeout(r, 300)); return { o: document.getElementById("o").textContent };
// open-when: "o": "9007199254740992"
// fixed-when: "o": "9007199254740993"
// From FEEDBACK25.md §Q-301 (found on 5f7f76c).

component P() {
    state o = ""
    <div><button id="go" @click={() => { o = str(json.parse("9007199254740993")) }}>go</button><p id="o">{o}</p></div>
}

route GET / = <html><body><P/></body></html>
