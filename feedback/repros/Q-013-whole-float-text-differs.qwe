// Q-013 A whole float is "8.0" on the server and "8" in the browser, so the component is made again
// mode: browser
// page: /
// probe: return document.querySelector("p").textContent
// open-when: "remade": 1
// fixed-when: "remade": 0
// From FEEDBACK2.md §3 (found on 896e758).

component Score(v: float) {
    state n = 0
    <p>{round(v, 1)} days <button @click={() => { n += 1 }}>{n}</button></p>
}

route GET / = <html><body><Score v={8.04}/></body></html>
