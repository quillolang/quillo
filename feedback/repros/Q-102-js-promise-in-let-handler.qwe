// Q-102 A promise from js() is not waited for in a component's `let` function used as a handler
// mode: browser
// page: /
// probe: for (let i = 0; i < 40 && !window.__quillo_booted; i++) { document.querySelector("button").dispatchEvent(new PointerEvent("pointerover", { bubbles: true })); await new Promise((r) => setTimeout(r, 50)); } for (const b of document.querySelectorAll("button")) b.click(); await new Promise((r) => setTimeout(r, 400)); return { inline: document.querySelector("#inline").textContent, named: document.querySelector("#named").textContent, mounted: document.querySelector("#mounted").textContent }
// open-when: /"named": "promise/
// fixed-when: "named": "int 5"
// From FEEDBACK18.md §Q-102 (found on fc8bfb9). A `server fn` called the same way is
// waited for ("int 5"); only js() is not.

component Waits() {
    state inline = "-"
    state named = "-"
    state mounted = "-"
    let go = () => {
        let r = js("Promise.resolve", 5)
        named = `${type_of(r)} ${r}`
    }
    let on_mount = () => {
        let r = js("Promise.resolve", 5)
        mounted = `${type_of(r)} ${r}`
    }
    <div @mount={() => on_mount()}>
        <button @click={() => {
            let r = js("Promise.resolve", 5)
            inline = `${type_of(r)} ${r}`
        }}>inline</button>
        <button @click={go}>named</button>
        <p id="inline">{inline}</p>
        <p id="named">{named}</p>
        <p id="mounted">{mounted}</p>
    </div>
}

route GET / = <html><body><Waits/></body></html>
