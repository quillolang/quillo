// The js-framework-benchmark app (keyed), in Quillo: a table of rows and
// buttons for the usual operations. driver.js clicks them and times each;
// /vanilla is the same app in plain JavaScript, to measure against.
//
//   bench/ui/run.sh          (or: quillo run bench/ui/quillo.qwe, then open /)

let ADJ = ["pretty", "large", "big", "small", "tall", "short", "long", "handsome", "plain", "quaint", "clean", "elegant", "easy", "angry", "crazy", "helpful", "mushy", "odd", "unsightly", "adorable", "important", "inexpensive", "cheap", "expensive", "fancy"]
let COLOR = ["red", "yellow", "blue", "green", "pink", "brown", "purple", "brown", "white", "black", "orange"]
let NOUN = ["table", "chair", "house", "bbq", "desk", "car", "pony", "cookie", "sandwich", "burger", "pizza", "mouse", "keyboard"]

fn label(i: int) = `${ADJ[(i * 7) % len(ADJ)]} ${COLOR[(i * 13) % len(COLOR)]} ${NOUN[(i * 17) % len(NOUN)]}`
fn build(from: int, n: int) = for i in range(from, from + n) => { id: i, label: label(i) }

component Main() {
    state rows = []
    state selected = 0
    state next = 1
    <div.container>
        <div.jumbotron><div.row>
            <div.col-md-6><h1>Quillo keyed</h1></div>
            <div.col-md-6><div.row>
                <div.col-sm-6.smallpad><button#run.btn.btn-primary.btn-block type="button" @click={() => { rows = build(next, 1000)
                    next += 1000 }}>Create 1,000 rows</button></div>
                <div.col-sm-6.smallpad><button#runlots.btn.btn-primary.btn-block type="button" @click={() => { rows = build(next, 10000)
                    next += 10000 }}>Create 10,000 rows</button></div>
                <div.col-sm-6.smallpad><button#add.btn.btn-primary.btn-block type="button" @click={() => { rows = rows + build(next, 1000)
                    next += 1000 }}>Append 1,000 rows</button></div>
                <div.col-sm-6.smallpad><button#update.btn.btn-primary.btn-block type="button" @click={() => {
                    rows = for [i, r] in enumerate(rows) => i % 10 == 0 ? { id: r.id, label: r.label + " !!!" } : r }}>Update every 10th row</button></div>
                <div.col-sm-6.smallpad><button#clear.btn.btn-primary.btn-block type="button" @click={() => { rows = [] }}>Clear</button></div>
                <div.col-sm-6.smallpad><button#swaprows.btn.btn-primary.btn-block type="button" @click={() => {
                    if len(rows) > 998 { rows = for [i, r] in enumerate(rows) => i == 1 ? rows[998] : i == 998 ? rows[1] : r } }}>Swap Rows</button></div>
            </div></div>
        </div></div>
        <table.table.table-hover.table-striped.test-data><tbody>
            {for r in rows =>
                <tr key={r.id} class={r.id == selected ? "danger" : ""}>
                    <td.col-md-1>{r.id}</td>
                    <td.col-md-4><a.lbl @click={() => { selected = r.id }}>{r.label}</a></td>
                    <td.col-md-1><a.remove @click={() => { rows = rows | filter((x) => x.id != r.id) }}><span.remove.glyphicon.glyphicon-remove aria-hidden="true"></span></a></td>
                    <td.col-md-6></td>
                </tr>}
        </tbody></table>
    </div>
}

route GET /vanilla = file("vanilla.html")
// The other frameworks' builds (frameworks/build.mjs).
route GET /fw/*path = file("frameworks/dist/" + path)
route GET / = <html><head><meta charset="utf-8"/><title>Quillo keyed</title></head><body><Main/></body></html>
