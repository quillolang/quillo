{
  "route": {
    "prefix": "route",
    "body": ["route ${1|GET,POST,PUT,PATCH,DELETE|} /${2:path} = ${0:null}"],
    "description": "A route"
  },
  "route with JSON body": {
    "prefix": "routejson",
    "body": ["route POST /${1:things} { json: { ${2:name}: ${3:str} } } {", "\t$0", "}"],
    "description": "A route matching a JSON payload"
  },
  "fn": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2}) = ${0:null}"],
    "description": "A function"
  },
  "fn block": {
    "prefix": "fnb",
    "body": ["fn ${1:name}(${2}) {", "\t$0", "}"],
    "description": "A function with a block body"
  },
  "server fn": {
    "prefix": "serverfn",
    "body": ["server fn ${1:name}(${2}) {", "\t$0", "}"],
    "description": "A function the browser can call"
  },
  "view": {
    "prefix": "view",
    "body": ["view ${1:Name}(${2:children}) =", "\t<${3:div}>{${2:children}}</${3:div}>"],
    "description": "A view (a function returning HTML)"
  },
  "component": {
    "prefix": "component",
    "body": [
      "component ${1:Counter}(${2:start: int = 0}) {",
      "\t~${3:count} = ${4:start}",
      "\t<div>",
      "\t\t<span>{${3:count}}</span>",
      "\t\t<button @click={() => { ${3:count} += 1 }}>+</button>",
      "\t</div>",
      "}"
    ],
    "description": "A component with state that runs in the browser"
  },
  "match": {
    "prefix": "match",
    "body": ["match ${1:value} {", "\t${2:pattern} => ${3:result}", "\t_ => ${0:null}", "}"],
    "description": "Pattern match"
  },
  "arrow": {
    "prefix": "arrow",
    "body": ["(${1:x}) => ${0:x}"],
    "description": "An anonymous function"
  },
  "template": {
    "prefix": "tpl",
    "body": ["`${1:text} \\${${2:expr}}`"],
    "description": "A template string with interpolation"
  },
  "for": {
    "prefix": "for",
    "body": ["for ${1:item} in ${2:items} => ${0:item}"],
    "description": "Loop producing a list"
  },
  "page": {
    "prefix": "page",
    "body": [
      "route GET /${1} =",
      "\t<html>",
      "\t\t<head><meta charset=\"utf-8\"/><title>${2:Title}</title></head>",
      "\t\t<body>",
      "\t\t\t$0",
      "\t\t</body>",
      "\t</html>"
    ],
    "description": "An HTML page route"
  },
  "udp.listen": {
    "prefix": "udplisten",
    "body": ["udp.listen(${1:9000}, (p) => {", "\t${0:udp.reply(p, \"ok\")}", "})"],
    "description": "Take UDP packets on a port: p.text, p.bytes, p.from"
  },
  "channel.on": {
    "prefix": "channelon",
    "body": ["channel.on(\"${1:room}\", (msg, peer) => {", "\tchannel.broadcast(\"${1:room}\", ${0:msg}, { except: peer })", "})"],
    "description": "Handle what pages send on a channel"
  },
  "channel.open": {
    "prefix": "channelopen",
    "body": ["let ${1:room} = channel.open(\"${2:room}\", (m) => {", "\t$0", "})"],
    "description": "Open a channel in a component; .send(value) to send"
  },
  "media.rtp": {
    "prefix": "mediartp",
    "body": ["media.rtp(\"${1:cam}\", { video: ${2:5004}, audio: ${3:5006} })", "$0"],
    "description": "Take an RTP stream (H.264, Opus) for <quillo-media stream=\"cam\">"
  },
  "quillo-media": {
    "prefix": "quillo-media",
    "body": ["<quillo-media stream=\"${1:cam}\" controls${2: muted}/>"],
    "description": "Play a stream taken with media.rtp"
  }
}
