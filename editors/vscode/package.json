{
  "name": "quillo-lang",
  "displayName": "Quillo",
  "description": "Quillo language support: highlighting, diagnostics, hover, go to definition, completion, outline (via `quillo lsp`) and debugging (via `quillo dap`).",
  "version": "0.8.0",
  "publisher": "quillolang",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quillolang/quillo"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "quillo",
    "web",
    "language server"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:quillo",
    "onLanguage:qwer",
    "onDebugResolve:quillo",
    "onDebugDynamicConfigurations:quillo"
  ],
  "contributes": {
    "languages": [
      {
        "id": "quillo",
        "aliases": [
          "Quillo",
          "quillo"
        ],
        "extensions": [
          ".qwe"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/qwe-light.svg",
          "dark": "./icons/qwe-dark.svg"
        }
      },
      {
        "id": "qwer",
        "aliases": [
          "Quillo Rust",
          "qwer"
        ],
        "extensions": [
          ".qwer"
        ],
        "configuration": "./language-configuration-qwer.json",
        "icon": {
          "light": "./icons/qwer-light.svg",
          "dark": "./icons/qwer-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "quillo",
        "scopeName": "source.quillo",
        "path": "./syntaxes/quillo.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.css": "css",
          "meta.embedded.block.sql": "sql"
        }
      },
      {
        "language": "qwer",
        "scopeName": "source.qwer",
        "path": "./syntaxes/qwer.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "quillo",
        "path": "./snippets/quillo.json"
      }
    ],
    "commands": [
      {
        "command": "quillo.run",
        "title": "Run this file (watch mode)",
        "category": "Quillo"
      },
      {
        "command": "quillo.debug",
        "title": "Debug this file",
        "category": "Quillo",
        "icon": "$(debug-alt)"
      },
      {
        "command": "quillo.check",
        "title": "Check this file",
        "category": "Quillo"
      },
      {
        "command": "quillo.restartServer",
        "title": "Restart the language server",
        "category": "Quillo"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "quillo.run",
          "when": "resourceLangId == quillo",
          "group": "navigation"
        },
        {
          "command": "quillo.debug",
          "when": "resourceLangId == quillo",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Quillo",
      "properties": {
        "quillo.path": {
          "type": "string",
          "default": "",
          "description": "Path to the `quillo` binary. Empty: `quillo` on the PATH, or target/release/quillo or target/debug/quillo in the workspace."
        },
        "quillo.port": {
          "type": "number",
          "default": 8080,
          "description": "Port for `Quillo: Run this file`."
        }
      }
    },
    "breakpoints": [
      {
        "language": "quillo"
      }
    ],
    "debuggers": [
      {
        "type": "quillo",
        "label": "Quillo",
        "languages": [
          "quillo"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .qwe file to run.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Options for `quillo run`, such as [\"--port\", \"8080\", \"--watch\"].",
                "default": [
                  "--watch"
                ]
              },
              "cwd": {
                "type": "string",
                "description": "The folder to run in.",
                "default": "${workspaceFolder}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the program's first statement.",
                "default": false
              },
              "browser": {
                "type": [
                  "boolean",
                  "string"
                ],
                "enum": [
                  true,
                  false,
                  "chrome",
                  "edge"
                ],
                "default": false,
                "description": "Also debug the components in the browser: opens Chrome (true or \"chrome\") or Edge (\"edge\") on the page, with VS Code's JavaScript debugger, once the server listens. Breakpoints in .qwe files stop there too."
              },
              "url": {
                "type": "string",
                "description": "The page the browser opens (default: the address the server listens on)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "quillo",
            "request": "launch",
            "name": "Debug this file",
            "program": "${file}",
            "args": [
              "--watch"
            ]
          },
          {
            "type": "quillo",
            "request": "launch",
            "name": "Debug this file and its pages",
            "program": "${file}",
            "args": [
              "--watch"
            ],
            "browser": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "Quillo: Debug a program",
            "description": "Run a .qwe program with the debugger",
            "body": {
              "type": "quillo",
              "request": "launch",
              "name": "Debug ${1:program}",
              "program": "^\"\\${workspaceFolder}/${1:main.qwe}\"",
              "args": [
                "--watch"
              ]
            }
          },
          {
            "label": "Quillo: Debug a program and its pages",
            "description": "Run a .qwe program with the debugger, and debug its components in Chrome",
            "body": {
              "type": "quillo",
              "request": "launch",
              "name": "Debug ${1:program} and its pages",
              "program": "^\"\\${workspaceFolder}/${1:main.qwe}\"",
              "args": [
                "--watch"
              ],
              "browser": true
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "test": "node test/grammar.test.js",
    "package": "vsce package --skip-license"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  }
}
