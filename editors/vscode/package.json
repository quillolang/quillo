{
  "name": "quillo-lang",
  "displayName": "Quillo",
  "description": "Quillo language support: highlighting, diagnostics, hover, go to definition, completion and outline (via `quillo lsp`).",
  "version": "0.6.0",
  "publisher": "wisp-one",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisp-one/quillo"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "quillo",
    "web",
    "language server"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:quillo"
  ],
  "contributes": {
    "languages": [
      {
        "id": "quillo",
        "aliases": [
          "Quillo",
          "quillo"
        ],
        "extensions": [
          ".qwe"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "quillo",
        "scopeName": "source.quillo",
        "path": "./syntaxes/quillo.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.css": "css",
          "meta.embedded.block.sql": "sql"
        }
      }
    ],
    "snippets": [
      {
        "language": "quillo",
        "path": "./snippets/quillo.json"
      }
    ],
    "commands": [
      {
        "command": "quillo.run",
        "title": "Run this file (watch mode)",
        "category": "Quillo"
      },
      {
        "command": "quillo.check",
        "title": "Check this file",
        "category": "Quillo"
      },
      {
        "command": "quillo.restartServer",
        "title": "Restart the language server",
        "category": "Quillo"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "quillo.run",
          "when": "resourceLangId == quillo",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Quillo",
      "properties": {
        "quillo.path": {
          "type": "string",
          "default": "",
          "description": "Path to the `quillo` binary. Empty: `quillo` on the PATH, or target/release/quillo or target/debug/quillo in the workspace."
        },
        "quillo.port": {
          "type": "number",
          "default": 8080,
          "description": "Port for `Quillo: Run this file`."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/grammar.test.js",
    "package": "vsce package --skip-license"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  }
}
