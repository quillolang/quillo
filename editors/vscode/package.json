{
  "name": "lite-lang",
  "displayName": "Lite",
  "description": "Lite language support: highlighting, diagnostics, hover, go to definition, completion and outline (via `lite lsp`).",
  "version": "0.2.0",
  "publisher": "wisp-one",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/wisp-one/lite" },
  "engines": { "vscode": "^1.82.0" },
  "categories": ["Programming Languages", "Linters", "Snippets"],
  "keywords": ["lite", "web", "language server"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:lite"],
  "contributes": {
    "languages": [
      {
        "id": "lite",
        "aliases": ["Lite", "lite"],
        "extensions": [".lt"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      { "language": "lite", "scopeName": "source.lite", "path": "./syntaxes/lite.tmLanguage.json" }
    ],
    "snippets": [
      { "language": "lite", "path": "./snippets/lite.json" }
    ],
    "commands": [
      { "command": "lite.run", "title": "Run this file (watch mode)", "category": "Lite" },
      { "command": "lite.check", "title": "Check this file", "category": "Lite" },
      { "command": "lite.restartServer", "title": "Restart the language server", "category": "Lite" }
    ],
    "menus": {
      "editor/title/run": [
        { "command": "lite.run", "when": "resourceLangId == lite", "group": "navigation" }
      ]
    },
    "configuration": {
      "title": "Lite",
      "properties": {
        "lite.path": {
          "type": "string",
          "default": "",
          "description": "Path to the `lite` binary. Empty: `lite` on the PATH, or target/release/lite or target/debug/lite in the workspace."
        },
        "lite.port": {
          "type": "number",
          "default": 8080,
          "description": "Port for `Lite: Run this file`."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/grammar.test.js",
    "package": "vsce package --skip-license"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  }
}
