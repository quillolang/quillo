{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Quillo",
  "scopeName": "source.quillo",
  "fileTypes": [
    "qwe"
  ],
  "patterns": [
    {
      "include": "#statements"
    }
  ],
  "repository": {
    "statements": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#route"
        },
        {
          "include": "#typedef"
        },
        {
          "include": "#definition"
        },
        {
          "include": "#state"
        },
        {
          "include": "#type-generic"
        },
        {
          "include": "#html-close"
        },
        {
          "include": "#html-void"
        },
        {
          "include": "#html-element"
        },
        {
          "include": "#tagged-css"
        },
        {
          "include": "#tagged-sql"
        },
        {
          "include": "#template"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#constant"
        },
        {
          "include": "#type-annotation"
        },
        {
          "include": "#arrow-param"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#module-call"
        },
        {
          "include": "#call"
        },
        {
          "include": "#component-name"
        },
        {
          "include": "#braces"
        },
        {
          "include": "#identifier"
        }
      ]
    },
    "comment": {
      "name": "comment.line.double-slash.quillo",
      "match": "//.*$"
    },
    "route": {
      "match": "\\b(route)\\s+(GET|POST|PUT|PATCH|DELETE|OPTIONS|HEAD|ANY)\\s+(/[^\\s?{=]*)",
      "captures": {
        "1": {
          "name": "keyword.other.route.quillo"
        },
        "2": {
          "name": "constant.language.http-method.quillo"
        },
        "3": {
          "name": "string.unquoted.path.quillo",
          "patterns": [
            {
              "match": "(:)([A-Za-z_]\\w*)(?:(\\()(int|float|dec|num|str)(\\)))?",
              "captures": {
                "1": {
                  "name": "punctuation.definition.parameter.quillo"
                },
                "2": {
                  "name": "variable.parameter.path.quillo"
                },
                "3": {
                  "name": "punctuation.section.parens.quillo"
                },
                "4": {
                  "name": "support.type.quillo"
                },
                "5": {
                  "name": "punctuation.section.parens.quillo"
                }
              }
            },
            {
              "match": "(\\*)([A-Za-z_]\\w*)?",
              "captures": {
                "1": {
                  "name": "keyword.operator.wildcard.quillo"
                },
                "2": {
                  "name": "variable.parameter.path.quillo"
                }
              }
            }
          ]
        }
      }
    },
    "definition": {
      "patterns": [
        {
          "match": "\\b(server)\\s+(fn)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.modifier.server.quillo"
            },
            "2": {
              "name": "storage.type.function.quillo"
            },
            "3": {
              "name": "entity.name.function.quillo"
            }
          }
        },
        {
          "match": "\\b(component)\\s+([A-Z]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.component.quillo"
            },
            "2": {
              "name": "entity.name.type.component.quillo"
            }
          }
        },
        {
          "match": "\\b(view)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.view.quillo"
            },
            "2": {
              "name": "entity.name.type.view.quillo"
            }
          }
        },
        {
          "match": "\\b(fn)\\s+([A-Za-z_]\\w*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "storage.type.function.quillo"
            },
            "2": {
              "name": "entity.name.function.quillo"
            }
          }
        },
        {
          "match": "\\b(let)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.let.quillo"
            },
            "2": {
              "name": "variable.other.declaration.quillo"
            }
          }
        },
        {
          "match": "\\b(with)\\s+((?:(?:db|http|fs|env|time|random|net)\\s*,?\\s*)+)",
          "captures": {
            "1": {
              "name": "keyword.other.with.quillo"
            },
            "2": {
              "name": "support.constant.effect.quillo"
            }
          }
        }
      ]
    },
    "state": {
      "match": "(~)([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "keyword.operator.state.quillo"
        },
        "2": {
          "name": "variable.other.state.quillo"
        }
      }
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.quillo",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.quillo"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.quillo"
            }
          },
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "name": "string.quoted.single.quillo",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.quillo"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.quillo"
            }
          },
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        }
      ]
    },
    "interpolation": {
      "name": "meta.template.expression.quillo",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.quillo"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.quillo"
        }
      },
      "contentName": "source.quillo.embedded",
      "patterns": [
        {
          "include": "#statements"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.quillo"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.quillo"
        }
      },
      "patterns": [
        {
          "include": "#statements"
        }
      ]
    },
    "html-close": {
      "match": "(</)([A-Za-z][\\w-]*)\\s*(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.quillo"
        },
        "2": {
          "patterns": [
            {
              "match": "\\b[A-Z][\\w-]*",
              "name": "entity.name.type.component.quillo"
            },
            {
              "match": "\\b[a-z][\\w-]*",
              "name": "entity.name.tag.quillo"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.tag.end.quillo"
        }
      }
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.quillo",
          "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?m\\b"
        },
        {
          "name": "constant.numeric.float.quillo",
          "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?[eE][+-]?\\d+\\b|\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.quillo",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.quillo",
          "match": "\\b(if|else|match|for|in|return|reply)\\b"
        },
        {
          "name": "keyword.other.quillo",
          "match": "\\b(use|as|with|route|mount|service)\\b"
        },
        {
          "name": "storage.type.quillo",
          "match": "\\b(let|fn|view|component|server)\\b"
        },
        {
          "match": "\\b(type)\\s+([A-Z]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.quillo"
            },
            "2": {
              "name": "entity.name.type.quillo"
            }
          }
        },
        {
          "match": "\\b(state)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*=(?!=))",
          "captures": {
            "1": { "name": "storage.type.quillo" },
            "2": { "name": "variable.other.state.quillo" }
          }
        }
      ]
    },
    "constant": {
      "name": "constant.language.quillo",
      "match": "\\b(true|false|null)\\b"
    },
    "type-annotation": {
      "patterns": [
        {
          "match": "(->|!)\\s*((?:(?:int|float|dec|num|str|bool|list|map|html|fn|any|response|null|[A-Z]\\w*)\\??\\s*\\|?\\s*)+)",
          "captures": {
            "1": {
              "name": "keyword.operator.type.quillo"
            },
            "2": {
              "patterns": [
                {
                  "match": "\\b(?:int|float|dec|num|str|bool|list|map|html|fn|any|response|null)\\b",
                  "name": "support.type.quillo"
                },
                {
                  "match": "\\b[A-Z]\\w*",
                  "name": "entity.name.type.quillo"
                }
              ]
            }
          }
        },
        {
          "match": "(?<=[\\w)])\\s*(:)\\s*((?:(?:int|float|dec|num|str|bool|list|map|html|fn|any|response|null|[A-Z][a-z]\\w*)\\??\\s*(?:\\|\\s*)?)+)(?=\\s*[,)=]|\\s*$)",
          "captures": {
            "1": {
              "name": "punctuation.separator.type.quillo"
            },
            "2": {
              "patterns": [
                {
                  "match": "\\b(?:int|float|dec|num|str|bool|list|map|html|fn|any|response|null)\\b",
                  "name": "support.type.quillo"
                },
                {
                  "match": "\\b[A-Z]\\w*",
                  "name": "entity.name.type.quillo"
                }
              ]
            }
          }
        },
        {
          "match": "(?<=[\\w)])\\s*(:)\\s*\\b(list|map)(?=<)",
          "captures": {
            "1": {
              "name": "punctuation.separator.type.quillo"
            },
            "2": {
              "name": "support.type.quillo"
            }
          }
        },
        {
          "match": "(?<=[:|{,]\\s{0,8})\\b(int|float|dec|num|str|bool|list|map|html|any|response)\\b(?!\\s*\\()",
          "name": "support.type.pattern.quillo"
        }
      ]
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.coalesce.quillo",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.logical.quillo",
          "match": "&&|\\|\\||!(?!=)"
        },
        {
          "name": "keyword.operator.pipe.quillo",
          "match": "\\|"
        },
        {
          "name": "storage.type.function.arrow.quillo",
          "match": "=>"
        },
        {
          "name": "keyword.operator.arrow.quillo",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.quillo",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.assignment.quillo",
          "match": "\\+=|-=|="
        },
        {
          "name": "keyword.operator.spread.quillo",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.quillo",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.ternary.quillo",
          "match": "\\?|:(?!:)"
        },
        {
          "name": "keyword.operator.arithmetic.quillo",
          "match": "[+\\-*/%]"
        }
      ]
    },
    "module-call": {
      "match": "\\b(json|db|http|udp|channel|media|crypto|image|math|stats|vec|date|money)(\\.)([a-z_]\\w*)",
      "captures": {
        "1": {
          "name": "support.module.quillo"
        },
        "2": {
          "name": "punctuation.accessor.quillo"
        },
        "3": {
          "name": "support.function.quillo"
        }
      }
    },
    "call": {
      "patterns": [
        {
          "match": "\\b(print|str|int|float|dec|len|type_of|upper|lower|trim|split|join|contains|starts_with|ends_with|replace|slice|map|filter|find|any|all|reduce|sum|min|max|sort|sort_by|reverse|first|last|push|range|enumerate|keys|values|get|has|set|remove|merge|err|is_err|unwrap|raw|escape|env|now|sleep|file|redirect|respond|read_file|write_file|random|random_int|uuid|abs|round|floor|ceil|sqrt|pow|unique|flatten|zip|take|drop|count|group_by|index_of|repeat|format_number|live|publish|watch|delete_file|check_program|join_on|markdown|highlight|run_script|sql_name|sql_param|ask|notify|translations|locale_from|locale|with_locale|t|schedule|allow_cross_site|tenant|tenant_from|with_tenant|save_upload|read_upload|js|js_new|parallel|every|stream|events|listen|receive|url|css|sql|navigate|set_cookie|delete_cookie|session|set_session|end_session|sessions|renew_session|end_sessions|user_sessions|rate_limit|rate_limit_reset|security_headers|csp|csp_nonce|idempotent)\\b(?=\\s*\\()",
          "name": "support.function.builtin.quillo"
        },
        {
          "match": "\\b([a-z_]\\w*)(?=\\s*\\()",
          "name": "entity.name.function.call.quillo"
        }
      ]
    },
    "component-name": {
      "match": "\\b[A-Z]\\w*\\b",
      "name": "entity.name.type.quillo"
    },
    "identifier": {
      "patterns": [
        {
          "match": "\\brequest\\b",
          "name": "variable.language.request.quillo"
        },
        {
          "match": "\\b[a-z_]\\w*\\b",
          "name": "variable.other.quillo"
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.quillo",
      "match": "\\\\[nrt0\"'`\\\\{}$]"
    },
    "template": {
      "name": "string.template.quillo",
      "begin": "`",
      "end": "`",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.begin.quillo"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.end.quillo"
        }
      },
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "html-void": {
      "name": "meta.tag.void.quillo",
      "begin": "(<)(area|base|br|col|embed|hr|img|input|link|meta|source|track|wbr)\\b((?:[.#](?:[\\w-]|\\{[^}]*\\})+)*)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.quillo"
        },
        "2": {
          "patterns": [
            {
              "match": "\\b[A-Z][\\w-]*",
              "name": "entity.name.type.component.quillo"
            },
            {
              "match": "\\b[a-z][\\w-]*",
              "name": "entity.name.tag.quillo"
            }
          ]
        },
        "3": {
          "patterns": [
            {
              "match": "\\.(?:[\\w-]|\\{[^}]*\\})+",
              "name": "entity.other.attribute-name.class.quillo"
            },
            {
              "match": "#(?:[\\w-]|\\{[^}]*\\})+",
              "name": "entity.other.attribute-name.id.quillo"
            }
          ]
        }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.quillo"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "(@)([\\w-]+)",
          "captures": {
            "1": {
              "name": "keyword.operator.event.quillo"
            },
            "2": {
              "name": "entity.other.attribute-name.event.quillo"
            }
          }
        },
        {
          "match": "(bind)(:)(value|checked)",
          "captures": {
            "1": {
              "name": "keyword.other.bind.quillo"
            },
            "2": {
              "name": "punctuation.separator.quillo"
            },
            "3": {
              "name": "entity.other.attribute-name.quillo"
            }
          }
        },
        {
          "match": "[A-Za-z_:][\\w:.-]*",
          "name": "entity.other.attribute-name.quillo"
        },
        {
          "match": "=",
          "name": "punctuation.separator.key-value.quillo"
        },
        {
          "include": "#string"
        },
        {
          "include": "#braces"
        },
        {
          "match": "[.#](?:[\\w-]|\\{[^}]*\\})+",
          "name": "entity.other.attribute-name.class.quillo"
        }
      ]
    },
    "html-element": {
      "name": "meta.tag.quillo",
      "begin": "(<)([A-Za-z][\\w-]*)((?:[.#](?:[\\w-]|\\{[^}]*\\})+)*)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.quillo"
        },
        "2": {
          "patterns": [
            {
              "match": "\\b[A-Z][\\w-]*",
              "name": "entity.name.type.component.quillo"
            },
            {
              "match": "\\b[a-z][\\w-]*",
              "name": "entity.name.tag.quillo"
            }
          ]
        },
        "3": {
          "patterns": [
            {
              "match": "\\.(?:[\\w-]|\\{[^}]*\\})+",
              "name": "entity.other.attribute-name.class.quillo"
            },
            {
              "match": "#(?:[\\w-]|\\{[^}]*\\})+",
              "name": "entity.other.attribute-name.id.quillo"
            }
          ]
        }
      },
      "end": "(/>)|(</)([A-Za-z][\\w-]*)\\s*(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.quillo"
        },
        "2": {
          "name": "punctuation.definition.tag.begin.quillo"
        },
        "3": {
          "patterns": [
            {
              "match": "\\b[A-Z][\\w-]*",
              "name": "entity.name.type.component.quillo"
            },
            {
              "match": "\\b[a-z][\\w-]*",
              "name": "entity.name.tag.quillo"
            }
          ]
        },
        "4": {
          "name": "punctuation.definition.tag.end.quillo"
        }
      },
      "patterns": [
        {
          "include": "#html-children"
        },
        {
          "include": "#comment"
        },
        {
          "match": "(@)([\\w-]+)",
          "captures": {
            "1": {
              "name": "keyword.operator.event.quillo"
            },
            "2": {
              "name": "entity.other.attribute-name.event.quillo"
            }
          }
        },
        {
          "match": "(bind)(:)(value|checked)",
          "captures": {
            "1": {
              "name": "keyword.other.bind.quillo"
            },
            "2": {
              "name": "punctuation.separator.quillo"
            },
            "3": {
              "name": "entity.other.attribute-name.quillo"
            }
          }
        },
        {
          "match": "[A-Za-z_:][\\w:.-]*",
          "name": "entity.other.attribute-name.quillo"
        },
        {
          "match": "=",
          "name": "punctuation.separator.key-value.quillo"
        },
        {
          "include": "#string"
        },
        {
          "include": "#braces"
        },
        {
          "match": "[.#](?:[\\w-]|\\{[^}]*\\})+",
          "name": "entity.other.attribute-name.class.quillo"
        }
      ]
    },
    "html-children": {
      "contentName": "meta.jsx.children.quillo",
      "begin": "(>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.quillo"
        }
      },
      "end": "(?=</)",
      "patterns": [
        {
          "include": "#html-void"
        },
        {
          "include": "#html-element"
        },
        {
          "include": "#braces"
        },
        {
          "match": "&(?:[a-zA-Z]+|#\\d+|#x[0-9a-fA-F]+);",
          "name": "constant.character.entity.quillo"
        }
      ]
    },
    "arrow-param": {
      "match": "\\b[a-z_]\\w*(?=\\s*=>)",
      "name": "variable.parameter.quillo"
    },
    "tagged-css": {
      "begin": "\\b(css)(`)",
      "beginCaptures": {
        "1": {
          "name": "support.function.tag.quillo"
        },
        "2": {
          "name": "punctuation.definition.string.template.begin.quillo"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.end.quillo"
        }
      },
      "contentName": "meta.embedded.block.css",
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "include": "#escape"
        },
        {
          "include": "source.css"
        }
      ]
    },
    "tagged-sql": {
      "begin": "\\b(sql)(`)",
      "beginCaptures": {
        "1": {
          "name": "support.function.tag.quillo"
        },
        "2": {
          "name": "punctuation.definition.string.template.begin.quillo"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.end.quillo"
        }
      },
      "contentName": "meta.embedded.block.sql",
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "include": "#escape"
        },
        {
          "include": "source.sql"
        }
      ]
    },
    "type-generic": {
      "comment": "`list<T>` (and `map<...>`): what is between `<` and `>` is a type, never an HTML tag.",
      "name": "meta.type.parameters.quillo",
      "begin": "(?<=\\blist|\\bmap)(<)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.typeparameters.begin.quillo"
        }
      },
      "end": ">",
      "endCaptures": {
        "0": {
