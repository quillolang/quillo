// Editorial desks: every category of posts can have its own people — who
// write and edit its posts, who review them, who publish them — and the
// approvals a post needs before it is published. A desk for no category
// ('') holds for every category without its own; with no desk at all,
// whoever writes a post publishes it.
//
// A post goes draft → review → approved → published (or back, with changes
// asked for). Reviewers approve or ask for changes, never on their own
// posts; an edit after the post went for review clears its approvals, so
// what is published is what was approved. Owners and admins may act in
// every part, and still need the approvals.

fn desk_out(r) = r == null ? null : merge(r, {
    editors: parsed(r.editors, []), reviewers: parsed(r.reviewers, []), publishers: parsed(r.publishers, []),
    editor_groups: parsed(r.editor_groups, []), reviewer_groups: parsed(r.reviewer_groups, []), publisher_groups: parsed(r.publisher_groups, []),
})

// The capability a group needs to fill a part of a desk that names no one.
let DESK_PARTS = { editors: ["editor_groups", "writer"], reviewers: ["reviewer_groups", "reviewer"], publishers: ["publisher_groups", "publisher"] }

fn desk_for(category: str) = desk_out(db.one("select * from desks where category = ?", category ?? "")) ?? desk_out(db.one("select * from desks where category = ''"))

// On a desk's part: owners and admins; the people and groups it names; or,
// when it names none, the groups that are its writers (reviewers, publishers).
fn on_desk(d, u, part: str) {
    if u.role != "member" || contains(d[part], u.id) { return true }
    let gp = DESK_PARTS[part]
    let groups = d[gp[0]] ?? []
    len(groups) > 0 ? any(groups, (g) => in_group(u, g)) : len(d[part]) == 0 && can_be(u, gp[1])
}

// Everyone on a part, for mail.
fn desk_people(d, part: str) = db.query("select id, email, name, role, role_id from users") | filter((u) => on_desk(d, u, part)) | map((u) => u.id)

// Approvals of the version that went for review: those after its latest
// submission (by order, not time: an edit in the same second still counts).
fn approvals_of(p) = p.submitted_at == null ? [] : db.query(
    "select r.*, u.name from post_reviews r left join users u on u.id = r.user_id where r.post_id = ? and r.decision = 'approved'
     and r.id > coalesce((select max(id) from post_reviews where post_id = ? and decision = 'submitted'), 0)",
    p.id, p.id)

// What `u` may do with the post now, and why not.
fn post_can(u, p) {
    let d = desk_for(p.category ?? "")
    if d == null {
        return { desk: null, edit: true, submit: false, review: false, publish: true, why: "" }
    }
    let approved = len(approvals_of(p))
    let editor = on_desk(d, u, "editors") || (p.author_id == u.id && contains(d.editors, u.id))
    let reviewer = on_desk(d, u, "reviewers") && p.author_id != u.id
    let publisher = on_desk(d, u, "publishers")
    let enough = approved >= d.approvals
    {
        desk: d,
        approved,
        edit: editor,
        submit: editor && contains(["draft", "changes"], p.stage),
        review: reviewer && p.stage == "review" && !any(approvals_of(p), (a) => a.user_id == u.id),
        publish: publisher && p.status != "published" && enough && (d.approvals == 0 || p.stage == "approved"),
        why: !publisher ? `Only the ${desk_name(d)}'s publishers publish`
            : !enough ? `It needs ${plural(d.approvals, "approval")}, and has ${approved}`
            : "",
    }
}

fn desk_name(d) = d.category == "" ? "default desk" : `${title_case(d.category)} desk`

fn note_review(post_id: int, u, decision: str, note: str) =
    db.exec("insert into post_reviews (post_id, user_id, decision, note, created_at) values (?, ?, ?, ?, ?)", post_id, u.id, decision, note, now())

// Mail to the people on a desk's part (not to `but`).
fn tell(ids: list, but, subject: str, text: str) {
    let base = site_url()
    for r in db.query("select id, email, name from users") | filter((x) => contains(ids, x.id) && x.id != but) =>
        queue_mail(r.email, subject, `<p>${escape(text)}</p><p><a href="${base}/app/posts">Open Posts</a></p>`, "system", null, null)
}

// ---- the workflow's server functions ---------------------------------------------------

server fn post_workflow(id: int) {
    let u = need_user()?
    let p = (post_out(db.one("select * from posts where id = ?", id)) ?? err("No such post"))?
    let can = post_can(u, p)
    merge(can, {
        reviews: db.query("select r.*, u.name from post_reviews r left join users u on u.id = r.user_id where r.post_id = ? order by r.created_at desc", id),
        stage: p.stage,
    })
}

server fn submit_post(id: int) {
    let u = need_user()?
    let p = (post_out(db.one("select * from posts where id = ?", id)) ?? err("No such post"))?
    let can = post_can(u, p)
    if !can.submit { return err(can.desk == null ? "This category has no desk: publish it" : "Only its desk's editors send it for review") }
    refused("post", p, rule_ctx())?
    db.exec("update posts set stage = 'review', submitted_at = ? where id = ?", now(), id)
    note_review(id, u, "submitted", "")
    tell(desk_people(can.desk, "reviewers"), u.id, `For review: ${p.title}`, `${u.name} sent “${p.title}” for review (${desk_name(can.desk)}).`)
    true
}

// A reviewer's decision: "approved", or "changes" with a note.
server fn review_post(id: int, decision: str, note: str) {
    let u = need_user()?
    let p = (post_out(db.one("select * from posts where id = ?", id)) ?? err("No such post"))?
    if p.author_id == u.id { return err("Someone else reviews your posts") }
    let can = post_can(u, p)
    if !can.review { return err(p.stage != "review" ? "It is not waiting for review" : "Only its desk's reviewers review it") }
    if decision == "changes" && blank(note) { return err({ problems: problem("note", "Say what to change") }) }
    if !contains(["approved", "changes"], decision) { return err("Approve, or ask for changes") }
    note_review(id, u, decision, trim(note))
    let author = db.one("select id from users where id = ?", p.author_id)
    if decision == "changes" {
        db.exec("update posts set stage = 'changes' where id = ?", id)
        if author != null { tell([author.id], u.id, `Changes asked: ${p.title}`, `${u.name}: ${trim(note)}`) }
    } else if len(approvals_of(p)) >= can.desk.approvals {
        db.exec("update posts set stage = 'approved' where id = ?", id)
        tell(desk_people(can.desk, "publishers"), u.id, `Ready to publish: ${p.title}`, `“${p.title}” has its approvals.`)
        if author != null { tell([author.id], u.id, `Approved: ${p.title}`, `${u.name} approved it.`) }
    }
    true
}

// Posts waiting for this person: to review, or to publish.
server fn my_queue() {
    let u = need_user()?
    db.query("select * from posts where stage in ('review', 'approved') and status != 'published' order by submitted_at") | map(post_out)
        | map((p) => { post: p, can: post_can(u, p) })
        | filter((x) => x.can.review || x.can.publish)
        | map((x) => merge(x.post, { waiting: x.can.review ? "review" : "publish" }))
}

// ---- desks ----------------------------------------------------------------------------

server fn list_desks() {
    need_user()?
    db.query("select * from desks order by category = '', category") | map(desk_out)
}

server fn save_desk(d: map) {
    need_admin()?
    let category = slugify(d.category ?? "")
    if db.one("select id from desks where category = ? and id != ?", category, d.id ?? 0) != null {
        return err({ problems: problem("category", category == "" ? "There is a default desk" : "This category has a desk") })
    }
    let n = int(d.approvals) ?? 1
    if n < 0 || n > 5 { return err({ problems: problem("approvals", "From 0 to 5 approvals") }) }
    let ids = (xs) => json.stringify((xs ?? []) | map((x) => int(x) ?? 0) | filter((x) => x > 0) | unique)
    let reviewers = len(d.reviewers ?? []) + len(d.reviewer_groups ?? [])
    if reviewers > 0 && len(d.reviewer_groups ?? []) == 0 && len(d.reviewers ?? []) < n { return err({ problems: problem("reviewers", `${plural(n, "approval")} need at least as many reviewers`) }) }
    let vals = { category, editors: ids(d.editors), reviewers: ids(d.reviewers), publishers: ids(d.publishers), eg: ids(d.editor_groups), rg: ids(d.reviewer_groups), pg: ids(d.publisher_groups), n }
    if d.id == null {
        audit("desk.create", vals)
        db.exec("insert into desks (category, editors, reviewers, publishers, editor_groups, reviewer_groups, publisher_groups, approvals, created_at) values (:category, :editors, :reviewers, :publishers, :eg, :rg, :pg, :n, :at)",
            set(vals, "at", now())).last_id
    } else {
        audit("desk.change", set(vals, "id", d.id))
        db.exec("update desks set category = :category, editors = :editors, reviewers = :reviewers, publishers = :publishers, editor_groups = :eg, reviewer_groups = :rg, publisher_groups = :pg, approvals = :n where id = :id",
            set(vals, "id", d.id))
        d.id
    }
}

server fn delete_desk(id: int) {
    need_admin()?
    audited("desk.delete", { id }, () => db.exec("delete from desks where id = ?", id))?
    true
}
