// The frame every public page is in: the theme (from the plugins switched
// on), the menu, the footer, and what search engines and link previews
// read. Pages, the blog and the shop all render inside SiteLayout.

let DEFAULT_THEME = { id: "clean", color: "#4f46e5", font: "system", dark: false, logo: "", menu: null, footer: "", footer_links: [], css: "" }

let FONTS = {
    system: "-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, system-ui, sans-serif",
    serif: "Georgia, 'Iowan Old Style', 'Times New Roman', serif",
    rounded: "ui-rounded, 'SF Pro Rounded', 'Nunito', system-ui, sans-serif",
    mono: "ui-monospace, SFMono-Regular, Menlo, monospace",
}

fn theme_of(s: map) = merge(DEFAULT_THEME, s.theme ?? {})

// The themes the plugins switched on bring; the core's first.
fn themes_for(enabled: list) = active_plugins(enabled) | map((p) => p.themes ?? []) | flatten

// A theme's description, or Clean's if its plugin is switched off.
fn theme_def(id, enabled: list) {
    let all = themes_for(enabled)
    find(all, (t) => t.id == id) ?? all[0]
}

// The theme as CSS: its variables, its own rules, and the workspace's own
// CSS, nested in `.site` so it styles the site and nothing else. Its values
// were checked when saved, and are checked again here, since they go into
// a style sheet.
fn theme_css(t: map, def: map) {
    let ok = len(errors_of(validate("theme", t, { enabled: [] }))) == 0
    let th = ok ? t : DEFAULT_THEME
    let own = ok && !blank(th.css) ? `\n.site { ${th.css} }` : ""
    `.site { --brand: ${th.color}; --site-font: ${FONTS[th.font] ?? FONTS.system}; --site-width: ${def.width ?? 980}px; }\n${replace(def.css ?? "", "<", "")}${own}`
}

fn site_classes(t: map, def: map) = `site theme-${def.id} head-${def.header ?? "bar"}${t.dark ? " dark" : ""}`

// The menu: the workspace's own, or the shop and the blog when they have
// something to show.
fn default_menu() {
    let shop = db.one("select id from products where active = 1 limit 1") != null
    (shop ? [{ label: "Shop", link: "/shop" }] : []) + (blog_on() ? [{ label: "Blog", link: "/blog" }] : [])
}

fn site_menu(t: map) = t.menu ?? default_menu()

let WEEKDAYS = ["Thursday", "Friday", "Saturday", "Sunday", "Monday", "Tuesday", "Wednesday"]
let MONTH_NAMES = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]

fn long_date(ms) {
    let c = civil(floor(ms / DAY))
    `${WEEKDAYS[floor(ms / DAY) % 7]}, ${c.d} ${MONTH_NAMES[c.m - 1]} ${c.y}`
}

fn absolute(link: str) = blank(link) || starts_with(link, "http") ? link : `${site_url()}${link}`

view SiteBrand(t: map, site: str) =
    <a.site-brand href="/">{t.logo != "" ? <img src={t.logo} alt={site}/> : <b>{site}</b>}</a>

view SiteMenu(items: list) = <nav.site-menu>{for l in items => <a href={safe_link(l.link)}>{l.label}</a>}</nav>

view CartLink(n: int) = <a.site-cart href="/cart" aria-label="Cart">Cart{n > 0 && <span.site-cart-n>{n}</span>}</a>

view SiteHeader(t: map, def: map, site: str, menu: list, cart: int, shop: bool) {
    let cart_link = shop || cart > 0
    match def.header ?? "bar" {
        "masthead" => <div>
            <div.site-dateline><span>{long_date(now())}</span>{cart_link ? <CartLink n={cart}/> : <span></span>}</div>
            <header.site-masthead><SiteBrand {t} {site}/></header>
            <div.site-menu-bar><SiteMenu items={menu}/></div>
        </div>
        "split" => <header.site-head.split>
            <SiteMenu items={menu}/>
            <SiteBrand {t} {site}/>
            <div.site-head-end>{cart_link && <CartLink n={cart}/>}</div>
        </header>
        "center" => <header.site-head.center>
            <SiteBrand {t} {site}/>
            <div.site-head-end><SiteMenu items={menu}/>{cart_link && <CartLink n={cart}/>}</div>
        </header>
        _ => <header.site-head>
            <SiteBrand {t} {site}/>
            <div.site-head-end><SiteMenu items={menu}/>{cart_link && <CartLink n={cart}/>}</div>
        </header>
    }
}

view SiteFooter(t: map, site: str, rss: bool, year: str) =
    <footer.site-foot>
        {len(t.footer_links ?? []) > 0 && <nav.site-foot-links>{for l in t.footer_links => <a href={safe_link(l.link)}>{l.label}</a>}</nav>}
        {!blank(t.footer) && <p.site-foot-text>{t.footer}</p>}
        <p>© {year} {site}{rss && <span> · <a href="/blog/feed.xml">RSS</a></span>}</p>
    </footer>

// `theme`: a theme to show instead of the workspace's (the theme picker's
// preview). `image`: the picture link previews show.
// `live`: a page's live preview (its secret link): not for search engines,
// its link not passed on to the sites it links to, the block being edited followed.
view SiteLayout(title: str, description: str, children, theme = null, image: str = "", kind: str = "website", live: bool = false) {
    let s = settings()
    let t = theme ?? theme_of(s)
    let def = theme_def(t.id, s.plugins ?? [])
    let site = s.name ?? ""
    let full = title == "" ? site : `${title} · ${site}`
    <html lang="en">
        <head>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
            <title>{full}</title>
            {description != "" && <meta name="description" content={description}/>}
            <meta property="og:site_name" content={site}/>
            <meta property="og:title" content={title == "" ? site : title}/>
            <meta property="og:type" content={kind}/>
            {description != "" && <meta property="og:description" content={description}/>}
            {image != "" && <meta property="og:image" content={absolute(image)}/>}
            <meta name="twitter:card" content={image != "" ? "summary_large_image" : "summary"}/>
            {blog_on() && <link rel="alternate" type="application/rss+xml" title={site} href="/blog/feed.xml"/>}
            <link rel="stylesheet" href="/assets/app.css"/>
            <style>{theme_css(t, def)}</style>
            {live && <meta name="robots" content="noindex, nofollow"/>}
            {live && <meta name="referrer" content="no-referrer"/>}
            {live && <script src="/assets/live.js" defer></script>}
            {live && <script src="/assets/feedback.js" defer></script>}
        </head>
        <body class={site_classes(t, def)}>
            <SiteHeader {t} {def} {site} menu={site_menu(t)} cart={cart_count()} shop={len(site_menu(t) | filter((l) => l.link == "/shop")) > 0}/>
            <main.site-main>{children}</main>
            <SiteFooter {t} {site} rss={blog_on()} year={slice(iso_day(now()), 0, 4)}/>
        </body>
    </html>
}

// ---- for search engines ----------------------------------------------------------------

fn sitemap() {
    let base = site_url()
    let url = (path, at) => `<url><loc>${xml(base + path)}</loc>${at == null ? "" : `<lastmod>${iso_day(at)}</lastmod>`}</url>`
    let pages = db.query("select slug, home, updated_at from pages where kind = 'page' and published is not null")
        | map((p) => url(p.home == 1 ? "/" : `/p/${p.slug}`, p.updated_at))
    let posts = blog_on() ? [url("/blog", null)] + (db.query("select slug, updated_at from posts where status = 'published'") | map((p) => url(`/blog/${p.slug}`, p.updated_at))) : []
    let products = db.query("select sku from products where active = 1") | map((p) => url(`/shop/${p.sku}`, null))
    let shop = len(products) > 0 ? [url("/shop", null)] : []
    respond(200, `<?xml version="1.0" encoding="UTF-8"?><urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">${join(pages + posts + shop + products, "")}</urlset>`,
        { "content-type": "application/xml; charset=utf-8" })
}

fn robots() = respond(200, `User-agent: *\nDisallow: /app\nDisallow: /cart\nDisallow: /checkout\nSitemap: ${site_url()}/sitemap.xml\n`, { "content-type": "text/plain; charset=utf-8" })

// ---- the theme picker's server functions ------------------------------------------------

// The site's home page (or its blog, or shop) as it would look in a theme.
server fn preview_site(t: map, what: str) {
    need_user()?
    let th = merge(DEFAULT_THEME, t)
    str(match what {
        "blog" => blog_index("", 1, th)
        "shop" => shop_page("", "", th)
        _ => {
            let home = home_page() ?? page_out(db.one("select * from pages where kind = 'page' and published is not null order by updated_at desc limit 1"))
            home == null
                ? <SiteLayout title="" description="" theme={th}><section.pb-hero><div.pb-hero-text><h1>{settings().name ?? ""}</h1><p.pb-lead>Your home page shows here once one is published.</p></div></section></SiteLayout>
                : <SitePage page={home} blocks={home.published.blocks ?? []} theme={th}/>
        }
    })
}

// What the theme editor offers: the themes, the links a menu may have.
server fn site_setup() {
    need_user()?
    let pages = db.query("select title, slug, home from pages where kind = 'page' and published is not null order by title")
        | map((p) => { label: p.title, link: p.home == 1 ? "/" : `/p/${p.slug}` })
    let cats = shop_categories() | map((c) => { label: title_case(c.category), link: `/shop?category=${c.category}` })
    let blog = blog_on() ? [{ label: "Blog", link: "/blog" }] + (post_categories() | map((c) => { label: title_case(c.slug), link: `/blog/category/${c.slug}` })) : []
    {
        themes: themes_for(enabled_plugins()) | map((d) => remove(d, "css")),
        links: [{ label: "Home", link: "/" }, { label: "Shop", link: "/shop" }] + cats + blog + pages,
        default_menu: default_menu(),
    }
}

// ---- how the app asks and tells: notice styles, from plugins ---------------------------

fn notices_for(enabled: list) = active_plugins(enabled) | map((p) => p.notices ?? []) | flatten

// The workspace's notice style (the first there is if its plugin is off).
fn notice_style() {
    let all = notices_for(enabled_plugins())
    find(all, (n) => n.id == settings().notices) ?? all[0]
}

fn notice_classes(n: map) = `dialog-${n.dialog ?? "center"} toasts-${n.toasts ?? "top-right"} notice-${n.id}`

// Every style's CSS (each scoped to its class): switching is a class away.
fn notices_css() = notices_for(enabled_plugins()) | map((n) => replace(n.css ?? "", "<", "")) | join("\n")

server fn save_notice_style(id: str) {
    need_designer()?
    if !any(notices_for(enabled_plugins()), (n) => n.id == id) { return err("No such notice style (is its plugin switched on?)") }
    put_setting("notices", id)
    true
}
