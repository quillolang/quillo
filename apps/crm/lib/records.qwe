// The workspace's records on the server: who is signed in, settings, and
// contacts, companies, deals, tasks, notes and the timeline. Every `server
// fn` here checks the signed-in user first (`need_user()?`), and every save
// runs the same rules the browser showed hints from.

// ---- who is signed in ----------------------------------------------------

fn current_user() {
    let s = session()
    if s.user == null { return null }
    db.one("select id, email, name, role, bio, role_id from users where id = ?", s.user)
}

fn need_user() = current_user() ?? err("Please sign in again")

fn need_admin() {
    let u = need_user()?
    u.role == "member" ? err("Only an admin can do that") : u
}

// ---- settings --------------------------------------------------------------

fn settings() =
    db.query("select key, value from settings")
        | reduce({}, (m, r) => set(m, r.key, parsed(r.value, r.value)))

fn put_setting(key: str, value) = db.exec(
    "insert into settings (key, value) values (?, ?) on conflict (key) do update set value = excluded.value",
    key, json.stringify(value))

// The plugins switched on, and "@drafts" where the studio's drafts are tried.
fn enabled_plugins() {
    let s = settings()
    (s.plugins ?? []) + (s.try_drafts == true ? ["@drafts"] : [])
}

fn custom_fields() = db.query("select * from custom_fields order by entity, position, id")
    | map((f) => set(f, "options", parsed(f.options, [])) | set("required", f.required == 1))

// What rules see, besides the record: the same on both sides.
fn rule_ctx(extra: map = {}) {
    let s = settings()
    merge({ enabled: enabled_plugins(), fields: custom_fields(), settings: s, today: iso_day(now()) }, extra)
}

// The problems that refuse a save, or null.
fn refused(kind: str, record: map, ctx: map) {
    let errs = errors_of(validate(kind, record, ctx))
    len(errs) > 0 ? err({ problems: errs }) : null
}

// ---- the timeline ----------------------------------------------------------

fn note_activity(kind: str, contact_id, deal_id, summary: str) = db.exec(
    "insert into activities (kind, contact_id, deal_id, summary, created_at) values (?, ?, ?, ?, ?)",
    kind, contact_id, deal_id, summary, now())

// ---- contacts --------------------------------------------------------------

fn contact_row(id) = id == null ? null : db.one("select * from contacts where id = ?", id)

fn contact_out(r) = r == null ? null : merge(r, {
    tags: parsed(r.tags, []),
    fields: parsed(r.fields, {}),
    subscribed: r.subscribed == 1,
    name: full_name(r),
})

fn clean_tags(tags) = (tags ?? []) | map((t) => slugify(str(t))) | filter((t) => t != "") | unique

// Adds tags to a contact; flows that start on a new tag start.
fn add_tags(id, tags: list) {
    let c = contact_row(id)
    if c == null { return null }
    let have = parsed(c.tags, [])
    let fresh = clean_tags(tags) | filter((t) => !contains(have, t))
    if len(fresh) > 0 {
        db.exec("update contacts set tags = ?, updated_at = ? where id = ?", json.stringify(have + fresh), now(), id)
        for t in fresh => {
            note_activity("tag", id, null, `Tagged ${t}`)
            fire("tag_added", { contact_id: id, tag: t })
        }
    }
    fresh
}

fn remove_tags(id, tags: list) {
    let c = contact_row(id)
    if c == null { return null }
    let drop = clean_tags(tags)
    db.exec("update contacts set tags = ?, updated_at = ? where id = ?",
        json.stringify(parsed(c.tags, []) | filter((t) => !contains(drop, t))), now(), id)
}

// The contact with this email, made if there is none (forms, checkout).
fn contact_for_email(email: str, extra: map = {}) {
    let e = lower(trim(email))
    let found = db.one("select * from contacts where lower(email) = ?", e)
    if found != null {
        // What they tell us now fills in what we did not know.
        if found.first_name == "" && found.last_name == "" && !blank(extra.first_name) {
            db.exec("update contacts set first_name = ?, last_name = ?, updated_at = ? where id = ?", extra.first_name, extra.last_name ?? "", now(), found.id)
            return contact_row(found.id)
        }
        return found
    }
    let t = now()
    let r = db.exec(
        "insert into contacts (first_name, last_name, email, stage, source, subscribed, tags, fields, created_at, updated_at) values (?, ?, ?, ?, ?, ?, '[]', ?, ?, ?)",
        extra.first_name ?? "", extra.last_name ?? "", e, extra.stage ?? "lead", extra.source ?? "", extra.subscribed == true ? 1 : 0,
        json.stringify(extra.fields ?? {}), t, t)
    note_activity("created", r.last_id, null, `Added from ${extra.source ?? "the app"}`)
    fire("contact_created", { contact_id: r.last_id })
    contact_row(r.last_id)
}

server fn list_contacts(query: map) {
    need_user()?
    let q = `%${lower(trim(query.q ?? ""))}%`
    let tag = query.tag ?? ""
    let stage = query.stage ?? ""
    let rows = db.query(
        "select c.*, co.name as company from contacts c left join companies co on co.id = c.company_id
         where (lower(c.first_name || ' ' || c.last_name || ' ' || c.email) like ?)
           and (? = '' or c.stage = ?)
           and (? = '' or exists (select 1 from json_each(c.tags) where value = ?))
         order by c.updated_at desc limit 200",
        q, stage, stage, tag, tag)
    rows | map(contact_out)
}

server fn get_contact(id: int) {
    need_user()?
    let c = (contact_out(contact_row(id)) ?? err("No such contact"))?
    merge(c, {
        company: c.company_id == null ? null : db.one("select id, name from companies where id = ?", c.company_id),
        deals: db.query("select d.*, s.name as stage from deals d join stages s on s.id = d.stage_id where d.contact_id = ? order by d.updated_at desc", id),
        orders: db.query("select id, number, status, total_cents, created_at from orders where contact_id = ? order by created_at desc", id),
        tasks: db.query("select * from tasks where contact_id = ? order by done, due", id),
        notes: db.query("select n.*, u.name as author from notes n left join users u on u.id = n.author_id where n.contact_id = ? order by n.created_at desc", id),
        timeline: db.query("select * from activities where contact_id = ? order by created_at desc, id desc limit 50", id),
        runs: db.query("select r.id, r.status, r.node, f.id as flow_id, f.name as flow from flow_runs r join flows f on f.id = r.flow_id where json_extract(r.context, '$.contact_id') = ? order by r.created_at desc limit 20", id),
    })
}

server fn save_contact(c: map) {
    let u = need_user()?
    let ctx = rule_ctx()
    refused("contact", c, ctx)?
    let email = lower(trim(c.email ?? ""))
    if email != "" {
        let other = db.one("select id from contacts where lower(email) = ? and id != ?", email, c.id ?? 0)
        if other != null { return err({ problems: problem("email", "Another contact has this email") }) }
    }
    let t = now()
    let tags = clean_tags(c.tags)
    let first = trim(c.first_name ?? "")
    let last = trim(c.last_name ?? "")
    let phone = trim(c.phone ?? "")
    let stage = c.stage ?? "lead"
    let subscribed = c.subscribed == true ? 1 : 0
    let fields = json.stringify(c.fields ?? {})
    if c.id == null {
        let r = db.exec(
            "insert into contacts (first_name, last_name, email, phone, company_id, stage, subscribed, fields, tags, owner_id, source, created_at, updated_at)
             values (?, ?, ?, ?, ?, ?, ?, ?, '[]', ?, 'app', ?, ?)",
            first, last, email, phone, c.company_id, stage, subscribed, fields, u.id, t, t)
        note_activity("created", r.last_id, null, `Added by ${u.name}`)
        fire("contact_created", { contact_id: r.last_id })
        add_tags(r.last_id, tags)
        drain_runs()
        contact_out(contact_row(r.last_id))
    } else {
        let before = (contact_row(c.id) ?? err("No such contact"))?
        db.exec("update contacts set first_name = ?, last_name = ?, email = ?, phone = ?, company_id = ?, stage = ?, subscribed = ?, fields = ?, updated_at = ? where id = ?",
            first, last, email, phone, c.company_id, stage, subscribed, fields, t, c.id)
        if before.stage != stage { note_activity("stage", c.id, null, `Stage: ${before.stage} → ${stage}`) }
        let had = parsed(before.tags, [])
        remove_tags(c.id, had | filter((x) => !contains(tags, x)))
        add_tags(c.id, tags)
        drain_runs()
        contact_out(contact_row(c.id))
    }
}

server fn delete_contact(id: int) {
    need_admin()?
    db.exec("delete from contacts where id = ?", id)
    true
}

server fn add_note(contact_id: int, body: str) {
    let u = need_user()?
    if trim(body) == "" { return err("Write something first") }
    db.exec("insert into notes (body, contact_id, author_id, created_at) values (?, ?, ?, ?)", trim(body), contact_id, u.id, now())
    note_activity("note", contact_id, null, `${u.name} wrote a note`)
    true
}

server fn all_tags() {
    need_user()?
    db.query("select value as tag, count(*) as n from contacts, json_each(contacts.tags) group by value order by n desc, value")
}

// ---- companies -------------------------------------------------------------

fn company_out(r) = r == null ? null : set(r, "fields", parsed(r.fields, {}))

server fn list_companies(q: str) {
    need_user()?
    db.query(
        "select co.*, (select count(*) from contacts c where c.company_id = co.id) as people,
                (select coalesce(sum(value_cents), 0) from deals d where d.company_id = co.id) as pipeline_cents
         from companies co where lower(co.name || ' ' || co.domain) like ? order by co.name limit 200",
        `%${lower(trim(q))}%`) | map(company_out)
}

server fn get_company(id: int) {
    need_user()?
    let co = (company_out(db.one("select * from companies where id = ?", id)) ?? err("No such company"))?
    merge(co, {
        people: db.query("select * from contacts where company_id = ? order by first_name", id) | map(contact_out),
        deals: db.query("select d.*, s.name as stage from deals d join stages s on s.id = d.stage_id where d.company_id = ?", id),
    })
}

server fn save_company(c: map) {
    need_user()?
    refused("company", c, rule_ctx())?
    let t = now()
    if c.id == null {
        let r = db.exec("insert into companies (name, domain, industry, fields, created_at, updated_at) values (?, ?, ?, ?, ?, ?)",
            trim(c.name), lower(trim(c.domain ?? "")), c.industry ?? "", json.stringify(c.fields ?? {}), t, t)
        company_out(db.one("select * from companies where id = ?", r.last_id))
    } else {
        db.exec("update companies set name = ?, domain = ?, industry = ?, fields = ?, updated_at = ? where id = ?",
            trim(c.name), lower(trim(c.domain ?? "")), c.industry ?? "", json.stringify(c.fields ?? {}), t, c.id)
        company_out(db.one("select * from companies where id = ?", c.id))
    }
}

// ---- pipelines and deals -----------------------------------------------------

fn stage_row(id) = id == null ? null : db.one("select * from stages where id = ?", id)

fn deal_out(r) = r == null ? null : set(r, "fields", parsed(r.fields, {}))

server fn load_board(pipeline_id: int) {
    need_user()?
    let stages = db.query("select * from stages where pipeline_id = ? order by position", pipeline_id)
    let deals = db.query(
        "select d.*, c.first_name, c.last_name, c.email, co.name as company from deals d
         left join contacts c on c.id = d.contact_id left join companies co on co.id = d.company_id
         where d.stage_id in (select id from stages where pipeline_id = ?) order by d.position, d.updated_at desc",
        pipeline_id) | map(deal_out)
    { stages, deals }
}

server fn save_deal(d: map) {
    let u = need_user()?
    let stage = stage_row(d.stage_id)
    refused("deal", d, rule_ctx({ stage_kind: stage == null ? "open" : stage.kind }))?
    let t = now()
    if d.id == null {
        let r = db.exec(
            "insert into deals (title, value_cents, stage_id, contact_id, company_id, owner_id, close_date, fields, created_at, updated_at) values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
            trim(d.title), d.value_cents, d.stage_id, d.contact_id, d.company_id, u.id, d.close_date ?? "", json.stringify(d.fields ?? {}), t, t)
        if d.contact_id != null { note_activity("deal", d.contact_id, r.last_id, `New deal: ${trim(d.title)}`) }
        deal_out(db.one("select * from deals where id = ?", r.last_id))
    } else {
        let before = (db.one("select * from deals where id = ?", d.id) ?? err("No such deal"))?
        db.exec("update deals set title = ?, value_cents = ?, stage_id = ?, contact_id = ?, company_id = ?, close_date = ?, fields = ?, updated_at = ? where id = ?",
            trim(d.title), d.value_cents, d.stage_id, d.contact_id, d.company_id, d.close_date ?? "", json.stringify(d.fields ?? {}), t, d.id)
        if before.stage_id != d.stage_id { deal_moved(d.id, before.stage_id, d.stage_id) }
        drain_runs()
        deal_out(db.one("select * from deals where id = ?", d.id))
    }
}

fn deal_moved(id: int, from_stage, to_stage) {
    let d = db.one("select * from deals where id = ?", id)
    let s = stage_row(to_stage)
    note_activity("deal", d.contact_id, id, `${d.title} moved to ${s.name}`)
    if s.kind == "won" { fire("deal_won", { contact_id: d.contact_id, deal_id: id }) }
}

// Dragging a card to another column: the deal's rules see its new stage
// (a won sponsorship needs its run date, say).
server fn move_deal(id: int, stage_id: int) {
    need_user()?
    let d = (deal_out(db.one("select * from deals where id = ?", id)) ?? err("No such deal"))?
    let stage = (stage_row(stage_id) ?? err("No such stage"))?
    refused("deal", set(d, "stage_id", stage_id), rule_ctx({ stage_kind: stage.kind }))?
    if d.stage_id != stage_id {
        db.exec("update deals set stage_id = ?, updated_at = ? where id = ?", stage_id, now(), id)
        deal_moved(id, d.stage_id, stage_id)
        drain_runs()
    }
    true
}

server fn delete_deal(id: int) {
    need_user()?
    db.exec("delete from deals where id = ?", id)
    true
}

// ---- tasks -------------------------------------------------------------------

server fn list_tasks(show_done: bool) {
    need_user()?
    db.query(
        "select t.*, c.first_name, c.last_name, c.email, u.name as owner from tasks t
         left join contacts c on c.id = t.contact_id left join users u on u.id = t.owner_id
         where (? or t.done = 0) order by t.done, case when t.due = '' then 1 else 0 end, t.due, t.id desc limit 300",
        show_done)
}

server fn save_task(t: map) {
    let u = need_user()?
    refused("task", t, rule_ctx())?
    if t.id == null {
        db.exec("insert into tasks (title, due, contact_id, deal_id, owner_id, created_at) values (?, ?, ?, ?, ?, ?)",
            trim(t.title), t.due ?? "", t.contact_id, t.deal_id, u.id, now())
        if t.contact_id != null { note_activity("task", t.contact_id, null, `Task: ${trim(t.title)}`) }
    } else {
        db.exec("update tasks set title = ?, due = ? where id = ?", trim(t.title), t.due ?? "", t.id)
    }
    true
}

server fn toggle_task(id: int) {
    need_user()?
    db.exec("update tasks set done = 1 - done where id = ?", id)
    true
}

// ---- the dashboard -------------------------------------------------------------

server fn load_dashboard() {
    need_user()?
    let week = now() - 7 * DAY
    let one = (sql) => (db.one(sql) ?? {}).n ?? 0
    let since = (sql, t) => (db.one(sql, t) ?? {}).n ?? 0
    let days = range(0, 14) | map((i) => iso_day(now() - (13 - i) * DAY))
    let sales = db.query("select date(paid_at / 1000, 'unixepoch') as day, sum(total_cents) as cents, count(*) as n from orders where status = 'paid' and paid_at >= ? group by day", now() - 14 * DAY)
    {
        contacts: one("select count(*) as n from contacts"),
        new_contacts: since("select count(*) as n from contacts where created_at >= ?", week),
        subscribers: one("select count(*) as n from contacts where subscribed = 1"),
        open_deals: one("select count(*) as n from deals d join stages s on s.id = d.stage_id where s.kind = 'open'"),
        pipeline_cents: one("select coalesce(sum(value_cents), 0) as n from deals d join stages s on s.id = d.stage_id where s.kind = 'open'"),
        won_cents: since("select coalesce(sum(value_cents), 0) as n from deals d join stages s on s.id = d.stage_id where s.kind = 'won' and d.updated_at >= ?", now() - 30 * DAY),
        revenue_cents: since("select coalesce(sum(total_cents), 0) as n from orders where status = 'paid' and paid_at >= ?", now() - 30 * DAY),
        orders: since("select count(*) as n from orders where status = 'paid' and paid_at >= ?", now() - 30 * DAY),
        tasks_due: since("select count(*) as n from tasks where done = 0 and due != '' and due <= ?", iso_day(now())),
        running_flows: one("select count(*) as n from flow_runs where status in ('running', 'waiting')"),
        sales: days | map((d) => { day: d, cents: (find(sales, (s) => s.day == d) ?? {}).cents ?? 0 }),
        stages: db.query("select s.name, s.kind, count(d.id) as n, coalesce(sum(d.value_cents), 0) as cents from stages s left join deals d on d.stage_id = s.id where s.pipeline_id = (select min(id) from pipelines) group by s.id order by s.position"),
        recent: db.query("select a.*, c.first_name, c.last_name, c.email from activities a left join contacts c on c.id = a.contact_id order by a.created_at desc, a.id desc limit 12"),
    }
}

// ---- search ----------------------------------------------------------------

server fn search(q: str) {
    need_user()?
    if len(trim(q)) < 2 { return [] }
    let like = `%${lower(trim(q))}%`
    let people = db.query("select id, first_name, last_name, email from contacts where lower(first_name || ' ' || last_name || ' ' || email) like ? limit 6", like)
        | map((c) => { kind: "Contact", label: full_name(c), sub: c.email, href: `/app/contacts/${c.id}` })
    let companies = db.query("select id, name, domain from companies where lower(name || ' ' || domain) like ? limit 4", like)
        | map((c) => { kind: "Company", label: c.name, sub: c.domain, href: `/app/companies/${c.id}` })
    let deals = db.query("select id, title from deals where lower(title) like ? limit 4", like)
        | map((d) => { kind: "Deal", label: d.title, sub: "", href: "/app/deals" })
    let products = db.query("select id, name, sku from products where lower(name || ' ' || sku) like ? limit 4", like)
        | map((p) => { kind: "Product", label: p.name, sub: p.sku, href: "/app/products" })
    let words = lower(trim(q))
    let u = current_user()
    let objs = readable_objects(u)
    // Its name first (the start of it best), then its folder.
    let rank = (o) => starts_with(lower(o.plural), words) || starts_with(lower(o.name), words) ? 0
        : contains(lower(`${o.plural} ${o.name}`), words) ? 1 : contains(lower(o.folder ?? ""), words) ? 2 : 9
    let objects = objs | filter((o) => rank(o) < 9) | sort_by(rank) | take(5)
        | map((o) => { kind: "Object", label: o.plural, sub: o.folder ?? "", href: `/app/o/${o.key}` })
    let pages = db.query("select id, title, slug, kind from pages where lower(title || ' ' || slug) like ? limit 5", like)
        | map((p) => { kind: p.kind == "section" ? "Section" : "Page", label: blank(p.title) ? "Untitled" : p.title, sub: `/p/${p.slug}`, href: `/app/pages/${p.id}` })
    objects + pages + people + companies + deals + products + object_records_like(u, objs, like)
}

// Records of every object whose title matches, in one query; an object
// whose access scripts choose the records someone sees is asked about each.
fn object_records_like(u, objs: list, like: str) {
    if len(objs) == 0 { return [] }
    let parts = enumerate(objs) | map((x) => `select * from (select ${sql_param(`k${x[0]}`)} as k, id, title from ${sql_name(x[1].table)} where lower(title) like :like limit 5)`)
    let params = enumerate(objs) | reduce({ like }, (m, x) => set(m, `k${x[0]}`, x[1].key))
    let rows = db.query(join(parts, " union all "), params)
    if is_err(rows) { return [] }
    let rs = u == null || u.role != "member" ? [] : roles_of(u)
    rows | filter((r) => {
        let a = access_in(u, rs, r.k)
        len(a.scripts) == 0 || may_see(u, a, rec_get(r.k, r.id) ?? { fields: {} })
    }) | take(8) | map((r) => {
        let o = find(objs, (x) => x.key == r.k)
        { kind: o.name, label: r.title, sub: o.folder ?? "", href: `/app/o/${r.k}/${r.id}` }
    })
}
