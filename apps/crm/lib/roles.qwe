// Roles, and the scripts that run on the server for objects.
//
// A role says, for each object, what its members may do with its records
// (none, read, edit, delete) and, optionally, which records they see: an
// access script, `owner_id == user.id` say. Owners and admins may do
// anything; a member with no role edits everything (as before roles).
//
// A field's rule script runs when a record is saved (and while its form is
// filled in, for hints): it gives `true` or null when the value is fine,
// `false` or a message when it is not. Scripts run in a sandbox
// (`run_script`): they see only the values below and builtins that compute.

let LEVELS = ["none", "read", "edit", "delete"]

fn allows(level: str, need: str) = (index_of(LEVELS, level) ?? 0) >= (index_of(LEVELS, need) ?? 0)

fn role_out(r) = r == null ? null : merge(r, { access: parsed(r.access, {}) })

// ---- groups, and what a member's roles add up to -----------------------------------------

let CAPABILITIES = [["designer", "Designers: objects, the theme, pages"], ["writer", "Writers"], ["reviewer", "Reviewers"], ["publisher", "Publishers"]]
let FIELD_LEVELS = ["hidden", "read", "edit"]

fn group_out(r) = r == null ? null : merge(r, { members: parsed(r.members, []), roles: parsed(r.roles, []), capabilities: parsed(r.capabilities, []) })

fn groups_of(u) = u == null ? [] : db.query("select * from groups") | map(group_out) | filter((g) => contains(g.members, u.id))

fn in_group(u, gid) = u != null && any(groups_of(u), (g) => g.id == gid)

// A member's roles: their own, and their groups'.
fn roles_of(u) {
    if u == null { return [] }
    let ids = unique((u.role_id == null ? [] : [u.role_id]) + (groups_of(u) | map((g) => g.roles) | flatten))
    ids | map((id) => role_out(db.one("select * from roles where id = ?", id))) | filter((r) => r != null)
}

fn has_role(u, rid) = u != null && (u.role != "member" || any(roles_of(u), (r) => r.id == rid))

// What a group lets its members be on the team (owners and admins are all).
fn can_be(u, capability: str) = u != null && (u.role != "member" || any(groups_of(u), (g) => contains(g.capabilities, capability)))

fn need_designer() {
    let u = need_user()?
    can_be(u, "designer") ? u : err("Only admins and designers may change this")
}

// What `u` may do with `key`'s records: the most any of their roles
// allows, the access scripts that decide which records (none: all), and
// each field's level. Owners and admins may do anything; a member with no
// roles edits everything.
fn access_to(u, key: str) = access_in(u, u == null || u.role != "member" ? [] : roles_of(u), key)

// The objects `u` may read, their roles read once (not once an object).
fn readable_objects(u) {
    let rs = u == null || u.role != "member" ? [] : roles_of(u)
    objects_all() | filter((o) => allows(access_in(u, rs, o.key).level, "read"))
}

// `access_to`, given `u`'s roles.
fn access_in(u, rs: list, key: str) {
    if u == null { return { level: "none", scripts: [], fields: {} } }
    if u.role != "member" { return { level: "delete", scripts: [], fields: {} } }
    if len(rs) == 0 { return { level: "edit", scripts: [], fields: {} } }
    let grants = rs | map((r) => merge({ level: "none", script: "", fields: {} }, r.access[key] ?? {})) | filter((a) => a.level != "none")
    if len(grants) == 0 { return { level: "none", scripts: [], fields: {} } }
    let level = grants | map((a) => a.level) | reduce("none", (m, l) => allows(l, m) ? l : m)
    // One role that sees every record means every record is seen.
    let scripts = any(grants, (a) => blank(a.script)) ? [] : grants | map((a) => a.script)
    let keys_all = grants | map((a) => keys(a.fields ?? {})) | flatten | unique
    let fields = keys_all | reduce({}, (m, k) => set(m, k, grants | map((a) => (a.fields ?? {})[k] ?? (allows(a.level, "edit") ? "edit" : "read"))
        | reduce("hidden", (best, l) => (index_of(FIELD_LEVELS, l) ?? 0) > (index_of(FIELD_LEVELS, best) ?? 0) ? l : best)))
    { level, scripts, fields }
}

// A field's level for `u`: hidden, read or edit.
fn field_level(a: map, key: str) = a.fields[key] ?? (allows(a.level, "edit") ? "edit" : "read")

fn script_user(u) = { id: u.id, name: u.name, email: u.email, role: u.role }

// Whether the access scripts let `u` see the record (none: yes).
fn may_see(u, access: map, r: map) {
    if len(access.scripts ?? []) == 0 { return true }
    let vars = { record: r.fields, state: r.state ?? "", owner_id: r.owner_id, id: r.id, user: script_user(u), today: iso_day(now()) }
    any(access.scripts, (src) => run_script(src, vars) == true)
}

// A record as `u` may see it: the fields their roles hide, taken out.
fn as_seen(a: map, r: map) = len(keys(a.fields ?? {})) == 0 ? r
    : set(r, "fields", keys(r.fields ?? {}) | filter((k) => field_level(a, k) != "hidden") | reduce({}, (m, k) => set(m, k, r.fields[k])))

// The record if `u` may do `need` with it; else an error.
fn need_access(u, key: str, need: str, r) {
    objects_ready()
    let a = access_to(u, key)
    if !allows(a.level, need) { return err(`Your role may not ${need == "read" ? "see" : need} these records`) }
    if r != null && !may_see(u, a, r) { return err("Your role may not see this record") }
    a
}

// ---- rule scripts on fields --------------------------------------------------------------

// What a field's script sees: the value, the whole record, who is saving,
// and helpers that read (others_with: how many other records have this
// value in that field; contact: a contact's name, email, stage and tags).
fn script_vars(key: str, values: map, id, u, f: map) = {
    value: values[f.key],
    record: values,
    is_new: id == null,
    user: u == null ? null : script_user(u),
    today: iso_day(now()),
    others_with: (field, v) => len(rec_where(key, str(field), v) | filter((r) => r.id != (id ?? 0))),
    contact: (cid) => {
        let c = db.one("select first_name, last_name, email, stage, tags from contacts where id = ?", int(cid) ?? 0)
        c == null ? null : { name: trim(`${c.first_name} ${c.last_name}`), email: c.email, stage: c.stage, tags: parsed(c.tags, []) }
    },
}

// A script's answer as problems at its field.
fn script_problems(f: map, out) {
    let at = `fields.${f.key}`
    is_err(out) ? problem(at, `${f.label}: its rule script failed (${str(out.error)})`)
        : out == true || out == null || out == "" ? []
        : out == false ? problem(at, `${f.label} is not valid`)
        : type_of(out) == "str" ? problem(at, out)
        : type_of(out) == "map" && !blank(out.message) ? (out.warning == true ? warning(at, out.message) : problem(at, out.message))
        : []
}

fn field_script_problems(key: str, fields: list, values: map, id, u) =
    fields | filter((f) => !blank(f.script)) | map((f) => script_problems(f, run_script(f.script, script_vars(key, values, id, u, f)))) | flatten

// For the form, while it is filled in.
server fn check_record_scripts(key: str, r: map) {
    let u = need_user()?
    need_access(u, key, "edit", null)?
    field_script_problems(key, object_fields(key), r.fields ?? {}, r.id, u)
}

// The designer's try: one script, on a sample record.
server fn try_field_script(key: str, field_key: str, src: str, values: map) {
    let u = need_designer()?
    let f = (find(object_fields(key), (x) => x.key == field_key) ?? err("No such field"))?
    let out = run_script(src, script_vars(key, values, null, u, f))
    { result: is_err(out) ? null : out, error: is_err(out) ? str(out.error) : null, problems: script_problems(merge(f, { script: src }), out) }
}

server fn save_field_script(id: int, src: str) {
    need_designer()?
    // It must at least read as code.
    let parsed_ok = run_script(`let _check = () => {\n${src}\n}\nnull`, {})
    if is_err(parsed_ok) { return err({ problems: problem("script", str(parsed_ok.error)) }) }
    db.exec("update custom_fields set script = ? where id = ?", src, id)
    true
}

// ---- roles ---------------------------------------------------------------------------------

server fn list_roles() {
    need_user()?
    db.query("select r.*, (select count(*) from users u where u.role_id = r.id) as members from roles r order by name") | map(role_out)
}

server fn save_role(r: map) {
    need_admin()?
    if blank(r.name) { return err({ problems: problem("name", "Name the role") }) }
    if db.one("select id from roles where lower(name) = ? and id != ?", lower(trim(r.name)), r.id ?? 0) != null { return err({ problems: problem("name", "There is a role with this name") }) }
    let access = keys(r.access ?? {}) | reduce({}, (m, k) => {
        let a = r.access[k]
        let fields = keys(a.fields ?? {}) | filter((f) => contains(FIELD_LEVELS, a.fields[f])) | reduce({}, (fm, f) => set(fm, f, a.fields[f]))
        set(m, k, { level: contains(LEVELS, a.level) ? a.level : "none", script: a.script ?? "", fields })
    })
    // Access scripts must read as code.
    let broken = keys(access) | filter((k) => !blank(access[k].script) && is_err(run_script(`let _check = () => {\n${access[k].script}\n}\nnull`, {})))
    if len(broken) > 0 { return err({ problems: problem("access", `The script for ${join(broken, ", ")} does not read as code`) }) }
    if r.id == null {
        db.exec("insert into roles (name, access, created_at) values (?, ?, ?)", trim(r.name), json.stringify(access), now()).last_id
    } else {
        db.exec("update roles set name = ?, access = ? where id = ?", trim(r.name), json.stringify(access), r.id)
        r.id
    }
}

server fn delete_role(id: int) {
    need_admin()?
    db.exec("update users set role_id = null where role_id = ?", id)
    db.exec("delete from roles where id = ?", id)
    true
}

server fn set_user_role(user_id: int, role_id) {
    need_admin()?
    db.exec("update users set role_id = ? where id = ? and role = 'member'", role_id, user_id)
    true
}

// Tries an access script on a record: does this role's member see it?
server fn try_access_script(src: str, key: str, record_id: int) {
    let u = need_admin()?
    let r = rec_get(key, record_id)
    if r == null { return err("No such record") }
    let out = run_script(src, { record: r.fields, owner_id: r.owner_id, id: r.id, user: script_user(u), today: iso_day(now()) })
    is_err(out) ? err(str(out.error)) : { sees: out == true, result: out }
}

// ---- groups -----------------------------------------------------------------------------

server fn list_groups() {
    need_user()?
    db.query("select * from groups order by name") | map(group_out)
}

server fn save_group(g: map) {
    need_admin()?
    if blank(g.name) { return err({ problems: problem("name", "Name the group") }) }
    if db.one("select id from groups where lower(name) = ? and id != ?", lower(trim(g.name)), g.id ?? 0) != null { return err({ problems: problem("name", "There is a group with this name") }) }
    let ids = (xs) => json.stringify((xs ?? []) | map((x) => int(x) ?? 0) | filter((x) => x > 0) | unique)
    let caps = json.stringify((g.capabilities ?? []) | filter((c) => any(CAPABILITIES, (k) => k[0] == c)) | unique)
    if g.id == null {
        db.exec("insert into groups (name, members, roles, capabilities, created_at) values (?, ?, ?, ?, ?)", trim(g.name), ids(g.members), ids(g.roles), caps, now()).last_id
    } else {
        db.exec("update groups set name = ?, members = ?, roles = ?, capabilities = ? where id = ?", trim(g.name), ids(g.members), ids(g.roles), caps, g.id)
        g.id
    }
}

server fn delete_group(id: int) {
    need_admin()?
    db.exec("delete from groups where id = ?", id)
    true
}
