// Flows: graphs of steps that start when something happens. A flow is
//
//     { nodes: [{ id, type, x, y, config }], edges: [{ from, to, port }] }
//
// with one `trigger` node. When its event happens (`fire`), a run starts at
// the trigger and follows edges, running each step; a step leaves by a port
// ("out", or "yes" / "no"). A step that waits (a delay, a purchase) parks the
// run; the job that resumes runs (`resume_due`) or a purchase (`purchased`)
// carries it on. A contact is in a flow once at a time.

let EMPTY_GRAPH = { nodes: [{ id: "n1", type: "trigger", x: 80, y: 120, config: { event: "contact_created" } }], edges: [] }

fn flow_out(r) = r == null ? null : merge(r, { graph: parsed(r.graph, EMPTY_GRAPH), active: r.active == 1 })

fn log_entry(node: str, text: str) = { at: now(), node, text }

// ---- starting runs ---------------------------------------------------------------

fn trigger_matches(c: map, event: str, data: map) =
    c.event == event && match event {
        "form_submitted" => blank(c.form) || c.form == data.form
        "order_paid" => blank(c.product) || lower(c.product) == data.sku
        "tag_added" => slugify(c.tag ?? "") == data.tag
        "record_created" => blank(c.object) || c.object == data.object
        "record_updated" => blank(c.object) || c.object == data.object
        "record_moved" => (blank(c.object) || c.object == data.object) && (blank(c.to) || c.to == data.to)
        _ => true
    }

fn start_run(f: map, trigger: map, data: map) {
    let busy = data.contact_id != null && db.one(
        "select id from flow_runs where flow_id = ? and status in ('running', 'waiting') and json_extract(context, '$.contact_id') = ?",
        f.id, data.contact_id) != null
    if busy { return null }
    let t = now()
    db.exec("insert into flow_runs (flow_id, status, node, context, next_at, log, created_at, updated_at) values (?, 'running', ?, ?, ?, ?, ?, ?)",
        f.id, trigger.id, json.stringify(data), t, json.stringify([log_entry(trigger.id, "started")]), t, t).last_id
}

// Something happened: runs start for the active flows it triggers. They
// run when `drain_runs` is next called (after the request's writes) or
// within seconds, by the job.
fn fire(event: str, data: map) {
    for f in db.query("select * from flows where active = 1") | map(flow_out) => {
        let trigger = find(f.graph.nodes ?? [], (n) => n.type == "trigger")
        if trigger != null && trigger_matches(trigger.config ?? {}, event, data) { start_run(f, trigger, data) }
    }
}

// ---- running them ------------------------------------------------------------------

fn finish_run(run: map, status: str, node: str, log: list) {
    db.exec("update flow_runs set status = ?, node = ?, log = ?, waiting_for = '', next_at = null, updated_at = ? where id = ?",
        status, node, json.stringify(log), now(), run.id)
    status
}

// Runs the flow from node `at`; with `leaving`, that node ran already (it
// waited) and the run leaves it by that port.
fn walk(run: map, graph: map, at: str, leaving, steps: int, log: list) {
    if steps > 100 { return finish_run(run, "failed", at, log + [log_entry(at, "stopped: more than 100 steps")]) }
    let node = flow_node(graph, at)
    if node == null { return finish_run(run, "done", at, log) }
    let outcome = leaving != null ? { port: leaving } : run_step(node, run)
    let logged = outcome.log == null ? log : log + [log_entry(at, outcome.log)]
    if outcome.error != null { return finish_run(run, "failed", at, logged + [log_entry(at, outcome.error)]) }
    if outcome.waiting_for != null {
        db.exec("update flow_runs set status = 'waiting', node = ?, waiting_for = ?, next_at = ?, context = ?, log = ?, updated_at = ? where id = ?",
            at, outcome.waiting_for, outcome.until, json.stringify(merge(run.context, { _resume: outcome.resume ?? "out", _sku: outcome.sku ?? "" })),
            json.stringify(logged), now(), run.id)
        return "waiting"
    }
    let next = find(graph.edges ?? [], (e) => e.from == at && e.port == (outcome.port ?? "out"))
    next == null || outcome.port == null ? finish_run(run, "done", at, logged) : walk(run, graph, next.to, null, steps + 1, logged)
}

fn run_out(r) = merge(r, { context: parsed(r.context, {}), log: parsed(r.log, []) })

fn advance(run_id: int, leaving) {
    let run = run_out(db.one("select * from flow_runs where id = ?", run_id))
    let f = flow_out(db.one("select * from flows where id = ?", run.flow_id))
    if f == null { return null }
    db.exec("update flow_runs set status = 'running', updated_at = ? where id = ?", now(), run_id)
    let at_trigger = leaving == null && (flow_node(f.graph, run.node) ?? {}).type == "trigger"
    walk(run, f.graph, run.node, at_trigger ? "out" : leaving, 0, run.log)
}

// Runs that are ready: just started, or done waiting.
fn drain_runs() {
    for r in db.query("select id from flow_runs where status = 'running' and next_at <= ? order by id limit 50", now()) => advance(r.id, null)
}

// The job's part: runs whose wait is over carry on (a purchase that never
// came leaves by "no"), and new ones start.
fn resume_due() {
    for r in db.query("select id, context from flow_runs where status = 'waiting' and next_at <= ? order by next_at limit 100", now()) =>
        advance(r.id, parsed(r.context, {})._resume ?? "out")
    drain_runs()
}

// A contact bought something: runs waiting for that purchase leave by "yes".
fn purchased(contact_id: int, sku: str) {
    for r in db.query("select id, context from flow_runs where status = 'waiting' and waiting_for = 'purchase' and json_extract(context, '$.contact_id') = ?", contact_id) => {
        let want = parsed(r.context, {})._sku ?? ""
        if want == "" || want == sku {
            db.exec("update flow_runs set context = json_set(context, '$.order_sku', ?), updated_at = ? where id = ?", sku, now(), r.id)
            advance(r.id, "yes")
        }
    }
}

// ---- the steps -------------------------------------------------------------------------

fn run_step(node: map, run: map) {
    if node.type == "trigger" { return { port: "out" } }
    let plugin = find(active_plugins(rule_ctx().enabled), (p) => any(p.steps ?? [], (s) => s.type == node.type))
    if plugin == null { return { error: `no step "${node.type}" (is its plugin switched on?)` } }
    let runner = (step_runners[plugin_key(plugin)] ?? {})[node.type]
    runner == null ? { error: `the ${plugin.name} plugin cannot run "${node.type}"` } : runner(node.config ?? {}, run)
}

fn run_contact(run) = contact_row(run.context.contact_id)

// What a condition looks at.
fn condition_value(field: str, run: map) {
    let c = run_contact(run)
    let order = run.context.order_id == null ? null : db.one("select * from orders where id = ?", run.context.order_id)
    match field {
        "contact.stage" => c.stage
        "contact.tags" => parsed(c.tags, [])
        "contact.email" => c.email
        "contact.subscribed" => c.subscribed == 1
        "order.total" => order == null ? null : order.total_cents / 100
        "order.sku" => run.context.order_sku ?? run.context.sku
        "deal.value" => {
            let d = run.context.deal_id == null ? null : db.one("select value_cents from deals where id = ?", run.context.deal_id)
            d == null ? null : d.value_cents / 100
        }
        _ => {
            let key = slice(field, len("contact.fields."))
            starts_with(field, "contact.fields.") && c != null ? parsed(c.fields, {})[key] : null
        }
    }
}

fn condition_holds(c: map, run: map) {
    let v = condition_value(c.field ?? "", run)
    let want = str(c.value ?? "")
    let as_num = (x) => float(str(x)) ?? null
    match c.op ?? "equals" {
        "is set" => v != null && v != "" && v != [] && v != false
        "contains" => type_of(v) == "list" ? contains(v, slugify(want)) : contains(lower(str(v ?? "")), lower(want))
        "greater than" => as_num(v) != null && as_num(want) != null && as_num(v) > as_num(want)
        "less than" => as_num(v) != null && as_num(want) != null && as_num(v) < as_num(want)
        _ => lower(str(v ?? "")) == lower(want)
    }
}

fn step_email(config, run) {
    let c = run_contact(run)
    if c == null || c.email == "" { return { port: "out", log: "skipped: no email address" } }
    queue_mail(c.email, fill(config.subject ?? "", mail_values(c)), mail_html(config.body ?? "", c), "flow", c.id, null)
    note_activity("email", c.id, null, `Flow sent “${fill(config.subject ?? "", mail_values(c))}”`)
    { port: "out", log: `emailed ${c.email}` }
}

fn step_offer(config, run) {
    let c = run_contact(run)
    let p = shop_product(config.product ?? "")
    if c == null || c.email == "" { return { port: "out", log: "skipped: no email address" } }
    if p == null { return { error: `no product "${config.product}" for sale` } }
    let link = `${site_url()}/shop/${p.sku}?email=${c.email}`
    let currency = settings().currency ?? "USD"
    let body = `${config.body ?? ""}\n\n**${p.name}**, ${fmt_money(p.price_cents, currency)}\n\n[Buy now](${link})`
    queue_mail(c.email, fill(config.subject ?? "", mail_values(c)), mail_html(body, c), "flow", c.id, null)
    note_activity("email", c.id, null, `Offered ${p.name}`)
    { port: "out", log: `offered ${p.sku} to ${c.email}` }
}

fn step_wait(config, run) {
    let n = int(config.amount) ?? 1
    let unit = config.unit ?? "days"
    let ms = n * (unit == "minutes" ? 60000 : unit == "hours" ? 3600000 : DAY)
    { waiting_for: "time", until: now() + ms, resume: "out", log: `waiting ${n} ${unit}` }
}

fn step_wait_purchase(config, run) {
    let days = int(config.days) ?? 7
    let sku = lower(trim(config.product ?? ""))
    { waiting_for: "purchase", until: now() + days * DAY, resume: "no", sku, log: `waiting up to ${days} days for ${sku == "" ? "a purchase" : sku}` }
}

fn step_condition(config, run) {
    let yes = condition_holds(config, run)
    { port: yes ? "yes" : "no", log: `${config.field} ${config.op ?? "equals"} ${config.value ?? ""}: ${yes ? "yes" : "no"}` }
}

fn step_add_tag(config, run) {
    add_tags(run.context.contact_id, [config.tag ?? ""])
    { port: "out", log: `tagged ${slugify(config.tag ?? "")}` }
}

fn step_remove_tag(config, run) {
    remove_tags(run.context.contact_id, [config.tag ?? ""])
    { port: "out", log: `untagged ${slugify(config.tag ?? "")}` }
}

fn step_stage(config, run) {
    let id = run.context.contact_id
    if id != null && contains(STAGES, config.stage ?? "") {
        db.exec("update contacts set stage = ?, updated_at = ? where id = ?", config.stage, now(), id)
        note_activity("stage", id, null, `Flow set stage to ${config.stage}`)
    }
    { port: "out", log: `stage ${config.stage}` }
}

fn step_task(config, run) {
    let c = run_contact(run)
    let days = int(config.due_days) ?? 0
    let title = fill(config.title ?? "Follow up", mail_values(c))
    db.exec("insert into tasks (title, due, contact_id, created_at) values (?, ?, ?, ?)", title, iso_day(now() + days * DAY), run.context.contact_id, now())
    { port: "out", log: `task: ${title}` }
}

fn step_deal(config, run) {
    let c = run_contact(run)
    let stage = db.one("select s.id from stages s join pipelines p on p.id = s.pipeline_id where s.kind = 'open' order by p.position, p.id, s.position limit 1")
    if stage == null { return { error: "no pipeline to put the deal in" } }
    let title = fill(config.title ?? "New deal", mail_values(c))
    let t = now()
    let r = db.exec("insert into deals (title, value_cents, stage_id, contact_id, company_id, close_date, created_at, updated_at) values (?, ?, ?, ?, ?, '', ?, ?)",
        title, parse_money(config.value ?? "0") ?? 0, stage.id, run.context.contact_id, c == null ? null : c.company_id, t, t)
    note_activity("deal", run.context.contact_id, r.last_id, `Flow opened deal ${title}`)
    { port: "out", log: `deal: ${title}` }
}

fn step_webhook(config, run) {
    let c = contact_out(run_contact(run))
    let r = post_hook(trim(str(config.url ?? "")), { event: "flow.step", flow_run: run.id, context: run.context, contact: c })
    is_err(r) ? { port: "out", log: `webhook failed: ${r.error}` } : { port: "out", log: `webhook answered ${r.status}` }
}

// A post to an address someone in the workspace typed, checked each time it
// is sent: https only, to an address on the public internet (not this
// server, the network it is on, or a cloud's metadata service), and no
// redirects, which could lead there.
fn post_hook(url: str, body) {
    if !starts_with(url, "https://") { return err("the address must start with https://") }
    http.post(url, body, {}, { redirects: 0, public_only: true })
}

// ---- steps people take: a group's or a role's decision -------------------------------

// The people who answer for a group or a role.
fn people_for(gid, rid) = db.query("select id, email, name, role, role_id from users")
    | filter((u) => (gid != null && in_group(u, gid)) || (rid != null && any(roles_of(u), (r) => r.id == rid)))

fn step_ask(config, run) {
    let gid = blank(config.group) ? null : int(config.group) ?? null
    let rid = blank(config.role) ? null : int(config.role) ?? null
    if gid == null && rid == null { return { error: "Ask: choose a group or a role" } }
    let c = run.context
    let title = trim(config.title ?? "A decision")
    db.exec("insert into flow_tasks (run_id, title, details, group_id, role_id, object, record_id, contact_id, created_at) values (?, ?, ?, ?, ?, ?, ?, ?, ?)",
        run.id, title, config.details ?? "", gid, rid, c.object ?? "", c.record_id, c.contact_id, now())
    tell(people_for(gid, rid) | map((u) => u.id), null, `To decide: ${title}`, blank(config.details) ? title : config.details)
    let days = int(config.days) ?? 0
    let who = gid != null ? `group ${(db.one("select name from groups where id = ?", gid) ?? { name: "?" }).name}` : `role ${(db.one("select name from roles where id = ?", rid) ?? { name: "?" }).name}`
    { waiting_for: "task", until: days > 0 ? now() + days * DAY : null, resume: "rejected", log: `asked the ${who}: ${title}` }
}

fn step_move_record(config, run) {
    let c = run.context
    if c.record_id == null || blank(c.object) { return { error: "Move the record: this flow did not start from a record" } }
    let o = object_out(db.one("select * from objects where key = ?", c.object))
    let st = o == null ? null : find(o.states, (x) => x.key == config.to || lower(x.label) == lower(trim(config.to ?? "")))
    if st == null { return { error: `Move the record: ${o == null ? "no such object" : `no state “${config.to}”`}` } }
    rec_set(c.object, c.record_id, { state: st.key })
    { port: "out", log: `moved the record to ${st.label}` }
}

// A decision, by someone in the group or with the role: the flow goes on
// from it, by "approved" or "rejected".
server fn answer_flow_task(id: int, outcome: str, note: str) {
    let u = need_user()?
    let t = (db.one("select * from flow_tasks where id = ? and status = 'open'", id) ?? err("It was answered already"))?
    let mine = u.role != "member" || (t.group_id != null && in_group(u, t.group_id)) || (t.role_id != null && has_role(u, t.role_id))
    if !mine { return err("This is for another group or role") }
    if !contains(["approved", "rejected"], outcome) { return err("Approve or reject") }
    db.exec("update flow_tasks set status = 'done', outcome = ?, note = ?, done_by = ?, done_at = ? where id = ?", outcome, trim(note ?? ""), u.id, now(), id)
    let run = db.one("select status, waiting_for from flow_runs where id = ?", t.run_id)
    if run != null && run.status == "waiting" && run.waiting_for == "task" {
        advance(t.run_id, outcome)
        drain_runs()
    }
    true
}

// What waits for this person's decision.
server fn my_flow_tasks() {
    let u = need_user()?
    db.query("select t.*, f.name as flow from flow_tasks t join flow_runs r on r.id = t.run_id join flows f on f.id = r.flow_id where t.status = 'open' order by t.created_at")
        | filter((t) => u.role != "member" || (t.group_id != null && in_group(u, t.group_id)) || (t.role_id != null && has_role(u, t.role_id)))
        | map((t) => merge(t, {
            record: t.record_id == null || blank(t.object) ? null : { title: rec_title(t.object, t.record_id) },
            contact: t.contact_id == null ? null : db.one("select trim(first_name || ' ' || last_name) as name from contacts where id = ?", t.contact_id),
            to: t.group_id != null ? (db.one("select name from groups where id = ?", t.group_id) ?? {}).name : (db.one("select name from roles where id = ?", t.role_id) ?? {}).name,
        }))
}

let core_runners = {
    trigger: (config, run) => { port: "out" },
    send_email: step_email,
    send_offer: step_offer,
    wait: step_wait,
    wait_purchase: step_wait_purchase,
    condition: step_condition,
    add_tag: step_add_tag,
    remove_tag: step_remove_tag,
    set_stage: step_stage,
    create_task: step_task,
    ask: step_ask,
    move_record: step_move_record,
    create_deal: step_deal,
    webhook: step_webhook,
}

// ---- the flows' pages -----------------------------------------------------------------

server fn list_flows() {
    need_user()?
    db.query("select f.*, (select count(*) from flow_runs r where r.flow_id = f.id) as runs,
                     (select count(*) from flow_runs r where r.flow_id = f.id and r.status in ('running', 'waiting')) as active_runs
              from flows f order by f.updated_at desc") | map(flow_out)
}

server fn get_flow(id: int) {
    need_user()?
    let f = (flow_out(db.one("select * from flows where id = ?", id)) ?? err("No such flow"))?
    merge(f, {
        runs: db.query("select r.*, c.first_name, c.last_name, c.email from flow_runs r left join contacts c on c.id = json_extract(r.context, '$.contact_id')
                        where r.flow_id = ? order by r.id desc limit 30", id) | map(run_out),
    })
}

// Saving checks the graph with the same rules the designer hints from. An
// active flow must be free of errors; a draft may be saved as it is.
server fn save_flow(f: map) {
    need_designer()?
    if blank(f.name) { return err({ problems: problem("name", "Name the flow") }) }
    let ctx = rule_ctx()
    if f.active == true { refused("flow", f.graph, ctx)? }
    let t = now()
    let graph = json.stringify(f.graph)
    if f.id == null {
        let r = db.exec("insert into flows (name, graph, active, created_at, updated_at) values (?, ?, ?, ?, ?)", trim(f.name), graph, f.active == true ? 1 : 0, t, t)
        flow_out(db.one("select * from flows where id = ?", r.last_id))
    } else {
        db.exec("update flows set name = ?, graph = ?, active = ?, updated_at = ? where id = ?", trim(f.name), graph, f.active == true ? 1 : 0, t, f.id)
        flow_out(db.one("select * from flows where id = ?", f.id))
    }
}

server fn delete_flow(id: int) {
    need_admin()?
    db.exec("delete from flows where id = ?", id)
    true
}

// Starts a flow for one contact, whatever its trigger (trying a flow out).
server fn start_flow(id: int, contact_id: int) {
    need_designer()?
    let f = (flow_out(db.one("select * from flows where id = ?", id)) ?? err("No such flow"))?
    let trigger = (find(f.graph.nodes ?? [], (n) => n.type == "trigger") ?? err("The flow has no trigger"))?
    let run = (start_run(f, trigger, { contact_id }) ?? err("This contact is in this flow already"))?
    drain_runs()
    run_out(db.one("select * from flow_runs where id = ?", run))
}

server fn new_flow(template: str) {
    need_designer()?
    let t = with_product(flow_template(template))
    let r = db.exec("insert into flows (name, graph, active, created_at, updated_at) values (?, ?, 0, ?, ?)", t.name, json.stringify(t.graph), now(), now())
    r.last_id
}

// ---- templates ----------------------------------------------------------------------

fn node(id: str, type: str, x: int, y: int, config: map = {}) = { id, type, x, y, config }

// A template's offers name the workspace's first product.
fn with_product(t: map) {
    let p = db.one("select sku from products where active = 1 order by id limit 1")
    p == null ? t : set(t, "graph", set(t.graph, "nodes", t.graph.nodes | map((n) =>
        n.type == "send_offer" && blank((n.config ?? {}).product) ? put(n, "config.product", p.sku) : n)))
}
fn edge(from: str, to: str, port: str = "out") = { from, to, port }

fn flow_template(kind: str) = match kind {
    "purchase" => {
        name: "After a purchase",
        graph: {
            nodes: [
                node("t", "trigger", 40, 160, { event: "order_paid" }),
                node("a", "send_email", 340, 160, { subject: "Thank you, {{first_name}}!", body: "Your order is on its way. Reply to this email with any question." }),
                node("b", "add_tag", 640, 160, { tag: "customer" }),
                node("c", "condition", 940, 160, { field: "order.total", op: "greater than", value: "100" }),
                node("d", "create_task", 1240, 60, { title: "Send {{first_name}} a thank-you gift", due_days: "2" }),
                node("e", "wait", 1240, 260, { amount: "3", unit: "days" }),
                node("f", "send_email", 1540, 260, { subject: "How do you like it?", body: "We would love to hear what you think. A one-line reply is plenty." }),
            ],
            edges: [edge("t", "a"), edge("a", "b"), edge("b", "c"), edge("c", "d", "yes"), edge("c", "e", "no"), edge("e", "f")],
        },
    }
    "welcome" => {
        name: "Welcome a subscriber, then offer",
        graph: {
            nodes: [
                node("t", "trigger", 40, 160, { event: "form_submitted" }),
                node("a", "send_email", 340, 160, { subject: "Welcome, {{first_name}}", body: "Thanks for subscribing. Here is what to expect from us." }),
                node("b", "wait", 640, 160, { amount: "2", unit: "days" }),
                node("c", "send_offer", 940, 160, { subject: "Something for you", body: "As a subscriber, you get first pick." }),
                node("d", "wait_purchase", 1240, 160, { days: "5" }),
                node("e", "add_tag", 1540, 60, { tag: "buyer" }),
                node("f", "send_email", 1540, 260, { subject: "Still thinking it over?", body: "No rush. The offer is there when you want it." }),
            ],
            edges: [edge("t", "a"), edge("a", "b"), edge("b", "c"), edge("c", "d"), edge("d", "e", "yes"), edge("d", "f", "no")],
        },
    }
    "membership" => {
        name: "New member",
        graph: {
            nodes: [
                node("t", "trigger", 40, 160, { event: "order_paid" }),
                node("a", "paywall.grant", 340, 160, {}),
                node("b", "send_email", 640, 160, { subject: "Welcome aboard, {{first_name}}", body: "You are a member now: every story, every day. Thank you for supporting our work." }),
                node("c", "wait", 940, 160, { amount: "25", unit: "days" }),
                node("d", "send_email", 1240, 160, { subject: "Your membership renews soon", body: "Thanks for another month with us." }),
            ],
            edges: [edge("t", "a"), edge("a", "b"), edge("b", "c"), edge("c", "d")],
        },
    }
    "winback" => {
        name: "Win back a lapsed customer",
        graph: {
            nodes: [
                node("t", "trigger", 40, 160, { event: "tag_added", tag: "lapsed" }),
                node("a", "send_email", 340, 160, { subject: "We miss you, {{first_name}}", body: "It has been a while. Here is what is new." }),
                node("b", "wait_purchase", 640, 160, { days: "14" }),
                node("c", "remove_tag", 940, 60, { tag: "lapsed" }),
                node("d", "set_stage", 940, 260, { stage: "churned" }),
            ],
            edges: [edge("t", "a"), edge("a", "b"), edge("b", "c", "yes"), edge("b", "d", "no")],
        },
    }
    _ => { name: "New flow", graph: EMPTY_GRAPH }
}
