// Workspaces: signing one up (on the main site), what each kind starts with,
// and their settings, fields, pipelines and team.

let RESERVED = ["www", "app", "api", "admin", "mail", "help", "status", "static", "assets", "login", "signup"]

let INDUSTRIES = [
    { id: "merchant", label: "Merchant", about: "Shops and makers: products, orders, loyalty, after-purchase flows." },
    { id: "blogger", label: "Blogger / creator", about: "Subscribers, memberships, sponsorships, welcome series." },
    { id: "news", label: "News outlet", about: "Readers, digital subscriptions, advertisers, newsletters." },
]

// Rules for the signup form: the browser hints, the server decides.
let workspace_rules = [
    (w, ctx) => when(blank(w.name), problem("name", "Name your workspace")),
    (w, ctx) => {
        let s = w.slug ?? ""
        blank(s) ? problem("slug", "Choose an address")
        : slugify(s) != s ? problem("slug", "Lowercase letters, digits and dashes")
        : len(s) < 3 || len(s) > 30 ? problem("slug", "3 to 30 characters")
        : contains(RESERVED, s) ? problem("slug", "That address is reserved")
        : []
    },
    (w, ctx) => when(!any(INDUSTRIES, (i) => i.id == w.industry), problem("industry", "What kind of business is this?")),
    (w, ctx) => when(blank(w.owner_name), problem("owner_name", "Your name")),
    (w, ctx) => when(!is_email(w.email), problem("email", "Your email address")),
    (w, ctx) => {
        let p = w.password ?? ""
        len(p) < 10 ? problem("password", "At least 10 characters")
        : contains(["password12", "1234567890", "qwertyuiop"], lower(p)) ? problem("password", "Too easy to guess")
        : []
    },
]


fn check_workspace(w: map) = workspace_rules | map((r) => r(w, {})) | flatten

// ---- what each kind of workspace starts with --------------------------------------

fn preset(industry: str) = match industry {
    "merchant" => {
        plugins: ["loyalty", "vat", "gdpr", "quality"],
        theme: { id: "boutique", color: "#0f766e", font: "rounded" },
        pipeline: { name: "Wholesale", stages: [["Lead", 10, "open"], ["Qualified", 30, "open"], ["Proposal", 60, "open"], ["Won", 100, "won"], ["Lost", 0, "lost"]] },
        products: [
            { name: "Organic cotton tee", sku: "tee", price_cents: 2500, kind: "one_time", interval: "", stock: 40, description: "Soft, heavy, made to last." },
            { name: "Gift card", sku: "gift-card", price_cents: 5000, kind: "one_time", interval: "", stock: null, description: "Delivered by email." },
        ],
        forms: [{ slug: "newsletter", name: "Newsletter", headline: "New arrivals and offers, twice a month.", fields: ["email", "first_name"], tags: ["newsletter"] }],
        flows: ["purchase", "welcome"],
    }
    "blogger" => {
        plugins: ["blog", "paywall", "sponsors", "gdpr", "quality"],
        theme: { id: "journal", color: "#1d4ed8", font: "serif" },
        pipeline: { name: "Sponsorships", stages: [["Pitched", 10, "open"], ["Negotiating", 40, "open"], ["Booked", 100, "won"], ["Declined", 0, "lost"]] },
        products: [{ name: "Supporter membership", sku: "supporter", price_cents: 500, kind: "subscription", interval: "month", stock: null, description: "Members-only posts and my thanks." }],
        forms: [{ slug: "subscribe", name: "Subscribe", headline: "New posts in your inbox. No spam.", fields: ["email", "first_name"], tags: ["reader"] }],
        flows: ["welcome", "membership"],
    }
    _ => {
        plugins: ["newsroom", "blog", "paywall", "sponsors", "gdpr", "quality"],
        theme: { id: "editorial", color: "#b91c1c", font: "serif" },
        pipeline: { name: "Advertising", stages: [["Inquiry", 10, "open"], ["Proposal", 40, "open"], ["Insertion order", 80, "open"], ["Booked", 100, "won"], ["Lost", 0, "lost"]] },
        products: [
            { name: "Digital subscription", sku: "digital", price_cents: 900, kind: "subscription", interval: "month", stock: null, description: "Every story, every day." },
            { name: "Digital subscription, annual", sku: "digital-annual", price_cents: 9000, kind: "subscription", interval: "year", stock: null, description: "Two months free." },
        ],
        forms: [{ slug: "morning-briefing", name: "Morning briefing", headline: "The day's news in five minutes, at 7am.", fields: ["email"], tags: ["briefing"] }],
        flows: ["welcome", "membership"],
    }
}

// Fills a new workspace's database. Runs inside `with_tenant`.
fn setup_workspace(w: map, url: str) {
    let p = preset(w.industry)
    let t = now()
    let currency = w.currency ?? "USD"
    for [k, v] in { name: trim(w.name), slug: w.slug, industry: w.industry, currency, plugins: p.plugins, theme: p.theme, secret: crypto.token(), url, country: "US", vat_rate: "0" } =>
        put_setting(k, v)
    let owner = db.exec("insert into users (email, name, password_hash, role, created_at) values (?, ?, ?, 'owner', ?)",
        lower(trim(w.email)), trim(w.owner_name), crypto.hash_password(w.password), t).last_id
    let pipeline = db.exec("insert into pipelines (name, position) values (?, 0)", p.pipeline.name).last_id
    for [i, s] in enumerate(p.pipeline.stages) =>
        db.exec("insert into stages (pipeline_id, name, position, probability, kind) values (?, ?, ?, ?, ?)", pipeline, s[0], i, s[1], s[2])
    for pr in p.products =>
        db.exec("insert into products (name, sku, price_cents, kind, interval, description, stock, active, created_at) values (?, ?, ?, ?, ?, ?, ?, 1, ?)",
            pr.name, pr.sku, pr.price_cents, pr.kind, pr.interval, pr.description, pr.stock, t)
    for f in p.forms =>
        db.exec("insert into forms (slug, name, headline, fields, tags, created_at) values (?, ?, ?, ?, ?, ?)",
            f.slug, f.name, f.headline, json.stringify(f.fields), json.stringify(f.tags), t)
    for kind in p.flows => {
        let tpl = with_product(flow_template(kind))
        db.exec("insert into flows (name, graph, active, created_at, updated_at) values (?, ?, 1, ?, ?)", tpl.name, json.stringify(tpl.graph), t, t)
    }
    install_models(p.plugins)
    audit("workspace.create", { slug: w.slug, owner: lower(trim(w.email)) })
    sign_in_token(owner)
}

fn sign_in_token(user_id: int) {
    let token = crypto.token()
    db.exec("insert into sign_in_tokens (token, user_id, expires_at) values (?, ?, ?)", token, user_id, now() + 10 * 60000)
    token
}

// On the main site: is this address free?
server fn slug_free(slug: str) = slugify(slug) == slug && !contains(RESERVED, slug) && !db.tenant_exists(slug)

// Each workspace is a database file of its own, so signing up is limited:
// a few an hour from one address, and so many an hour in all
// (CRM_SIGNUPS_PER_HOUR, 100 by default). Checked once the form is
// right, so mistakes cost nothing; counted only when one is made.
let SIGNUPS_PER_IP = 5
let SIGNUPS_PER_HOUR = int(env("CRM_SIGNUPS_PER_HOUR", "100")) ?? 100

server fn create_workspace(form: map) {
    // With one workspace, it has no address of its own to choose, and can
    // be set up once.
    let w = SINGLE ? set(form, "slug", ONLY) : form
    let problems = errors_of(check_workspace(w))
    if len(problems) > 0 { return err({ problems }) }
    let mine = `signup:${request.ip}`
    if !rate_limit(mine, SIGNUPS_PER_IP, "1h", { cost: 0 }) || !rate_limit("signup:all", SIGNUPS_PER_HOUR, "1h", { cost: 0 }) {
        return err({ problems: problem("", "Too many workspaces were made just now: try again in an hour") })
    }
    if db.tenant_exists(w.slug) {
        return err({ problems: SINGLE ? problem("", "This CRM is set up already: sign in") : problem("slug", "That address is taken") })
    }
    let host = request.headers.host ?? DOMAIN
    let url = SINGLE ? `${SCHEME}://${host}` : workspace_url(w.slug, host)
    rate_limit(mine, SIGNUPS_PER_IP, "1h")
    rate_limit("signup:all", SIGNUPS_PER_HOUR, "1h")
    let token = with_tenant(w.slug, () => setup_workspace(w, url))
    { url: `${url}/welcome/${token}` }
}

// ---- settings, fields, pipelines and the team ---------------------------------------

// Everything the app's pages need about the workspace, once, when it loads.
server fn load_workspace() {
    let u = need_user()?
    let s = settings()
    let objects = readable_objects(u) | map((o) => remove(o, "site"))
    {
        user: u,
        name: s.name ?? "",
        slug: s.slug ?? "",
        industry: s.industry ?? "merchant",
        currency: s.currency ?? "USD",
        enabled: enabled_plugins(),
        developer: is_developer(u.email),
        try_drafts: s.try_drafts == true,
        // Objects' fields come with each object (get_object): a hundred objects
        // would be thousands of fields on every page.
        fields: custom_fields() | filter((f) => !starts_with(f.entity, "obj.")),
        settings: remove(remove(s, "secret"), "mail_webhook"),
        mail_live: (s.mail_webhook ?? "") != "",
        today: iso_day(now()),
        pipelines: db.query("select * from pipelines order by position, id"),
        stages: db.query("select * from stages order by pipeline_id, position"),
        users: db.query("select id, name, email, role, role_id from users order by name"),
        forms: db.query("select slug, name from forms order by name"),
        skus: db.query("select sku, name from products where active = 1 order by name"),
        objects: objects,
        roles: db.query("select id, name from roles order by name"),
        groups: db.query("select id, name, members, capabilities from groups order by name") | map((g) => merge(g, { members: parsed(g.members, []), capabilities: parsed(g.capabilities, []) })),
        designer: can_be(u, "designer"),
        notice_styles: notices_for(enabled_plugins()) | map((n) => remove(n, "css")),
        notice: notice_style().id,
    }
}

// The sidebar's objects and pages: the pinned ones, then what this person
// opened last, eight of each at most. Live: it follows what they open.
server fn sidebar_nav() {
    let u = need_user()?
    sidebar_lists(u, readable_objects(u))
}

fn sidebar_lists(u, objects: list) {
    let seen = recent_refs(u, "object")
    let pinned = objects | filter((o) => o.pinned == 1)
    let recent = objects | filter((o) => o.pinned != 1 && seen[o.key] != null) | sort_by((o) => -seen[o.key])
    let pages = db.query("select id, title, kind, pinned from pages")
    let pseen = recent_refs(u, "page")
    let ppinned = pages | filter((p) => p.pinned == 1)
    let precent = pages | filter((p) => p.pinned != 1 && pseen[str(p.id)] != null) | sort_by((p) => -pseen[str(p.id)])
    {
        objects: (pinned + recent) | take(8) | map((o) => { href: `/app/o/${o.key}`, label: o.plural, icon: o.icon, pinned: o.pinned == 1 }),
        pages: (ppinned + precent) | take(8) | map((p) => { href: `/app/pages/${p.id}`, label: blank(p.title) ? "Untitled" : p.title, icon: p.kind == "section" ? "▭" : "▤", pinned: p.pinned == 1 }),
        object_count: len(objects),
        page_count: len(pages),
    }
}

server fn save_profile(name: str, bio: str) {
    let u = need_user()?
    if blank(name) { return err({ problems: problem("name", "Your name, please") }) }
    if len(bio) > 400 { return err({ problems: problem("bio", "At most 400 characters") }) }
    db.exec("update users set name = ?, bio = ? where id = ?", trim(name), trim(bio), u.id)
    true
}

server fn save_settings(s: map) {
    need_admin()?
    let rate = float(str(s.vat_rate ?? "0"))
    if is_err(rate) || rate < 0 || rate > 50 { return err({ problems: problem("vat_rate", "A rate from 0 to 50 (percent)") }) }
    if blank(s.name) { return err({ problems: problem("name", "The workspace needs a name") }) }
    if !blank(s.mail_webhook) && !starts_with(s.mail_webhook, "https://") { return err({ problems: problem("mail_webhook", "An https:// address") }) }
    let names = ["name", "currency", "country", "vat_rate", "mail_webhook"]
    let before = settings()
    let changed = names | filter((k) => s[k] != null && str(before[k] ?? "") != trim(str(s[k])))
    audited("settings.change", { changed }, () => {
        for k in names => s[k] != null && put_setting(k, trim(str(s[k])))
        true
    })
}

server fn mail_webhook_of() {
    need_admin()?
    settings().mail_webhook ?? ""
}

// What switching a plugin off takes away here: the pages with its blocks,
// the flows with its steps, the theme if it is the site's.
server fn plugin_uses(id: str) {
    need_user()?
    let p = (find(plugins, (x) => x.id == id) ?? err("No such plugin"))?
    let blocks = (p.blocks ?? []) | map((b) => b.type)
    let steps = (p.steps ?? []) | map((s) => s.type)
    let themes = (p.themes ?? []) | map((t) => t.id)
    let page_uses = (r) => any(flat_blocks(parsed(r.draft, {}).blocks), (b) => contains(blocks, b.type)) || any(flat_blocks(parsed(r.published, {}).blocks), (b) => contains(blocks, b.type))
    {
        pages: db.query("select title, kind, draft, published from pages") | filter(page_uses) | map((r) => r.title),
        flows: db.query("select name, graph, active from flows") | filter((f) => any(parsed(f.graph, {}).nodes ?? [], (n) => contains(steps, n.type))) | map((f) => f.name),
        theme: contains(themes, theme_of(settings()).id),
    }
}

server fn set_plugins(enabled: list) {
    need_admin()?
    let known = plugins | map((p) => p.id)
    let before = enabled_plugins()
    let now_on = enabled | filter((id) => id != "core" && contains(known, id)) | unique
    let on = now_on | filter((id) => !contains(before, id))
    let off = before | filter((id) => !contains(now_on, id))
    audited("plugins.change", { on, off }, () => put_setting("plugins", now_on))?
    // A plugin switched on brings its model (what the workspace lacks).
    install_models(now_on | filter((id) => !contains(before, id)))
    true
}

server fn save_field(f: map) {
    let u = need_user()?
    // An object's fields are its designers' to change; the others, admins'.
    if !(starts_with(f.entity ?? "", "obj.") ? can_be(u, "designer") : u.role != "member") { return err("Only admins and designers may change this") }
    let key = replace(slugify(blank(f.key) ? f.label : f.key), "-", "_")
    if blank(f.label) { return err({ problems: problem("label", "A label") }) }
    let object = starts_with(f.entity ?? "", "obj.") ? db.one("select key from objects where key = ?", slice(f.entity, 4)) : null
    if !contains(["contact", "company", "deal"], f.entity) && object == null { return err({ problems: problem("entity", "Contacts, companies, deals or one of your objects") }) }
    // Links to contacts, companies and records are for objects' fields.
    let types = object != null ? FIELD_TYPES : ["text", "number", "date", "select", "checkbox", "url", "email", "money", "textarea"]
    if !contains(types, f.type) { return err({ problems: problem("type", "Choose a type") }) }
    if f.type == "record" && db.one("select key from objects where key = ?", (f.options ?? [])[0] ?? "") == null { return err({ problems: problem("options", "Choose which object it links to") }) }
    if contains(["select"], f.type) && len((f.options ?? []) | filter((o) => trim(str(o)) != "")) == 0 { return err({ problems: problem("options", "Give the choices") }) }
    if f.type == "lookup" {
        let via = find(object_fields(slice(f.entity, 4)), (x) => x.key == (f.options ?? [])[0] && contains(LINK_TYPES, x.type))
        if via == null { return err({ problems: problem("options", "Choose the link it shows a field of") }) }
        if !any(lookup_targets(via, custom_fields() | map((x) => merge(x, { options: type_of(x.options) == "list" ? x.options : parsed(x.options, []) }))), (t) => t[0] == (f.options ?? [])[1]) {
            return err({ problems: problem("options", "Choose which of its fields") })
        }
    }
    let options = json.stringify((f.options ?? []) | map((o) => trim(str(o))) | filter((o) => o != ""))
    let unique = f.is_unique == true || f.is_unique == 1 ? 1 : 0
    let id = if f.id == null {
        let other = db.one("select id from custom_fields where entity = ? and key = ?", f.entity, key)
        if other != null { return err({ problems: problem("label", "There is a field with this name") }) }
        if key == "" { return err({ problems: problem("label", "A label with letters in it") }) }
        db.exec("insert into custom_fields (entity, key, label, type, required, options, is_unique, position) values (?, ?, ?, ?, ?, ?, ?, (select coalesce(max(position), 0) + 1 from custom_fields))",
            f.entity, key, trim(f.label), f.type, f.required == true ? 1 : 0, options, unique).last_id
    } else {
        // An object's field keeps its type: its column was made for it.
        let was = db.one("select type, entity from custom_fields where id = ?", f.id)
        if was != null && starts_with(was.entity, "obj.") && was.type != f.type { return err({ problems: problem("type", "A field's type stays as it was made: add a new field instead") }) }
        db.exec("update custom_fields set label = ?, type = ?, required = ?, options = ?, is_unique = ? where id = ?", trim(f.label), f.type, f.required == true ? 1 : 0, options, unique, f.id)
        f.id
    }
    // An object's table follows its fields: a column for it, an index if unique.
    if object != null {
        let synced = sync_table(object.key)
        if is_err(synced) {
            db.exec("update custom_fields set is_unique = 0 where id = ?", id)
            sync_table(object.key)
            return err({ problems: problem("is_unique", str(synced.error)) })
        }
    }
    true
}

server fn delete_field(id: int) {
    need_designer()?
    let f = db.one("select entity, key, label from custom_fields where id = ?", id)
    if f == null { return true }
    // A link to an object's records stays while another field shows through it.
    if starts_with(f.entity, "obj.") {
        let through = db.query("select label, options from custom_fields where entity = ? and type = 'lookup'", f.entity) | filter((x) => (parsed(x.options, [])[0] ?? "") == f.key)
        if len(through) > 0 { return err(`${through[0].label} shows a field through ${f.label}: remove it first`) }
    }
    audited("field.delete", { id, entity: f.entity, key: f.key }, () => db.exec("delete from custom_fields where id = ?", id))?
    if starts_with(f.entity, "obj.") { sync_table(slice(f.entity, 4)) }
    true
}

server fn save_stage(s: map) {
    need_admin()?
    if blank(s.name) { return err({ problems: problem("name", "Name the stage") }) }
    if s.id == null {
        db.exec("insert into stages (pipeline_id, name, position, probability, kind) values (?, ?, (select coalesce(max(position), 0) + 1 from stages where pipeline_id = ?), ?, ?)",
            s.pipeline_id, trim(s.name), s.pipeline_id, s.probability ?? 0, s.kind ?? "open")
    } else {
        db.exec("update stages set name = ?, probability = ?, kind = ? where id = ?", trim(s.name), s.probability ?? 0, s.kind ?? "open", s.id)
    }
    true
}

server fn add_pipeline(name: str) {
    need_admin()?
    if blank(name) { return err("Name the pipeline") }
    let id = db.exec("insert into pipelines (name, position) values (?, (select coalesce(max(position), 0) + 1 from pipelines))", trim(name)).last_id
    for [i, s] in enumerate([["New", 10, "open"], ["Won", 100, "won"], ["Lost", 0, "lost"]]) =>
        db.exec("insert into stages (pipeline_id, name, position, probability, kind) values (?, ?, ?, ?, ?)", id, s[0], i, s[1], s[2])
    id
}

server fn add_user(u: map) {
    need_admin()?
    if blank(u.name) { return err({ problems: problem("name", "Their name") }) }
    if !is_email(u.email) { return err({ problems: problem("email", "Their email address") }) }
    if len(u.password ?? "") < 10 { return err({ problems: problem("password", "At least 10 characters") }) }
    if db.one("select id from users where email = ?", lower(trim(u.email))) != null { return err({ problems: problem("email", "Already on the team") }) }
    let role = u.role == "admin" ? "admin" : "member"
    let hash = crypto.hash_password(u.password)
    audited("user.add", (r) => { id: r.last_id, email: lower(trim(u.email)), role }, () =>
        db.exec("insert into users (email, name, password_hash, role, created_at) values (?, ?, ?, ?, ?)", lower(trim(u.email)), trim(u.name), hash, role, now()))?
    true
}
