// Signing in safely: wrong passwords lock an account for a while, a second
// step (an authenticator app's code, or a recovery code) for those who set
// one up (or everyone, when the workspace asks), and the sessions each
// person has open, which they or an admin can end. Each of these is in the
// audit log (lib/audit.qwe); a row written before someone is signed in
// names them in its details.

let ISSUER = "Relay"
// Five wrong passwords or codes in fifteen minutes lock the account for
// the rest of them; thirty tries a minute from one address.
let TRIES = 5
let TRIES_PER = "15m"
// Between the password and the code: five minutes.
let SECOND_STEP_MS = 300000

fn login_locked(email: str) = !rate_limit(`login-fail:${email}`, TRIES, TRIES_PER, { cost: 0 })
fn login_failed(email: str) = rate_limit(`login-fail:${email}`, TRIES, TRIES_PER)
fn login_ok(email: str) = rate_limit_reset(`login-fail:${email}`)

fn two_step_required() = settings().require_two_step == true
fn has_two_step(u) = u != null && (u.totp_secret ?? "") != ""

// Who passed the password and owes the second step: the session holds
// them, without signing them in.
fn pending_user() {
    let s = session()
    if s.pending == null || now() - (s.pending_at ?? 0) > SECOND_STEP_MS { return null }
    db.one("select * from users where id = ?", s.pending)
}

// After a first step (the password, or a link from signing up): where to
// go for the second, with `u` pending in the session and how they began
// (`method`, for the audit log); null when there is none to take.
fn second_step_next(u, method: str) {
    if !has_two_step(u) && !two_step_required() { return null }
    set_session({ pending: u.id, pending_at: now(), pending_method: method })
    redirect(has_two_step(u) ? "/login/code" : "/login/setup")
}

// A code from the app (six digits, each once) or a recovery code (each
// once): which it was ("app" or "recovery_code"), or null for neither. A
// recovery code used is in the audit log with how many are left.
fn second_step(u, code: str) {
    let typed = trim(code)
    let digits = replace(typed, " ", "")
    if len(digits) == 6 && int(digits) != null {
        let step = crypto.totp_verify(u.totp_secret, digits, { after: u.totp_step })
        if step == null { return null }
        db.exec("update users set totp_step = ? where id = ?", step, u.id)
        return "app"
    }
    let hashes = parsed(u.recovery_hashes, [])
    let i = crypto.verify_recovery_code(typed, hashes)
    if i == null { return null }
    let left = take(hashes, i) + drop(hashes, i + 1)
    let used = audited("two_step.recovery_code", { user: u.id, left: len(left) }, () =>
        db.exec("update users set recovery_hashes = ? where id = ?", json.stringify(left), u.id))
    is_err(used) ? null : "recovery_code"
}

// A new secret for the app, kept in the session until a code confirms it.
fn new_two_step(u) {
    let secret = crypto.totp_secret()
    set_session(merge(session(), { new_secret: secret }))
    { secret: spaced(secret), uri: crypto.totp_uri(secret, u.email, settings().name ?? ISSUER) }
}

// The secret in groups of four, to type in.
fn spaced(s: str) = range(0, floor((len(s) + 3) / 4)) | map((i) => slice(s, i * 4, i * 4 + 4)) | join(" ")

// Confirms the new secret with a code from the app; the recovery codes, to
// show once.
fn confirm_two_step(u, code: str) {
    let secret = session().new_secret ?? ""
    if secret == "" { return err({ problems: problem("code", "Start again: set up two-step sign-in") }) }
    let step = crypto.totp_verify(secret, replace(trim(code), " ", ""))
    if step == null { return err({ problems: problem("code", "That code does not match; check the app's clock and try the next one") }) }
    let codes = crypto.recovery_codes(10)
    audited("two_step.on", { user: u.id }, () => db.exec("update users set totp_secret = ?, totp_step = ?, recovery_hashes = ? where id = ?",
        secret, step, json.stringify(codes | map((c) => c.hash)), u.id))?
    set_session(remove(session(), "new_secret"))
    codes | map((c) => c.code)
}

// ---- in the app (Settings, Security) ----------------------------------------------------

server fn security_status() {
    let u = need_user()?
    let me = db.one("select totp_secret, recovery_hashes from users where id = ?", u.id)
    let admin = u.role != "member"
    {
        two_step: has_two_step(me),
        recovery_left: len(parsed(me.recovery_hashes, [])),
        required: two_step_required(),
        admin: admin,
        team: admin ? db.query("select id, name, email, totp_secret != '' as two_step from users order by name") : [],
    }
}

server fn begin_two_step() {
    let u = need_user()?
    new_two_step(u)
}

server fn finish_two_step(code: str) {
    let u = need_user()?
    confirm_two_step(u, code)
}

// New recovery codes (the old ones stop working), with the password.
server fn renew_recovery_codes(password: str) {
    let u = need_user()?
    let me = db.one("select * from users where id = ?", u.id)
    if !has_two_step(me) { return err("Set up two-step sign-in first") }
    if !crypto.verify_password(password, me.password_hash) { return err({ problems: problem("password", "That is not your password") }) }
    let codes = crypto.recovery_codes(10)
    audited("two_step.recovery_codes", { user: u.id }, () => db.exec("update users set recovery_hashes = ? where id = ?", json.stringify(codes | map((c) => c.hash)), u.id))?
    codes | map((c) => c.code)
}

server fn turn_off_two_step(password: str) {
    let u = need_user()?
    let me = db.one("select * from users where id = ?", u.id)
    if two_step_required() { return err("This workspace requires two-step sign-in") }
    if !crypto.verify_password(password, me.password_hash) { return err({ problems: problem("password", "That is not your password") }) }
    audited("two_step.off", { user: u.id }, () => db.exec("update users set totp_secret = '', totp_step = 0, recovery_hashes = '[]' where id = ?", u.id))?
    true
}

// A new password ends every other session of yours. (Sessions are kept
// apart from the workspace's transactions: they are ended after it.)
server fn change_password(current: str, next: str) {
    let u = need_user()?
    let me = db.one("select * from users where id = ?", u.id)
    if !crypto.verify_password(current, me.password_hash) { return err({ problems: problem("current", "That is not your password") }) }
    if len(next) < 10 { return err({ problems: problem("next", "At least 10 characters") }) }
    let hash = crypto.hash_password(next)
    audited("password.change", { user: u.id }, () => db.exec("update users set password_hash = ? where id = ?", hash, u.id))?
    end_sessions(u.id, { keep_current: true })
}

// Where you are signed in: this browser first.
server fn my_sessions() {
    let u = need_user()?
    user_sessions(u.id)? | map((s) => { id: s.id, current: s.current, seen: s.seen * 1000, created: s.created * 1000, ip: s.ip, device: device_name(s.agent) })
}

server fn end_my_session(id: str) {
    let u = need_user()?
    end_sessions(u.id, { id })
}

server fn end_my_other_sessions() {
    let u = need_user()?
    end_sessions(u.id, { keep_current: true })
}

// An admin signs someone out everywhere (a lost laptop, someone leaving).
server fn sign_out_everywhere(user_id: int) {
    need_admin()?
    let ended = end_sessions(user_id)
    audit("sessions.end_all", { user: user_id, ended })
    ended
}

server fn set_two_step_required(on: bool) {
    let u = need_admin()?
    if on && !has_two_step(db.one("select totp_secret from users where id = ?", u.id)) {
        return err("Set up two-step sign-in for yourself first")
    }
    audited("settings.two_step_required", { on }, () => put_setting("require_two_step", on))?
    true
}

// "Chrome on macOS", from a browser's User-Agent.
fn device_name(agent: str) {
    let a = lower(agent ?? "")
    let browser = contains(a, "edg/") ? "Edge" : contains(a, "firefox/") ? "Firefox" : contains(a, "chrome/") ? "Chrome" : contains(a, "safari/") ? "Safari" : "A browser"
    let os = contains(a, "iphone") || contains(a, "ipad") ? "iOS" : contains(a, "android") ? "Android" : contains(a, "mac os") ? "macOS" : contains(a, "windows") ? "Windows" : contains(a, "linux") ? "Linux" : ""
    os == "" ? browser : `${browser} on ${os}`
}
