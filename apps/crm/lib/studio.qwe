// The plugin studio: developers write a plugin in the app, try it in their
// workspace's pages and flows, and release it for every workspace.
//
// A plugin's code lives in plugins/studio/<id>.qwe once released, and its
// next version in <id>.draft.qwe. index.qwe (written here) loads them and
// lists them. Every top-level name in a plugin starts with its id
// (`birthday_plugin`, `birthday_renderers`, `fn birthday_wish`, views
// `BirthdayCard`), so plugins never clash; a draft's names are made
// distinct from its release's here (`birthday__d_...`), so both run side by
// side: the release where workspaces switched it on, the draft where a
// developer tries drafts.
//
// Plugin code runs on the server with the program's full power, so only the
// installation's developers (CRM_DEVELOPERS, their emails) may write it.
// The program must run with --watch or --reload to take up what is saved.

let DEVELOPERS = split(env("CRM_DEVELOPERS", ""), ",") | map((e) => lower(trim(e))) | filter((e) => e != "")
let STUDIO = "plugins/studio"

fn is_developer(email) = contains(DEVELOPERS, lower(str(email ?? "")))

fn need_developer() {
    let u = need_user()?
    is_developer(u.email) ? u : err("Only the installation's developers can use the studio (CRM_DEVELOPERS)")
}

fn studio_registry() = parsed(read_file(`${STUDIO}/registry.json`) ?? "", { plugins: [] })

fn studio_entry(id: str) = find(studio_registry().plugins, (p) => p.id == id)

fn put_registry(r: map) = write_file(`${STUDIO}/registry.json`, json.stringify(r, true))

fn pascal(id: str) = `${upper(slice(id, 0, 1))}${slice(id, 1)}`

let IDENT = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

// `from` replaced by `to` where it starts a name (not inside another one).
fn rename_prefix(src: str, from: str, to: str) {
    let parts = split(src, from)
    parts | enumerate | map((ip) => {
        if ip[0] == 0 { return ip[1] }
        let before = parts[ip[0] - 1]
        let last = before == "" ? "" : slice(before, len(before) - 1)
        let starts_name = before == "" || !contains(IDENT, last)
        `${starts_name ? to : from}${ip[1]}`
    }) | join("")
}

fn draft_source(id: str, src: str) = rename_prefix(rename_prefix(src, `${id}_`, `${id}__d_`), pascal(id), `${pascal(id)}D_`)

// Names a plugin defines that do not start with its id; and what it lacks.
fn naming_problems(id: str, src: str) {
    let lines = split(src, "\n")
    let decl = (l) => match split(trim(l), " ") | filter((w) => w != "") {
        ["let", name, ..rest] => name
        ["fn", name, ..rest] => split(name, "(")[0]
        ["server", "fn", name, ..rest] => split(name, "(")[0]
        ["view", name, ..rest] => split(name, "(")[0]
        ["component", name, ..rest] => split(name, "(")[0]
        _ => null
    }
    let names = lines | filter((l) => !starts_with(l, " ") && !starts_with(l, "\t")) | map(decl) | filter((n) => n != null)
    let wrong = names | filter((n) => !starts_with(n, `${id}_`) && !starts_with(n, pascal(id)))
        | map((n) => { line: 0, message: `"${n}" must start with ${id}_ (or ${pascal(id)} for views), so it cannot clash with other plugins` })
    let needed = [`${id}_plugin`, `${id}_renderers`, `${id}_runners`] | filter((n) => !contains(names, n))
        | map((n) => { line: 0, message: `The plugin must define ${n} (an empty map is fine for renderers and runners)` })
    wrong + needed
}

// index.qwe: what the program loads of the studio's plugins.
// `built`: when it was written, so the studio can tell when the program
// has loaded it (studio_built_at).
fn write_index(entries: list) {
    let t = now()
    write_file(`${STUDIO}/index.qwe`, index_text(entries, t))
    t
}

fn index_text(entries: list, built: int = 0) {
    let uses = entries | map((e) => (e.released != null ? [`use "${STUDIO}/${e.id}.qwe"`] : []) + (e.draft ? [`use "${STUDIO}/${e.id}.draft.qwe"`] : [])) | flatten
    let listed = entries | map((e) =>
        (e.released != null ? [`set(set(${e.id}_plugin, "status", "released"), "version", ${e.released})`] : [])
        + (e.draft ? [`set(set(${e.id}__d_plugin, "status", "draft"), "version", ${(e.released ?? 0) + 1})`] : [])) | flatten
    let keyed = (suffix) => entries | map((e) =>
        (e.released != null ? [`"${e.id}": ${e.id}_${suffix}`] : []) + (e.draft ? [`"${e.id}#draft": ${e.id}__d_${suffix}`] : [])) | flatten
    let text = join([
        "// Written by the plugin studio (Studio, in the app): the plugins made there.",
        "// Do not edit it by hand.",
        "",
    ] + uses + [
        "",
        `let studio_plugins = [${join(listed, ", ")}]`,
        `let studio_renderers = { ${join(keyed("renderers"), ", ")} }`,
        `let studio_runners = { ${join(keyed("runners"), ", ")} }`,
        `let studio_built = ${built}`,
        "",
    ], "\n")
    text
}

// The program's checks as it would be with these files' text (nothing is
// written until they pass): errors in this plugin's file by line, others
// with where they are.
fn check_with(id: str, files: map) {
    let found = check_program("main.qwe", files) ?? []
    let mine = (f) => contains(f, `${id}.draft.qwe`) || ends_with(f, `${id}.qwe`)
    found | filter((d) => d.severity == "error")
        | map((d) => { line: mine(d.file) ? d.line : 0, message: mine(d.file) ? d.message : `${d.file}:${d.line}: ${d.message}` })
}

// A new plugin's code: a block, a rule and a renderer to start from.
fn plugin_template(id: str, name: str) =
    (read_file(`${STUDIO}/template.txt`) ?? "")
        | replace("__ID__", id)
        | replace("__PASCAL__", pascal(id))
        | replace("__NAME__", name)

// ---- the studio's server functions ---------------------------------------------------

server fn studio_list() {
    need_developer()?
    studio_registry().plugins
}

server fn studio_get(id: str) {
    need_developer()?
    let e = (studio_entry(id) ?? err("No such plugin"))?
    let draft = read_file(`${STUDIO}/${id}.source.qwe`)
    let released = read_file(`${STUDIO}/${id}.qwe`)
    merge(e, { source: !is_err(draft) ? draft : !is_err(released) ? released : "" })
}

server fn studio_create(id: str, name: str) {
    need_developer()?
    let ok = len(id) >= 2 && len(id) <= 20 && all(split(id, ""), (ch) => contains("abcdefghijklmnopqrstuvwxyz0123456789", ch)) && !contains("0123456789", slice(id, 0, 1))
    if !ok { return err({ problems: problem("id", "2 to 20 lowercase letters and digits, starting with a letter") }) }
    if blank(name) { return err({ problems: problem("name", "Name the plugin") }) }
    if any(plugins, (p) => p.id == id) || studio_entry(id) != null { return err({ problems: problem("id", "There is a plugin with this id") }) }
    let src = plugin_template(id, trim(name))
    let r = studio_registry()
    put_registry(set(r, "plugins", r.plugins + [{ id, name: trim(name), released: null, draft: false, updated_at: now() }]))
    write_file(`${STUDIO}/${id}.source.qwe`, src)
    id
}

// The problems the code has, as saving would find them, with nothing
// written: what the editor shows while you type.
server fn studio_check(id: str, src: str) {
    need_developer()?
    (studio_entry(id) ?? err("No such plugin"))?
    let naming = naming_problems(id, src)
    if len(naming) > 0 { return naming }
    let entries = studio_registry().plugins | map((x) => x.id == id ? set(x, "draft", true) : x)
    check_with(id, {} | set(`${STUDIO}/${id}.draft.qwe`, draft_source(id, src)) | set(`${STUDIO}/index.qwe`, index_text(entries)))
}

// When the program last loaded the studio's plugins.
server fn studio_built_at() {
    need_developer()?
    studio_built
}

// The plugin's blocks (its draft's, else its release's) with sample
// settings, as visitors would see them: the studio's live preview.
fn studio_preview(id: str) {
    let p = find(plugins, (x) => x.id == id && x.status == "draft") ?? find(plugins, (x) => x.id == id)
    if p == null { return <SiteLayout title="Preview" description=""><p.pb-missing>Save the plugin to see it here.</p></SiteLayout> }
    let renderers = block_renderers[plugin_key(p)] ?? {}
    let ctx = render_ctx(true)
    <SiteLayout title={`${p.name} (preview)`} description="">
        {len(p.blocks ?? []) == 0 && <p.pb-missing>{p.name} has no page blocks: its rules and steps show in the forms and the flow designer.</p>}
        {for t in p.blocks ?? [] => <section.studio-sample>
            <p.studio-sample-label>{t.label} · {t.type}{p.status == "draft" && ` · draft v${p.version}`}</p>
            {renderers[t.type] == null ? <p.pb-missing>No renderer for {t.type} in {id}_renderers.</p> : renderers[t.type](sample_config(t, ctx), ctx)}
        </section>}
    </SiteLayout>
}

// Settings to show a block with: each field's `example`, or one of its kind.
fn sample_config(t: map, ctx: map) = (t.fields ?? []) | reduce({}, (m, f) => set(m, f.key, f.example ?? match f.type {
    "textarea" => `Some ${lower(f.label)}, written here.`
    "select" => (f.options ?? [""])[0]
    "url" => "https://example.com"
    "link" => "/"
    "image" => null
    "product" => (ctx.products[0] ?? {}).sku
    "form" => (db.one("select slug from forms limit 1") ?? {}).slug
    _ => f.label
}))

// Saves the code as the plugin's draft: checked first (names, then the
// whole program with it), and kept only if the program still loads.
server fn studio_save(id: str, src: str) {
    let u = need_developer()?
    let e = (studio_entry(id) ?? err("No such plugin"))?
    let naming = naming_problems(id, src)
    if len(naming) > 0 { return err({ problems: naming }) }
    write_file(`${STUDIO}/${id}.source.qwe`, src)
    let r = studio_registry()
    let entries = r.plugins | map((x) => x.id == id ? set(x, "draft", true) : x)
    let draft = draft_source(id, src)
    let found = check_with(id, {} | set(`${STUDIO}/${id}.draft.qwe`, draft) | set(`${STUDIO}/index.qwe`, index_text(entries)))
    if len(found) > 0 { return err({ problems: found }) }
    write_file(`${STUDIO}/${id}.draft.qwe`, draft)
    let written = write_index(entries)
    put_registry(set(r, "plugins", r.plugins | map((x) => x.id == id ? merge(x, { draft: true, updated_at: now(), by: u.email }) : x)))
    { saved: true, version: (e.released ?? 0) + 1, written }
}

// The draft becomes the release, for every workspace.
server fn studio_release(id: str) {
    let u = need_developer()?
    let e = (studio_entry(id) ?? err("No such plugin"))?
    if !e.draft { return err("Save a draft first") }
    let src = (read_file(`${STUDIO}/${id}.source.qwe`) ?? err("The draft's code is missing"))?
    let version = (e.released ?? 0) + 1
    let r = studio_registry()
    let entries = r.plugins | map((x) => x.id == id ? merge(x, { released: version, draft: false }) : x)
    let found = check_with(id, {} | set(`${STUDIO}/${id}.qwe`, src) | set(`${STUDIO}/index.qwe`, index_text(entries)))
    if len(found) > 0 { return err({ problems: found }) }
    write_file(`${STUDIO}/${id}.qwe`, src)
    let written = write_index(entries)
    delete_file(`${STUDIO}/${id}.draft.qwe`)
    put_registry(set(r, "plugins", entries | map((x) => x.id == id ? merge(x, { released_at: now(), released_by: u.email, updated_at: now() }) : x)))
    { released: version, written }
}

// Drops the draft; the released version (if any) stays as it is.
server fn studio_discard(id: str) {
    need_developer()?
    (studio_entry(id) ?? err("No such plugin"))?
    delete_file(`${STUDIO}/${id}.draft.qwe`)
    let released = read_file(`${STUDIO}/${id}.qwe`)
    if !is_err(released) { write_file(`${STUDIO}/${id}.source.qwe`, released) }
    let r = studio_registry()
    let entries = r.plugins | map((x) => x.id == id ? set(x, "draft", false) : x) | filter((x) => x.id != id || x.released != null)
    write_index(entries)
    put_registry(set(r, "plugins", entries))
    true
}

// Whether this workspace runs the studio's drafts in place of their
// releases (a workspace developers test in).
server fn set_try_drafts(on: bool) {
    need_developer()?
    put_setting("try_drafts", on)
    true
}
