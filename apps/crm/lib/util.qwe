// Helpers that compute and nothing else, so pages in the browser and code on
// the server use the same ones: dates, money, names, text.

let DAY = 86400000

fn pad2(n: int) = n < 10 ? `0${n}` : str(n)

// The calendar date of a day number (days since 1970-01-01, UTC).
fn civil(days: int) {
    let z = days + 719468
    let era = floor((z >= 0 ? z : z - 146096) / 146097)
    let doe = z - era * 146097
    let yoe = floor((doe - floor(doe / 1460) + floor(doe / 36524) - floor(doe / 146096)) / 365)
    let doy = doe - (365 * yoe + floor(yoe / 4) - floor(yoe / 100))
    let mp = floor((5 * doy + 2) / 153)
    let d = doy - floor((153 * mp + 2) / 5) + 1
    let m = mp < 10 ? mp + 3 : mp - 9
    { y: m <= 2 ? yoe + era * 400 + 1 : yoe + era * 400, m, d }
}

fn day_number(y: int, m: int, d: int) {
    let y2 = m <= 2 ? y - 1 : y
    let era = floor((y2 >= 0 ? y2 : y2 - 399) / 400)
    let yoe = y2 - era * 400
    let mp = m > 2 ? m - 3 : m + 9
    let doy = floor((153 * mp + 2) / 5) + d - 1
    era * 146097 + yoe * 365 + floor(yoe / 4) - floor(yoe / 100) + doy - 719468
}

let MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

// `2026-10-24` for a time in milliseconds.
fn iso_day(ms: int) {
    let c = civil(floor(ms / DAY))
    `${c.y}-${pad2(c.m)}-${pad2(c.d)}`
}

// Milliseconds at the start of a `YYYY-MM-DD` day, or null.
fn parse_day(s: str) = match split(trim(s), "-") | map((p) => int(p)) {
    [int as y, int as m, int as d] if m >= 1 && m <= 12 && d >= 1 && d <= 31 => day_number(y, m, d) * DAY
    _ => null
}

fn fmt_day(s: str) = match parse_day(s) {
    null => s
    ms => {
        let c = civil(floor(ms / DAY))
        `${MONTHS[c.m - 1]} ${c.d}, ${c.y}`
    }
}

fn fmt_date(ms) = ms == null ? "" : fmt_day(iso_day(ms))

fn fmt_time(ms) {
    if ms == null { return "" }
    let mins = floor((ms % DAY) / 60000)
    `${fmt_date(ms)}, ${pad2(floor(mins / 60))}:${pad2(mins % 60)}`
}

// "just now", "5 min ago", "3 h ago", "2 d ago", or the date.
fn fmt_ago(ms, now_ms: int) {
    if ms == null { return "" }
    let s = floor((now_ms - ms) / 1000)
    s < 60 ? "just now"
    : s < 3600 ? `${floor(s / 60)} min ago`
    : s < 86400 ? `${floor(s / 3600)} h ago`
    : s < 86400 * 14 ? `${floor(s / 86400)} d ago`
    : fmt_date(ms)
}

let CURRENCIES = { USD: "$", EUR: "€", GBP: "£", JPY: "¥", IDR: "Rp", AUD: "A$", CAD: "C$" }

// Thousands with commas: 1234567 is "1,234,567".
fn group(n: int) {
    let s = str(n)
    len(s) <= 3 ? s : `${group(floor(n / 1000))},${slice(s, len(s) - 3)}`
}

fn fmt_money(cents, currency: str = "USD") {
    let c = cents ?? 0
    let sign = c < 0 ? "-" : ""
    let a = abs(c)
    `${sign}${CURRENCIES[currency] ?? `${currency} `}${group(floor(a / 100))}.${pad2(a % 100)}`
}

// "12.50" or "12" as cents; null for anything else.
fn parse_money(s) {
    let t = trim(str(s ?? "")) | replace(",", "")
    let parts = split(t, ".")
    match parts {
        [whole] => is_err(int(whole)) ? null : int(whole) * 100
        [whole, frac] if len(frac) <= 2 && !is_err(int(whole == "" ? "0" : whole)) && !is_err(int(frac == "" ? "0" : frac)) =>
            int(whole == "" ? "0" : whole) * 100 + int(len(frac) == 1 ? `${frac}0` : frac == "" ? "0" : frac)
        _ => null
    }
}

fn full_name(c) {
    let n = trim(`${c.first_name ?? ""} ${c.last_name ?? ""}`)
    n != "" ? n : (c.email ?? "") != "" ? c.email : "Unnamed"
}

fn initials(name: str) =
    split(trim(name), " ")
        | filter((w) => w != "")
        | take(2)
        | map((w) => upper(slice(w, 0, 1)))
        | join("")

let SLUG_CHARS = "abcdefghijklmnopqrstuvwxyz0123456789"

// "Hello, World!" is "hello-world".
// A folder's name as kept: trimmed, at most 40 characters.
fn folder_name(v) = slice(trim(str(v ?? "")), 0, 40)

// What `u` opened: kept for their sidebar, the latest 40.
fn note_recent(u, kind: str, ref) {
    if u == null { return null }
    db.exec("insert into recents (user_id, kind, ref, at) values (?, ?, ?, ?) on conflict (user_id, kind, ref) do update set at = excluded.at", u.id, kind, str(ref), now())
    db.exec("delete from recents where user_id = ? and kind = ? and ref not in (select ref from recents where user_id = ? and kind = ? order by at desc limit 40)", u.id, kind, u.id, kind)
}

// When `u` last opened each, by ref.
fn recent_refs(u, kind: str) = u == null ? {}
    : db.query("select ref, at from recents where user_id = ? and kind = ?", u.id, kind) | reduce({}, (m, r) => set(m, r.ref, r.at))

fn slugify(s: str) {
    let chars = split(lower(trim(s)), "") | map((ch) => contains(SLUG_CHARS, ch) ? ch : "-")
    split(join(chars, ""), "-") | filter((p) => p != "") | join("-")
}

// `base`, or `base-2`, `base-3`, ... : the first not taken.
fn free_slug(taken: list, base: str, n: int) {
    let s = n == 1 ? base : `${base}-${n}`
    contains(taken, s) ? free_slug(taken, base, n + 1) : s
}

fn is_email(s) {
    let t = trim(s ?? "")
    let parts = split(t, "@")
    len(parts) == 2 && parts[0] != "" && contains(parts[1], ".") && !starts_with(parts[1], ".")
        && !ends_with(parts[1], ".") && !contains(t, " ")
}

fn plural(n: int, one: str, many: str = "") = n == 1 ? `1 ${one}` : `${group(n)} ${many != "" ? many : `${one}s`}`

// A JSON text column as a value, with a fallback for empty or broken text.
fn parsed(text, fallback) {
    if text == null || text == "" { return fallback }
    let v = json.parse(text)
    is_err(v) ? fallback : v
}

// A field of CSV: quoted when it must be.
fn csv_cell(v) {
    let s = v == null ? "" : str(v)
    contains(s, ",") || contains(s, "\"") || contains(s, "\n") ? `"${replace(s, "\"", "\"\"")}"` : s
}

fn csv_row(cells: list) = cells | map(csv_cell) | join(",")

// The rows of a CSV text, as lists of cells (quotes and doubled quotes
// understood, a newline inside quotes kept).
fn csv_parse(text: str) {
    let chars = split(replace(text, "\r\n", "\n"), "")
    let state = chars | reduce({ rows: [], row: [], cell: "", quoted: false, prev: "" }, (st, ch) =>
        st.quoted
            ? (ch == "\"" ? set(st, "quoted", false) | set("prev", "\"")
               : set(st, "cell", st.cell + ch) | set("prev", ch))
            : ch == "\"" ? (st.prev == "\"" ? set(st, "cell", st.cell + "\"") : st) | set("quoted", true) | set("prev", "")
            : ch == "," ? set(st, "row", st.row + [st.cell]) | set("cell", "") | set("prev", ch)
            : ch == "\n" ? set(st, "rows", st.rows + [st.row + [st.cell]]) | set("row", []) | set("cell", "") | set("prev", ch)
            : set(st, "cell", st.cell + ch) | set("prev", ch))
    let last = state.row + [state.cell]
    let rows = len(last) == 1 && last[0] == "" ? state.rows : state.rows + [last]
    rows | filter((r) => !(len(r) == 1 && trim(r[0]) == ""))
}

// `{{ name }}` placeholders in text, filled from a map (missing ones empty).
fn fill(text: str, values: map) =
    split(text, "{{")
        | enumerate
        | map((ip) => ip[0] == 0 ? ip[1] : match split(ip[1], "}}") {
            [key, ..rest] => `${str(values[trim(key)] ?? "")}${join(rest, "}}")}`
            _ => ip[1]
        })
        | join("")

// A value at a dotted path: `pick(c, "fields.points")`.
fn pick(m, path: str) = split(path, ".") | reduce(m, (acc, k) => acc == null ? null : acc[k])

// A copy with the value at a dotted path replaced.
fn put(m, path: str, v) = match split(path, ".") {
    [k] => set(m ?? {}, k, v)
    [k, ..rest] => set(m ?? {}, k, put((m ?? {})[k] ?? {}, join(rest, "."), v))
    _ => m
}
