// Where objects' records are kept: a table per object (named when the
// object is made: `o_press_releases`; `tbl`), with
// a column per field, `f_<field>`, typed as the field is (numbers, yes/no
// as 0 or 1, links as references to the contacts, companies or records
// they lead to, read back as ids: ints). Designing an object changes its table: a field added is
// a column added, a field removed a column dropped, a unique field a
// unique index. Names go into SQL with `sql_name`, which takes only
// letters, digits and `_`.

let LINKS = ["contact", "company", "person", "record"]

// An object's table: the name it was given, or `o_<key>` (objects from before).
fn tbl(key: str) {
    let o = db.one("select table_name from objects where key = ?", key)
    o == null || is_err(o) || blank(o.table_name) ? `o_${key}` : o.table_name
}

// A table name as chosen: `o_` and letters, digits and `_`.
fn table_name(given) {
    let s = replace(slugify(str(given ?? "")), "-", "_")
    let rest = starts_with(s, "o_") ? slice(s, 2) : s
    rest == "" ? "" : `o_${rest}`
}

// Why `t` cannot be the table of object `key` (null: it can).
fn table_problem(t: str, key: str) {
    if t == "" { return problem("table", "Name its table") }
    if len(t) > 48 { return problem("table", "At most 48 characters") }
    let mine = db.one("select key from objects where key = ?", key) == null ? "" : tbl(key)
    if t == mine { return null }
    let taken = db.query("select key from objects where key != ?", key) | any((x) => tbl(x.key) == t)
    let exists = db.one("select name from sqlite_master where lower(name) = ?", t) != null
    taken || exists ? problem("table", `There is a table named ${t} already`) : null
}

fn to_col(f: map, v) = v == null ? null
    : f.type == "checkbox" ? (v == true ? 1 : 0)
    : f.type == "image" ? (type_of(v) == "map" ? json.stringify(v) : null)
    : contains(LINKS, f.type) ? int(v) ?? null
    : v

fn from_col(f: map, v) = v == null ? null
    : f.type == "checkbox" ? v == 1 || v == true
    : f.type == "image" ? parsed(str(v), null)
    : contains(LINKS, f.type) ? int(v) ?? null
    : v

fn row_record(key: str, fields: list, row) = row == null ? null : {
    id: row.id, object: key, title: row.title, state: row.state ?? "", owner_id: row.owner_id, created_at: row.created_at, updated_at: row.updated_at, moved_at: row.moved_at,
    fields: fields | reduce({}, (m, f) => set(m, f.key, from_col(f, row[`f_${f.key}`]))),
}

// The table as the object's fields say it should be: made, its columns
// added and dropped, its indexes made. Refused (with the database's
// reason) when a unique field's records already share a value.
fn sync_table(key: str) {
    let fields = object_fields(key)
    let t = tbl(key)
    db.exec(`create table if not exists ${sql_name(t)} (
        id integer primary key, title text not null default '', state text not null default '',
        owner_id integer references users(id) on delete set null, created_at integer not null, updated_at integer not null)`)
    let have = db.query("select name from pragma_table_info(?)", t) | map((r) => r.name)
    // When the record last moved (its state's time: published on, say).
    if !contains(have, "moved_at") { db.exec(`alter table ${sql_name(tbl(key))} add column moved_at integer`) }
    // Each field a column, typed as the field is.
    for f in fields | filter((f) => !contains(have, `f_${f.key}`)) => db.exec(`alter table ${sql_name(tbl(key))} add column ${sql_name(`f_${f.key}`)} ${match f.type {
        "number" => "NUMERIC"
        "money" => "NUMERIC"
        "checkbox" => "INTEGER"
        "contact" => "INTEGER REFERENCES contacts(id) ON DELETE SET NULL"
        "company" => "INTEGER REFERENCES companies(id) ON DELETE SET NULL"
        "person" => "INTEGER REFERENCES users(id) ON DELETE SET NULL"
        "record" => `INTEGER REFERENCES ${sql_name(tbl((f.options ?? [])[0] ?? ""))}(id) ON DELETE SET NULL`
        "lookup" => ""
        _ => "TEXT"
    }}`)
    let gone = have | filter((c) => starts_with(c, "f_") && !any(fields, (f) => `f_${f.key}` == c))
    for c in gone => {
        db.exec(`drop index if exists ${sql_name(`ix_${key}_${c}`)}`)
        db.exec(`drop index if exists ${sql_name(`ux_${key}_${c}`)}`)
        db.exec(`alter table ${sql_name(tbl(key))} drop column ${sql_name(c)}`)
    }
    for f in fields | filter((f) => contains(LINKS, f.type)) => db.exec(`create index if not exists ${sql_name(`ix_${key}_f_${f.key}`)} on ${sql_name(tbl(key))}(${sql_name(`f_${f.key}`)})`)
    let bad = fields | map((f) => {
        if f.is_unique == 1 || f.is_unique == true {
            let r = db.exec(`create unique index if not exists ${sql_name(`ux_${key}_f_${f.key}`)} on ${sql_name(tbl(key))}(${sql_name(`f_${f.key}`)})`)
            is_err(r) ? [f.label] : []
        } else {
            db.exec(`drop index if exists ${sql_name(`ux_${key}_f_${f.key}`)}`)
            []
        }
    }) | flatten
    len(bad) > 0 ? err(`Some records share a value of ${join(bad, ", ")}: it cannot be unique yet`) : true
}

fn drop_table(key: str) = db.exec(`drop table if exists ${sql_name(tbl(key))}`)

// ---- records -----------------------------------------------------------------------------

fn rec_get(key: str, id) {
    let row = db.one(`select * from ${sql_name(tbl(key))} where id = ?`, int(id) ?? 0)
    is_err(row) ? null : row_record(key, object_fields(key), row)
}

fn rec_all(key: str, limit: int) {
    let fields = object_fields(key)
    rows_of(key, fields, db.query(`select * from ${sql_name(tbl(key))} order by updated_at desc limit ?`, limit))
}

// Rows as records; a table that is not there (yet) has none.
fn rows_of(key: str, fields: list, rows) = is_err(rows) ? [] : rows | map((r) => row_record(key, fields, r))

fn rec_count(key: str) = (db.one(`select count(*) as n from ${sql_name(tbl(key))}`) ?? {}).n ?? 0

// The values of the object's fields for a write: a map by parameter name.
fn rec_params(fields: list, values: map) = fields | reduce({}, (m, f) => set(m, `f_${f.key}`, to_col(f, values[f.key])))

fn rec_insert(key: str, values: map, state: str, owner, id = null) {
    let fields = object_fields(key)
    let cols = fields | map((f) => `f_${f.key}`)
    let base = { title: "", state, owner, at: now() }
    let ps = merge(merge(base, rec_params(fields, values)), id == null ? {} : { id })
    let names = (id == null ? [] : ["id"]) + ["title", "state", "owner_id", "created_at", "updated_at"] + cols
    let params = (id == null ? [] : ["id"]) + ["title", "state", "owner", "at", "at"] + cols
    let r = db.exec(`insert into ${sql_name(tbl(key))} (${sql_name(names)}) values (${sql_param(params)})`, ps)
    is_err(r) ? r : r.last_id
}

// A write the table refused, as problems: a unique field's value taken.
fn store_problems(key: str, r) {
    let msg = str(r.error)
    let t = tbl(key)
    let f = find(object_fields(key), (x) => contains(msg, `${t}.f_${x.key}`))
    f != null && contains(msg, "UNIQUE") ? problem(`fields.${f.key}`, `${f.label}: another record has this value`) : problem("", `It was not saved: ${msg}`)
}

fn rec_update(key: str, id: int, values: map) {
    let fields = object_fields(key)
    let cols = fields | map((f) => `f_${f.key}`)
    if len(cols) == 0 { return db.exec(`update ${sql_name(tbl(key))} set updated_at = ? where id = ?`, now(), id) }
    db.exec(`update ${sql_name(tbl(key))} set (${sql_name(cols)}) = (${sql_param(cols)}), updated_at = :at where id = :id`,
        merge(rec_params(fields, values), { at: now(), id }))
}

fn rec_set(key: str, id: int, what: map) {
    if what.state != null { db.exec(`update ${sql_name(tbl(key))} set state = ?, moved_at = ?, updated_at = ? where id = ?`, what.state, now(), now(), id) }
    if what.title != null { db.exec(`update ${sql_name(tbl(key))} set title = ? where id = ?`, what.title, id) }
}

fn rec_delete(key: str, id: int) = db.exec(`delete from ${sql_name(tbl(key))} where id = ?`, id)

// Records whose field `fkey` holds `v` (links, uniqueness).
fn rec_where(key: str, fkey: str, v) {
    let f = find(object_fields(key), (x) => x.key == fkey)
    if f == null { return [] }
    let fields = object_fields(key)
    rows_of(key, fields, db.query(`select * from ${sql_name(tbl(key))} where ${sql_name(`f_${fkey}`)} = ?`, to_col(f, v)))
}

fn rec_title(key: str, id) = (db.one(`select title from ${sql_name(tbl(key))} where id = ?`, int(id) ?? 0) ?? {}).title

// ---- moving records from before (one shared table, the values as JSON) ---------

// Once per workspace: each object's table made, its records copied in (ids
// kept, so links still lead where they did). The shared table keeps its
// rows, untouched, as a backup.
// Tables as this program makes them: 1, records copied in; 2, every table
// brought up to date (columns the program added since, such as moved_at).
let TABLES_VERSION = 2

fn objects_ready() {
    let s = settings()
    let v = s.object_tables ?? (s.objects_in_tables == true ? 1 : 0)
    if v >= TABLES_VERSION { return true }
    let old = v < 1 && db.one("select name from sqlite_master where type = 'table' and name = 'object_records'") != null
    // Targets before the objects that link to them, so references are made.
    for o in db.query("select key from objects order by id") => sync_table(o.key)
    if old {
        db.transaction(() => {
            for r in db.query("select * from object_records order by id") => {
                if db.one("select key from objects where key = ?", r.object) != null {
                    // The record keeps its id (links to it still lead to it),
                    // unless the table has a record with that id already.
                    let first = rec_insert(r.object, parsed(r.fields, {}), r.state ?? "", r.owner_id, r.id)
                    let id = is_err(first) ? rec_insert(r.object, parsed(r.fields, {}), r.state ?? "", r.owner_id) : first
                    if !is_err(id) {
                        db.exec(`update ${sql_name(tbl(r.object))} set title = ?, created_at = ?, updated_at = ? where id = ?`, r.title, r.created_at, r.updated_at, id)
                    }
                }
            }
        })
        // The old rows stay where they were, as they were: a backup (the flag
        // below keeps them from moving twice).
    }
    put_setting("object_tables", TABLES_VERSION)
    true
}
