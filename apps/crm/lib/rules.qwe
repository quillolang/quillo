// Rules: what makes a record acceptable. Each plugin brings rules for the
// kinds of records it cares about; a rule is a function of the record and
// its context giving the problems it sees:
//
//     (record, ctx) => [{ field: "email", message: "Not an email address" }]
//
// A problem with `level: "warning"` is advice; any other is an error. The
// same functions run in the browser, where they only hint while you type,
// and on the server, where errors refuse what was submitted. Rules compute
// and nothing else (no database, no clock: `ctx.today` is the date), so
// both always agree.
//
// `ctx` is { enabled: [plugin ids], fields: [custom field definitions],
// settings: {...}, today: "YYYY-MM-DD", and whatever the kind adds }.

fn problem(field: str, message: str) = [{ field, message }]
fn warning(field: str, message: str) = [{ field, message, level: "warning" }]
fn when(cond, problems: list) = cond ? problems : []

fn blank(v) = v == null || trim(str(v)) == ""

// The plugins switched on: core always, the rest by the workspace's choice.
// Drafts from the plugin studio take their released version's place in
// a workspace that tries drafts ("@drafts" among its plugins).
fn active_plugins(enabled: list) {
    let drafts = contains(enabled, "@drafts")
    let on = (p) => p.id == "core" || contains(enabled, p.id) || (drafts && p.status == "draft")
    let shadowed = (p) => drafts && p.status != "draft" && any(plugins, (q) => q.status == "draft" && q.id == p.id)
    plugins | filter((p) => (p.status != "draft" || drafts) && on(p) && !shadowed(p))
}

// Where a plugin's renderers and runners are found: its version's key.
fn plugin_key(p) = p.status == "draft" ? `${p.id}#draft` : p.id

// A custom object's records (kind "obj.<key>") also get the checks their
// fields bring and the rules made for them in the object designer.
fn validate(kind: str, record: map, ctx: map) =
    (starts_with(kind, "obj.") ? field_rules(record, ctx, kind) + object_rules(kind, record, ctx) : [])
    + (active_plugins(ctx.enabled ?? [])
        | map((p) => p.rules[kind] ?? [])
        | flatten
        | map((rule) => rule(record, ctx))
        | flatten)

// ---- rules made in the object designer ---------------------------------------------
//
// A rule is data: `{ if, then, message, warning }`, each condition
// `{ field, op, value }`. When `if` holds (or there is none) and `then`
// does not, the record has a problem at `then`'s field. A value that
// starts with `@` is another field's (`end` after `@start`).

let RULE_OPS = ["is filled", "is empty", "is", "is not", "more than", "at least", "less than", "at most", "after", "before", "longer than", "shorter than"]

fn rule_value(v, values: map) {
    let s = str(v ?? "")
    starts_with(s, "@") ? values[slice(s, 1)] : v
}

fn as_number(v) {
    let n = float(str(v ?? ""))
    is_err(n) ? null : n
}

fn holds(c, values: map) {
    if c == null || blank(c.field) { return true }
    let v = values[c.field]
    let w = rule_value(c.value, values)
    let n = as_number(v)
    let m = as_number(w)
    match c.op {
        "is filled" => !blank(v)
        "is empty" => blank(v)
        "is" => lower(str(v ?? "")) == lower(str(w ?? ""))
        "is not" => lower(str(v ?? "")) != lower(str(w ?? ""))
        "more than" => blank(v) || (n != null && m != null && n > m)
        "at least" => blank(v) || (n != null && m != null && n >= m)
        "less than" => blank(v) || (n != null && m != null && n < m)
        "at most" => blank(v) || (n != null && m != null && n <= m)
        "after" => blank(v) || blank(w) || str(v) > str(w)
        "before" => blank(v) || blank(w) || str(v) < str(w)
        "longer than" => len(str(v ?? "")) > (int(w) ?? 0)
        "shorter than" => len(str(v ?? "")) < (int(w) ?? 0)
        _ => true
    }
}

fn object_rules(kind: str, record: map, ctx: map) {
    let o = find(ctx.objects ?? [], (x) => `obj.${x.key}` == kind)
    // `state` reads as a field: "If State is assigned, then Deadline is filled".
    let values = merge(record.fields ?? {}, { state: record.state ?? "" })
    (o == null ? [] : o.rules ?? []) | map((r) =>
        !holds(r.if, values) || r.then == null || holds(r.then, values) ? []
        : r.warning == true ? warning(`fields.${r.then.field}`, r.message ?? "Check this")
        : problem(`fields.${r.then.field}`, r.message ?? "Check this")) | flatten
}

// A rule in words, for the designer's list.
fn rule_text(r: map, label_of) {
    let cond = (c) => c == null || blank(c.field) ? "" : `${label_of(c.field)} ${c.op}${contains(["is filled", "is empty"], c.op) ? "" : ` ${starts_with(str(c.value ?? ""), "@") ? label_of(slice(str(c.value), 1)) : str(c.value ?? "")}`}`
    `${r.if == null || blank(r.if.field) ? "Always" : `If ${cond(r.if)}`}: ${cond(r.then)}`
}

fn errors_of(problems: list) = problems | filter((p) => p.level != "warning")

// The messages for one field (for the hint under its input).
fn hints_for(problems: list, field: str) = problems | filter((p) => p.field == field)

// Fields plugins add, and the workspace's own, for one kind of record.
fn fields_for(entity: str, ctx: map) =
    (active_plugins(ctx.enabled ?? []) | map((p) => p.fields ?? []) | flatten | filter((f) => f.entity == entity))
        + ((ctx.fields ?? []) | filter((f) => f.entity == entity))

// The rules every workspace's own custom fields bring: required, numbers,
// dates, choices.
fn field_rules(record: map, ctx: map, entity: str) {
    let values = record.fields ?? {}
    fields_for(entity, ctx) | map((f) => {
        let v = values[f.key]
        let key = `fields.${f.key}`
        if blank(v) {
            when(f.required == true || f.required == 1, problem(key, `${f.label} is required`))
        } else {
            match f.type {
                "number" => when(is_err(float(str(v))), problem(key, `${f.label} must be a number`))
                "date" => when(parse_day(str(v)) == null, problem(key, `${f.label} must be a date (YYYY-MM-DD)`))
                "select" => when(len(f.options ?? []) > 0 && !contains(f.options, str(v)), problem(key, `${f.label}: choose one of ${join(f.options, ", ")}`))
                "url" => when(!starts_with(str(v), "https://") && !starts_with(str(v), "http://"), problem(key, `${f.label} must be a web address`))
                "money" => when(is_err(float(str(v))), problem(key, `${f.label} must be an amount`))
                "email" => when(!is_email(str(v)), problem(key, `${f.label} must be an email address`))
                "contact" => when(is_err(int(v)), problem(key, `${f.label}: choose a contact`))
                "person" => when(is_err(int(v)), problem(key, `${f.label}: choose someone on the team`))
                "company" => when(is_err(int(v)), problem(key, `${f.label}: choose a company`))
                "record" => when(is_err(int(v)), problem(key, `${f.label}: choose one`))
                _ => []
            }
        }
    }) | flatten
}

// Card numbers: digits, the right length, and Luhn's check digit. (Test
// mode takes 4242 4242 4242 4242; a real provider checks for itself.)
fn luhn_ok(digits: str) {
    let ds = split(digits, "") | map((d) => int(d))
    let total = reverse(ds) | enumerate | map((p) => {
        let d = p[1]
        p[0] % 2 == 1 ? (d * 2 > 9 ? d * 2 - 9 : d * 2) : d
    }) | sum
    total % 10 == 0
}

fn card_digits(s) = split(str(s ?? ""), "") | filter((ch) => contains("0123456789", ch)) | join("")
