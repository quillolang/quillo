// Pages a workspace designs, made of blocks, all of them from plugins: a
// block's type, its settings and its rules are plugin data (the designer
// offers what the plugins switched on bring), and its HTML comes from the
// plugin's renderer. A page has a draft, which the designer edits, and a
// published version, which visitors see at /p/<slug> (or at the
// workspace's own address, for the home page). A section is made the same
// way but has no address: pages put it in with the Section block, and
// show its published version wherever they do. Owners, admins and
// designers change pages (`need_designer`); any member may look.


fn page_out(r) = r == null ? null : merge(r, {
    draft: parsed(r.draft, { blocks: [] }),
    published: parsed(r.published, null),
    home: r.home == 1,
    kind: r.kind ?? "page",
    changed: r.published == null || r.published != r.draft,
})

// What renderers see.
fn render_ctx(preview: bool) {
    let s = settings()
    { products: shop_products(), currency: s.currency ?? "USD", site: s.name ?? "", preview, enabled: enabled_plugins(), posts: recent_posts(40) }
}

// One block's HTML, from the renderer of the plugin that brings it.
fn render_block(b: map, ctx: map) {
    let p = find(active_plugins(ctx.enabled), (p) => any(p.blocks ?? [], (t) => t.type == b.type))
    let render = p == null ? null : (block_renderers[plugin_key(p)] ?? {})[b.type]
    render == null ? <p.pb-missing>A block from a plugin that is switched off.</p> : render(b.config ?? {}, ctx)
}

// A section's published blocks, in a page. Sections may hold sections; the
// page rules refuse loops, and depth stops one made some other way.
fn section_html(id, ctx: map) {
    let depth = ctx.depth ?? 0
    let s = depth >= 5 ? null : page_out(db.one("select * from pages where id = ? and kind = 'section'", int(id) ?? 0))
    if s == null || s.published == null {
        return ctx.preview ? <p.pb-missing>{s == null ? "A section that no longer exists." : `“${s.title}” is not published yet.`}</p> : <div.pb-section></div>
    }
    let inner = merge(ctx, { depth: depth + 1 })
    <div.pb-section>{for b in s.published.blocks ?? [] => render_block(b, inner)}</div>
}

// The pages and sections that put a section in, in their draft or their
// published version.
fn pages_using(id: int) = db.query("select id, title, kind, draft, published from pages where id != ?", id)
    | filter((r) => contains(section_ids(parsed(r.draft, {}).blocks) + section_ids(parsed(r.published, {}).blocks), str(id)))
    | map((r) => { id: r.id, title: r.title, kind: r.kind, live: contains(section_ids(parsed(r.published, {}).blocks), str(id)) })

view SitePage(page: map, blocks: list, theme = null) =
    <SiteLayout title={page.title} description={page.description != "" ? page.description : page_summary(blocks)} {theme} image={first_image(blocks)}>
        {for b in blocks => render_block(b, render_ctx(false))}
    </SiteLayout>

fn published_page(slug: str) = page_out(db.one("select * from pages where slug = ? and kind = 'page' and published is not null", slugify(slug)))

fn home_page() = page_out(db.one("select * from pages where home = 1 and kind = 'page' and published is not null"))

fn show_page(p: map) = <SitePage page={p} blocks={p.published.blocks ?? []}/>

// What page rules see: the products for sale, the forms there are, and the
// sections (with the sections their published versions put in).
fn page_ctx() = rule_ctx({
    posts: db.query("select id, category from posts where status = 'published' order by published_at desc limit 200"),
    skus: db.query("select sku from products where active = 1") | map((r) => r.sku),
    forms: db.query("select slug from forms") | map((r) => r.slug),
    sections: db.query("select id, title, published from pages where kind = 'section' order by title") | map((r) => {
        id: str(r.id),
        title: r.title != "" ? r.title : "Untitled",
        published: r.published != null,
        embeds: section_ids(parsed(r.published, {}).blocks),
    }),
})

// ---- the designer's server functions ---------------------------------------------

// The pages as their list shows them: not their blocks. A section's use is
// worked out in one pass over the pages.
server fn list_pages() {
    let u = need_user()?
    let rows = db.query("select id, slug, title, description, kind, home, folder, pinned, created_at, updated_at, published_at,
        published is null as never, (published is not null and published != draft) as differs from pages order by home desc, updated_at desc")
    let opened = recent_refs(u, "page")
    let uses = section_uses()
    rows | map((r) => merge(r, {
        home: r.home == 1, pinned: r.pinned == 1, kind: r.kind ?? "page", folder: r.folder ?? "",
        published: r.never == 1 ? null : true, changed: r.never == 1 || r.differs == 1, opened_at: opened[str(r.id)],
        used_on: r.kind == "section" ? uses[str(r.id)] ?? [] : null,
    }))
}

// For each section, the pages it is on, by its id.
fn section_uses() = db.query("select id, title, kind, draft, published from pages where draft like '%\"section\"%' or published like '%\"section\"%'")
    | reduce({}, (m, r) => {
        let live = section_ids(parsed(r.published, {}).blocks)
        let all = unique(section_ids(parsed(r.draft, {}).blocks) + live)
        all | filter((sid) => sid != str(r.id)) | reduce(m, (acc, sid) => set(acc, sid, (acc[sid] ?? []) + [{ id: r.id, title: r.title, kind: r.kind, live: contains(live, sid) }]))
    })

// Pinned: in everyone's sidebar. A folder: where the Pages page groups it.
server fn set_page_place(id: int, place: map) {
    need_designer()?
    if db.one("select id from pages where id = ?", id) == null { return err("No such page") }
    if place.pinned != null { db.exec("update pages set pinned = ? where id = ?", place.pinned == true ? 1 : 0, id) }
    if place.folder != null { db.exec("update pages set folder = ? where id = ?", folder_name(place.folder), id) }
    true
}

server fn get_page(id: int) {
    let u = need_user()?
    note_recent(u, "page", id)
    // The designer starts from the draft: so does the live preview.
    db.exec("delete from page_live where page_id = ?", id)
    preview_token_of(id)
    let p = (page_out(db.one("select * from pages where id = ?", id)) ?? err("No such page"))?
    p.kind == "section" ? merge(p, { used_on: pages_using(id) }) : p
}

// Each block's HTML as visitors would see it, for the designer's preview.
server fn preview_page(blocks: list) {
    need_user()?
    let ctx = render_ctx(true)
    flat_blocks(blocks) | map((b) => { id: b.id, html: str(render_block(b, ctx)) })
}

// A saved page's draft, rendered (the designer's first preview).
server fn preview_of(id: int) {
    need_user()?
    let p = (page_out(db.one("select * from pages where id = ?", id)) ?? err("No such page"))?
    let ctx = render_ctx(true)
    flat_blocks(upgrade_blocks(p.draft.blocks ?? [])) | map((b) => { id: b.id, html: str(render_block(b, ctx)) })
}

// ---- the live preview ----------------------------------------------------------------
// A page as its designer has it on screen, saved or not, at a secret link of
// its own (/preview/<token>): for any browser, a phone, a client. It follows
// each change (`live` on page_live), and the block being edited.

fn preview_token_of(id: int) {
    let r = db.one("select preview_token from pages where id = ?", id)
    if r == null { return "" }
    if !blank(r.preview_token) { return r.preview_token }
    let t = crypto.token(18)
    db.exec("update pages set preview_token = ? where id = ?", t, id)
    t
}

// A new link: the one before stops working.
server fn new_preview_link(id: int) {
    need_designer()?
    if db.one("select id from pages where id = ?", id) == null { return err("No such page") }
    let t = crypto.token(18)
    db.exec("update pages set preview_token = ? where id = ?", t, id)
    t
}

// The blocks on the designer's screen, and the one being edited.
server fn live_draft(id: int, blocks: list, focus) {
    let u = need_designer()?
    db.exec("insert into page_live (page_id, blocks, focus, user_id, updated_at) values (?, ?, ?, ?, ?)
             on conflict (page_id) do update set blocks = excluded.blocks, focus = excluded.focus, user_id = excluded.user_id, updated_at = excluded.updated_at",
        id, json.stringify(blocks), str(focus ?? ""), u.id, now())
    true
}

// Only which block is being edited.
server fn live_focus(id: int, focus) {
    need_designer()?
    db.exec("update page_live set focus = ? where page_id = ?", str(focus ?? ""), id)
    true
}

// A change: drawn for the designer, and kept for the live preview.
server fn preview_live(id: int, blocks: list, focus) {
    live_draft(id, blocks, focus)?
    preview_page(blocks)
}

// What the live preview shows: the designer's blocks (or the draft, when
// it is newer or there are none), as visitors would see them, each marked
// and the one being edited (or the one holding it) picked out.
server fn live_view(token: str) {
    if blank(token) { return err("No such preview") }
    let p = page_out(db.one("select * from pages where preview_token = ?", token))
    if p == null { return err("This preview link is no longer in use: ask for the new one") }
    let l = db.one("select l.*, u.name from page_live l left join users u on u.id = l.user_id where l.page_id = ?", p.id)
    let fresh = l != null && l.updated_at >= p.updated_at
    let blocks = fresh ? parsed(l.blocks, []) : p.draft.blocks ?? []
    let focus = fresh ? l.focus ?? "" : ""
    let ctx = merge(render_ctx(false), { live: true })
    {
        title: p.title,
        html: join(blocks | map((b) => str(<div data-live-block={b.id} class={!blank(focus) && any(flat_blocks([b]), (x) => x.id == focus) ? "live-block live-focus" : "live-block"}>{render_block(b, ctx)}</div>)), ""),
        focus,
        by: fresh ? l.name ?? "" : "",
        at: fresh ? l.updated_at : p.updated_at,
        saved: !fresh,
    }
}

// Saving the progress: what changed since the designer last saved — the
// blocks that changed (by id), the order of the page's blocks, the page's
// settings that changed. The other blocks are kept as they are saved. A
// block in that order that is neither sent nor saved (the page changed
// elsewhere): refused as stale, and the designer saves the whole page.
server fn save_changes(id: int, c: map) {
    need_designer()?
    let p = (page_out(db.one("select * from pages where id = ?", id)) ?? err("No such page"))?
    let saved = upgrade_blocks(p.draft.blocks ?? [])
    let changed = c.blocks ?? {}
    let order = c.order ?? (saved | map((b) => b.id))
    let kept = (bid) => changed[bid] ?? find(saved, (b) => b.id == bid)
    if any(order, (bid) => kept(bid) == null) { return err({ stale: true }) }
    let meta = merge({ title: p.title, slug: p.slug, description: p.description }, c.meta ?? {})
    save_page(merge(meta, { id, blocks: order | map(kept) }))
}

// A draft may be saved as it is; only the address must be one.
server fn save_page(p: map) {
    need_designer()?
    let slug = slugify(p.slug ?? "")
    if slug == "" { return err({ problems: problem("slug", "Choose its address") }) }
    if db.one("select id from pages where slug = ? and id != ?", slug, p.id) != null { return err({ problems: problem("slug", "Another page has this address") }) }
    db.exec("update pages set title = ?, slug = ?, description = ?, draft = ?, updated_at = ? where id = ?",
        trim(p.title ?? ""), slug, trim(p.description ?? ""), json.stringify({ blocks: p.blocks ?? [] }), now(), p.id)
    // Saved: the live preview shows the draft now.
    db.exec("delete from page_live where page_id = ?", p.id)
    page_out(db.one("select * from pages where id = ?", p.id))
}

// Publishing checks the draft with the page rules the designer showed.
server fn publish_page(id: int) {
    need_designer()?
    let p = (page_out(db.one("select * from pages where id = ?", id)) ?? err("No such page"))?
    // The rules see every block, those in columns too.
    let record = merge(p.draft, { id: str(p.id), kind: p.kind, title: p.title, slug: p.slug, description: p.description, blocks: flat_blocks(p.draft.blocks) })
    refused("page", record, page_ctx())?
    db.exec("update pages set published = draft, published_at = ?, updated_at = ? where id = ?", now(), now(), id)
    page_out(db.one("select * from pages where id = ?", id))
}

// A section that published pages show stays published, and one that
// pages put in is not deleted: they would show a gap.
fn in_use(id: int, live_only: bool) {
    let users = pages_using(id) | filter((u) => u.live || !live_only)
    len(users) == 0 ? null : err(`Used on ${join(users | map((u) => u.title != "" ? `“${u.title}”` : "an untitled page"), ", ")}: take the section out of ${len(users) == 1 ? "that page" : "those pages"} first`)
}

server fn unpublish_page(id: int) {
    need_designer()?
    in_use(id, true)?
    db.exec("update pages set published = null, home = 0, updated_at = ? where id = ?", now(), id)
    true
}

server fn set_home(id: int) {
    need_admin()?
    db.transaction(() => {
        db.exec("update pages set home = 0")
        db.exec("update pages set home = 1 where id = ? and kind = 'page'", id)
    })
    true
}

server fn delete_page(id: int) {
    need_admin()?
    in_use(id, false)?
    db.exec("delete from pages where id = ?", id)
    true
}

server fn page_rule_ctx() {
    need_user()?
    page_ctx()
}

// A page's first words, for search results when it has no description.
fn page_summary(blocks: list) {
    let b = find(flat_blocks(blocks), (b) => !blank((b.config ?? {}).text) || !blank((b.config ?? {}).body) || !blank((b.config ?? {}).headline))
    let c = b == null ? {} : b.config
    let text = !blank(c.text) ? c.text : !blank(c.body) ? c.body : c.headline ?? ""
    let plain = split(replace(replace(replace(str(text), "#", ""), "*", ""), "\n", " "), " ") | filter((w) => w != "") | join(" ")
    len(plain) > 155 ? `${slice(plain, 0, 152)}…` : plain
}

// The first picture a page shows, for link previews.
fn first_image(blocks: list) {
    let b = find(flat_blocks(blocks), (b) => type_of((b.config ?? {}).image) == "map")
    b == null ? "" : media_src(b.config.image, crop_text(b.config.image), 1280)
}

server fn save_theme(t: map) {
    need_designer()?
    let links = (ls) => (ls ?? []) | map((l) => { label: trim(l.label ?? ""), link: trim(l.link ?? "") })
    let theme = {
        id: t.id ?? "clean", color: lower(trim(t.color ?? "")), font: t.font ?? "system", dark: t.dark == true, logo: trim(t.logo ?? ""),
        menu: t.menu == null ? null : links(t.menu), footer: trim(t.footer ?? ""), footer_links: links(t.footer_links), css: t.css ?? "",
    }
    refused("theme", theme, rule_ctx())?
    put_setting("theme", theme)
    theme
}

server fn new_page(template: str) {
    need_designer()?
    let t = page_template(template)
    let kind = template == "section" ? "section" : "page"
    let base = kind == "section" ? "section" : slugify(t.title)
    let taken = db.query("select slug from pages") | map((r) => r.slug)
    let slug = free_slug(taken, base, 1)
    let t0 = now()
    db.exec("insert into pages (slug, title, description, draft, kind, created_at, updated_at) values (?, ?, ?, ?, ?, ?, ?)",
        slug, t.title, t.description, json.stringify({ blocks: t.blocks }), kind, t0, t0).last_id
}

// ---- templates ----------------------------------------------------------------------

fn block(id: str, type: str, config: map) = { id, type, config }

fn page_template(kind: str) {
    let s = settings()
    let product = (db.one("select sku from products where active = 1 order by id limit 1") ?? {}).sku ?? ""
    let form = (db.one("select slug from forms order by id limit 1") ?? {}).slug ?? ""
    let name = s.name ?? "Us"
    let enabled = s.plugins ?? []
    match kind {
        "launch" => {
            title: "New arrivals",
            description: `What is new at ${name}.`,
            blocks: [
                block("b1", "hero", { headline: "Made to last, made with care", text: "Our new collection is here: honest materials, fair prices.", button: "Shop now", link: "/shop" }),
                block("b2", "product", { product, button: "Buy now" }),
                block("b3", "quote", { quote: "The best thing I bought this year.", name: "A happy customer" }),
                block("b4", "form", { form, heading: "Be first to know" }),
            ],
        }
        "section" => {
            title: "Join us",
            description: "",
            blocks: [
                block("b1", "text", { body: `## Stay in the loop\n\nThe best of ${name}, once a week. No spam, leave any time.` }),
                block("b2", "form", { form, heading: "" }),
            ],
        }
        "membership" => {
            title: "Become a member",
            description: `Support ${name}.`,
            blocks: [
                block("b1", "hero", { headline: "Independent, because of you", text: "Members keep this going, and get more of it.", button: "See the plans", link: "#plans" }),
                block("b2", "columns", { left: "### Every story\nNo paywall, no limits.", right: "### First to read\nNewsletters a day early." }),
            ] + (contains(enabled, "paywall") ? [block("b3", "paywall.plans", { heading: "Plans", perks: "Every story\nThe members' newsletter\nOur thanks" })] : [block("b3", "products", { heading: "Plans" })])
              + [block("b4", "form", { form, heading: "Not ready? Get the free newsletter" })],
        }
        _ => {
            title: "Welcome",
            description: "",
            blocks: [block("b1", "hero", { headline: `Welcome to ${name}`, text: "Say what you do, for whom, in a sentence." }), block("b2", "form", { form, heading: "Stay in touch" })],
        }
    }
}
