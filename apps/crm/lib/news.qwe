// Objects on the site: an object's records, in the state the site shows,
// read as articles at /<path> — a front page, a page per section (another
// object's records, which may depend on one another: Elections under
// Politics), a page per article. What is the headline, the picture, the
// body, the section and the byline is the object's site setting, made in
// its designer: the model, not the code.

let SITE_DEFAULT = { on: false, path: "", state: "", title: "", summary: "", image: "", caption: "", body: "", group: "", byline: "", home: false }

// A site setting as saved: a path that is a name, fields that exist.
fn site_config(s: map) {
    let c = merge(SITE_DEFAULT, s)
    if c.on != true { return merge(c, { on: false }) }
    let path = slugify(c.path ?? "")
    if path == "" { return err({ problems: problem("site", "Give it an address: news, say") }) }
    if contains(["app", "p", "blog", "shop", "cart", "checkout", "login", "logout", "setup", "media", "assets", "f", "unsubscribe", "welcome", "preview", "sitemap.xml", "robots.txt"], path) {
        return err({ problems: problem("site", `/${path} is the site's own: choose another address`) })
    }
    merge(c, { on: true, path })
}

fn site_objects() = db.query("select * from objects") | map(object_out) | filter((o) => o.site.on == true)

fn site_object(path: str) = find(site_objects(), (o) => o.site.path == path)

// The section object (the one the group field links to), and its field
// that links a section to the one it depends on.
fn section_object(o: map) {
    let f = find(object_fields(o.key), (x) => x.key == o.site.group && x.type == "record")
    f == null ? null : object_out(db.one("select * from objects where key = ?", (f.options ?? [])[0] ?? ""))
}

fn parent_field(so: map) = find(object_fields(so.key), (x) => x.type == "record" && (x.options ?? [])[0] == so.key)

fn section_color(r) = blank(r.fields.color) ? "var(--brand)" : r.fields.color

fn sections_of(o: map) {
    let so = section_object(o)
    if so == null { return [] }
    let pf = parent_field(so)
    // In the order the newsroom made them.
    rec_all(so.key, 500) | sort_by((r) => r.id) | map((r) => merge(r, {
        slug: slugify(r.title),
        parent: pf == null ? null : r.fields[pf.key],
    }))
}

// A section and every section that depends on it, at any depth.
fn section_family(all: list, id: int) {
    let kids = all | filter((x) => x.parent == id) | map((x) => section_family(all, x.id)) | flatten
    [id] + kids
}

// A record as the site shows it.
fn site_item(o: map, r: map, sections: list, people: map) {
    let s = o.site
    let title = blank(s.title) ? r.title : str(r.fields[s.title] ?? r.title)
    let sid = blank(s.group) ? null : r.fields[s.group]
    let byline = blank(s.byline) ? people[str(r.owner_id)] : people[str(r.fields[s.byline] ?? "")]
    {
        id: r.id, state: r.state,
        slug: `${r.id}-${slugify(title)}`,
        title,
        summary: blank(s.summary) ? "" : str(r.fields[s.summary] ?? ""),
        image: blank(s.image) ? null : r.fields[s.image],
        caption: blank(s.caption) ? "" : str(r.fields[s.caption] ?? ""),
        body: blank(s.body) ? "" : str(r.fields[s.body] ?? ""),
        section: find(sections, (x) => x.id == sid),
        byline: byline ?? "",
        date: r.moved_at ?? r.updated_at,
    }
}

fn people_names() = db.query("select id, name from users") | reduce({}, (m, u) => set(m, str(u.id), u.name))

// The records the site shows, newest first.
fn site_items(o: map) {
    let sections = sections_of(o)
    let people = people_names()
    rec_all(o.key, 1000)
        | filter((r) => blank(o.site.state) || r.state == o.site.state)
        | map((r) => site_item(o, r, sections, people))
        | sort_by((x) => -(x.date ?? 0))
}

fn item_link(o: map, x: map) = `/${o.site.path}/${x.slug}`
fn section_link(o: map, sec: map) = `/${o.site.path}/c/${sec.slug}`

// ---- views ------------------------------------------------------------------------------

// A section's name over a story: a link, except inside a card (a link in
// a link is no HTML: the card is the link).
view NpLabel(o: map, sec, link: bool = true) = sec == null ? null
    : link ? <a.np-label href={section_link(o, sec)} style={`--sec:${section_color(sec)}`}>{sec.title}</a>
    : <span.np-label style={`--sec:${section_color(sec)}`}>{sec.title}</span>

view NpMeta(x: map) =
    <p.np-meta>{x.byline != "" && <span>By <b>{x.byline}</b> · </span>}{fmt_date(x.date)} · {reading_minutes(x.body)} min read</p>

view NpCard(o: map, x: map, size: str = "") =
    <article class={size == "" ? "np-card" : `np-card np-${size}`}>
        <a.np-card-link href={item_link(o, x)}>
            {x.image != null && <div.np-img><Picture v={x.image} alt={x.caption} shown={size == "lead" ? 980 : 480}/></div>}
            <div.np-card-text>
                <NpLabel {o} sec={x.section} link={false}/>
                <h3>{x.title}</h3>
                {x.summary != "" && size != "small" && <p.np-summary>{x.summary}</p>}
                <NpMeta {x}/>
            </div>
        </a>
    </article>

view NpLine(o: map, x: map) =
    <li.np-line><NpLabel {o} sec={x.section}/><a href={item_link(o, x)}>{x.title}</a></li>

// The front page: the lead, the next stories beside it, then a row per
// section (with the sections that depend on it).
fn site_front(o: map) {
    let items = site_items(o)
    let sections = sections_of(o)
    let lead = find(items, (x) => x.image != null) ?? items[0]
    let rest = items | filter((x) => lead == null || x.id != lead.id)
    let top = sections | filter((s) => s.parent == null)
    <SiteLayout title="" description={`The latest from ${settings().name ?? ""}.`}>
        {lead == null ? <section.np-empty><h1>Nothing published yet</h1><p>Stories show here once they are published.</p></section>
        : <div.np-front>
            <section.np-top>
                <NpCard {o} x={lead} size="lead"/>
                <div.np-side>
                    {for x in rest | take(3) => <NpCard {o} {x} size="small"/>}
                </div>
                <aside.np-latest>
                    <h2>Latest</h2>
                    <ol>{for x in items | take(6) => <NpLine {o} {x}/>}</ol>
                </aside>
            </section>
            {for sec in top => {
                let fam = section_family(sections, sec.id)
                let mine = items | filter((x) => x.section != null && contains(fam, x.section.id)) | take(3)
                len(mine) == 0 ? null : <section.np-row style={`--sec:${section_color(sec)}`}>
                    <h2.np-row-head><a href={section_link(o, sec)}>{sec.title}</a>
                        <span.np-subs>{for k in sections | filter((s) => s.parent == sec.id) => <a href={section_link(o, k)}>{k.title}</a>}</span>
                        <a.np-more href={section_link(o, sec)}>More →</a></h2>
                    <div.np-grid>{for x in mine => <NpCard {o} {x}/>}</div>
                </section>
            }}
        </div>}
    </SiteLayout>
}

fn site_section(o: map, slug: str) {
    let sections = sections_of(o)
    let sec = find(sections, (s) => s.slug == slugify(slug)) ?? reply 404 <NotFoundPage what="section"/>
    let fam = section_family(sections, sec.id)
    let items = site_items(o) | filter((x) => x.section != null && contains(fam, x.section.id))
    let parent = sec.parent == null ? null : find(sections, (s) => s.id == sec.parent)
    let kids = sections | filter((s) => s.parent == sec.id)
    <SiteLayout title={sec.title} description={str(sec.fields.description ?? "")}>
        <header.np-section-head style={`--sec:${section_color(sec)}`}>
            {parent != null && <p.np-crumbs><a href={section_link(o, parent)}>{parent.title}</a> ›</p>}
            <h1>{sec.title}</h1>
            {!blank(sec.fields.description) && <p.np-section-desc>{sec.fields.description}</p>}
            {len(kids) > 0 && <nav.np-chips>{for k in kids => <a href={section_link(o, k)}>{k.title}</a>}</nav>}
        </header>
        {len(items) == 0 ? <p.np-empty>Nothing in {sec.title} yet.</p>
        : <div.np-section-body>
            <NpCard {o} x={items[0]} size="lead"/>
            <div.np-grid>{for x in drop(items, 1) => <NpCard {o} {x}/>}</div>
        </div>}
    </SiteLayout>
}

// An article. Its team may see it before it is published (`preview`).
fn site_article(o: map, slug: str, preview: bool) {
    let id = int(split(slug, "-")[0]) ?? 0
    let r = rec_get(o.key, id) ?? reply 404 <NotFoundPage what="story"/>
    let shown = blank(o.site.state) || r.state == o.site.state
    let u = current_user()
    let may = u != null && allows(access_to(u, o.key).level, "read") && may_see(u, access_to(u, o.key), r)
    if !shown && !(preview && may) { reply 404 <NotFoundPage what="story"/> }
    let sections = sections_of(o)
    let x = site_item(o, r, sections, people_names())
    let more = site_items(o) | filter((y) => y.id != x.id && y.section != null && x.section != null && y.section.id == x.section.id) | take(3)
    let state = find(o.states, (st) => st.key == r.state)
    <SiteLayout title={x.title} description={x.summary} kind="article"
        image={x.image == null || type_of(x.image) != "map" ? "" : media_src(x.image, crop_text(x.image), 1280)}>
        {!shown && <p.np-preview>Preview · {state == null ? "not published" : state.label} · <a href={`/app/o/${o.key}/${r.id}`}>Back to the story's page</a></p>}
        <article.np-article style={x.section == null ? "" : `--sec:${section_color(x.section)}`}>
            <header.np-article-head>
                <NpLabel {o} sec={x.section}/>
                <h1>{x.title}</h1>
                {x.summary != "" && <p.np-standfirst>{x.summary}</p>}
                <NpMeta {x}/>
            </header>
            {x.image != null && <figure.np-figure><Picture v={x.image} alt={x.caption} shown={1180}/>{x.caption != "" && <figcaption>{x.caption}</figcaption>}</figure>}
            <section.np-body>{markdown(x.body)}</section>
        </article>
        {len(more) > 0 && <section.np-more-from>
            <h2>More in {x.section.title}</h2>
            <div.np-grid>{for y in more => <NpCard {o} x={y}/>}</div>
        </section>}
    </SiteLayout>
}
