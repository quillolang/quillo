// Products, the cart, discount codes, orders and the checkout. Prices are
// in cents. The checkout page shows the same quote the server charges
// (`quote_lines` computes and nothing else), and its rules run on both
// sides; payment is the server's alone.

fn product_out(r) = r == null ? null : merge(r, {
    fields: parsed(r.fields, {}),
    active: r.active == 1,
    images: parsed(r.images, []),
    featured: r.featured == 1,
    digital: r.digital == 1,
    variants: parsed(r.variants, []),
})

// A product as one of its variants: its own name, stock and price.
fn as_variant(p: map, v) = v == null ? merge(p, { key: p.sku, variant: "" }) : merge(p, {
    key: `${p.sku}~${v.name}`,
    variant: v.name,
    name: `${p.name} (${v.name})`,
    stock: v.stock,
    price_cents: v.price_cents ?? p.price_cents,
})

// The lowest price, and whether every variant (or the product) is sold out.
fn price_from(p: map) = len(p.variants) == 0 ? p.price_cents : min(p.variants | map((v) => v.price_cents ?? p.price_cents))
fn sold_out(p: map) = len(p.variants) == 0 ? p.stock == 0 : all(p.variants, (v) => v.stock == 0)

fn clamp_qty(q) = max([1, min([99, int(q) ?? 1])])

// The quote for lines ({ product, qty }) with a discount (or null), as the
// buyer filled the checkout in: subtotal, discount, shipping (from the
// workspace's settings), tax (from the plugins that add it) and total.
fn quote_lines(o: map, lines: list, discount, ctx: map) {
    let ls = lines | map((l) => {
        let qty = clamp_qty(l.qty)
        { sku: l.product.key ?? l.product.sku, name: l.product.name, price_cents: l.product.price_cents, qty, total_cents: l.product.price_cents * qty }
    })
    let subtotal = ls | map((l) => l.total_cents) | sum
    let usable = discount != null && subtotal >= (discount.min_cents ?? 0)
    let off = !usable ? 0
        : discount.kind == "percent" ? round(subtotal * min([100, discount.value]) / 100)
        : discount.kind == "amount" ? min([subtotal, discount.value])
        : 0
    let s = ctx.settings ?? {}
    let rate = int(s.shipping_cents) ?? 0
    let free_over = int(s.free_shipping_over_cents) ?? 0
    let ships = any(lines, (l) => !(l.product.digital == true) && l.product.kind != "subscription")
    let shipping = !ships || (usable && discount.kind == "shipping") || (free_over > 0 && subtotal - off >= free_over) ? 0 : rate
    let tax = active_plugins(ctx.enabled ?? [])
        | filter((p) => p.taxes != null)
        | map((p) => p.taxes(o, subtotal - off, ctx))
        | sum
    { lines: ls, subtotal_cents: subtotal, discount_cents: off, discount_ok: usable, shipping_cents: shipping, tax_cents: tax, total_cents: subtotal - off + shipping + tax, ships }
}

// For one product (a qty of it), with no discount.
fn quote(o: map, product: map, ctx: map) = quote_lines(o, [{ product, qty: o.qty }], null, ctx)

// The checkout's extra inputs, from the plugins that ask for them.
fn checkout_fields(enabled: list) = active_plugins(enabled) | map((p) => p.checkout_fields ?? []) | flatten | unique

server fn list_products() {
    need_user()?
    db.query("select p.*, (select coalesce(sum(json_extract(i.value, '$.qty')), 0) from orders o, json_each(o.items) i
               where o.status = 'paid' and json_extract(i.value, '$.product_id') = p.id) as sold
              from products p order by p.active desc, p.name") | map(product_out)
}

server fn save_product(p: map) {
    need_admin()?
    refused("product", p, rule_ctx())?
    let sku = lower(trim(p.sku))
    let other = db.one("select id from products where sku = ? and id != ?", sku, p.id ?? 0)
    if other != null { return err({ problems: problem("sku", "Another product has this SKU") }) }
    let interval = p.kind == "subscription" ? p.interval ?? "month" : ""
    let vals = { name: trim(p.name), sku, price: p.price_cents, kind: p.kind ?? "one_time", interval, description: p.description ?? "", stock: p.stock,
        active: p.active == false ? 0 : 1, images: json.stringify(p.images ?? []), category: slugify(p.category ?? ""), compare: p.compare_at_cents,
        featured: p.featured == true ? 1 : 0, digital: p.digital == true ? 1 : 0, at: now(), id: p.id ?? 0,
        vlabel: trim(p.variant_label ?? ""), variants: json.stringify((p.variants ?? []) | map((v) => { name: trim(v.name ?? ""), stock: v.stock, price_cents: v.price_cents })) }
    let id = if p.id == null {
        db.exec("insert into products (name, sku, price_cents, kind, interval, description, stock, active, images, category, compare_at_cents, featured, digital, variant_label, variants, created_at)
                 values (:name, :sku, :price, :kind, :interval, :description, :stock, :active, :images, :category, :compare, :featured, :digital, :vlabel, :variants, :at)", remove(vals, "id")).last_id
    } else {
        db.exec("update products set name = :name, sku = :sku, price_cents = :price, kind = :kind, interval = :interval, description = :description, stock = :stock,
                 active = :active, images = :images, category = :category, compare_at_cents = :compare, featured = :featured, digital = :digital,
                 variant_label = :vlabel, variants = :variants where id = :id", remove(vals, "at"))
        p.id
    }
    product_out(db.one("select * from products where id = ?", id))
}

server fn list_orders(status: str) {
    need_user()?
    db.query("select o.*, c.first_name, c.last_name, c.email from orders o left join contacts c on c.id = o.contact_id
              where (? = '' or o.status = ?) order by o.created_at desc limit 300", status, status)
        | map((o) => merge(o, { items: parsed(o.items, []), review: parsed(o.fields, {}).review ?? [] }))
}

server fn refund_order(id: int) {
    need_admin()?
    let o = (db.one("select * from orders where id = ?", id) ?? err("No such order"))?
    if o.status != "paid" { return err("Only a paid order can be refunded") }
    audited("order.refund", { id, number: o.number, total_cents: o.total_cents }, () => db.exec("update orders set status = 'refunded' where id = ?", id))?
    // What was sold goes back on the shelf.
    for i in parsed(o.items, []) => take_stock(i.product_id, i.variant ?? "", -i.qty)
    note_activity("order", o.contact_id, null, `Order ${o.number} refunded (${fmt_money(o.total_cents, settings().currency ?? "USD")})`)
    true
}

server fn save_shipping(rate_cents, free_over_cents) {
    need_admin()?
    if rate_cents == null || rate_cents < 0 { return err({ problems: problem("shipping", "An amount, zero or more") }) }
    if free_over_cents == null || free_over_cents < 0 { return err({ problems: problem("free", "An amount, zero or more") }) }
    put_setting("shipping_cents", rate_cents)
    put_setting("free_shipping_over_cents", free_over_cents)
    true
}

// ---- discount codes ---------------------------------------------------------------

fn discount_out(r) = r == null ? null : merge(r, { active: r.active == 1 })

server fn list_discounts() {
    need_user()?
    db.query("select * from discounts order by active desc, created_at desc") | map(discount_out)
}

server fn save_discount(d: map) {
    need_admin()?
    refused("discount", d, rule_ctx())?
    let code = upper(trim(d.code))
    if db.one("select id from discounts where code = ? and id != ?", code, d.id ?? 0) != null { return err({ problems: problem("code", "Another discount has this code") }) }
    let vals = { code, kind: d.kind, value: d.value ?? 0, min: d.min_cents ?? 0, max: d.max_uses, ends: d.ends_at, active: d.active == false ? 0 : 1 }
    if d.id == null {
        db.exec("insert into discounts (code, kind, value, min_cents, max_uses, ends_at, active, created_at) values (:code, :kind, :value, :min, :max, :ends, :active, :at)", set(vals, "at", now()))
    } else {
        db.exec("update discounts set code = :code, kind = :kind, value = :value, min_cents = :min, max_uses = :max, ends_at = :ends, active = :active where id = :id", set(vals, "id", d.id))
    }
    true
}

server fn delete_discount(id: int) {
    need_admin()?
    audited("discount.delete", { id }, () => db.exec("delete from discounts where id = ?", id))?
    true
}

// A code a buyer may use now, or why not.
fn usable_discount(code: str) {
    if blank(code) { return null }
    let d = discount_out(db.one("select * from discounts where code = ?", upper(trim(code))))
    d == null || !d.active ? err("That code does not exist")
        : d.ends_at != null && d.ends_at < now() ? err("That code has ended")
        : d.max_uses != null && d.uses >= d.max_uses ? err("That code has been used up")
        : { code: d.code, kind: d.kind, value: d.value, min_cents: d.min_cents }
}

// One use of a code, taken only while it has uses left (and is on), in
// the order's transaction: two checkouts at once cannot both take the
// last one, as they could between `usable_discount` and paying.
fn take_discount_use(code: str) {
    let r = db.exec("update discounts set uses = uses + 1 where code = ? and active = 1 and (max_uses is null or uses < max_uses)", code)?
    r.changes == 1 ? true : err({ problems: problem("discount", "That code has been used up") })
}

fn discount_label(d, currency: str) =
    d.kind == "percent" ? `${d.value}% off`
    : d.kind == "amount" ? `${fmt_money(d.value, currency)} off`
    : "Free shipping"

// ---- the cart (in the visitor's session) -----------------------------------------------

fn cart() = session().cart ?? []

fn cart_count() = cart() | map((i) => i.qty ?? 1) | sum

// `qty` of a product (or of one of its variants) leaves the shelf (or,
// negative, comes back).
fn take_stock(product_id: int, variant: str, qty: int) {
    if variant == "" {
        db.exec("update products set stock = stock - ? where id = ? and stock is not null", qty, product_id)
    } else {
        let p = db.one("select variants from products where id = ?", product_id)
        if p != null {
            let vs = parsed(p.variants, []) | map((v) => v.name == variant && v.stock != null ? set(v, "stock", v.stock - qty) : v)
            db.exec("update products set variants = ? where id = ?", json.stringify(vs), product_id)
        }
    }
}

fn set_cart(items: list) = set_session(merge(session(), { cart: items | filter((i) => i.qty > 0) }))

// Adds to the cart; a product in variants needs one of them. Null when
// added, else why not.
fn add_to_cart(sku: str, qty, variant: str = "") {
    let p = shop_product(sku)
    if p == null { return "This product is not for sale" }
    let v = find(p.variants, (x) => x.name == variant)
    if len(p.variants) > 0 && v == null { return `Choose a ${lower(p.variant_label != "" ? p.variant_label : "variant")}` }
    let key = as_variant(p, v).key
    let have = find(cart(), (i) => item_key(i) == key)
    // A subscription is bought one at a time.
    let n = p.kind == "subscription" ? 1 : clamp_qty((have == null ? 0 : have.qty) + clamp_qty(qty))
    let item = { sku: p.sku, variant: v == null ? "" : v.name, qty: n }
    set_cart(have == null ? cart() + [item] : cart() | map((i) => item_key(i) == key ? item : i))
    null
}

fn item_key(i: map) = blank(i.variant) ? i.sku : `${i.sku}~${i.variant}`

fn update_cart(key: str, qty) {
    let n = int(qty) ?? 0
    set_cart(cart() | map((i) => item_key(i) == key ? set(i, "qty", n <= 0 ? 0 : clamp_qty(n)) : i))
}

// The cart's products (as the variants chosen), still for sale.
fn cart_lines(items: list) = items
    | map((i) => {
        let p = shop_product(i.sku)
        let v = p == null || blank(i.variant) ? null : find(p.variants, (x) => x.name == i.variant)
        { product: p == null || (!blank(i.variant) && v == null) ? null : as_variant(p, v), qty: i.qty }
    })
    | filter((l) => l.product != null)

fn session_discount() {
    let d = usable_discount(session().discount ?? "")
    is_err(d) ? null : d
}

// ---- the public shop ---------------------------------------------------------

fn shop_product(sku: str) = product_out(db.one("select * from products where sku = ? and active = 1", lower(sku)))

server fn shop_products() = db.query("select id, name, sku, price_cents, compare_at_cents, kind, interval, description, stock, images, category, featured, digital, variant_label, variants
    from products where active = 1 order by featured desc, name") | map(product_out)

fn shop_categories() = db.query("select category, count(*) as n from products where active = 1 and category != '' group by category order by category")

// What the checkout page needs: the cart's lines, the code, the context
// the rules run in, and the extra inputs plugins ask for.
fn checkout_ctx(lines: list, discount) {
    let stock = lines | reduce({}, (m, l) => set(m, l.product.key, l.product.stock))
    let ships = any(lines, (l) => !l.product.digital && l.product.kind != "subscription")
    rule_ctx({ stock, discount, ships })
}

server fn checkout_context() {
    let lines = cart_lines(cart())
    let discount = session_discount()
    let ctx = checkout_ctx(lines, discount)
    let s = ctx.settings
    { lines: lines | map((l) => { product: remove(l.product, "fields"), qty: l.qty }), discount, ctx: remove(ctx, "fields"),
      extra: checkout_fields(ctx.enabled), shop: s.name ?? "Shop", currency: s.currency ?? "USD" }
}

let DECLINED = "4000000000000002"

// Pays for the cart (or, given a sku, for that one product). The test-mode
// provider takes any card that passes the checks, except
// 4000 0000 0000 0002, which it declines.
server fn checkout(o: map) {
    let items = o.sku != null ? [{ sku: o.sku, variant: o.variant ?? "", qty: o.qty ?? 1 }] : cart()
    let lines = cart_lines(items)
    if len(lines) == 0 { return err({ problems: problem(o.sku != null ? "sku" : "items", o.sku != null ? "This product is not for sale" : "Your cart is empty") }) }
    let discount = o.sku != null ? null : session_discount()
    let order = merge(o, { items: lines | map((l) => { sku: l.product.key, name: l.product.name, qty: clamp_qty(l.qty) }) })
    let ctx = checkout_ctx(lines, discount)
    refused("checkout", order, ctx)?
    if card_digits(o.card) == DECLINED { return err({ problems: problem("card", "The card was declined") }) }
    let q = quote_lines(order, lines, discount, ctx)
    let settings = ctx.settings
    let cur = settings.currency ?? "USD"
    let names = split(trim(o.name), " ")
    let done = db.transaction(() => {
        let c = contact_for_email(o.email, { first_name: names[0] ?? "", last_name: join(drop(names, 1), " "), source: "checkout", stage: "customer" })
        let t = now()
        let number = `${upper(slice(settings.slug ?? "ord", 0, 3))}-${1000 + ((db.one("select count(*) as n from orders") ?? {}).n ?? 0) + 1}`
        let items = lines | map((l) => { product_id: l.product.id, name: l.product.name, sku: l.product.sku, variant: l.product.variant, price_cents: l.product.price_cents,
            qty: clamp_qty(l.qty), kind: l.product.kind, interval: l.product.interval })
        // What plugins ask the team to check by hand (a VAT number that took
        // the tax off): kept with the order, and a task for each.
        let review = active_plugins(ctx.enabled ?? []) | filter((p) => p.review != null) | map((p) => p.review(order, ctx)) | filter((r) => !blank(r))
        let fields = { country: upper(trim(o.country ?? "")), vat_id: upper(trim(o.vat_id ?? "")), address: trim(o.address ?? ""), review }
        let used = q.discount_ok ? discount.code : ""
        if used != "" { take_discount_use(used)? }
        let r = db.exec(
            "insert into orders (number, contact_id, status, subtotal_cents, tax_cents, total_cents, items, payment_ref, fields, discount_code, discount_cents, shipping_cents, created_at, paid_at) values (?, ?, 'paid', ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
            number, c.id, q.subtotal_cents, q.tax_cents, q.total_cents, json.stringify(items), `test_${crypto.token(9)}`, json.stringify(fields),
            used, q.discount_cents, q.shipping_cents, t, t)
        for l in items => take_stock(l.product_id, l.variant, l.qty)
        for why in review => db.exec("insert into tasks (title, due, contact_id, created_at) values (?, ?, ?, ?)", `Order ${number}: ${why}`, iso_day(t), c.id, t)
        if c.stage != "customer" { db.exec("update contacts set stage = 'customer', updated_at = ? where id = ?", t, c.id) }
        let money = fmt_money(q.total_cents, cur)
        note_activity("order", c.id, null, `Bought ${items | map((l) => `${l.qty} × ${l.name}`) | join(", ")} (${money}), order ${number}`)
        add_tags(c.id, ["customer"])
        queue_mail(c.email, `Your order ${number}`, receipt_html(settings, number, q), "receipt", c.id, null)
        for l in items => fire("order_paid", { contact_id: c.id, order_id: r.last_id, sku: l.sku, total_cents: q.total_cents })
        { number, total: money, email: c.email, contact_id: c.id, skus: items | map((l) => l.sku) }
    })
    if is_err(done) { return done }
    if o.sku == null { set_session(merge(session(), { cart: [], discount: null })) }
    // After the commit: the flows the purchase started, and the ones that
    // were waiting for it.
    drain_runs()
    for sku in done.skus => purchased(done.contact_id, sku)
    remove(remove(done, "contact_id"), "skus")
}

fn receipt_html(settings: map, number: str, q: map) {
    let cur = settings.currency ?? "USD"
    let row = (label, cents) => `<tr><td>${label}</td><td align="right">${fmt_money(cents, cur)}</td></tr>`
    let rows = (q.lines | map((l) => row(`${l.qty} × ${escape(l.name)}`, l.total_cents)))
        + (q.discount_cents > 0 ? [row("Discount", -q.discount_cents)] : [])
        + (q.shipping_cents > 0 ? [row("Shipping", q.shipping_cents)] : [])
        + (q.tax_cents > 0 ? [row("Tax", q.tax_cents)] : [])
    `<p>Thank you for your order.</p><table width="100%">${join(rows, "")}<tr><td><b>Total</b></td><td align="right"><b>${fmt_money(q.total_cents, cur)}</b></td></tr></table><p>Order ${number}, ${escape(settings.name ?? "")}</p>`
}
