// Products, orders and the checkout. Prices are in cents. The checkout page
// shows the same quote the server charges (`quote` computes and nothing
// else), and its rules run on both sides; payment is the server's alone.

fn product_out(r) = r == null ? null : merge(r, { fields: parsed(r.fields, {}), active: r.active == 1 })

// Subtotal, tax (from the plugins that add it) and total, for `qty` of a
// product, as the buyer filled the checkout in.
fn quote(o: map, product: map, ctx: map) {
    let qty = max([1, int(str(o.qty ?? 1)) ?? 1])
    let subtotal = (product.price_cents ?? 0) * qty
    let tax = active_plugins(ctx.enabled ?? [])
        | filter((p) => p.taxes != null)
        | map((p) => p.taxes(o, subtotal, ctx))
        | sum
    { qty, subtotal_cents: subtotal, tax_cents: tax, total_cents: subtotal + tax }
}

// The checkout's extra inputs, from the plugins that ask for them.
fn checkout_fields(enabled: list) = active_plugins(enabled) | map((p) => p.checkout_fields ?? []) | flatten | unique

server fn list_products() {
    need_user()?
    db.query("select p.*, (select coalesce(sum(json_extract(i.value, '$.qty')), 0) from orders o, json_each(o.items) i
               where o.status = 'paid' and json_extract(i.value, '$.product_id') = p.id) as sold
              from products p order by p.active desc, p.name") | map(product_out)
}

server fn save_product(p: map) {
    need_admin()?
    refused("product", p, rule_ctx())?
    let sku = lower(trim(p.sku))
    let other = db.one("select id from products where sku = ? and id != ?", sku, p.id ?? 0)
    if other != null { return err({ problems: problem("sku", "Another product has this SKU") }) }
    let interval = p.kind == "subscription" ? p.interval ?? "month" : ""
    if p.id == null {
        let r = db.exec("insert into products (name, sku, price_cents, kind, interval, description, stock, active, created_at) values (?, ?, ?, ?, ?, ?, ?, ?, ?)",
            trim(p.name), sku, p.price_cents, p.kind ?? "one_time", interval, p.description ?? "", p.stock, p.active == false ? 0 : 1, now())
        product_out(db.one("select * from products where id = ?", r.last_id))
    } else {
        db.exec("update products set name = ?, sku = ?, price_cents = ?, kind = ?, interval = ?, description = ?, stock = ?, active = ? where id = ?",
            trim(p.name), sku, p.price_cents, p.kind ?? "one_time", interval, p.description ?? "", p.stock, p.active == false ? 0 : 1, p.id)
        product_out(db.one("select * from products where id = ?", p.id))
    }
}

server fn list_orders(status: str) {
    need_user()?
    db.query("select o.*, c.first_name, c.last_name, c.email from orders o left join contacts c on c.id = o.contact_id
              where (? = '' or o.status = ?) order by o.created_at desc limit 300", status, status)
        | map((o) => set(o, "items", parsed(o.items, [])))
}

server fn refund_order(id: int) {
    need_admin()?
    let o = (db.one("select * from orders where id = ?", id) ?? err("No such order"))?
    if o.status != "paid" { return err("Only a paid order can be refunded") }
    db.exec("update orders set status = 'refunded' where id = ?", id)
    note_activity("order", o.contact_id, null, `Order ${o.number} refunded (${fmt_money(o.total_cents, settings().currency ?? "USD")})`)
    true
}

// ---- the public shop ---------------------------------------------------------

fn shop_product(sku: str) = product_out(db.one("select * from products where sku = ? and active = 1", lower(sku)))

server fn shop_products() = db.query("select id, name, sku, price_cents, kind, interval, description, stock from products where active = 1 order by name")

// What the checkout page needs to show hints and the total as the server will.
server fn checkout_context(sku: str) {
    let p = (shop_product(sku) ?? err("This product is not for sale"))?
    let ctx = rule_ctx({ product: { id: p.id, stock: p.stock, price_cents: p.price_cents } })
    let s = ctx.settings
    { product: p, ctx: remove(ctx, "fields"), extra: checkout_fields(ctx.enabled), shop: s.name ?? "Shop", currency: s.currency ?? "USD" }
}

let DECLINED = "4000000000000002"

// Pays for a product. The test-mode provider takes any card that passes the
// checks, except 4000 0000 0000 0002, which it declines.
server fn checkout(o: map) {
    let p = (shop_product(o.sku ?? "") ?? err({ problems: problem("sku", "This product is not for sale") }))?
    let ctx = rule_ctx({ product: { id: p.id, stock: p.stock, price_cents: p.price_cents } })
    refused("checkout", o, ctx)?
    if card_digits(o.card) == DECLINED { return err({ problems: problem("card", "The card was declined") }) }
    let q = quote(o, p, ctx)
    let settings = ctx.settings
    let names = split(trim(o.name), " ")
    let done = db.transaction(() => {
        let c = contact_for_email(o.email, { first_name: names[0] ?? "", last_name: join(drop(names, 1), " "), source: "checkout", stage: "customer" })
        let t = now()
        let number = `${upper(slice(settings.slug ?? "ord", 0, 3))}-${1000 + ((db.one("select count(*) as n from orders") ?? {}).n ?? 0) + 1}`
        let items = [{ product_id: p.id, name: p.name, sku: p.sku, price_cents: p.price_cents, qty: q.qty, kind: p.kind, interval: p.interval }]
        let fields = { country: upper(trim(o.country ?? "")), vat_id: upper(trim(o.vat_id ?? "")) }
        let r = db.exec(
            "insert into orders (number, contact_id, status, subtotal_cents, tax_cents, total_cents, items, payment_ref, fields, created_at, paid_at) values (?, ?, 'paid', ?, ?, ?, ?, ?, ?, ?, ?)",
            number, c.id, q.subtotal_cents, q.tax_cents, q.total_cents, json.stringify(items), `test_${crypto.token(9)}`, json.stringify(fields), t, t)
        if p.stock != null { db.exec("update products set stock = stock - ? where id = ?", q.qty, p.id) }
        if c.stage != "customer" { db.exec("update contacts set stage = 'customer', updated_at = ? where id = ?", t, c.id) }
        let money = fmt_money(q.total_cents, settings.currency ?? "USD")
        note_activity("order", c.id, null, `Bought ${q.qty} × ${p.name} (${money}), order ${number}`)
        add_tags(c.id, ["customer"])
        queue_mail(c.email, `Your order ${number}`, receipt_html(settings, number, p, q), "receipt", c.id, null)
        let ctx_run = { contact_id: c.id, order_id: r.last_id, sku: p.sku, total_cents: q.total_cents }
        fire("order_paid", ctx_run)
        { number, total: money, email: c.email, contact_id: c.id }
    })
    // After the commit: the flows the purchase started, and the ones that
    // were waiting for it.
    drain_runs()
    purchased(done.contact_id, p.sku)
    remove(done, "contact_id")
}

fn receipt_html(settings: map, number: str, p: map, q: map) {
    let cur = settings.currency ?? "USD"
    let rows = [`<tr><td>${q.qty} × ${escape(p.name)}</td><td align="right">${fmt_money(q.subtotal_cents, cur)}</td></tr>`]
        + (q.tax_cents > 0 ? [`<tr><td>Tax</td><td align="right">${fmt_money(q.tax_cents, cur)}</td></tr>`] : [])
    `<p>Thank you for your order.</p><table width="100%">${join(rows, "")}<tr><td><b>Total</b></td><td align="right"><b>${fmt_money(q.total_cents, cur)}</b></td></tr></table><p>Order ${number}, ${escape(settings.name ?? "")}</p>`
}
