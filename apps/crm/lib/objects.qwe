// Custom objects: kinds of records a workspace designs for itself —
// vehicles, events, tickets, properties — beside contacts and companies.
// An object has fields (custom_fields with entity "obj.<key>", of any type,
// including links to contacts, companies and other objects' records) and
// rules made in the designer (lib/rules.qwe), which the browser runs as you
// type and the server runs again when a record is saved, with any rules
// plugins bring for "obj.<key>".

let FIELD_TYPES = ["text", "textarea", "markdown", "number", "money", "date", "select", "checkbox", "url", "email", "image", "contact", "company", "person", "record", "lookup"]

// Fields that lead to something: a contact, a company, a team member, a record.
let LINK_TYPES = ["contact", "company", "person", "record"]
let PERSON_LOOKUPS = [["name", "Name"], ["email", "Email"], ["bio", "About"]]

// A lookup field shows a field of what one of the record's links leads to:
// options are [the link field, the field there]. These are what a contact's
// and a company's links can show.
let CONTACT_LOOKUPS = [["name", "Name"], ["email", "Email"], ["phone", "Phone"], ["stage", "Stage"]]
let COMPANY_LOOKUPS = [["name", "Name"], ["domain", "Domain"]]

// The fields a link field can show, as [key, label]s.
fn lookup_targets(via: map, all_fields: list) = match via.type {
    "contact" => CONTACT_LOOKUPS
    "company" => COMPANY_LOOKUPS
    "person" => PERSON_LOOKUPS
    "record" => all_fields | filter((f) => f.entity == `obj.${(via.options ?? [])[0] ?? ""}` && f.type != "lookup") | map((f) => [f.key, f.label])
    _ => []
}

fn lookup_value(via: map, target: str, id: int) = match via.type {
    "contact" => {
        let c = db.one("select first_name, last_name, email, phone, stage from contacts where id = ?", id)
        c == null ? null : target == "name" ? trim(`${c.first_name} ${c.last_name}`) : c[target]
    }
    "company" => (db.one("select name, domain from companies where id = ?", id) ?? {})[target]
    "person" => (db.one("select name, email, bio from users where id = ?", id) ?? {})[target]
    _ => (rec_get((via.options ?? [])[0] ?? "", id) ?? { fields: {} }).fields[target]
}

// The record's values with its lookup fields filled in from what it links to.
fn fill_lookups(fields: list, values: map) = fields | filter((f) => f.type == "lookup") | reduce(values, (m, f) => {
    let via = find(fields, (x) => x.key == (f.options ?? [])[0])
    let id = via == null ? 0 : int(m[via.key]) ?? 0
    set(m, f.key, id == 0 ? null : lookup_value(via, (f.options ?? [])[1] ?? "", id))
})

// A number as typed: whole numbers stay whole.
fn as_num(v) {
    let n = float(str(v))
    is_err(n) ? v : n == floor(n) ? int(n) : n
}

fn object_out(r) = r == null ? null : merge(r, { rules: parsed(r.rules, []), states: parsed(r.states, []), transitions: parsed(r.transitions, []), site: parsed(r.site ?? "{}", {}),
    table: blank(r.table_name) ? `o_${r.key}` : r.table_name, list_fields: parsed(r.list_fields ?? "[]", []) })

fn objects_all() = db.query("select * from objects order by name") | map(object_out)

fn record_out(r) = r == null ? null : merge(r, { fields: parsed(r.fields, {}), state: r.state ?? "" })

fn object_fields(key: str) = db.query("select * from custom_fields where entity = ? order by position, id", `obj.${key}`)
    | map((f) => merge(f, { options: parsed(f.options, []), required: f.required == 1 }))

// A record's name: its title field's value, else the object's name and id.
fn record_title(o: map, fields: list, values: map, id) {
    let f = find(fields, (x) => x.key == o.title_field) ?? find(fields, (x) => x.type == "text")
    let v = f == null ? null : values[f.key]
    blank(v) ? `${o.name} ${id ?? "(new)"}` : str(v)
}

fn need_object(key: str) {
    objects_ready()
    object_out(db.one("select * from objects where key = ?", key)) ?? err("No such object")
}

// ---- designing objects ---------------------------------------------------------------

// The objects as their page lists them: how many fields, rules and records,
// and when a record last changed (in one query over every table).
server fn list_objects() {
    let u = need_user()?
    objects_ready()
    let objs = readable_objects(u)
    let stats = object_stats(objs)
    let nfields = db.query("select entity, count(*) as n from custom_fields where entity like 'obj.%' group by entity") | reduce({}, (m, r) => set(m, r.entity, r.n))
    let opened = recent_refs(u, "object")
    objs | map((o) => {
        key: o.key, name: o.name, plural: o.plural, icon: o.icon, description: o.description, folder: o.folder ?? "", pinned: o.pinned == 1,
        table: o.table, fields: nfields[`obj.${o.key}`] ?? 0, rules: len(o.rules), states: len(o.states),
        count: (stats[o.key] ?? {}).n ?? 0, changed_at: (stats[o.key] ?? {}).at, opened_at: opened[o.key],
    })
}

// Each object's records: how many, and the last change, by key.
fn object_stats(objs: list) {
    if len(objs) == 0 { return {} }
    let parts = enumerate(objs) | map((x) => `select ${sql_param(`k${x[0]}`)} as k, count(*) as n, max(updated_at) as at from ${sql_name(x[1].table)}`)
    let params = enumerate(objs) | reduce({}, (m, x) => set(m, `k${x[0]}`, x[1].key))
    let rows = db.query(join(parts, " union all "), params)
    // A table not made yet (an object from before): each on its own.
    is_err(rows) ? objs | reduce({}, (m, o) => set(m, o.key, { n: rec_count(o.key), at: null }))
        : rows | reduce({}, (m, r) => set(m, r.k, r))
}

// Every object's fields, by key: for the roles' editor (in one query).
server fn objects_fields() {
    need_user()?
    db.query("select entity, key, label, type from custom_fields where entity like 'obj.%' order by position, id")
        | reduce({}, (m, f) => set(m, slice(f.entity, 4), (m[slice(f.entity, 4)] ?? []) + [f]))
}

// Pinned: in everyone's sidebar. A folder: where the Objects page groups it.
server fn set_object_place(key: str, place: map) {
    need_designer()?
    need_object(key)?
    if place.pinned != null { db.exec("update objects set pinned = ? where key = ?", place.pinned == true ? 1 : 0, key) }
    if place.folder != null { db.exec("update objects set folder = ? where key = ?", folder_name(place.folder), key) }
    true
}

server fn get_object(key: str) {
    let u = need_user()?
    let a = need_access(u, key, "read", null)?
    let o = need_object(key)?
    note_recent(u, "object", key)
    let fields = object_fields(key)
    merge(o, { fields: fields | filter((f) => field_level(a, f.key) != "hidden"), can: a.level,
        levels: fields | reduce({}, (m, f) => set(m, f.key, field_level(a, f.key))) })
}

server fn save_object(o: map) {
    need_designer()?
    let name = trim(o.name ?? "")
    if blank(name) { return err({ problems: problem("name", "Name the object (one of them: Vehicle)") }) }
    let plural = blank(o.plural) ? `${name}s` : trim(o.plural)
    let rules = o.rules ?? []
    if any(rules, (r) => r.then == null || blank(r.then.field) || blank(r.message)) { return err({ problems: problem("rules", "Every rule needs a field to check and a message") }) }
    let states = (o.states ?? []) | map((st) => { key: replace(slugify(blank(st.key) ? st.label ?? "" : st.key), "-", "_"), label: trim(st.label ?? ""), color: st.color ?? "gray" })
    if any(states, (st) => st.key == "" || st.label == "") { return err({ problems: problem("states", "Every state needs a name") }) }
    if len(unique(states | map((st) => st.key))) != len(states) { return err({ problems: problem("states", "Two states have the same name") }) }
    let keys_of = states | map((st) => st.key)
    let transitions = (o.transitions ?? []) | map((t) => merge(t, { key: replace(slugify(blank(t.key) ? t.label ?? "" : t.key), "-", "_"), label: trim(t.label ?? ""),
        from: (t.from ?? []) | filter((x) => contains(keys_of, x)), groups: t.groups ?? [], roles: t.roles ?? [], fields: t.fields ?? [] }))
    if any(transitions, (t) => t.label == "" || !contains(keys_of, t.to)) { return err({ problems: problem("transitions", "Every move needs a name and a state it goes to") }) }
    if len(unique(transitions | map((t) => t.key))) != len(transitions) { return err({ problems: problem("transitions", "Two moves have the same name") }) }
    if o.id == null {
        let key = replace(slugify(name), "-", "_")
        if key == "" || contains(["contact", "company", "deal"], key) { return err({ problems: problem("name", "Choose another name") }) }
        if db.one("select id from objects where key = ?", key) != null { return err({ problems: problem("name", "There is an object with this name") }) }
        // Its table: as named, or after the object.
        let table = blank(o.table) ? `o_${key}` : table_name(o.table)
        let tp = table_problem(table, key)
        if tp != null { return err({ problems: tp }) }
        db.exec("insert into objects (key, name, plural, icon, description, title_field, rules, states, transitions, table_name, created_at) values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
            key, name, plural, blank(o.icon) ? "◆" : trim(o.icon), trim(o.description ?? ""), o.title_field ?? "", json.stringify(rules), json.stringify(states), json.stringify(transitions), table, now())
        objects_ready()
        sync_table(key)
        key
    } else {
        let site = site_config(o.site ?? {})?
        db.exec("update objects set name = ?, plural = ?, icon = ?, description = ?, title_field = ?, rules = ?, states = ?, transitions = ?, site = ? where id = ?",
            name, plural, blank(o.icon) ? "◆" : trim(o.icon), trim(o.description ?? ""), o.title_field ?? "", json.stringify(rules), json.stringify(states), json.stringify(transitions), json.stringify(site), o.id)
        // Records in a state that is gone start over in the first one.
        if len(states) > 0 {
            for r in rec_all(o.key, 100000) | filter((r) => !contains(keys_of, r.state)) => rec_set(o.key, r.id, { state: states[0].key })
        }
        o.key
    }
}

// Deletes an object with its fields and records.
server fn delete_object(key: str) {
    need_designer()?
    let linking = db.query("select entity, label, options from custom_fields where type = 'record' and entity != ?", `obj.${key}`)
        | filter((f) => (parsed(f.options, [])[0] ?? "") == key)
    if len(linking) > 0 {
        let o = db.one("select name from objects where key = ?", slice(linking[0].entity, 4))
        return err(`${o == null ? "Another object" : o.name}'s field ${linking[0].label} links to it: remove that field first`)
    }
    db.transaction(() => {
        drop_table(key)
        db.exec("delete from custom_fields where entity = ?", `obj.${key}`)
        db.exec("delete from objects where key = ?", key)
    })
    true
}

server fn move_field(id: int, by: int) {
    need_designer()?
    let f = (db.one("select * from custom_fields where id = ?", id) ?? err("No such field"))?
    let all = db.query("select id from custom_fields where entity = ? order by position, id", f.entity) | map((r) => r.id)
    let i = index_of(all, id) ?? 0
    let j = clamp_int(i + by, 0, len(all) - 1)
    let order = all | enumerate | map((x) => x[0] == i ? all[j] : x[0] == j ? all[i] : x[1])
    for [n, fid] in enumerate(order) => db.exec("update custom_fields set position = ? where id = ?", n, fid)
    true
}

// Objects to start from: their fields and rules.
let OBJECT_TEMPLATES = [
    { name: "Event", plural: "Events", icon: "◷", description: "Things you run: launches, readings, open days.", title: "name",
      fields: [["name", "Name", "text", true, []], ["starts", "Starts", "date", true, []], ["ends", "Ends", "date", false, []], ["venue", "Venue", "text", false, []],
               ["capacity", "Capacity", "number", false, []], ["organizer", "Organizer", "contact", false, []], ["status", "Status", "select", false, ["planned", "open", "full", "done"]]],
      rules: [{ if: null, then: { field: "ends", op: "after", value: "@starts" }, message: "It ends after it starts", warning: false },
              { if: { field: "status", op: "is", value: "full" }, then: { field: "capacity", op: "is filled", value: "" }, message: "A full event needs its capacity", warning: false }] },
    { name: "Ticket", plural: "Tickets", icon: "✚", description: "Questions and problems from customers, until they are solved.", title: "subject",
      fields: [["subject", "Subject", "text", true, []], ["customer", "Customer", "contact", true, []], ["priority", "Priority", "select", true, ["low", "normal", "high", "urgent"]],
               ["status", "Status", "select", true, ["new", "open", "waiting", "solved"]], ["details", "Details", "textarea", false, []], ["due", "Due", "date", false, []]],
      rules: [{ if: { field: "priority", op: "is", value: "urgent" }, then: { field: "due", op: "is filled", value: "" }, message: "An urgent ticket needs a due date", warning: false },
              { if: null, then: { field: "subject", op: "shorter than", value: "120" }, message: "Keep the subject short", warning: true }] },
    { name: "Property", plural: "Properties", icon: "⌂", description: "Places you sell or let.", title: "address",
      fields: [["address", "Address", "text", true, []], ["price", "Price", "money", true, []], ["bedrooms", "Bedrooms", "number", false, []],
               ["owner", "Owner", "contact", false, []], ["agency", "Agency", "company", false, []], ["listing", "Listing", "url", false, []]],
      rules: [{ if: null, then: { field: "price", op: "more than", value: "0" }, message: "A price above zero", warning: false }] },
    { name: "Story pitch", plural: "Story pitches", icon: "✎", description: "Ideas for stories, from pitch to published.", title: "headline",
      fields: [["headline", "Headline", "text", true, []], ["reporter", "Reporter", "email", true, []], ["desk", "Desk", "select", true, ["politics", "business", "sport", "culture"]],
               ["stage", "Stage", "select", true, ["pitched", "assigned", "filed", "published"]], ["deadline", "Deadline", "date", false, []], ["source", "Source", "contact", false, []]],
      rules: [{ if: { field: "stage", op: "is", value: "assigned" }, then: { field: "deadline", op: "is filled", value: "" }, message: "An assigned story needs a deadline", warning: false }] },
]

server fn object_templates() = OBJECT_TEMPLATES | map((t) => { name: t.name, icon: t.icon, description: t.description, fields: t.fields | map((f) => f[1]) })

server fn create_from_template(name: str) {
    need_designer()?
    let t = (find(OBJECT_TEMPLATES, (x) => x.name == name) ?? err("No such template"))?
    let key = (save_object({ name: t.name, plural: t.plural, icon: t.icon, description: t.description, title_field: t.title, rules: t.rules }))?
    for [i, f] in enumerate(t.fields) =>
        db.exec("insert into custom_fields (entity, key, label, type, required, options, position) values (?, ?, ?, ?, ?, ?, ?)",
            `obj.${key}`, f[0], f[1], f[2], f[3] ? 1 : 0, json.stringify(f[4]), i)
    sync_table(key)
    key
}

// ---- records ---------------------------------------------------------------------------

// What the record forms choose from, for their link fields.
server fn link_choices(key: str) {
    let u = need_user()?
    objects_ready()
    let fields = object_fields(key)
    let targets = fields | filter((f) => f.type == "record") | map((f) => (f.options ?? [])[0] ?? "") | unique
    {
        contact: any(fields, (f) => f.type == "contact") ? db.query("select id, first_name, last_name, email from contacts order by first_name, last_name limit 1000")
            | map((c) => { value: str(c.id), label: blank(`${c.first_name}${c.last_name}`) ? c.email : `${trim(`${c.first_name} ${c.last_name}`)} (${c.email})` }) : [],
        person: any(fields, (f) => f.type == "person") ? db.query("select id, name, email from users order by name") | map((x) => { value: str(x.id), label: x.name }) : [],
        company: any(fields, (f) => f.type == "company") ? db.query("select id, name from companies order by name limit 1000") | map((c) => { value: str(c.id), label: c.name }) : [],
        records: targets | reduce({}, (m, t) => set(m, t, !allows(access_to(u, t).level, "read") ? [] : rec_all(t, 1000)
            | filter((r) => may_see(u, access_to(u, t), r)) | sort_by((r) => lower(r.title)) | map((r) => { value: str(r.id), label: r.title }))),
    }
}

server fn list_records(key: str, q: str) {
    let u = need_user()?
    let a = need_access(u, key, "read", null)?
    let words = lower(trim(q))
    let fields = object_fields(key)
    rec_all(key, 500)
        | map((r) => set(r, "fields", fill_lookups(fields, r.fields)))
        | filter((r) => may_see(u, a, r))
        | map((r) => as_seen(a, r))
        | filter((r) => words == "" || contains(lower(r.title), words) || contains(lower(json.stringify(r.fields)), words))
        | map((r) => set(r, "names", link_names(fields, r.fields)))
}

// A record, with the names of what it links to and what links to it.
server fn get_record(key: str, id: int) {
    let u = need_user()?
    need_object(key)?
    let r0 = (rec_get(key, id) ?? err("No such record"))?
    let r = set(r0, "fields", fill_lookups(object_fields(key), r0.fields))
    let a = need_access(u, key, "read", r)?
    let o = need_object(key)?
    let seen = as_seen(a, r)
    merge(seen, { names: link_names(object_fields(key), seen.fields), linked: records_linking(u, "record", id, key), can: a.level,
        moves: moves_for(u, o, r) | map((t) => remove(remove(t, "groups"), "roles")), comments: open_annotations(key, id) })
}

// "Ada Lovelace" for a contact field's id, and so on.
fn link_names(fields: list, values: map) = fields | filter((f) => contains(LINK_TYPES, f.type) && !blank(values[f.key])) | reduce({}, (m, f) => {
    let id = int(values[f.key]) ?? 0
    let row = match f.type {
        "contact" => db.one("select trim(first_name || ' ' || last_name) as name, id from contacts where id = ?", id)
        "company" => db.one("select name, id from companies where id = ?", id)
        "person" => db.one("select name, id from users where id = ?", id)
        _ => { let t = rec_title((f.options ?? [])[0] ?? "", id); t == null ? null : { name: t, id } }
    }
    set(m, f.key, row == null ? "(deleted)" : row.name)
})

// The records whose link fields point at a contact, a company, or a record
// (`target`: the record's object), each with its object.
fn records_linking(u, kind: str, id: int, target: str = "") {
    objects_ready()
    let fields = db.query("select * from custom_fields where entity like 'obj.%' and type = ?", kind)
        | map((f) => merge(f, { options: parsed(f.options, []) }))
        | filter((f) => kind != "record" || (f.options[0] ?? "") == target)
    let objects = objects_all()
    fields | map((f) => {
        let key = slice(f.entity, 4)
        let o = find(objects, (x) => x.key == key)
        let a = access_to(u, key)
        !allows(a.level, "read") ? [] : rec_where(key, f.key, id)
            | filter((r) => may_see(u, a, r))
            | map((r) => { id: r.id, title: r.title, object: key, name: o == null ? key : o.name, icon: o == null ? "◆" : o.icon, via: f.label })
    }) | flatten
}

server fn records_of_contact(id: int) {
    let u = need_user()?
    records_linking(u, "contact", id)
}

server fn records_of_company(id: int) {
    let u = need_user()?
    records_linking(u, "company", id)
}

// The context a record's rules run in: the workspace's, with its objects.
fn object_ctx() = rule_ctx({ objects: objects_all() })

// Values as their fields' types have them (only the fields given).
fn typed_values(fields: list, given: map) = fields | filter((f) => f.type != "lookup") | reduce({}, (m, f) => {
    let v = given[f.key]
    set(m, f.key, blank(v) ? null : match f.type {
        "number" => as_num(v)
        "money" => as_num(v)
        "checkbox" => v == true
        // Links are ids; what is not one stays as it was given, for the
        // rules to refuse ("choose a contact").
        "contact" => int(v) ?? v
        "company" => int(v) ?? v
        "record" => int(v) ?? v
        "person" => int(v) ?? v
        // A picture: the media value (its key, size, crop) as it was chosen.
        "image" => type_of(v) == "map" ? v : null
        "markdown" => str(v)
        _ => trim(str(v))
    })
})

// What refuses a record: its rules (the designer's, its fields', plugins'),
// links that lead nowhere, and its fields' rule scripts.
fn record_problems(key: str, fields: list, values: map, state: str, id, u) {
    let ruled = errors_of(validate(`obj.${key}`, { fields: values, state }, object_ctx()))
    if len(ruled) > 0 { return ruled }
    let missing = fields | filter((f) => contains(LINK_TYPES, f.type) && !blank(values[f.key])) | filter((f) => {
        let lid = int(values[f.key]) ?? 0
        match f.type {
            "contact" => db.one("select id from contacts where id = ?", lid) == null
            "company" => db.one("select id from companies where id = ?", lid) == null
            "person" => db.one("select id from users where id = ?", lid) == null
            _ => rec_title((f.options ?? [])[0] ?? "", lid) == null
        }
    }) | map((f) => problem(`fields.${f.key}`, `${f.label}: that one no longer exists`)) | flatten
    if len(missing) > 0 { return missing }
    errors_of(field_script_problems(key, fields, merge(values, { state }), id, u))
}

fn first_contact(fields: list, values: map) {
    let f = find(fields, (x) => x.type == "contact" && !blank(values[x.key]))
    f == null ? null : int(values[f.key])
}

// Saving a record: its fields, as far as the person may edit them. Its
// state is not a field: it changes only by a move (`move_record`).
server fn save_record(key: str, r: map) {
    let u = need_user()?
    let o = need_object(key)?
    let before = r.id == null ? null : rec_get(key, r.id)
    if r.id != null && before == null { return err("No such record") }
    let a = need_access(u, key, "edit", before)?
    let fields = object_fields(key)
    let typed = typed_values(fields, r.fields ?? {})
    // Fields their roles let them read, or not see, keep what they held.
    let kept = fields | filter((f) => f.type != "lookup") | reduce(typed, (m, f) =>
        field_level(a, f.key) == "edit" ? m : set(m, f.key, before == null ? null : before.fields[f.key]))
    let values = fill_lookups(fields, kept)
    let state = before == null ? ((o.states[0] ?? {}).key ?? "") : before.state
    let problems = record_problems(key, fields, values, state, r.id, u)
    if len(problems) > 0 { return err({ problems }) }
    let id = if r.id == null {
        rec_insert(key, values, state, u.id)
    } else {
        let w = rec_update(key, r.id, values)
        is_err(w) ? w : r.id
    }
    if is_err(id) { return err({ problems: store_problems(key, id) }) }
    rec_set(key, id, { title: record_title(o, fields, values, id) })
    // Flows: a record added or changed, with the first contact it links to.
    let contact_id = first_contact(fields, values)
    if contact_id != null { note_activity("record", contact_id, null, `${o.name} ${r.id == null ? "added" : "changed"}: ${record_title(o, fields, values, id)}`) }
    fire(r.id == null ? "record_created" : "record_updated", { object: key, record_id: id, contact_id })
    drain_runs()
    // A flow may have removed it meanwhile.
    as_seen(a, (rec_get(key, id) ?? err("It was removed as it was saved"))?)
}

// ---- states, and the moves between them ----------------------------------------------------

// Who may make a move: the groups and roles it names (none named: anyone
// who may edit the object's records), and owners and admins.
// A move for groups no one is in (a writer working alone) is anyone's who
// may edit.
fn may_move(u, o: map, t: map) {
    if u.role != "member" { return true }
    let staffed = len(t.roles ?? []) > 0 || any(t.groups ?? [], (g) => len(group_out(db.one("select * from groups where id = ?", g) ?? { members: "[]", roles: "[]", capabilities: "[]" }).members) > 0)
    staffed ? any(t.groups ?? [], (g) => in_group(u, g)) || any(t.roles ?? [], (rid) => has_role(u, rid))
        : allows(access_to(u, o.key).level, "edit")
}

// The moves `u` may make with the record now.
fn moves_for(u, o: map, r: map) = (o.transitions ?? []) | filter((t) => (len(t.from ?? []) == 0 || contains(t.from, r.state)) && may_move(u, o, t))

// The fields its list shows, in the order of its fields (none: the first
// few short ones).
server fn set_list_fields(key: str, keys: list) {
    need_designer()?
    need_object(key)?
    let known = object_fields(key) | map((f) => f.key)
    let kept = known | filter((k) => contains(keys, k))
    db.exec("update objects set list_fields = ? where key = ?", json.stringify(kept), key)
    kept
}

// Renames an object's table. Its records, links to it (the database
// changes those) and everything that names the object by its key stay as
// they are; SQL of your own (reports, scripts) that names the table does not.
server fn rename_object_table(key: str, name: str) {
    need_designer()?
    need_object(key)?
    let from = tbl(key)
    let to = table_name(name)
    let p = table_problem(to, key)
    if p != null { return err({ problems: p }) }
    if to == from { return to }
    let done = db.transaction(() => {
        db.exec(`alter table ${sql_name(from)} rename to ${sql_name(to)}`)?
        db.exec("update objects set table_name = ? where key = ?", to, key)?
        to
    })
    is_err(done) ? err({ problems: problem("table", `It was not renamed: ${done.error}`) }) : to
}

// A move: the only way a record's state changes. Its form gives the
// fields it asks for (each one needed); the record's rules then hold in
// the state it goes to.
server fn move_record(key: str, id: int, move: str, given: map) {
    let u = need_user()?
    let o = need_object(key)?
    let before = (rec_get(key, id) ?? err("No such record"))?
    let a = need_access(u, key, "read", before)?
    let t = (find(moves_for(u, o, before), (x) => x.key == move) ?? err("You may not make this move now"))?
    let fields = object_fields(key)
    let asked = fields | filter((f) => contains(t.fields ?? [], f.key) && field_level(a, f.key) != "hidden")
    let typed = typed_values(asked, given ?? {})
    let empty = asked | filter((f) => blank(typed[f.key])) | map((f) => problem(`fields.${f.key}`, `${f.label}: needed to ${lower(t.label)}`)) | flatten
    if len(empty) > 0 { return err({ problems: empty }) }
    let values = fill_lookups(fields, merge(before.fields, typed))
    let problems = record_problems(key, fields, values, t.to, id, u)
    if len(problems) > 0 { return err({ problems }) }
    let w = rec_update(key, id, values)
    if is_err(w) { return err({ problems: store_problems(key, w) }) }
    rec_set(key, id, { state: t.to, title: record_title(o, fields, values, id) })
    hand_over(o, (rec_get(key, id) ?? err("No such record"))?, u, t.label)
    let label = (find(o.states, (st) => st.key == t.to) ?? { label: t.to }).label
    let contact_id = first_contact(fields, values)
    if contact_id != null { note_activity("record", contact_id, null, `${o.name} “${record_title(o, fields, values, id)}”: ${t.label} (now ${label})`) }
    fire("record_moved", { object: key, record_id: id, from: before.state, to: t.to, move: t.key, contact_id })
    drain_runs()
    as_seen(a, (rec_get(key, id) ?? err("It was removed as it moved"))?)
}

server fn delete_record(key: str, id: int) {
    let u = need_user()?
    let r = (rec_get(key, id) ?? err("No such record"))?
    need_access(u, key, "delete", r)?
    rec_delete(key, id)
    true
}

fn records_csv(key: str) {
    let u = current_user()
    let a = access_to(u, key)
    if !allows(a.level, "read") { return respond(403, "Your role may not see these records", {}) }
    let fields = object_fields(key)
    let rows = sort_by(rec_all(key, 1000000), (r) => r.id) | filter((r) => may_see(u, a, r))
        | map((r) => csv_row([str(r.id), r.title] + (fields | map((f) => str(r.fields[f.key] ?? "")))))
    respond(200, join([csv_row(["id", "title"] + (fields | map((f) => f.key)))] + rows, "\n") + "\n",
        { "content-type": "text/csv; charset=utf-8", "content-disposition": `attachment; filename=${key}.csv` })
}

// ---- models plugins bring --------------------------------------------------------------

// A plugin's model (groups, objects with their fields, states, moves and
// site), made where the workspace does not have it yet: what it has, it
// keeps as it designed it.
fn install_model(model) {
    if model == null { return true }
    objects_ready()
    for g in model.groups ?? [] => {
        if db.one("select id from groups where lower(name) = ?", lower(g.name)) == null {
            db.exec("insert into groups (name, members, roles, capabilities, created_at) values (?, '[]', '[]', ?, ?)", g.name, json.stringify(g.capabilities ?? []), now())
        }
    }
    let gid = (name) => (db.one("select id from groups where lower(name) = ?", lower(name)) ?? {}).id
    for o in model.objects ?? [] => {
        if db.one("select id from objects where key = ?", o.key) == null {
            let moves = (o.moves ?? []) | map((t) => { key: t.key, label: t.label, from: t.from ?? [], to: t.to,
                groups: (t.groups ?? []) | map(gid) | filter((x) => x != null), roles: [], fields: t.fields ?? [] })
            db.exec("insert into objects (key, name, plural, icon, description, title_field, rules, states, transitions, site, created_at) values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
                o.key, o.name, o.plural, o.icon ?? "◆", o.description ?? "", o.title ?? "", json.stringify(o.rules ?? []), json.stringify(o.states ?? []),
                json.stringify(moves), json.stringify(o.site ?? {}), now())
            for [i, f] in enumerate(o.fields ?? []) =>
                db.exec("insert into custom_fields (entity, key, label, type, required, options, is_unique, position) values (?, ?, ?, ?, ?, ?, ?, ?)",
                    `obj.${o.key}`, f.key, f.label, f.type, f.required == true ? 1 : 0, json.stringify(f.target != null ? [f.target] : f.options ?? []), f.unique == true ? 1 : 0, i)
            sync_table(o.key)
        }
    }
    true
}

fn install_models(ids: list) = plugins | filter((p) => p.model != null && contains(ids, p.id)) | map((p) => install_model(p.model))
