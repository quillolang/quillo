// Review: anyone who may read a record can mark any of its text (a few
// words of the headline, a sentence of the body) or any of its pictures,
// and comment on it; comments are threads, answered and resolved. Moves
// (a reviewer's "Send back", a writer's "Submit") carry the record between
// them: the comments stay with it until they are resolved.

let REVIEW_TYPES = ["text", "textarea", "markdown", "image", "email", "url"]

fn note_out(r) = merge(r, { resolved: r.resolved_at != null })

// The record as reviewers read it: each text field as text, Markdown as
// it reads, pictures as pictures.
server fn review_view(key: str, id: int) {
    let u = need_user()?
    let o = need_object(key)?
    let r = (rec_get(key, id) ?? err("No such record"))?
    let a = need_access(u, key, "read", r)?
    let fields = object_fields(key) | filter((f) => contains(REVIEW_TYPES, f.type) && field_level(a, f.key) != "hidden")
    // The site's order first: headline, summary, picture, caption, body.
    let s = o.site ?? {}
    let first = [s.title, s.summary, s.image, s.caption, s.body] | filter((k) => !blank(k))
    let ordered = (first | map((k) => find(fields, (f) => f.key == k)) | filter((f) => f != null)) + (fields | filter((f) => !contains(first, f.key)))
    ordered | map((f) => {
        let v = r.fields[f.key]
        {
            key: f.key, label: f.label, type: f.type,
            role: f.key == s.title ? "headline" : f.key == s.summary ? "summary" : f.key == s.body ? "body" : f.key == s.caption ? "caption" : "",
            html: v == null || v == "" ? "" : match f.type {
                "markdown" => str(markdown(str(v)))
                "image" => type_of(v) == "map" ? `<img src="${escape(media_src(v, crop_text(v), 960))}" alt="${escape(v.alt ?? "")}">` : ""
                _ => escape(str(v))
            },
        }
    })
}

server fn list_annotations(key: str, id: int) {
    let u = need_user()?
    let r = (rec_get(key, id) ?? err("No such record"))?
    need_access(u, key, "read", r)?
    let all = db.query("select a.*, u.name as author, ru.name as resolver from annotations a left join users u on u.id = a.author_id left join users ru on ru.id = a.resolved_by
                        where a.object = ? and a.record_id = ? order by a.created_at", key, id) | map(note_out)
    all | filter((x) => x.parent_id == null) | map((x) => merge(x, { replies: all | filter((y) => y.parent_id == x.id) }))
}

// A comment on a field's text (`quote`, found again by `prefix`, the text
// just before it) or on a picture (`image`).
server fn add_annotation(key: str, id: int, a: map) {
    let u = need_user()?
    let r = (rec_get(key, id) ?? err("No such record"))?
    let acc = need_access(u, key, "read", r)?
    let f = find(object_fields(key), (x) => x.key == a.field && contains(REVIEW_TYPES, x.type) && field_level(acc, x.key) != "hidden")
    if f == null { return err({ problems: problem("field", "Mark some of the record's text, or a picture") }) }
    if blank(a.body) { return err({ problems: problem("body", "Write your comment") }) }
    if len(a.quote ?? "") > 2000 { return err({ problems: problem("quote", "Mark less text (at most 2,000 characters)") }) }
    db.exec("insert into annotations (object, record_id, field, quote, prefix, image, body, author_id, created_at) values (?, ?, ?, ?, ?, ?, ?, ?, ?)",
        key, id, f.key, a.quote ?? "", last_chars(str(a.prefix ?? ""), 40), a.image ?? "", trim(a.body), u.id, now()).last_id
}

fn last_chars(s: str, n: int) = len(s) <= n ? s : slice(s, len(s) - n)


server fn reply_annotation(parent: int, body: str) {
    let u = need_user()?
    let p = (db.one("select * from annotations where id = ? and parent_id is null", parent) ?? err("No such comment"))?
    let r = (rec_get(p.object, p.record_id) ?? err("No such record"))?
    need_access(u, p.object, "read", r)?
    if blank(body) { return err({ problems: problem("body", "Write your reply") }) }
    db.exec("insert into annotations (object, record_id, field, quote, prefix, image, body, parent_id, author_id, created_at) values (?, ?, ?, '', '', '', ?, ?, ?, ?)",
        p.object, p.record_id, p.field, trim(body), parent, u.id, now()).last_id
}

server fn resolve_annotation(id: int, resolved: bool) {
    let u = need_user()?
    let p = (db.one("select * from annotations where id = ?", id) ?? err("No such comment"))?
    let r = (rec_get(p.object, p.record_id) ?? err("No such record"))?
    need_access(u, p.object, "read", r)?
    db.exec("update annotations set resolved_at = ?, resolved_by = ? where id = ?", resolved ? now() : null, resolved ? u.id : null, id)
    true
}

server fn delete_annotation(id: int) {
    let u = need_user()?
    let p = (db.one("select * from annotations where id = ?", id) ?? err("No such comment"))?
    if p.author_id != u.id && u.role == "member" { return err("Only its author removes a comment") }
    db.exec("delete from annotations where id = ? or parent_id = ?", id, id)
    true
}

fn open_annotations(key: str, id: int) = (db.one("select count(*) as n from annotations where object = ? and record_id = ? and parent_id is null and resolved_at is null", key, id) ?? {}).n ?? 0

// ---- moves tell people ---------------------------------------------------------------------

// Who a move hands the record to: the people who may make its next moves
// (named in them, by group or role), and its writer, if someone else moved it.
fn hand_over(o: map, r: map, mover, move_label: str) {
    let users = db.query("select id, email, name, role, role_id from users")
    let named = (t) => len(t.groups ?? []) + len(t.roles ?? []) > 0
    let next = (o.transitions ?? []) | filter((t) => (len(t.from ?? []) == 0 || contains(t.from, r.state)) && named(t))
    let to = users | filter((u) => any(next, (t) => any(t.groups ?? [], (g) => in_group(u, g)) || any(t.roles ?? [], (rid) => any(roles_of(u), (x) => x.id == rid))))
        | map((u) => u.id)
    let writer = r.owner_id == null ? [] : [r.owner_id]
    let state = (find(o.states, (st) => st.key == r.state) ?? { label: r.state }).label
    let open = open_annotations(o.key, r.id)
    tell(unique(to + writer), mover.id, `${o.name} “${r.title}”: ${state}`,
        `${mover.name} chose “${move_label}”: it is ${lower(state)} now.${open > 0 ? ` ${plural(open, "open comment")} on it.` : ""}`)
}

// What waits for this person: records whose next move names a group or a
// role they are in (owners and admins: what names no one in particular).
server fn my_records_queue() {
    let u = need_user()?
    objects_ready()
    let mine = (t) => any(t.groups ?? [], (g) => in_group(u, g)) || any(t.roles ?? [], (rid) => any(roles_of(u), (x) => x.id == rid))
    objects_all() | filter((o) => len(o.transitions ?? []) > 0) | map((o) => {
        let a = access_to(u, o.key)
        rec_all(o.key, 300) | filter((r) => may_see(u, a, r)) | map((r) => {
            let moves = (o.transitions ?? []) | filter((t) => (len(t.from ?? []) == 0 || contains(t.from, r.state)) && mine(t))
            len(moves) == 0 ? [] : [{ object: o.key, name: o.name, icon: o.icon, id: r.id, title: r.title,
                state: (find(o.states, (st) => st.key == r.state) ?? { label: r.state }).label, moves: moves | map((t) => t.label),
                comments: open_annotations(o.key, r.id), updated_at: r.updated_at }]
        }) | flatten
    }) | flatten | sort_by((x) => -(x.updated_at ?? 0))
}
