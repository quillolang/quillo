// The audit log: who signed in, changed the team, settings, pages and
// flows, or deleted and exported data. Quillo keeps it (`audit`) in each
// workspace's database, each row chained to the one before, so a row
// changed afterwards shows when the log is checked.

// A change and its row in the audit log, in one transaction: both or
// neither. `details` is a map, or a function of what the change gave (a
// new row's id, say).
fn audited(action: str, details, change) = db.transaction(() => {
    let r = change()
    if is_err(r) { return r }
    audit(action, type_of(details) == "fn" ? details(r) : details)?
    r
})

// The log, newest first, 50 rows at a time, with who each was.
server fn list_audit(filter: map) {
    need_admin()?
    let rows = audit.query({ action: blank(filter.action ?? "") ? null : trim(filter.action), before: filter.before, limit: 50 })?
    let people = db.query("select id, name, email from users")
    rows | map((r) => {
        let u = find(people, (p) => str(p.id) == r.actor)
        set(r, "who", u != null ? u.name : r.actor ?? "")
    })
}

// Whether every row still follows from the one before.
server fn check_audit() {
    need_admin()?
    audit.verify()
}
