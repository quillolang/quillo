// Feedback on a page, from its live preview (/preview/<token>): whoever has
// the link — a customer — chooses a block, draws on a snapshot of it and
// says what they think. The team sees each as a to-do in the page designer,
// acknowledges it and talks it over; both sides see the talk as it goes
// (`live`); the viewer marks it resolved. The snapshot is the block as the
// server rendered it then, and the drawing, strokes measured in its size.

let FEEDBACK_COLORS = ["#e11d48", "#2563eb", "#16a34a"]

fn feedback_page(token: str) = blank(token) ? null : page_out(db.one("select * from pages where preview_token = ?", token))

fn feedback_out(f) = merge(f, { strokes: parsed(f.strokes, []) })

fn feedback_of(page_id: int) {
    let items = db.query("select f.*, u.name as acknowledger from page_feedback f left join users u on u.id = f.acknowledged_by where f.page_id = ? order by f.created_at desc", page_id)
    let replies = db.query("select r.* from page_feedback_replies r join page_feedback f on f.id = r.feedback_id where f.page_id = ? order by r.created_at", page_id)
    items | map((f) => merge(feedback_out(f), { replies: replies | filter((r) => r.feedback_id == f.id) | map((r) => merge(r, { team: r.user_id != null })) }))
}

// The strokes as given: a few colours, points inside the block, not too many.
fn clean_strokes(given, w: int, h: int) = (type_of(given) == "list" ? given : []) | take(200) | map((s) => {
    color: contains(FEEDBACK_COLORS, s.color) ? s.color : FEEDBACK_COLORS[0],
    points: (type_of(s.points) == "list" ? s.points : []) | take(2000) | map((pt) => [
        min([w, max([0, round(float(pt[0]) ?? 0)])]), min([h, max([0, round(float(pt[1]) ?? 0)])])]),
}) | filter((s) => len(s.points) > 0)

// ---- the viewer (by the preview's link) -----------------------------------------------------

server fn preview_feedback(token: str) {
    let p = feedback_page(token) ?? err("This preview link is no longer in use")
    if is_err(p) { return p }
    feedback_of(p.id)
}

// Feedback on a block: rendered here, from the page as it is now.
server fn give_feedback(token: str, f: map) {
    let p = (feedback_page(token) ?? err("This preview link is no longer in use"))?
    let name = slice(trim(str(f.author ?? "")), 0, 60)
    let body = slice(trim(str(f.body ?? "")), 0, 4000)
    if blank(name) { return err({ problems: problem("author", "Your name, so they know who said it") }) }
    if blank(body) { return err({ problems: problem("body", "Say what you think of it") }) }
    let l = db.one("select * from page_live where page_id = ?", p.id)
    let blocks = l != null && l.updated_at >= p.updated_at ? parsed(l.blocks, []) : p.draft.blocks ?? []
    let b = (find(flat_blocks(upgrade_blocks(blocks)), (x) => x.id == str(f.block)) ?? err("That block is no longer on the page"))?
    let w = min([2400, max([40, int(f.width) ?? 800])])
    let h = min([4000, max([20, int(f.height) ?? 300])])
    let markup = str(render_block(b, merge(render_ctx(false), { live: true })))
    let id = db.exec("insert into page_feedback (page_id, block_id, block_html, width, height, strokes, body, author, created_at) values (?, ?, ?, ?, ?, ?, ?, ?, ?)",
        p.id, b.id, markup, w, h, json.stringify(clean_strokes(f.strokes, w, h)), body, name, now()).last_id
    feedback_told(p, name, body)
    id
}

server fn viewer_reply(token: str, id: int, author: str, body: str) {
    let p = (feedback_page(token) ?? err("This preview link is no longer in use"))?
    if db.one("select id from page_feedback where id = ? and page_id = ?", id, p.id) == null { return err("No such feedback") }
    if blank(author) { return err({ problems: problem("author", "Your name, so they know who said it") }) }
    if blank(body) { return err({ problems: problem("body", "Write your reply") }) }
    db.exec("insert into page_feedback_replies (feedback_id, body, author, created_at) values (?, ?, ?, ?)", id, slice(trim(body), 0, 4000), slice(trim(author), 0, 60), now()).last_id
}

// The viewer's to decide: resolved, or open again.
server fn resolve_feedback(token: str, id: int, resolved: bool) {
    let p = (feedback_page(token) ?? err("This preview link is no longer in use"))?
    let f = (db.one("select * from page_feedback where id = ? and page_id = ?", id, p.id) ?? err("No such feedback"))?
    db.exec("update page_feedback set status = ?, resolved_at = ? where id = ?",
        resolved ? "resolved" : (f.acknowledged_by == null ? "open" : "acknowledged"), resolved ? now() : null, id)
    true
}

// ---- the team (in the page designer) ---------------------------------------------------------

server fn page_feedback(id: int) {
    need_user()?
    feedback_of(id)
}

server fn acknowledge_feedback(id: int) {
    let u = need_user()?
    let f = (db.one("select * from page_feedback where id = ?", id) ?? err("No such feedback"))?
    db.exec("update page_feedback set acknowledged_by = ?, status = ? where id = ?", u.id, f.status == "resolved" ? "resolved" : "acknowledged", id)
    true
}

server fn team_reply(id: int, body: str) {
    let u = need_user()?
    if db.one("select id from page_feedback where id = ?", id) == null { return err("No such feedback") }
    if blank(body) { return err({ problems: problem("body", "Write your reply") }) }
    db.exec("insert into page_feedback_replies (feedback_id, body, author, user_id, created_at) values (?, ?, ?, ?, ?)", id, slice(trim(body), 0, 4000), u.name, u.id, now()).last_id
}

// Told by mail: those who opened the page lately (else the owners).
fn feedback_told(p: map, name: str, body: str) {
    let seen = db.query("select distinct user_id from recents where kind = 'page' and ref = ? and at > ?", str(p.id), now() - 14 * DAY) | map((r) => r.user_id)
    let to = len(seen) > 0 ? seen : db.query("select id from users where role = 'owner'") | map((r) => r.id)
    let link = `${site_url()}/app/pages/${p.id}`
    for r in db.query("select id, email from users") | filter((x) => contains(to, x.id)) =>
        queue_mail(r.email, `Feedback on “${p.title}” from ${name}`, `<p>${escape(name)} says: “${escape(body)}”</p><p><a href="${escape(link)}">See it in the page designer</a></p>`, "system", null, null)
}
