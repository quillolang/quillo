// Loyalty points for merchants: a points field on contacts, and a flow step
// that awards them (a fixed number, or per currency unit spent).

let plugin_loyalty = {
    id: "loyalty",
    name: "Loyalty points",
    description: "Customers collect points; flows award them for purchases.",
    audience: ["merchant"],
    fields: [{ entity: "contact", key: "points", label: "Loyalty points", type: "number" }],
    rules: {
        contact: [(c, ctx) => {
            let p = (c.fields ?? {}).points
            when(!blank(p) && (is_err(int(p)) || int(p) < 0), problem("fields.points", "Points are a whole number, zero or more"))
        }],
    },
    steps: [{ type: "loyalty.award", label: "Award points", group: "Sell", outputs: ["out"], fields: [
        { key: "points", label: "Points (empty: one per unit spent)", type: "number" },
    ] }],
}

fn loyalty_award(config, run) {
    let c = contact_row(run.context.contact_id)
    if c == null { return { port: "out", log: "no contact" } }
    let order = run.context.order_id == null ? null : db.one("select total_cents from orders where id = ?", run.context.order_id)
    let points = !blank(config.points) ? int(config.points) ?? 0 : order == null ? 0 : floor(order.total_cents / 100)
    let fields = parsed(c.fields, {})
    let total = (int(fields.points) ?? 0) + points
    db.exec("update contacts set fields = ?, updated_at = ? where id = ?", json.stringify(set(fields, "points", total)), now(), c.id)
    note_activity("loyalty", c.id, null, `Earned ${points} points (now ${total})`)
    { port: "out", log: `awarded ${points} points` }
}

let runners_loyalty = { "loyalty.award": loyalty_award }
