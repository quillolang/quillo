// Memberships for bloggers and news outlets: a subscription product makes
// the buyer a member until a date; flows grant and end memberships.

let plugin_paywall = {
    id: "paywall",
    name: "Memberships",
    description: "Paid subscriptions make readers members; flows grant and end membership.",
    audience: ["blogger", "news"],
    fields: [{ entity: "contact", key: "member_until", label: "Member until", type: "date" }],
    rules: {
        product: [(p, ctx) => when(p.kind == "subscription" && p.price_cents == 0, warning("price", "A free subscription: members will not pay"))],
    },
    steps: [
        { type: "paywall.grant", label: "Grant membership", group: "Sell", outputs: ["out"], fields: [
            { key: "months", label: "Months (empty: by the product's interval)", type: "number" },
        ] },
        { type: "paywall.end", label: "End membership", group: "Sell", outputs: ["out"], fields: [] },
    ],
}

fn paywall_grant(config, run) {
    let c = contact_row(run.context.contact_id)
    if c == null { return { port: "out", log: "no contact" } }
    let order = run.context.order_id == null ? null : db.one("select items from orders where id = ?", run.context.order_id)
    let items = order == null ? [] : parsed(order.items, [])
    let yearly = any(items, (i) => i.interval == "year")
    let months = !blank(config.months) ? int(str(config.months)) ?? 1 : yearly ? 12 : 1
    let fields = parsed(c.fields, {})
    let from = max([now(), parse_day(fields.member_until ?? "") ?? 0])
    let until = iso_day(from + months * 30 * DAY)
    db.exec("update contacts set fields = ?, updated_at = ? where id = ?", json.stringify(set(fields, "member_until", until)), now(), c.id)
    add_tags(c.id, ["member"])
    note_activity("membership", c.id, null, `Member until ${fmt_day(until)}`)
    { port: "out", log: `member until ${until}` }
}

fn paywall_end(config, run) {
    let c = contact_row(run.context.contact_id)
    if c == null { return { port: "out", log: "no contact" } }
    db.exec("update contacts set fields = ?, updated_at = ? where id = ?", json.stringify(remove(parsed(c.fields, {}), "member_until")), now(), c.id)
    remove_tags(c.id, ["member"])
    { port: "out", log: "membership ended" }
}

let runners_paywall = { "paywall.grant": paywall_grant, "paywall.end": paywall_end }
