// Sponsorships for news outlets and bloggers: deals say where an ad runs
// and when; a won deal must have its run date.

let PLACEMENTS = ["Newsletter", "Article", "Homepage", "Podcast", "Social"]

let plugin_sponsors = {
    id: "sponsors",
    name: "Sponsorships",
    description: "Deals for ad placements: where it runs and when.",
    audience: ["news", "blogger"],
    blocks: [{ type: "sponsors.banner", label: "Sponsor banner", group: "Grow", fields: [
        { key: "name", label: "Sponsor", type: "text", required: true },
        { key: "logo", label: "Logo address", type: "url" },
        { key: "link", label: "Their site", type: "link", required: true },
        { key: "line", label: "One line about them", type: "text" },
    ] }],
    fields: [
        { entity: "deal", key: "placement", label: "Placement", type: "select", options: PLACEMENTS },
        { entity: "deal", key: "run_date", label: "Runs on", type: "date" },
    ],
    rules: {
        page: [(pg, ctx) => (pg.blocks ?? []) | filter((b) => b.type == "sponsors.banner" && starts_with(str((b.config ?? {}).link ?? ""), "/"))
            | map((b) => problem(`block.${b.id}`, "Sponsor banner: link to the sponsor's own site (https://...)")) | flatten],
        deal: [
            (d, ctx) => {
                let f = d.fields ?? {}
                when(ctx.stage_kind == "won" && !blank(f.placement) && blank(f.run_date), problem("fields.run_date", "A won sponsorship needs its run date"))
            },
            (d, ctx) => {
                let run = (d.fields ?? {}).run_date
                when(!blank(run) && parse_day(run) != null && !blank(ctx.today) && run < ctx.today && ctx.stage_kind == "open",
                    warning("fields.run_date", "This run date has passed"))
            },
        ],
    },
}

let runners_sponsors = {}

// Sponsored content says so, and its link is marked as paid (rel=sponsored).
let renderers_sponsors = {
    "sponsors.banner": (c, ctx) =>
        <aside.pb-sponsor>
            <span.pb-sponsor-label>Sponsored by</span>
            {!blank(c.logo) ? <img src={c.logo} alt={c.name}/> : <b data-edit={ed(ctx, "name")} data-hint={hint(ctx, "The sponsor")}>{c.name}</b>}
            {(!blank(c.line) || ctx.preview) && <span data-edit={ed(ctx, "line")} data-md={line_mark(ctx)} data-hint={hint(ctx, "One line about them")} data-optional={opt_mark(ctx)}>{line(c.line)}</span>}
            <a href={safe_link(c.link)} rel="sponsored noopener" target="_blank">Visit {c.name}</a>
        </aside>,
}
