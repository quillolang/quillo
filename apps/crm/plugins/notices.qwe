// More looks for how the app asks and tells: notice styles (see
// CORE_NOTICES), from a plugin like any other.

let plugin_notices = {
    id: "notices",
    name: "Notice styles",
    description: "More looks for the app's questions and notes: Glass and Bold.",
    audience: ["merchant", "blogger", "news"],
    notices: [
        { id: "glass", name: "Glass", description: "Frosted, over a blurred app; notes at the top.", dialog: "center", toasts: "top-center", css: "
.notice-glass .q-backdrop { background: rgba(15, 23, 42, .25); backdrop-filter: blur(6px); }
.notice-glass .q-dialog, .notice-glass .q-toast { background: rgba(255, 255, 255, .78); backdrop-filter: blur(14px) saturate(1.4); border: 1px solid rgba(255, 255, 255, .6); }
.notice-glass .q-dialog { border-radius: 20px; }
.notice-glass .q-toast { border-radius: 999px; padding-left: 18px; }
" },
        { id: "bold", name: "Bold", description: "A panel from the side, high contrast; notes at the bottom right.", dialog: "side", toasts: "bottom-right", css: "
.notice-bold .q-dialog { background: #111827; color: #f9fafb; border-radius: 0; }
.notice-bold .q-dialog .q-cancel { background: transparent; color: #f9fafb; border-color: #4b5563; }
.notice-bold .q-dialog.q-danger .q-ok { background: #ef4444; }
.notice-bold .q-toast { background: #111827; color: #f9fafb; border-left: 4px solid var(--brand); border-radius: 4px; }
.notice-bold .q-toast .q-close { color: #9ca3af; }
" },
    ],
}

