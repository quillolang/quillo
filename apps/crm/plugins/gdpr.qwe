// Consent: subscribing someone needs their recorded consent, public forms
// ask for it, and a flow can forget a contact entirely.

let plugin_gdpr = {
    id: "gdpr",
    name: "Consent (GDPR)",
    description: "Subscribing needs recorded consent; forms ask for it; flows can forget a contact.",
    audience: ["merchant", "blogger", "news"],
    fields: [
        { entity: "contact", key: "consent", label: "Agreed to email", type: "checkbox" },
        { entity: "contact", key: "consent_date", label: "Agreed on", type: "date" },
    ],
    form_fields: ["consent"],
    blocks: [{ type: "gdpr.privacy", label: "Privacy note", group: "Grow", fields: [
        { key: "contact", label: "Who to write to about their data (email)", type: "text", required: true },
    ] }],
    rules: {
        page: [(pg, ctx) => (pg.blocks ?? []) | filter((b) => b.type == "gdpr.privacy" && !blank((b.config ?? {}).contact) && !is_email((b.config ?? {}).contact))
            | map((b) => problem(`block.${b.id}`, "Privacy note: an email address to write to")) | flatten],
        contact: [(c, ctx) => when((c.subscribed == true || c.subscribed == 1) && (c.fields ?? {}).consent != true,
            problem("fields.consent", "Subscribing needs their consent: tick \"Agreed to email\""))],
        signup: [(s, ctx) => when(s.consent != true, problem("consent", "Please agree to receive our email"))],
    },
    steps: [{ type: "gdpr.forget", label: "Forget contact", group: "Contact", outputs: [], fields: [] }],
}

// Removes what identifies the contact, keeping orders' amounts for the books.
fn gdpr_forget(config, run) {
    let id = run.context.contact_id
    if id == null { return { port: null, log: "no contact to forget" } }
    db.exec("update contacts set first_name = '', last_name = 'Forgotten', email = '', phone = '', tags = '[]', fields = '{}', subscribed = 0, updated_at = ? where id = ?", now(), id)
    db.exec("delete from notes where contact_id = ?", id)
    db.exec("delete from form_submissions where contact_id = ?", id)
    { port: null, log: "forgot the contact" }
}

let runners_gdpr = { "gdpr.forget": gdpr_forget }

let renderers_gdpr = {
    "gdpr.privacy": (c, ctx) =>
        <section.pb-privacy>
            <p>We keep your email address only to write to you, and never sell it. Every email has an unsubscribe link.
                To see or erase what we hold about you, write to <a href={`mailto:${c.contact ?? ""}`}>{c.contact}</a>.</p>
        </section>,
}
