// The blog: posts (in the app's Posts), their pages at /blog, an RSS feed,
// members-only posts (with Memberships), and blocks that show the latest
// posts on any page.

let plugin_blog = {
    id: "blog",
    name: "Blog",
    description: "Posts with covers and tags, at /blog, with an RSS feed; members-only posts with Memberships.",
    audience: ["blogger", "news", "merchant"],
    blocks: [
        { type: "blog.latest", label: "Latest posts", group: "Content", fields: [
            { key: "heading", label: "Heading", type: "text" },
            { key: "count", label: "How many", type: "select", options: ["3", "6", "9"] },
            { key: "tag", label: "Only with tag", type: "text" },
        ] },
        { type: "blog.top", label: "Top stories", group: "News", fields: [
            { key: "heading", label: "Heading", type: "text" },
            { key: "category", label: "Only from category", type: "text" },
        ] },
        { type: "blog.category", label: "Category row", group: "News", fields: [
            { key: "category", label: "Category", type: "text", required: true, example: "politics" },
            { key: "heading", label: "Heading (empty: the category)", type: "text" },
            { key: "count", label: "How many", type: "select", options: ["3", "4", "6"] },
        ] },
        { type: "blog.popular", label: "Most read", group: "News", fields: [
            { key: "heading", label: "Heading", type: "text", example: "Most read" },
            { key: "count", label: "How many", type: "select", options: ["5", "3", "10"] },
        ] },
        { type: "blog.breaking", label: "Breaking news", group: "News", fields: [
            { key: "text", label: "Text", type: "text", required: true, example: "Polls close at 8pm: live results all night" },
            { key: "link", label: "Link", type: "link" },
            { key: "label", label: "Label", type: "text", example: "Breaking" },
        ] },
    ],
    rules: {
        post: [
            (p, ctx) => when(blank(p.title), problem("title", "A post needs a title")),
            (p, ctx) => when(len(p.title ?? "") > 70, warning("title", "Search results show about 60 characters")),
            (p, ctx) => blank(p.slug) ? problem("slug", "Choose its address")
                : slugify(p.slug) != p.slug ? problem("slug", "Lowercase letters, digits and dashes")
                : [],
            (p, ctx) => when(blank(p.body), problem("body", "Write the post")),
            (p, ctx) => when(len(p.excerpt ?? "") > 300, warning("excerpt", "An excerpt over 300 characters is a lot for a list of posts")),
            (p, ctx) => when(p.members_only == true && !contains(ctx.enabled ?? [], "paywall"), problem("members_only", "Members-only posts need the Memberships plugin")),
            (p, ctx) => {
                let c = p.cover
                when(type_of(c) == "map" && blank(c.alt) && blank(p.cover_alt), warning("cover", "Describe the cover for screen readers (in Media)"))
            },
        ],
        // A reader's comment, as the post page has it.
        comment: [
            (c, ctx) => when(blank(c.name), problem("name", "Your name, please")),
            (c, ctx) => when(!is_email(c.email ?? ""), problem("email", "Your email (it is not shown)")),
            (c, ctx) => when(len(trim(c.body ?? "")) < 2, problem("body", "Write your comment")),
            (c, ctx) => when(len(c.body ?? "") > 2000, problem("body", "At most 2,000 characters")),
            (c, ctx) => when(len(split(lower(c.body ?? ""), "http")) > 3, problem("body", "At most two links")),
        ],
        page: [
            (pg, ctx) => (pg.blocks ?? []) | filter((b) => contains(["blog.latest", "blog.top", "blog.popular"], b.type) && len(ctx.posts ?? []) == 0)
                | map((b) => warning(`block.${b.id}`, "There are no published posts yet")) | flatten,
            (pg, ctx) => (pg.blocks ?? []) | filter((b) => b.type == "blog.category" && !blank((b.config ?? {}).category)
                && !any(ctx.posts ?? [], (p) => p.category == slugify(b.config.category)))
                | map((b) => warning(`block.${b.id}`, `Category row: no published posts in “${b.config.category}” yet`)) | flatten,
        ],
    },
}

// A post's card in lists.
view BlogCard(p: map, lead: bool = false) =
    <article class={lead ? "blog-card is-lead" : "blog-card"}>
        <a href={`/blog/${p.slug}`}>
            {p.cover != null && p.cover != "" && <Picture v={p.cover} alt="" shown={lead ? 980 : 420}/>}
            {p.category != "" && <span.post-cat>{title_case(p.category)}</span>}
            <h3>{p.title}</h3>
        </a>
        <p.blog-meta>{fmt_date(p.published_at)}{p.members_only && <span.blog-members>Members</span>}</p>
        {p.excerpt != "" && <p>{p.excerpt}</p>}
    </article>

// A headline only, for dense lists.
view BlogLine(p: map, n: int = 0) =
    <li.blog-line>
        {n > 0 && <span.blog-n>{n}</span>}
        <div>{p.category != "" && <span.post-cat>{title_case(p.category)}</span>}<a href={`/blog/${p.slug}`}><b>{p.title}</b></a></div>
    </li>

let renderers_blog = {
    "blog.latest": (c, ctx) => {
        let n = int(c.count) ?? 3
        let tag = slugify(c.tag ?? "")
        let posts = (ctx.posts ?? []) | filter((p) => tag == "" || contains(p.tags, tag)) | take(n)
        <section.pb-blog>
            {(!blank(c.heading) || ctx.preview) && <h2 data-edit={ed(ctx, "heading")} data-md={line_mark(ctx)} data-hint={hint(ctx, "A heading")} data-optional={opt_mark(ctx)}>{line(c.heading)}</h2>}
            {len(posts) == 0 ? <p.pb-missing>No posts yet.</p> : <div.blog-grid>{for p in posts => <BlogCard {p}/>}</div>}
            <p.pb-center><a href={tag == "" ? "/blog" : `/blog?tag=${tag}`}>All posts →</a></p>
        </section>
    },
    // The lead story (the newest featured one, else the newest), and the
    // next four beside it.
    "blog.top": (c, ctx) => {
        let cat = slugify(c.category ?? "")
        let posts = (ctx.posts ?? []) | filter((p) => cat == "" || p.category == cat)
        let lead = find(posts, (p) => p.featured) ?? posts[0]
        let rest = posts | filter((p) => lead == null || p.id != lead.id) | take(4)
        <section.pb-top>
            {(!blank(c.heading) || ctx.preview) && <h2 data-edit={ed(ctx, "heading")} data-md={line_mark(ctx)} data-hint={hint(ctx, "A heading")} data-optional={opt_mark(ctx)}>{line(c.heading)}</h2>}
            {lead == null ? <p.pb-missing>No posts yet.</p> : <div.pb-top-grid>
                <BlogCard p={lead} lead={true}/>
                <ul.blog-lines>{for p in rest => <BlogLine {p}/>}</ul>
            </div>}
        </section>
    },
    "blog.category": (c, ctx) => {
        let cat = slugify(c.category ?? "")
        let n = int(c.count) ?? 3
        let posts = (ctx.posts ?? []) | filter((p) => p.category == cat) | take(n)
        <section.pb-blog.pb-cat-row>
            <h2.pb-row-head><a href={`/blog/category/${cat}`} data-edit={ed(ctx, "heading")} data-md={line_mark(ctx)}>{blank(c.heading) ? title_case(cat) : line(c.heading)}</a><a.pb-more href={`/blog/category/${cat}`}>More →</a></h2>
            {len(posts) == 0 ? <p.pb-missing>Nothing in {cat} yet.</p> : <div.blog-grid>{for p in posts => <BlogCard {p}/>}</div>}
        </section>
    },
    "blog.popular": (c, ctx) => {
        let n = int(c.count) ?? 5
        let posts = sort_by(ctx.posts ?? [], (p) => -(p.views ?? 0)) | take(n)
        <section.pb-blog.pb-popular>
            <h2 data-edit={ed(ctx, "heading")} data-md={line_mark(ctx)}>{blank(c.heading) ? "Most read" : line(c.heading)}</h2>
            {len(posts) == 0 ? <p.pb-missing>No posts yet.</p> : <ol.blog-lines>{for [i, p] in enumerate(posts) => <BlogLine {p} n={i + 1}/>}</ol>}
        </section>
    },
    "blog.breaking": (c, ctx) =>
        <div.pb-breaking>
            <b data-edit={ed(ctx, "label")}>{blank(c.label) ? "Breaking" : c.label}</b>
            {blank(c.link) ? <span data-edit={ed(ctx, "text")} data-md={line_mark(ctx)} data-hint={hint(ctx, "What is happening")}>{line(c.text)}</span>
            : <a href={safe_link(c.link)} data-edit={ed(ctx, "text")} data-md={line_mark(ctx)} data-hint={hint(ctx, "What is happening")}>{line(c.text)}</a>}
        </div>,
}

let runners_blog = {}
