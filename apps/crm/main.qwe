// A CRM for merchants, bloggers and news outlets, each workspace its own
// tenant (acme.example.com) with its own database.
//
//   quillo run apps/crm/main.qwe --port 9000 --watch
//   then open http://localhost:9000 and create a workspace
//
// Plugins (plugins/*.qwe) bring fields, rules and flow steps; workspaces
// switch them on. Rules run in the browser, for hints while typing, and on
// the server, where they decide.

let DOMAIN = env("CRM_DOMAIN", "localhost")
let SCHEME = env("CRM_SCHEME", "http")
// `single`: one workspace on its own domain (crm.example.com), set up on
// the first visit. `multi` (the default): workspaces sign up on the main
// site and each gets a subdomain.
let SINGLE = env("CRM_MODE", "multi") == "single"
let ONLY = "main"

// With one workspace, every request is its: the rest of the program is the
// same either way.
if SINGLE { tenant_from((request) => ONLY) } else { tenant_from(DOMAIN) }
db.open("data/{tenant}.db")
// Quillo's own tables (scheduled jobs' runs), with the rest of the data.
db.system("data/quillo-system.db")
db.migrate("migrations")

use "lib/util.qwe"
use "lib/rules.qwe"
use "plugins/core_themes.qwe"
use "plugins/core.qwe"
use "plugins/gdpr.qwe"
use "plugins/loyalty.qwe"
use "plugins/vat.qwe"
use "plugins/paywall.qwe"
use "plugins/sponsors.qwe"
use "plugins/quality.qwe"
use "plugins/notices.qwe"
use "plugins/newsroom.qwe"
use "plugins/blog.qwe"

// The plugins there are.
// The plugin studio's (plugins/studio/), released and drafts.
use "plugins/studio/index.qwe"

let plugins = [plugin_core, plugin_blog, plugin_gdpr, plugin_loyalty, plugin_vat, plugin_paywall, plugin_sponsors, plugin_quality, plugin_notices, plugin_newsroom] + studio_plugins

use "lib/records.qwe"
use "lib/audit.qwe"
use "lib/commerce.qwe"
use "lib/marketing.qwe"
use "lib/flows.qwe"

// The steps flows run, on the server: the core's and the plugins'.
// By plugin (and version: "birthday#draft").
let step_runners = merge({ core: core_runners, blog: runners_blog, gdpr: runners_gdpr, loyalty: runners_loyalty, paywall: runners_paywall, vat: runners_vat, sponsors: runners_sponsors, quality: runners_quality, notices: runners_notices, newsroom: runners_newsroom }, studio_runners)

use "lib/workspace.qwe"
use "lib/site.qwe"
use "lib/pages.qwe"
use "lib/media.qwe"
use "lib/studio.qwe"
use "lib/blog.qwe"
use "lib/store.qwe"
use "lib/objects.qwe"
use "lib/news.qwe"
use "lib/review.qwe"
use "lib/feedback.qwe"
use "lib/roles.qwe"
use "lib/desks.qwe"
use "plugins/core_blocks.qwe"

// How each plugin's page blocks look (on the server).
let block_renderers = merge({ core: renderers_core, blog: renderers_blog, sponsors: renderers_sponsors, paywall: renderers_paywall, gdpr: renderers_gdpr }, studio_renderers)
use "ui/kit.qwe"
use "ui/public.qwe"
use "ui/app.qwe"
use "ui/pages.qwe"
use "ui/designer.qwe"
use "ui/pagedesigner.qwe"
use "ui/media.qwe"
use "ui/studio.qwe"
use "ui/posts.qwe"
use "ui/shop.qwe"
use "ui/code.qwe"
use "ui/site.qwe"
use "ui/objects.qwe"
use "ui/review.qwe"
use "ui/audit.qwe"

// `http://acme.localhost:9000` for a workspace, from the main site's host.
fn workspace_url(slug: str, host: str) {
    let port = contains(host, ":") ? `:${split(host, ":")[-1]}` : ""
    `${SCHEME}://${slug}.${DOMAIN}${port}`
}

fn site_url() = settings().url ?? ""

// Every few seconds, for each workspace: flows that are due carry on, and
// queued mail goes out.
fn tick() {
    for t in db.tenants() ?? [] => with_tenant(t, () => {
        resume_due()
        deliver_mail()
    })
}
schedule("10s", tick)

// ---- pages --------------------------------------------------------------------------

route GET /assets/*path = file("public/" + path)

route GET / {
    if tenant() == null { return <Landing/> }
    workspace_here()
    // A published home page, for visitors; else the app.
    let home = home_page()
    if home != null { return show_page(home) }
    // An object on the site can be its home (a newspaper's front page).
    objects_ready()
    let front = find(site_objects(), (o) => o.site.home == true)
    front != null ? site_front(front) : current_user() == null ? redirect("/login") : redirect("/app")
}

// An image at one of its sizes (and crops), for pages anyone may see.
route GET /media/:key/:crop/:width {
    workspace_here()
    media_variant(key, crop, width)
}

// ---- the blog (the Blog plugin) --------------------------------------------------------

fn blog_here() {
    workspace_here()
    blog_on() || reply 404 <NotFoundPage what="blog"/>
}

route GET /blog {
    blog_here()
    blog_index(request.query.tag ?? "", int(request.query.page ?? "1") ?? 1, null, "", request.query.q ?? "")
}

route GET /blog/category/:slug {
    blog_here()
    blog_index("", int(request.query.page ?? "1") ?? 1, null, slug)
}

route GET /blog/author/:id {
    blog_here()
    let n = int(id) ?? 0
    db.one("select id from users where id = ?", n) ?? reply 404 <NotFoundPage what="author"/>
    blog_index("", int(request.query.page ?? "1") ?? 1, null, "", "", n)
}

route GET /blog/feed.xml {
    blog_here()
    blog_feed()
}

// A reader asks for a sign-in link (to read members-only posts).
route POST /blog/signin { form: { email: str, back: str } } {
    blog_here()
    send_reader_link(email, starts_with(back, "/blog/") ? back : "/blog")
    <SiteLayout title="Check your email" description="">
        <section.blog-head><h1>Check your email</h1><p>If {email} is one of our readers, a sign-in link is on its way.</p></section>
    </SiteLayout>
}

route GET /blog/signin/:token {
    blog_here()
    let link = db.one("select * from reader_links where token = ? and expires_at > ?", token, now())
    if link == null { return redirect("/blog") }
    db.exec("delete from reader_links where token = ?", token)
    set_session(merge(session(), { reader: link.contact_id }))
    let back = request.query.back ?? "/blog"
    redirect(starts_with(back, "/blog/") && !contains(back, "//") ? back : "/blog")
}

route GET /blog/:slug {
    blog_here()
    blog_post(slug)
}

// A page as its designer has it on screen, following each change, by its
// secret link (any browser, no sign-in).
route GET /preview/:token {
    workspace_here()
    let p = page_out(db.one("select * from pages where preview_token = ? and preview_token != ''", token)) ?? reply 404 <NotFoundPage what="preview"/>
    <SiteLayout title={p.title} description="" live={true}><LivePreview {token}/></SiteLayout>
}

route GET /p/:slug {
    workspace_here()
    show_page(published_page(slug) ?? reply 404 <NotFoundPage what="page"/>)
}

// A request for a workspace that does not exist answers 404, before any
// page touches its (absent) database.
// (On the main site, with no workspace in the address, there is none.)
fn workspace_here() {
    let t = tenant()
    (t != null && db.tenant_exists(t)) || (SINGLE ? reply 303 redirect("/setup") : reply 404 <NoWorkspace/>)
}

// With one workspace: setting it up, on the first visit.
route GET /setup {
    if !SINGLE || db.tenant_exists(ONLY) { return redirect("/") }
    <SetupPage/>
}

route GET /login {
    if tenant() == null { return redirect("/") }
    workspace_here()
    <LoginPage problem={request.query.problem ?? ""} email={request.query.email ?? ""}/>
}

route POST /login { form: { email: str, password: str } } {
    workspace_here()
    let u = db.one("select * from users where email = ?", lower(trim(email)))
    if !crypto.verify_password(password, u.password_hash) {
        audit("login.failed", { email: lower(trim(email)) })
        return redirect(`/login?problem=wrong&email=${email}`)
    }
    set_session({ user: u.id })
    audit("login", { method: "password" })
    put_setting("url", `${SCHEME}://${request.headers.host}`)
    redirect("/app")
}

route POST /logout {
    if tenant() != null { audit("logout") }
    end_session()
    redirect("/login")
}

// The link from signing up: signs the owner in once.
route GET /welcome/:token {
    workspace_here()
    let row = db.one("select * from sign_in_tokens where token = ? and expires_at > ?", token, now())
    if row == null {
        audit("login.failed", { method: "link" })
        return redirect("/login?problem=expired")
    }
    db.exec("delete from sign_in_tokens where token = ?", token)
    set_session({ user: row.user_id })
    audit("login", { method: "link" })
    put_setting("url", `${SCHEME}://${request.headers.host}`)
    redirect("/app")
}

route GET /app/export/contacts.csv {
    workspace_here()
    if current_user() == null { reply 401 "Sign in first" }
    let fields = custom_fields() | filter((f) => f.entity == "contact")
    let head = csv_row(["first_name", "last_name", "email", "phone", "stage", "subscribed", "tags"] + (fields | map((f) => f.key)))
    let rows = db.query("select * from contacts order by id") | map(contact_out) | map((c) =>
        csv_row([c.first_name, c.last_name, c.email, c.phone, c.stage, c.subscribed ? "yes" : "no", join(c.tags, " ")]
            + (fields | map((f) => c.fields[f.key]))))
    audit("contacts.export", { rows: len(rows) })
    respond(200, join([head] + rows, "\n") + "\n", { "content-type": "text/csv; charset=utf-8", "content-disposition": "attachment; filename=contacts.csv" })
}

// A CSV of contacts (a header row naming the columns). Each row goes through
// the contact rules; rows they refuse are reported, not imported.
route POST /app/import/contacts {
    workspace_here()
    let u = current_user() ?? reply 401 "Sign in first"
    let file = request.files.file ?? reply 400 "Choose a CSV file"
    let rows = csv_parse(read_upload(file) ?? "")
    if len(rows) < 2 { return redirect("/app/contacts?imported=0&skipped=0") }
    let head = rows[0] | map((h) => lower(trim(h)))
    let ctx = rule_ctx()
    let results = drop(rows, 1) | map((cells) => {
        let at = (name) => {
            let i = index_of(head, name)
            i == null ? "" : trim(cells[i] ?? "")
        }
        let custom = ctx.fields | filter((f) => f.entity == "contact" && index_of(head, f.key) != null) | reduce({}, (m, f) => set(m, f.key, at(f.key)))
        let c = { first_name: at("first_name"), last_name: at("last_name"), email: at("email"), phone: at("phone"),
            stage: at("stage") != "" ? at("stage") : "lead", subscribed: contains(["yes", "true", "1"], lower(at("subscribed"))),
            tags: split(at("tags"), " "), fields: custom }
        let refusal = refused("contact", c, ctx)
        if refusal != null || (c.email != "" && db.one("select id from contacts where lower(email) = ?", lower(c.email)) != null) {
            false
        } else {
            let t = now()
            let id = db.exec("insert into contacts (first_name, last_name, email, phone, stage, subscribed, tags, fields, owner_id, source, created_at, updated_at) values (?, ?, ?, ?, ?, ?, '[]', ?, ?, 'import', ?, ?)",
                c.first_name, c.last_name, lower(c.email), c.phone, c.stage, c.subscribed ? 1 : 0, json.stringify(custom), u.id, t, t).last_id
            add_tags(id, c.tags)
            true
        }
    })
    let ok = results | filter((r) => r) | len
    audit("contacts.import", { imported: ok, skipped: len(results) - ok })
    drain_runs()
    redirect(`/app/contacts?imported=${ok}&skipped=${len(results) - ok}`)
}

// The plugin studio's live preview: a plugin's blocks, rendered.
route GET /app/studio/:id/preview {
    workspace_here()
    if is_err(need_developer()) { reply 403 "Only the installation's developers" }
    studio_preview(id)
}

route GET /app/export/objects/:key {
    workspace_here()
    if current_user() == null { reply 401 "Sign in first" }
    records_csv(key)
}

route GET /app {
    workspace_here()
    current_user() == null ? redirect("/login") : <AppPage/>
}

route GET /app/*rest {
    workspace_here()
    current_user() == null ? redirect("/login") : <AppPage/>
}

// ---- public pages: the shop, forms, unsubscribing ----------------------------------------

route GET /shop {
    workspace_here()
    shop_page(request.query.category ?? "", request.query.q ?? "", null, request.query.sort ?? "featured")
}

route GET /shop/:sku {
    workspace_here()
    product_page(shop_product(sku) ?? reply 404 <NotFoundPage what="product"/>, request.query.choose == "1")
}

// The cart is in the visitor's session; its forms work without JavaScript.
route POST /cart/add {
    workspace_here()
    let sku = request.form.sku ?? ""
    let problem = add_to_cart(sku, request.form.qty ?? "1", request.form.variant ?? "")
    redirect(problem != null ? `/shop/${slugify(sku)}?choose=1` : request.form.then == "checkout" ? "/checkout" : "/cart")
}

route POST /cart/update {
    workspace_here()
    update_cart(request.form.sku ?? "", request.form.qty ?? "0")
    redirect("/cart")
}

route POST /cart/discount {
    workspace_here()
    let code = upper(trim(request.form.code ?? ""))
    set_session(merge(session(), { discount: code == "" ? null : code }))
    redirect("/cart")
}

route GET /cart {
    workspace_here()
    cart_page()
}

route GET /checkout {
    workspace_here()
    <CheckoutPage/>
}

route GET /sitemap.xml {
    workspace_here()
    sitemap()
}

route GET /robots.txt {
    workspace_here()
    robots()
}

route GET /f/:slug {
    workspace_here()
    public_form(slug) ?? reply 404 <NotFoundPage what="form"/>
    <FormPage {slug}/>
}

route GET /unsubscribe/:token {
    workspace_here()
    <UnsubscribedPage ok={unsubscribe(token)} name={settings().name ?? ""}/>
}

// ---- objects on the site (last: what nothing above claims) ----------------------------------

route GET /:section {
    workspace_here()
    objects_ready()
    site_front(site_object(section) ?? reply 404 <NotFoundPage what="page"/>)
}

route GET /:section/c/:slug {
    workspace_here()
    site_section(site_object(section) ?? reply 404 <NotFoundPage what="page"/>, slug)
}

route GET /:section/:item {
    workspace_here()
    site_article(site_object(section) ?? reply 404 <NotFoundPage what="page"/>, item, request.query.preview == "1")
}
