// The plugin studio, for the installation's developers: write a plugin,
// save it as a draft (checked like the rest of the program), try it in
// this workspace's pages and flows, and release it for every workspace.

component StudioPage(ws: map, on_change) {
    state rows = studio_list()
    state id = ""
    state name = ""
    state problems = []
    state try_drafts = ws.try_drafts
    <div>
        <PageHead title="Plugin studio" sub="Write plugins here, try them in your pages and flows, release them to every workspace."/>
        <section.card.studio-try>
            <label.check-inline><input type="checkbox" checked={try_drafts} @change={(e) => {
                try_drafts = e.checked
                set_try_drafts(e.checked)
                on_change()
            }}/> Try drafts in this workspace</label>
            <span.muted.small>Here, drafts take the place of their released versions: their blocks are in the page designer, their steps in the flow designer. Other workspaces keep the released ones.</span>
        </section>
        <div.grid-pages>
            <div>{rows == null ? <Loading/>
                : is_err(rows) ? <Empty title={str(rows.error)}/>
                : len(rows) == 0 ? <Empty title="No plugins yet"><p>Start one on the right.</p></Empty>
                : <table.table>
                    <thead><tr><th>Plugin</th><th>Released</th><th>Draft</th><th>Updated</th></tr></thead>
                    <tbody>{for p in rows => <tr key={p.id} class="clickable" @click={() => { navigate(`/app/studio/${p.id}`) }}>
                        <td><b>{p.name}</b> <code>{p.id}</code></td>
                        <td>{p.released == null ? <span.muted>not yet</span> : <Badge text={`v${p.released}`} tone="green"/>}</td>
                        <td>{p.draft ? <Badge text={`v${(p.released ?? 0) + 1} draft`} tone="amber"/> : <span.muted>—</span>}</td>
                        <td.muted>{fmt_ago(p.updated_at, now())}</td>
                    </tr>}</tbody>
                </table>}</div>
            <form.card.stack @submit={() => {
                let r = studio_create(id, name)
                if is_err(r) { problems = refusal_problems(r) } else { navigate(`/app/studio/${r}`) }
            }}>
                <h2>New plugin</h2>
                <TextField label="Id (in its names and its blocks' types)" field="id" value={id} {problems} on_change={(v) => { id = lower(v) }} placeholder="birthday"/>
                <TextField label="Name" field="name" value={name} {problems} on_change={(v) => { name = v }} placeholder="Birthdays"/>
                <FormProblems {problems}/>
                <div.form-actions><button.primary>Create</button></div>
                <p.muted.small>It starts with a block, a rule and its renderer, to change into yours.</p>
            </form>
        </div>
    </div>
}

component PluginEditor(id: str, ws: map) {
    state p = studio_get(id)
    state src = null
    state problems = []
    state message = ""
    state busy = false
    // Live: checked when typing pauses, saved (and so loaded by the
    // program, and shown in the preview) whenever the checks pass.
    state live = true
    state typed_at = null
    state checking = false
    state waiting = null
    state frame = 0
    state pane = "preview"
    if p == null { return <Loading/> }
    if is_err(p) { return <Empty title={str(p.error)}><p><a href="/app/studio">The studio</a></p></Empty> }
    let code = src ?? p.source
    let reload_note = "The program loads the new version in a moment."
    let save = () => {
        busy = true
        let r = studio_save(id, code)
        busy = false
        if is_err(r) { problems = refusal_problems(r); message = "" } else {
            problems = []
            message = `Draft v${r.version} saved; loading it…`
            p = merge(p, { draft: true, source: code })
            src = null
            waiting = r.written
        }
    }
    let check = () => {
        checking = true
        let r = studio_check(id, code)
        checking = false
        problems = is_err(r) ? refusal_problems(r) : r
        if live && len(problems) == 0 && code != p.source { save() }
    }
    // Typing paused: check (and, live, save).
    if typed_at != null {
        every(250, () => {
            if now() - typed_at > 700 {
                typed_at = null
                check()
            }
        })
    }
    // Saved: wait for the program to load it, then show it.
    if waiting != null {
        every(400, () => {
            let b = studio_built_at()
            if !is_err(b) && b >= waiting {
                waiting = null
                frame = frame + 1
                message = `Draft v${(p.released ?? 0) + 1} is running: the preview shows it`
            }
        })
    }
    <div.studio>
        <header.designer-bar>
            <a href="/app/studio">← Studio</a>
            <b.page-title>{p.name}</b>
            <code>{id}</code>
            {p.released != null && <Badge text={`released v${p.released}`} tone="green"/>}
            {p.draft && <Badge text={`draft v${(p.released ?? 0) + 1}`} tone="amber"/>}
            <span.grow></span>
            {checking ? <span.muted>Checking…</span> : waiting != null ? <span.muted>Loading the draft…</span> : message != "" && <span.ok>{message}</span>}
            {len(problems) > 0 && <span.bad>{plural(len(problems), "problem")}</span>}
            <label.inline.small title="Check as you type, and save the draft whenever it checks"><input type="checkbox" checked={live} @change={() => { live = !live }}/> Live</label>
            <button disabled={busy} @click={() => { save() }}>{busy ? "Checking…" : "Save draft"}</button>
            {p.draft && <button.primary disabled={busy || src != null} title={src != null ? "Save the draft first" : ""} @click={() => {
                if ask("Every workspace can switch it on.", { title: `Release ${p.name} v${(p.released ?? 0) + 1}?`, ok: "Release" }) {
                    busy = true
                    let r = studio_release(id)
                    busy = false
                    if is_err(r) { problems = refusal_problems(r) } else { message = `Released v${r.released}. ${reload_note}`; p = merge(p, { draft: false, released: r.released }); waiting = r.written }
                }
            }}>Release</button>}
            {p.draft && <button.ghost @click={() => {
                if ask("The released version stays as it is.", { title: "Throw the draft away?", ok: "Throw away", tone: "danger" }) { studio_discard(id); p = studio_get(id); src = null; problems = [] }
            }}>Discard draft</button>}
        </header>
        <div.studio-body>
            <CodeEditor value={code} lang="qwe" fill={true} {problems} on_change={(v) => { src = v; message = ""; typed_at = now() }}/>
            <aside.studio-side>
                <nav.preview-bar>
                    {for t in [["preview", "Preview"], ["checks", len(problems) > 0 ? `Problems (${len(problems)})` : "Checks"], ["help", "How it is made"]] =>
                        <button type="button" class={pane == t[0] ? "tab on" : "tab"} @click={() => { pane = t[0] }}>{t[1]}</button>}
                </nav>
                {match pane {
                    "preview" => <div.studio-preview>
                        {len(problems) > 0 && <p.studio-stale>The preview shows the last version that checked.</p>}
                        <iframe.site-frame key={frame} title="Preview" src={`/app/studio/${id}/preview?v=${frame}`}></iframe>
                    </div>
                    "checks" => <div.inspector-body>
                        {len(problems) == 0 ? <p.ok>No problems: it checks with the rest of the program (names, types, everything quillo check checks).</p>
                        : <ul.problems>{for x in problems => <li>{x.line > 0 && <b>Line {x.line}: </b>}{x.message ?? str(x)}</li>}</ul>}
                    </div>
                    _ => <div.inspector-body>
                        <ul.howto>
                            <li><code>{id}_plugin</code>: id, name, description, audience; <code>fields</code>, <code>rules</code> by kind (contact, deal, page, checkout, …), <code>blocks</code>, <code>steps</code> and <code>themes</code> described for the designers.</li>
                            <li><code>{id}_renderers</code>: each block type's HTML, <code>(config, ctx) =&gt; &lt;section&gt;…</code>. A field's <code>example</code> is what the preview shows.</li>
                            <li><code>{id}_runners</code>: each step type's work on the server, <code>(config, run) =&gt; {"{"} port: "out" {"}"}</code>.</li>
                            <li>A theme: <code>{"{"} id, name, description, header: "bar" | "center" | "masthead" | "split", width, color, font, css {"}"}</code>, its CSS under <code>.theme-&lt;id&gt;</code>.</li>
                            <li>Rules compute only: they run in the browser too. A problem is <code>problem(field, message)</code>, or <code>warning(...)</code>.</li>
                            <li>Every top-level name starts with <code>{id}_</code> (views: <code>{pascal(id)}</code>).</li>
                        </ul>
                    </div>
                }}
            </aside>
        </div>
    </div>
}
