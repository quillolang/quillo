// The media library, and the picker that blocks and the theme use: choose
// an image (or upload one), then crop it. A crop is kept beside the image,
// in its own pixels, so it can be changed later; the image is never altered.

let RATIOS = [["original", "Original", 0], ["free", "Free", 0], ["16:9", "16:9", 16 / 9], ["4:3", "4:3", 4 / 3], ["1:1", "Square", 1], ["3:1", "Banner", 3]]

fn thumb(m) = `/media/${m.key}/full/320`

// The largest crop of a ratio that fits, in the middle.
fn centered(w: int, h: int, ratio) {
    let cw = min([w, round(h * ratio)])
    let ch = min([h, round(cw / ratio)])
    { x: floor((w - cw) / 2), y: floor((h - ch) / 2), w: cw, h: ch }
}

fn clamp(v, lo, hi) = max([lo, min([hi, v])])

component MediaPage(ws: map) {
    state items = live(list_media)
    state open = null
    state problem = ""
    state busy = false
    <div>
        <PageHead title="Media" sub="Images for your pages, shop and logo. Upload once; pages use the sizes and crops they need.">
            <label class="button primary">{busy ? "Uploading…" : "Upload images"}
                <input type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple style="display:none" @change={(e) => {
                    busy = true
                    problem = ""
                    for f in js("Array.from", e.target.files) => {
                        let r = upload_image(f)
                        if is_err(r) { problem = `${f.name}: ${r.error}` }
                    }
                    busy = false
                }}/>
            </label>
        </PageHead>
        {problem != "" && <div.alert><p>{problem}</p></div>}
        {items == null ? <Loading/>
        : is_err(items) || len(items) == 0 ? <Empty title="No images yet"><p>Upload JPEG, PNG, WebP or GIF images, up to 10 MB each.</p></Empty>
        : <div.media-grid>{for m in items => <button.media-item key={m.id} type="button" @click={() => { open = m }}>
            <img src={thumb(m)} alt={m.alt} loading="lazy"/>
            <span>{m.name}</span>
            {m.alt == "" && <Badge text="no description" tone="amber"/>}
        </button>}</div>}
        {open != null && <Drawer title={open.name} on_close={() => { open = null }}>
            <MediaDetails m={open} on_done={() => { open = null }}/>
        </Drawer>}
    </div>
}

component MediaDetails(m: map, on_done) {
    state name = m.name
    state alt = m.alt
    state saved = false
    <div.stack>
        <img.media-large src={`/media/${m.key}/full/960`} alt={alt}/>
        <p.muted.small>{m.width} × {m.height} pixels · {m.format} · {round(m.size / 1024)} KB</p>
        <TextField label="Name" field="name" value={name} problems={[]} on_change={(v) => { name = v; saved = false }}/>
        <TextField label="Description (what it shows, for screen readers)" field="alt" value={alt} problems={[]} on_change={(v) => { alt = v; saved = false }}/>
        <div.form-actions>
            <button.primary @click={() => { update_media(m.id, { name, alt }); saved = true }}>Save</button>
            {saved && <span.ok>Saved</span>}
            <span.grow></span>
            <button.danger @click={() => {
                if ask("Pages that show this image will no longer show it.", { title: "Delete this image?", ok: "Delete", tone: "danger" }) { delete_media(m.id); notify("Image deleted"); on_done() }
            }}>Delete</button>
        </div>
    </div>
}

// An image setting: { key, w, h, alt, crop } from the library, or an
// address written in by hand (older pages).
component ImagePicker(value, on_change, label: str = "Image") {
    state mode = null
    state picked = null
    state items = null
    state problem = ""
    let v = type_of(value) == "map" ? value : null
    <div.field>
        <span.label>{label}</span>
        <div.picker>
            {v != null ? <img src={media_src(v, crop_text(v), 320)} alt=""/>
            : type_of(value) == "str" && value != "" ? <img src={value} alt=""/>
            : <span.picker-empty>No image</span>}
            <div.picker-actions>
                <button type="button" @click={() => { items = list_media(); mode = "library" }}>{v == null ? "Choose image" : "Change"}</button>
                {v != null && <button type="button" @click={() => { picked = v; mode = "crop" }}>Crop</button>}
                {value != null && value != "" && <button.ghost type="button" @click={() => { on_change(null) }}>Remove</button>}
            </div>
        </div>
        {mode == "library" && <Drawer title="Choose an image" on_close={() => { mode = null }}>
            <label class="button">Upload a new one
                <input type="file" accept="image/jpeg,image/png,image/webp,image/gif" style="display:none" @change={(e) => {
                    let r = upload_image(e.target.files[0])
                    if is_err(r) { problem = r.error } else { picked = { key: r.key, w: r.width, h: r.height, alt: r.alt, crop: null }; mode = "crop" }
                }}/>
            </label>
            {problem != "" && <div.alert><p>{problem}</p></div>}
            {items == null ? <Loading/>
            : is_err(items) || len(items) == 0 ? <p.muted>No images yet: upload one.</p>
            : <div.media-grid.small>{for m in items => <button.media-item key={m.id} type="button" @click={() => {
                picked = { key: m.key, w: m.width, h: m.height, alt: m.alt, crop: null }
                mode = "crop"
            }}><img src={thumb(m)} alt={m.alt}/><span>{m.name}</span></button>}</div>}
        </Drawer>}
        {mode == "crop" && picked != null && <Drawer title="Crop" on_close={() => { mode = null }}>
            <CropEditor image={picked} on_done={(crop) => {
                on_change(set(picked, "crop", crop))
                mode = null
            }}/>
        </Drawer>}
    </div>
}

// Drag the frame to move it, its corner to resize it; the ratios keep its
// shape. What it gives is in the image's own pixels.
component CropEditor(image: map, on_done) {
    state crop = image.crop
    state ratio = image.crop == null ? "original" : "free"
    state drag = null
    let shown_w = min([460, image.w])
    let scale = shown_w / image.w
    let r = (find(RATIOS, (x) => x[0] == ratio) ?? RATIOS[0])[2]
    let c = crop ?? { x: 0, y: 0, w: image.w, h: image.h }
    let pick = (key) => {
        ratio = key
        let rr = (find(RATIOS, (x) => x[0] == key) ?? RATIOS[0])[2]
        crop = key == "original" ? null : rr == 0 ? c : centered(image.w, image.h, rr)
    }
    let moved = (e) => {
        if drag != null {
            let dx = (e.clientX - drag.sx) / scale
            let dy = (e.clientY - drag.sy) / scale
            let f = drag.from
            if drag.mode == "move" {
                crop = set(set(f, "x", round(clamp(f.x + dx, 0, image.w - f.w))), "y", round(clamp(f.y + dy, 0, image.h - f.h)))
            } else {
                let nw = clamp(f.w + dx, 16, image.w - f.x)
                let nh0 = r == 0 ? clamp(f.h + dy, 16, image.h - f.y) : nw / r
                let fits = f.y + nh0 <= image.h
                let nh = fits ? nh0 : image.h - f.y
                let nw2 = fits || r == 0 ? nw : nh * r
                crop = { x: f.x, y: f.y, w: round(nw2), h: round(nh) }
            }
        }
    }
    <div.stack>
        <div.ratios>{for x in RATIOS => <button type="button" class={ratio == x[0] ? "choice on" : "choice"} @click={() => { pick(x[0]) }}>{x[1]}</button>}</div>
        <div.crop-stage style={`width:${shown_w}px;height:${round(image.h * scale)}px`}
            @mousemove={moved} @mouseup={() => { drag = null }} @mouseleave={() => { drag = null }}>
            <img src={`/media/${image.key}/full/960`} alt="" draggable="false" style={`width:${shown_w}px`}/>
            {crop != null && <div.crop-box style={`left:${c.x * scale}px;top:${c.y * scale}px;width:${c.w * scale}px;height:${c.h * scale}px`}
                @mousedown={(e) => { e.preventDefault(); drag = { mode: "move", sx: e.clientX, sy: e.clientY, from: c } }}>
                <span.crop-handle @mousedown={(e) => {
                    e.preventDefault()
                    e.stopPropagation()
                    drag = { mode: "resize", sx: e.clientX, sy: e.clientY, from: c }
                }}></span>
            </div>}
        </div>
        <p.muted.small>{crop == null ? `The whole image, ${image.w} × ${image.h}` : `${c.w} × ${c.h} from ${c.x}, ${c.y}`}</p>
        <div.form-actions><button.primary @click={() => { on_done(crop) }}>Use this</button></div>
    </div>
}
