// Signing in in two steps, and the Security tab of Settings.

// ---- signing in: the second step ----------------------------------------------------------

view CodePage(problem: str) =
    <Page title="Two-step sign-in">
        <div.center-card>
            <Logo/>
            <h1>Enter your code</h1>
            <p.muted>The six digits your authenticator app shows for this workspace, or one of your recovery codes.</p>
            {problem == "wrong" && <div.alert><p>That code does not match. Try the app's next one.</p></div>}
            <form method="post" action="/login/code" class="stack">
                <label.field><span.label>Code</span><input name="code" inputmode="numeric" autocomplete="one-time-code" required autofocus/></label>
                <button.primary.wide>Sign in</button>
            </form>
            <p.small><a href="/login">Start again</a></p>
        </div>
    </Page>

// The secret, as a link the phone's app opens, and as text to type in.
view TwoStepSecret(secret: str, uri: str) =
    <div.stack>
        <p>Add this workspace to an authenticator app (1Password, Google Authenticator, Authy…):
            on your phone, <a href={uri}>open it in the app</a>; elsewhere, type in this key.</p>
        <p><code.secret aria-label="Setup key">{secret}</code></p>
    </div>

view TwoStepSetupPage(secret: str, uri: str, problem: str) =
    <Page title="Set up two-step sign-in">
        <div.center-card>
            <Logo/>
            <h1>Set up two-step sign-in</h1>
            <p.muted>This workspace asks everyone to sign in with a code from an app as well as a password.</p>
            <TwoStepSecret {secret} {uri}/>
            {problem == "wrong" && <div.alert><p>That code does not match; check the phone's clock and try the next one.</p></div>}
            <form method="post" action="/login/setup" class="stack">
                <label.field><span.label>The code the app shows</span><input name="code" inputmode="numeric" autocomplete="one-time-code" required/></label>
                <button.primary.wide>Turn it on</button>
            </form>
        </div>
    </Page>

view RecoveryCodes(codes: list) =
    <div.stack>
        <p>If you lose your phone, each of these signs you in once instead of a code. Keep them somewhere safe: they are not shown again.</p>
        <ul.recovery-codes>{for c in codes => <li><code>{c}</code></li>}</ul>
    </div>

view RecoveryPage(codes: list) =
    <Page title="Your recovery codes">
        <div.center-card>
            <Logo/>
            <h1>Two-step sign-in is on</h1>
            <RecoveryCodes {codes}/>
            <p><a.button.primary href="/app">I have kept them: open the app</a></p>
        </div>
    </Page>

// ---- Settings, Security --------------------------------------------------------------------

component SecuritySettings(ws: map) {
    state s = security_status()
    let reload = () => { s = security_status() }
    if s == null { return <Loading/> }
    if is_err(s) { return <p.bad>{err_text(s)}</p> }
    <div.grid2>
        <div>
            <TwoStepCard status={s} on_change={reload}/>
            <PasswordCard/>
        </div>
        <div>
            <DevicesCard/>
            {s.admin && <TeamSecurityCard status={s} on_change={reload}/>}
        </div>
    </div>
}

component TwoStepCard(status: map, on_change) {
    state setup = null
    state code = ""
    state codes = null
    state password = ""
    state problems = []
    <section.card.stack>
        <h2>Two-step sign-in</h2>
        {codes != null ? <div.stack><RecoveryCodes {codes}/><div.form-actions><button.primary @click={() => { codes = null; on_change() }}>Done</button></div></div>
        : setup != null ? <form.stack @submit={() => {
            let r = finish_two_step(code)
            if is_err(r) { problems = refusal_problems(r) } else { codes = r; setup = null; code = ""; problems = [] }
        }}>
            <TwoStepSecret secret={setup.secret} uri={setup.uri}/>
            <TextField label="The code the app shows" field="code" value={code} {problems} on_change={(v) => { code = v }}/>
            <FormProblems {problems}/>
            <div.form-actions><button.primary>Turn it on</button><button.ghost type="button" @click={() => { setup = null }}>Cancel</button></div>
        </form>
        : status.two_step ? <div.stack>
            <p><Badge text="On" tone="green"/> You sign in with a code from your app. {plural(status.recovery_left, "recovery code")} left.</p>
            <TextField label="Your password (for the changes below)" field="password" value={password} {problems} on_change={(v) => { password = v }} type="password"/>
            <FormProblems {problems}/>
            <div.form-actions>
                <button @click={() => {
                    let r = renew_recovery_codes(password)
                    if is_err(r) { problems = refusal_problems(r) } else { codes = r; password = ""; problems = [] }
                }}>New recovery codes</button>
                {!status.required && <button.danger @click={() => {
                    let r = turn_off_two_step(password)
                    if is_err(r) { problems = refusal_problems(r) } else { password = ""; problems = []; on_change() }
                }}>Turn off</button>}
            </div>
        </div>
        : <div.stack>
            <p.muted>Sign in with a code from an app on your phone as well as your password, so a password someone learns is not enough.</p>
            <div.form-actions><button.primary @click={() => { setup = begin_two_step() }}>Set up</button></div>
        </div>}
    </section>
}

component PasswordCard() {
    state p = { current: "", next: "" }
    state problems = []
    state done = null
    <form.card.stack @submit={() => {
        let r = change_password(p.current, p.next)
        if is_err(r) { problems = refusal_problems(r) } else { done = r; p = { current: "", next: "" }; problems = [] }
    }}>
        <h2>Password</h2>
        <TextField label="Your password" field="current" value={p.current} {problems} on_change={(v) => { p = set(p, "current", v); done = null }} type="password"/>
        <TextField label="A new one" field="next" value={p.next} {problems} on_change={(v) => { p = set(p, "next", v); done = null }} type="password" help="At least 10 characters. Your other sessions end."/>
        <FormProblems {problems}/>
        <div.form-actions><button.primary>Change password</button>{done != null && <span.ok>Changed{done > 0 ? `; ${plural(done, "other session")} ended` : ""}</span>}</div>
    </form>
}

component DevicesCard() {
    state list = my_sessions()
    let reload = () => { list = my_sessions() }
    <section.card.stack>
        <h2>Where you are signed in</h2>
        {list == null ? <Loading/> : is_err(list) ? <p.bad>{err_text(list)}</p>
        : <ul.plain.devices>{for d in list => <li key={d.id}>
            <b>{d.device}</b> <span.muted>{d.ip} · {d.current ? "this browser" : fmt_ago(d.seen, now())}</span>
            {!d.current && <button.ghost @click={() => { end_my_session(d.id); reload() }}>Sign out</button>}
        </li>}</ul>}
        {list != null && !is_err(list) && len(list) > 1 && <div.form-actions><button @click={() => { end_my_other_sessions(); reload() }}>Sign out everywhere else</button></div>}
    </section>
}

component TeamSecurityCard(status: map, on_change) {
    state problems = []
    state ended = null
    <section.card.stack>
        <h2>The team</h2>
        <CheckField label="Everyone signs in in two steps (each sets it up at their next sign-in)" field="required" value={status.required} {problems} on_change={(v) => {
            let r = set_two_step_required(v)
            if is_err(r) { problems = refusal_problems(r) } else { problems = []; on_change() }
        }}/>
        <FormProblems {problems}/>
        <ul.plain>{for x in status.team => <li key={x.id}>
            <b>{x.name}</b> <span.muted>{x.email}</span> {x.two_step == 1 || x.two_step == true ? <Badge text="two-step" tone="green"/> : <Badge text="password only"/>}
            <button.ghost @click={() => { ended = { name: x.name, n: sign_out_everywhere(x.id) } }}>Sign out everywhere</button>
        </li>}</ul>
        {ended != null && <p.ok>{ended.name}: {plural(ended.n ?? 0, "session")} ended</p>}
    </section>
}
