// Pieces the pages are made of. Inputs take the rules' problems and show
// the ones for their field under them, as you type.

view Hints(problems: list, field: str) {
    let mine = hints_for(problems, field)
    len(mine) == 0 ? null : <div.hints>{for p in mine => <p class={p.level == "warning" ? "hint warn" : "hint"}>{p.message}</p>}</div>
}

fn invalid(problems: list, field: str) = len(errors_of(hints_for(problems, field))) > 0

view TextField(label: str, field: str, value, problems: list, on_change, type: str = "text", placeholder: str = "", help: str = "", autofocus: bool = false) =
    <label.field>
        <span.label>{label}</span>
        <input {type} name={field} value={value ?? ""} {placeholder} {autofocus} class={invalid(problems, field) && "invalid"}
            @input={(e) => { on_change(e.value) }}/>
        {help != "" && <span.help>{help}</span>}
        <Hints {problems} {field}/>
    </label>

view AreaField(label: str, field: str, value, problems: list, on_change, rows: int = 5, placeholder: str = "") =
    <label.field>
        <span.label>{label}</span>
        <textarea name={field} {rows} {placeholder} class={invalid(problems, field) && "invalid"} @input={(e) => { on_change(e.value) }}>{value ?? ""}</textarea>
        <Hints {problems} {field}/>
    </label>

view SelectField(label: str, field: str, value, options: list, problems: list, on_change, empty: str = "") =
    <label.field>
        <span.label>{label}</span>
        <select name={field} class={invalid(problems, field) && "invalid"} @change={(e) => { on_change(e.value) }}>
            {empty != "" && <option value="" selected={blank(value)}>{empty}</option>}
            {for o in options => {
                let v = type_of(o) == "map" ? str(o.value) : str(o)
                <option value={v} selected={str(value ?? "") == v}>{type_of(o) == "map" ? o.label : o}</option>
            }}
        </select>
        <Hints {problems} {field}/>
    </label>

// One of many (a hundred objects): typed to narrow, the arrows and Enter
// to choose, or a click. `options` are { value, label }; `empty`, if given,
// is a first choice whose value is "". Its input is in no form, so Enter
// chooses and does not send the form around it.
component PickOne(label: str, field: str, value, options: list, problems: list, on_change, empty: str = "") {
    state q = null
    state at = 0
    let all = (empty == "" ? [] : [{ value: "", label: empty }]) + options
    let chosen = find(all, (o) => str(o.value) == str(value ?? ""))
    let words = lower(trim(q ?? ""))
    let matching = q == null ? [] : all | filter((o) => words == "" || contains(lower(o.label), words))
    let shown = matching | take(60)
    let pick = (o) => { on_change(o.value); q = null; at = 0 }
    <div.field.pick>
        <span.label id={`${field}-label`}>{label}</span>
        <input name={field} form="pick-none" role="combobox" aria-labelledby={`${field}-label`} aria-expanded={q != null} aria-autocomplete="list" autocomplete="off"
            placeholder={empty != "" ? empty : "Choose"} value={q ?? (chosen == null ? "" : chosen.label)} class={invalid(problems, field) && "invalid"}
            @focusin={() => { q = "" }} @focusout={() => { q = null }} @input={(e) => { q = e.value; at = 0 }}
            @keydown={(e) => {
                if e.key == "ArrowDown" && len(shown) > 0 { at = (at + 1) % len(shown) }
                if e.key == "ArrowUp" && len(shown) > 0 { at = (at + len(shown) - 1) % len(shown) }
                if e.key == "Enter" && len(shown) > 0 { pick(shown[at]) }
                if e.key == "Escape" { q = null }
            }}/>
        {q != null && <div.pick-list role="listbox">
            {len(shown) == 0 ? <p.muted.small>Nothing matches</p>
            : <div>{for [i, o] in enumerate(shown) => <button type="button" role="option" aria-selected={i == at} class={i == at ? "on" : ""} @pointerdown={() => { pick(o) }}>{o.label}</button>}</div>}
            {len(matching) > len(shown) && <p.muted.small>{len(matching) - len(shown)} more: type to narrow</p>}
        </div>}
        <Hints {problems} {field}/>
    </div>
}

view CheckField(label: str, field: str, value, problems: list, on_change) =
    <label.field.check>
        <input type="checkbox" name={field} checked={value == true || value == 1} @change={(e) => { on_change(e.checked) }}/>
        <span>{label}</span>
        <Hints {problems} {field}/>
    </label>

// A field from a definition (a plugin's, or the workspace's own), at
// `fields.<key>` of the record.
view DefinedField(f: map, record: map, problems: list, on_change) {
    let path = `fields.${f.key}`
    let v = pick(record, path)
    let set_to = (x) => { on_change(path, x) }
    let label = f.required == true ? `${f.label} *` : f.label
    match f.type {
        "checkbox" => <CheckField {label} field={path} value={v} {problems} on_change={set_to}/>
        "select" => <SelectField {label} field={path} value={v} options={f.options ?? []} {problems} on_change={set_to} empty="—"/>
        "number" => <TextField {label} field={path} value={v} {problems} on_change={set_to} type="number"/>
        "date" => <TextField {label} field={path} value={v} {problems} on_change={set_to} type="date"/>
        _ => <TextField {label} field={path} value={v} {problems} on_change={set_to}/>
    }
}

// What the server refused, for the problems list: its problems, or one
// general message.
fn refusal_problems(r) =
    !is_err(r) ? []
    : type_of(r.error) == "map" && r.error.problems != null ? r.error.problems
    : [{ field: "", message: str(r.error) }]

// A refusal as one sentence.
fn err_text(r) = refusal_problems(r) | map((p) => p.message) | join(" ")

view FormProblems(problems: list) {
    let general = problems | filter((p) => p.field == "" || p.field == "graph")
    len(general) == 0 ? null : <div.alert>{for p in general => <p>{p.message}</p>}</div>
}

view Badge(text: str, tone: str = "") = <span class={`badge ${tone}`}>{text}</span>

fn stage_tone(stage: str) = match stage {
    "customer" => "green"
    "prospect" => "blue"
    "subscriber" => "purple"
    "churned" => "gray"
    _ => "amber"
}

fn status_tone(s: str) = match s {
    "paid" | "sent" | "done" | "won" => "green"
    "waiting" | "queued" | "draft" | "running" => "blue"
    "failed" | "refunded" | "lost" => "red"
    _ => "gray"
}

// Small line icons, drawn (font arrows like ↶ read badly at this size).
view Icon(name: str) = <svg.ico viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    {match name {
        "undo" => <g><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/></g>
        "redo" => <g><path d="m15 14 5-5-5-5"/><path d="M20 9H9a5 5 0 0 0 0 10h3"/></g>
        _ => null
    }}
</svg>

// ---- feedback on a page (lib/feedback.qwe) -----------------------------------------------

fn stroke_path(pts: list) = len(pts) == 0 ? "" : `M${join(pts | map((pt) => `${pt[0]} ${pt[1]}`), " L")}`

// The part of a snapshot to show: around what was drawn (at least 360
// pixels wide, so its words read), or the whole block if nothing was.
fn snap_view(f: map) {
    let pts = f.strokes | reduce([], (acc, st) => acc + st.points)
    if len(pts) == 0 { return { x: 0, y: 0, w: f.width, h: f.height } }
    let xs = pts | map((pt) => pt[0])
    let ys = pts | map((pt) => pt[1])
    let w = min([f.width, max([360, max(xs) - min(xs) + 120])])
    let h = min([f.height, max([120, max(ys) - min(ys) + 80])])
    let x = min([f.width - w, max([0, (min(xs) + max(xs)) / 2 - w / 2])])
    let y = min([f.height - h, max([0, (min(ys) + max(ys)) / 2 - h / 2])])
    { x: round(x), y: round(y), w: round(w), h: round(h) }
}

// A snapshot: the block as it was, around what was drawn on it, scaled to
// `shown` pixels wide.
view FeedbackSnap(f: map, shown: int = 280) {
    let v = snap_view(f)
    let scale = min([1.5, shown / max([1, v.w])])
    <div.fb-snap style={`width:${round(v.w * scale)}px;height:${round(v.h * scale)}px`} title={v.w < f.width || v.h < f.height ? "Around what was drawn" : ""}>
        <div.fb-snap-block style={`width:${f.width}px;transform:scale(${scale}) translate(${-v.x}px, ${-v.y}px)`}>{raw(f.block_html)}</div>
        <svg.fb-snap-ink viewBox={`${v.x} ${v.y} ${v.w} ${v.h}`} preserveAspectRatio="none" aria-hidden="true">
            {for st in f.strokes => <path d={stroke_path(st.points)} stroke={st.color} fill="none" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>}
        </svg>
    </div>
}

fn feedback_state(f: map) = f.status == "resolved" ? "resolved" : f.status == "acknowledged" ? "acknowledged" : "open"

// One piece of feedback: its snapshot, what was said, the talk; what may
// be done with it (`children`) below.
view FeedbackThread(f: map, shown: int = 280, children) =
    <article class={`fb-item ${feedback_state(f)}`}>
        <FeedbackSnap {f} {shown}/>
        <div.fb-meta>
            <b>{f.author}</b>
            <span.muted>{fmt_ago(f.created_at, now())}</span>
            <Badge text={feedback_state(f) == "acknowledged" ? `seen by ${f.acknowledger ?? "the team"}` : feedback_state(f)} tone={feedback_state(f) == "resolved" ? "green" : feedback_state(f) == "acknowledged" ? "purple" : "amber"}/>
        </div>
        <p.fb-body>{f.body}</p>
        {len(f.replies ?? []) > 0 && <ol.fb-replies>{for r in f.replies => <li key={r.id} class={r.team ? "team" : ""}>
            <b>{r.author}</b>{r.team && <span.fb-team>team</span>}<span.muted> · {fmt_ago(r.created_at, now())}</span>
            <p>{r.body}</p>
        </li>}</ol>}
        {children}
    </article>

view Avatar(name: str, size: str = "") = <span class={`avatar ${size}`}>{initials(name)}</span>

view Tags(tags: list) = <span.tags>{for t in tags => <span.tag>{t}</span>}</span>

view Empty(title: str, children) = <div.empty><p.empty-title>{title}</p>{children}</div>

view Loading() = <div.loading><span.spinner></span> Loading…</div>

view PageHead(title: str, sub: str = "", children) =
    <header.page-head>
        <div><h1>{title}</h1>{sub != "" && <p.sub>{sub}</p>}</div>
        <div.actions>{children}</div>
    </header>

view Drawer(title: str, on_close, children) =
    <div.drawer-wrap>
        <div.drawer-shade @click={() => { on_close() }}></div>
        <aside.drawer>
            <header><h2>{title}</h2><button.icon type="button" @click={() => { on_close() }}>✕</button></header>
            <div.drawer-body>{children}</div>
        </aside>
    </div>

view Stat(label: str, value, sub: str = "", tone: str = "") =
    <div class={`stat ${tone}`}><p.stat-label>{label}</p><p.stat-value>{value}</p>{sub != "" && <p.stat-sub>{sub}</p>}</div>

// Bars for a series of { label, value }.
view Bars(points: list, height: int = 120, money: str = "") {
    let top = max((points | map((p) => p.value)) + [1])
    let w = 100 / max([len(points), 1])
    <svg.bars viewBox={`0 0 100 ${height}`} preserveAspectRatio="none" style={`height:${height}px`}>
        {for [i, p] in enumerate(points) => {
            let h = p.value * (height - 4) / top
            <rect x={i * w + w * 0.15} y={height - h} width={w * 0.7} height={h} rx="0.8">
                <title>{p.label}: {money != "" ? fmt_money(p.value, money) : str(p.value)}</title>
            </rect>
        }}
    </svg>
}
