// The pages anyone sees: the main site (signing a workspace up), signing
// in, and a workspace's shop, forms and unsubscribe page.

view Page(title: str, children, wide: bool = false) =
    <html lang="en">
        <head>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
            <title>{title}</title>
            <link rel="stylesheet" href="/assets/app.css"/>
        </head>
        <body class={wide ? "public wide" : "public"}>{children}</body>
    </html>

view Logo() = <span.logo><span.logo-mark>◆</span> Relay</span>

// ---- the main site --------------------------------------------------------------------

view Landing() =
    <Page title="Relay — the CRM for merchants, writers and newsrooms" wide={true}>
        <div.landing>
            <section.hero>
                <Logo/>
                <h1>Know your customers. Grow your audience.</h1>
                <p.lead>Contacts, deals, a shop, newsletters and flows you draw — for merchants,
                    bloggers and news outlets. Each workspace is yours alone.</p>
                <ul.points>
                    <li><b>Flows you draw:</b> welcome series, after-purchase follow-ups, win-backs.</li>
                    <li><b>A checkout built in</b>, with tax, receipts and purchase-triggered flows.</li>
                    <li><b>Plugins with rules</b> that check your data as you type, and again when it is saved.</li>
                </ul>
            </section>
            <section.signup-card><Signup domain={DOMAIN}/></section>
        </div>
    </Page>

// `single`: setting up the one workspace, which has no address to choose.
component Signup(domain: str, single: bool = false) {
    state w = { name: "", slug: "", industry: "merchant", owner_name: "", email: "", password: "", currency: "USD" }
    state touched = []
    state server = []
    state free = null
    state busy = false
    let all = check_workspace(single ? set(w, "slug", "main") : w) + server
    // Hints for what you have typed in, not for what you have yet to.
    let shown = all | filter((p) => contains(touched, p.field))
    let change = (field) => (v) => {
        w = set(w, field, v)
        touched = unique(touched + [field])
        server = server | filter((p) => p.field != field)
        if field == "name" && !contains(touched, "slug") { w = set(w, "slug", slugify(v)) }
    }
    <form.signup @submit={() => {
        touched = ["name", "slug", "industry", "owner_name", "email", "password"]
        if len(errors_of(check_workspace(single ? set(w, "slug", "main") : w))) == 0 {
            busy = true
            let r = create_workspace(w)
            busy = false
            // The new workspace is on its own address.
            if is_err(r) { server = refusal_problems(r) } else { js("location.assign", r.url) }
        }
    }}>
        <h2>{single ? "Set up your CRM" : "Create your workspace"}</h2>
        <TextField label="Business name" field="name" value={w.name} problems={shown} on_change={change("name")} placeholder="Acme Goods" autofocus={true}/>
        {!single && <label.field>
            <span.label>Address</span>
            <div.slug-input>
                <input name="slug" value={w.slug} class={invalid(shown, "slug") && "invalid"} @input={(e) => {
                    change("slug")(lower(e.value))
                    free = null
                }} @blur={() => { free = slug_free(w.slug) }}/>
                <span.suffix>.{domain}</span>
            </div>
            {free == false && <p.hint>That address is taken</p>}
            {free == true && <p.hint.ok>Available</p>}
            <Hints problems={shown} field="slug"/>
        </label>}
        <label.field>
            <span.label>What do you do?</span>
            <div.choices>{for i in INDUSTRIES => <button type="button" class={w.industry == i.id ? "choice on" : "choice"}
                @click={() => { change("industry")(i.id) }}><b>{i.label}</b><span>{i.about}</span></button>}</div>
        </label>
        <TextField label="Your name" field="owner_name" value={w.owner_name} problems={shown} on_change={change("owner_name")}/>
        <TextField label="Email" field="email" value={w.email} problems={shown} on_change={change("email")} type="email"/>
        <TextField label="Password" field="password" value={w.password} problems={shown} on_change={change("password")} type="password" help="At least 10 characters"/>
        <FormProblems problems={server}/>
        <button.primary.wide disabled={busy}>{busy ? "Creating…" : "Create workspace"}</button>
    </form>
}

view SetupPage() =
    <Page title="Set up Relay" wide={true}>
        <div.landing>
            <section.hero>
                <Logo/>
                <h1>Welcome. Let us set up your CRM.</h1>
                <p.lead>One workspace, on this address. You will be its owner, and can add your team after.</p>
            </section>
            <section.signup-card><Signup domain={DOMAIN} single={true}/></section>
        </div>
    </Page>

view NoWorkspace() =
    <Page title="No workspace here">
        <div.center-card><Logo/><h1>There is no workspace here</h1><p>Check the address, or <a href="/">create one</a>.</p></div>
    </Page>

view NotFoundPage(what: str) =
    <SiteLayout title="Not found" description="">
        <div.site-narrow><h1>No such {what}</h1><p><a href="/">Back to the home page</a></p></div>
    </SiteLayout>

// ---- signing in --------------------------------------------------------------------------

view LoginPage(problem: str, email: str) =
    <Page title="Sign in">
        <div.center-card>
            <Logo/>
            <h1>Sign in</h1>
            {problem == "wrong" && <div.alert><p>That email and password do not match.</p></div>}
            {problem == "expired" && <div.alert><p>That sign-in link has expired. Sign in with your password.</p></div>}
            {problem == "locked" && <div.alert><p>Too many tries. Wait a quarter of an hour, then sign in again.</p></div>}
            <form method="post" action="/login" class="stack">
                <label.field><span.label>Email</span><input type="email" name="email" value={email} required autofocus/></label>
                <label.field><span.label>Password</span><input type="password" name="password" required/></label>
                <button.primary.wide>Sign in</button>
            </form>
        </div>
    </Page>

// ---- forms -------------------------------------------------------------------------------

view FormPage(slug: str) =
    <SiteLayout title="Sign up" description="">
        <div.site-narrow><PublicForm {slug}/></div>
    </SiteLayout>

// `embedded`: inside a page's block, which has its own heading.
component PublicForm(slug: str, embedded: bool = false) {
    state c = form_context(slug)
    state s = { email: "", first_name: "", last_name: "", consent: false }
    state touched = []
    state server = []
    state done = null
    if c == null { return <Loading/> }
    if is_err(c) { return <h1>No such form</h1> }
    let all = validate("signup", s, c.ctx) + server
    let shown = all | filter((p) => contains(touched, p.field))
    let change = (field) => (v) => {
        s = set(s, field, v)
        touched = unique(touched + [field])
        server = []
    }
    done != null
        ? <div><p.big-check>✓</p><h1>You are in!</h1><p>Thanks for signing up to {c.site}.</p></div>
        : <form.stack @submit={() => {
            touched = ["email", "first_name", "consent"]
            if len(errors_of(validate("signup", s, c.ctx))) == 0 {
                let r = submit_form(slug, s)
                if is_err(r) { server = refusal_problems(r) } else { done = r }
            }
        }}>
            {!embedded && <p.muted>{c.site}</p>}
            {!embedded && <h1>{c.form.name}</h1>}
            {c.form.headline != "" && <p>{c.form.headline}</p>}
            {contains(c.form.fields, "first_name") && <TextField label="First name" field="first_name" value={s.first_name} problems={shown} on_change={change("first_name")}/>}
            {contains(c.form.fields, "last_name") && <TextField label="Last name" field="last_name" value={s.last_name} problems={shown} on_change={change("last_name")}/>}
            <TextField label="Email" field="email" value={s.email} problems={shown} on_change={change("email")} type="email"/>
            {contains(c.extra, "consent") && <CheckField label={`I agree to receive email from ${c.site}`} field="consent" value={s.consent} problems={shown} on_change={change("consent")}/>}
            <FormProblems problems={server}/>
            <button.primary.wide>Sign up</button>
        </form>
}

view UnsubscribedPage(ok: bool, name: str) =
    <SiteLayout title="Unsubscribe" description="">
        <div.site-narrow>{ok
            ? <div><h1>You are unsubscribed</h1><p>{name} will not email you again.</p></div>
            : <div><h1>That link did not work</h1><p>It may have been copied wrongly.</p></div>}</div>
    </SiteLayout>

// A page's live preview: what its designer has on screen, as it changes;
// and feedback on it. Whoever has the link chooses a block, takes a
// snapshot of it to draw on and say what they think; everyone's feedback,
// and the team's answers, as they come; the viewer resolves it.
component LivePreview(token: str) {
    state v = live(live_view, token)
    state fb = live(preview_feedback, token)
    state choosing = false
    state chosen = null
    state shot = null
    state color = "#e11d48"
    state author = ""
    state body = ""
    state problems = []
    state panel = false
    state drafts = {}
    state sent = ""
    if v == null { return <p.pb-missing>Loading…</p> }
    if is_err(v) { return <section.np-empty><h1>This preview is not available</h1><p>{err_text(v)}</p></section> }
    let items = fb == null || is_err(fb) ? [] : fb
    let open_items = items | filter((f) => f.status != "resolved")
    let counts = open_items | reduce({}, (m, f) => set(m, f.block_id, (m[f.block_id] ?? 0) + 1))
    let snapshot = () => {
        shot = { block: chosen }
        author = js("pbFeedback.name") ?? ""
        body = ""
        problems = []
        js("pbFeedback.mount", chosen, "#fb-frame")
    }
    let send = () => {
        let t = js("pbFeedback.take")
        let r = give_feedback(token, { block: shot.block, width: t.width, height: t.height, strokes: t.strokes, body, author })
        if is_err(r) { problems = refusal_problems(r) } else {
            js("pbFeedback.remember", author)
            shot = null
            chosen = null
            choosing = false
            panel = true
            sent = "Sent: the team sees it now"
        }
    }
    let answer = (f) => {
        let text = drafts[str(f.id)] ?? ""
        if blank(author) { author = js("pbFeedback.name") ?? "" }
        let r = viewer_reply(token, f.id, blank(author) ? "A viewer" : author, text)
        if !is_err(r) { drafts = set(drafts, str(f.id), "") }
    }
    <div class={choosing ? "live-page fb-choosing" : "live-page"}>
        <style>{join(keys(counts) | map((k) => `[data-live-block=${k}]::after { content: "${counts[k]}"; }`), "\n")}{chosen == null ? "" : `\n[data-live-block=${chosen}] { outline: 3px solid #e11d48; outline-offset: -3px; }`}</style>
        <div.live-blocks @click={(e) => {
            if choosing {
                e.preventDefault()
                let el = e.target.closest("[data-live-block]")
                if el != null { chosen = el.dataset.liveBlock }
            }
        }}>{raw(v.html)}</div>
        {choosing && <div.fb-choose role="status">
            {chosen == null ? <span>Click the part of the page your feedback is about</span>
            : <span>Block chosen</span>}
            <button.primary type="button" disabled={chosen == null} @click={() => { snapshot() }}>📷 Snapshot and comment</button>
            <button type="button" @click={() => { choosing = false; chosen = null }}>Cancel</button>
        </div>}
        <div.live-bar role="status">
            <span class={v.saved ? "live-dot saved" : "live-dot"}></span>
            <b>Live preview</b>
            <span>{v.saved ? "the saved draft" : `${blank(v.by) ? "someone" : v.by} is editing`}</span>
            <span.live-sep></span>
            <button type="button" class={choosing ? "on" : ""} @click={() => { choosing = !choosing; chosen = null; panel = false }}>Give feedback</button>
            <button type="button" class={panel ? "on" : ""} @click={() => { panel = !panel; choosing = false }}>Feedback{len(open_items) > 0 && ` (${len(open_items)})`}</button>
        </div>
        {shot != null && <div.fb-modal role="dialog" aria-modal="true" aria-label="Feedback on a block" @keydown={(e) => { if e.key == "Escape" { shot = null } }}>
            <div.fb-card>
                <header.fb-head><h2>Your feedback</h2><button.icon type="button" aria-label="Close" @click={() => { shot = null }}>✕</button></header>
                <div.fb-tools>
                    <span.muted>Draw on it to point things out</span>
                    {for c in FEEDBACK_COLORS => <button type="button" class={color == c ? "fb-color on" : "fb-color"} style={`--c:${c}`} aria-label={`Draw in ${c}`} aria-pressed={color == c}
                        @click={() => { color = c; js("pbFeedback.color", c) }}></button>}
                    <button type="button" @click={() => { js("pbFeedback.undo") }}>Undo</button>
                    <button type="button" @click={() => { js("pbFeedback.clear") }}>Clear</button>
                </div>
                <div.fb-frame id="fb-frame"></div>
                <label.fb-field><span>What should change?</span>
                    <textarea rows="3" value={body} placeholder="The price should be bigger; this photo is old…" @input={(e) => { body = e.value }}></textarea></label>
                <label.fb-field><span>Your name</span>
                    <input value={author} placeholder="So they know who said it" @input={(e) => { author = e.value }}/></label>
                {len(problems) > 0 && <ul.fb-problems>{for x in problems => <li>{x.message}</li>}</ul>}
                <div.fb-actions>
                    <button.primary type="button" @click={() => { send() }}>Send feedback</button>
                    <button type="button" @click={() => { shot = null }}>Cancel</button>
                </div>
            </div>
        </div>}
        {panel && <aside.fb-panel aria-label="Feedback">
            <header.fb-head><h2>Feedback</h2><button.icon type="button" aria-label="Close" @click={() => { panel = false }}>✕</button></header>
            {sent != "" && <p.fb-sent>{sent}</p>}
            {len(items) == 0 ? <p.muted>None yet: “Give feedback”, then click the part of the page it is about.</p>
            : <div.fb-list>{for f in items => <FeedbackThread key={f.id} {f} shown={340}>
                <div.fb-reply>
                    <input placeholder="Reply…" aria-label="Reply" value={drafts[str(f.id)] ?? ""} @input={(e) => { drafts = set(drafts, str(f.id), e.value) }}
                        @keydown={(e) => { if e.key == "Enter" { answer(f) } }}/>
                    <button type="button" @click={() => { answer(f) }}>Send</button>
                </div>
                <div.fb-actions>
                    {f.status == "resolved"
                        ? <button type="button" @click={() => { resolve_feedback(token, f.id, false) }}>Reopen</button>
                        : <button.primary type="button" @click={() => { resolve_feedback(token, f.id, true) }}>Mark resolved</button>}
                </div>
            </FeedbackThread>}</div>}
        </aside>}
    </div>
}
