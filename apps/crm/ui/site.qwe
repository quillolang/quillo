// The site's look, in the app: the theme (from the plugins switched on),
// its colour, font and logo, the menu and the footer, and CSS of the
// workspace's own, with the site shown as it will look while you change it.

component SiteEditor(ws: map, on_change) {
    state setup = site_setup()
    state t = merge(DEFAULT_THEME, ws.settings.theme ?? {})
    state server = []
    state saved = false
    state what = "home"
    state shown = preview_site(merge(DEFAULT_THEME, ws.settings.theme ?? {}), "home")
    state css_open = (ws.settings.theme ?? {}).css != null && (ws.settings.theme ?? {}).css != ""
    if setup == null { return <Loading/> }
    if is_err(setup) { return <Empty title="The theme did not load"><p>{err_text(setup)}</p></Empty> }
    let problems = validate("theme", t, ctx_of(ws)) + server
    let errors = errors_of(problems)
    // Every change shows at once, the site rendered by the server in it.
    let refresh = (next, page) => {
        let r = preview_site(next, page)
        if !is_err(r) { shown = r }
    }
    let change = (k) => (v) => {
        t = set(t, k, v)
        saved = false
        server = []
        refresh(t, what)
    }
    let pick = (d) => {
        t = merge(t, { id: d.id, color: d.color ?? t.color, font: d.font ?? t.font })
        saved = false
        refresh(t, what)
    }
    let menu = t.menu ?? setup.default_menu
    let admin = ws.user.role != "member"
    <div.site-editor>
        <div.site-settings.stack>
            <section.stack>
                <h3>Theme</h3>
                <div.theme-grid>{for d in setup.themes => <button type="button" class={t.id == d.id ? "theme-card on" : "theme-card"} @click={() => { pick(d) }}>
                    <span class={`theme-swatch head-${d.header}`} style={`--c:${d.color ?? "#4f46e5"};font-family:${FONTS[d.font ?? "system"] ?? FONTS.system}`}>
                        <i></i><b>Aa</b><em></em><em></em>
                    </span>
                    <b>{d.name}</b>
                    <span.small.muted>{d.description}</span>
                </button>}</div>
            </section>
            <section.stack>
                <h3>Colour, type, logo</h3>
                <label.field>
                    <span.label>Brand colour</span>
                    <div.inline>
                        <input type="color" value={t.color} style="width:48px;padding:2px" @input={(e) => { change("color")(e.value) }}/>
                        <input name="color" value={t.color} @input={(e) => { change("color")(e.value) }}/>
                    </div>
                    <Hints {problems} field="color"/>
                </label>
                <SelectField label="Font" field="font" value={t.font} options={[{ value: "system", label: "Clean (system)" }, { value: "serif", label: "Classic (serif)" }, { value: "rounded", label: "Friendly (rounded)" }, { value: "mono", label: "Technical (mono)" }]} {problems} on_change={change("font")}/>
                <CheckField label="Dark" field="dark" value={t.dark} {problems} on_change={change("dark")}/>
                <ImagePicker label="Logo (optional)" value={t.logo} on_change={(v) => { change("logo")(v == null ? "" : type_of(v) == "str" ? v : media_src(v, crop_text(v), 320)) }}/>
                <Hints {problems} field="logo"/>
            </section>
            <section.stack>
                <h3>Menu</h3>
                {t.menu == null
                    ? <div.stack>
                        <p.muted.small>Automatic: {len(menu) == 0 ? "nothing yet" : menu | map((l) => l.label) | join(", ")}. The shop and the blog show when they have something.</p>
                        <div><button type="button" @click={() => { change("menu")(menu) }}>Make my own menu</button></div>
                    </div>
                    : <LinkList links={t.menu} options={setup.links} on_change={change("menu")} on_reset={() => { change("menu")(null) }}/>}
                <Hints {problems} field="menu"/>
            </section>
            <section.stack>
                <h3>Footer</h3>
                <AreaField label="Text (an address, a line about you)" field="footer" value={t.footer} {problems} on_change={change("footer")} rows={2}/>
                <span.label>Links</span>
                <LinkList links={t.footer_links ?? []} options={setup.links} on_change={change("footer_links")}/>
            </section>
            <section.stack>
                <h3>Your own CSS</h3>
                {css_open
                    ? <div.stack>
                        <p.muted.small>Styles the site only: it is nested in <code>.site</code>, so <code>h1 {"{"} ... {"}"}</code> styles the site's headings.</p>
                        <CodeEditor value={t.css} lang="css" rows={12} on_change={change("css")} problems={problems | filter((p) => p.field == "css")}/>
                        <Hints {problems} field="css"/>
                    </div>
                    : <div><button type="button" @click={() => { css_open = true }}>Add CSS</button></div>}
            </section>
            <FormProblems problems={server}/>
            <div.form-actions.sticky-actions>
                <button.primary disabled={!admin || len(errors) > 0} @click={() => {
                    let r = save_theme(t)
                    if is_err(r) { server = refusal_problems(r) } else { saved = true; on_change() }
                }}>Save the look</button>
                {saved && <span.ok>Saved: visitors see it now</span>}
                {len(errors) > 0 && <span.bad>{plural(len(errors), "problem")}</span>}
            </div>
        </div>
        <div.site-preview-pane>
            <div.preview-bar>
                {for w in [["home", "Home"], ["blog", "Blog"], ["shop", "Shop"]] =>
                    <button type="button" class={what == w[0] ? "tab on" : "tab"} @click={() => { what = w[0]; refresh(t, w[0]) }}>{w[1]}</button>}
                <span.grow></span>
                <span.muted.small>A preview: links do not work here.</span>
            </div>
            {shown == null ? <Loading/> : is_err(shown) ? <p.bad>{err_text(shown)}</p> : <iframe.site-frame title="The site, in this theme" sandbox="" srcdoc={shown}></iframe>}
        </div>
    </div>
}

// Links (a menu): each a label and where it goes, in order.
view LinkList(links: list, options: list, on_change, on_reset = null) {
    let put_at = (i, k, v) => links | enumerate | map((x) => x[0] == i ? set(x[1], k, v) : x[1])
    let without = (i) => links | enumerate | filter((x) => x[0] != i) | map((x) => x[1])
    let swap = (i, j) => links | enumerate | map((x) => x[0] == i ? links[j] : x[0] == j ? links[i] : x[1])
    <div.link-list>
        {for [i, l] in enumerate(links) => <div.link-row key={i}>
            <input value={l.label} placeholder="Label" aria-label="Label" @input={(e) => { on_change(put_at(i, "label", e.value)) }}/>
            <input value={l.link} placeholder="/p/about" aria-label="Link" @input={(e) => { on_change(put_at(i, "link", e.value)) }}/>
            <button.icon type="button" title="Up" disabled={i == 0} @click={() => { on_change(swap(i, i - 1)) }}>↑</button>
            <button.icon type="button" title="Remove" @click={() => { on_change(without(i)) }}>✕</button>
        </div>}
        <div.inline>
            <select aria-label="Add a link" @change={(e) => {
                let o = find(options, (x) => x.link == e.value)
                if e.value == "custom" { on_change(links + [{ label: "", link: "" }]) } else if o != null { on_change(links + [o]) }
            }} key={`add-${len(links)}`}>
                <option value="">Add a link…</option>
                {for o in options => <option value={o.link}>{o.label} ({o.link})</option>}
                <option value="custom">Another address…</option>
            </select>
            {on_reset != null && <button.ghost type="button" @click={() => { on_reset() }}>Back to automatic</button>}
        </div>
    </div>
}

// How the app asks and tells: the notice styles plugins bring.
component NoticeSettings(ws: map) {
    state picked = ws.notice
    state problems = []
    <section.card.stack.narrow>
        <h2>Questions and notes</h2>
        <p.muted.small>How the app asks before it deletes, and tells you what it did. Plugins bring more styles.</p>
        <div.theme-grid>{for n in ws.notice_styles ?? [] => <button type="button" class={picked == n.id ? "theme-card on" : "theme-card"} @click={() => { picked = n.id }}>
            <b>{n.name}</b>
            <span.small.muted>{n.description}</span>
        </button>}</div>
        <FormProblems {problems}/>
        <div.form-actions>
            <button.primary disabled={!ws.designer || picked == ws.notice} @click={() => {
                let r = save_notice_style(picked)
                if is_err(r) { problems = refusal_problems(r) } else { js("location.reload") }
            }}>Use it</button>
            <button type="button" @click={() => {
                if ask("This is how the app asks before it does something that cannot be undone.", { title: "Try a question?", ok: "Delete", tone: "danger" }) {
                    notify("This is how it tells you it is done.", { title: "Done" })
                } else {
                    notify("Nothing was changed.")
                }
            }}>Try it</button>
        </div>
    </section>
}
