// The app's pages. Each loads its data from server functions (most of them
// live: what another user changes shows up), and each editor runs the rules
// for its kind of record as you type, with the same context the server
// uses when it saves.

fn ctx_of(ws: map, extra: map = {}) = merge({ enabled: ws.enabled, fields: ws.fields, settings: ws.settings, today: ws.today, objects: ws.objects ?? [] }, extra)

fn tag_list(text: str) = split(text, ",") | map((t) => slugify(trim(t))) | filter((t) => t != "")

let KIND_ICON = { created: "＋", tag: "#", stage: "↗", note: "✎", deal: "◫", order: "≡", form: "✍", email: "✉", campaign: "✉",
    task: "☑", loyalty: "★", membership: "◆", unsubscribed: "⊘" }

view Timeline(items: list, show_contact: bool = false) =
    len(items) == 0 ? <p.muted>Nothing yet.</p>
    : <ul.timeline>{for a in items => <li key={a.id}>
        <span.tl-icon>{KIND_ICON[a.kind] ?? "•"}</span>
        <div>
            <p>{a.summary}{show_contact && a.contact_id != null && <span> · <a href={`/app/contacts/${a.contact_id}`}>{full_name(a)}</a></span>}</p>
            <p.muted.small>{fmt_ago(a.created_at, now())}</p>
        </div>
    </li>}</ul>

// ---- the dashboard -------------------------------------------------------------------------

component Dashboard(ws: map) {
    state d = live(load_dashboard)
    if d == null { return <Loading/> }
    if is_err(d) { return <Empty title="Could not load the dashboard"/> }
    let cur = ws.currency
    let top = max((d.stages | map((s) => s.cents)) + [1])
    <div>
        <PageHead title={`Hello, ${split(ws.user.name, " ")[0]}`} sub={`${ws.name} · ${fmt_day(ws.today)}`}>
            <a.button href="/app/contacts">Contacts</a>
            <a.button.primary href="/app/flows">Flows</a>
        </PageHead>
        <div.stats>
            <Stat label="Contacts" value={group(d.contacts)} sub={`+${d.new_contacts} this week`}/>
            <Stat label="Subscribers" value={group(d.subscribers)}/>
            <Stat label="Open pipeline" value={fmt_money(d.pipeline_cents, cur)} sub={plural(d.open_deals, "deal")}/>
            <Stat label="Revenue, 30 days" value={fmt_money(d.revenue_cents, cur)} sub={plural(d.orders, "order")}/>
            <Stat label="Tasks due" value={str(d.tasks_due)} tone={d.tasks_due > 0 ? "warn" : ""}/>
            <Stat label="In flows now" value={str(d.running_flows)}/>
        </div>
        <div.grid2>
            <section.card>
                <h2>Sales, last 14 days</h2>
                <Bars points={d.sales | map((s) => { label: fmt_day(s.day), value: s.cents })} money={cur}/>
                <div.axis><span>{fmt_day(d.sales[0].day)}</span><span>today</span></div>
            </section>
            <section.card>
                <h2>Pipeline</h2>
                {for s in d.stages => <div.funnel-row>
                    <span.funnel-name>{s.name}</span>
                    <span.funnel-bar><span class={`fill ${s.kind}`} style={`width:${max([2, s.cents * 100 / top])}%`}></span></span>
                    <span.funnel-n>{s.n} · {fmt_money(s.cents, cur)}</span>
                </div>}
            </section>
        </div>
        <section.card><h2>Recent activity</h2><Timeline items={d.recent} show_contact={true}/></section>
    </div>
}

// ---- contacts ---------------------------------------------------------------------------------

component ContactsPage(ws: map, query: map) {
    state q = ""
    state stage = ""
    state tag = ""
    state adding = false
    state importing = false
    state tags = all_tags() ?? []
    <div>
        <PageHead title="Contacts" sub="Everyone you sell to, write for, or work with.">
            <a.button href="/app/export/contacts.csv" data-reload>Export CSV</a>
            <button @click={() => { importing = !importing }}>Import CSV</button>
            <button.primary @click={() => { adding = true }}>New contact</button>
        </PageHead>
        {query.imported != null && <div.notice>Imported {query.imported} contacts{query.skipped != "0" && `, skipped ${query.skipped} (invalid or already there)`}.</div>}
        {importing && <form.card.import method="post" action="/app/import/contacts" enctype="multipart/form-data">
            <p>A CSV with a header row: <code>first_name, last_name, email, phone, stage, subscribed, tags</code> and your own fields' keys. Each row is checked by the same rules as the form.</p>
            <input type="file" name="file" accept=".csv,text/csv" required/>
            <button.primary>Import</button>
        </form>}
        <div.filters>
            <input type="search" aria-label="Search contacts" placeholder="Name or email" value={q} @input={(e) => { q = e.value }}/>
            <select aria-label="Stage" @change={(e) => { stage = e.value }}>
                <option value="">All stages</option>
                {for s in STAGES => <option value={s} selected={stage == s}>{s}</option>}
            </select>
            <select aria-label="Tag" @change={(e) => { tag = e.value }}>
                <option value="">All tags</option>
                {for t in tags => <option value={t.tag} selected={tag == t.tag}>{t.tag} ({t.n})</option>}
            </select>
        </div>
        <ContactTable key={json.stringify([q, stage, tag])} query={{ q, stage, tag }}/>
        {adding && <Drawer title="New contact" on_close={() => { adding = false }}>
            <ContactForm contact={{ first_name: "", last_name: "", email: "", phone: "", stage: "lead", tags: [], fields: {}, subscribed: false }} {ws}
                on_saved={(c) => { adding = false; navigate(`/app/contacts/${c.id}`) }}/>
        </Drawer>}
    </div>
}

component ContactTable(query: map) {
    state rows = live(list_contacts, query)
    if rows == null { return <Loading/> }
    if is_err(rows) { return <Empty title="Could not load contacts"/> }
    len(rows) == 0
        ? <Empty title="No contacts here"><p>Add one, import a CSV, or share a form.</p></Empty>
        : <table.table>
            <thead><tr><th>Name</th><th>Email</th><th>Company</th><th>Stage</th><th>Tags</th><th>Updated</th></tr></thead>
            <tbody>{for c in rows => <tr key={c.id}>
                <td><a.person href={`/app/contacts/${c.id}`}><Avatar name={c.name} size="sm"/>{c.name}</a></td>
                <td>{c.email}</td>
                <td>{c.company ?? ""}</td>
                <td><Badge text={c.stage} tone={stage_tone(c.stage)}/>{c.subscribed && <Badge text="subscribed" tone="purple"/>}</td>
                <td><Tags tags={c.tags}/></td>
                <td.muted>{fmt_ago(c.updated_at, now())}</td>
            </tr>}</tbody>
        </table>
}

// Editing a contact: the rules of core and of the plugins switched on, and
// the workspace's own fields, hint as you type; the server checks again.
component ContactForm(contact: map, ws: map, on_saved) {
    state c = contact
    state tag_text = join(contact.tags ?? [], ", ")
    state touched = contact.id != null
    state server = []
    state busy = false
    state companies = list_companies("") ?? []
    let ctx = ctx_of(ws)
    let problems = touched ? validate("contact", c, ctx) + server : server
    let on_field = (path, v) => {
        c = put(c, path, v)
        touched = true
        server = server | filter((p) => p.field != path)
    }
    let change = (path) => (v) => { on_field(path, v) }
    <form.stack @submit={() => {
        touched = true
        let record = set(c, "tags", tag_list(tag_text))
        if len(errors_of(validate("contact", record, ctx))) == 0 {
            busy = true
            let r = save_contact(record)
            busy = false
            if is_err(r) { server = refusal_problems(r) } else { on_saved(r) }
        }
    }}>
        <div.row2>
            <TextField label="First name" field="first_name" value={c.first_name} {problems} on_change={change("first_name")}/>
            <TextField label="Last name" field="last_name" value={c.last_name} {problems} on_change={change("last_name")}/>
        </div>
        <TextField label="Email" field="email" value={c.email} {problems} on_change={change("email")} type="email"/>
        <TextField label="Phone" field="phone" value={c.phone} {problems} on_change={change("phone")}/>
        <div.row2>
            <SelectField label="Stage" field="stage" value={c.stage} options={STAGES} {problems} on_change={change("stage")}/>
            <SelectField label="Company" field="company_id" value={c.company_id} options={companies | map((co) => { value: co.id, label: co.name })}
                {problems} on_change={(v) => { on_field("company_id", v == "" ? null : int(v)) }} empty="None"/>
        </div>
        <label.field>
            <span.label>Tags</span>
            <input name="tags" value={tag_text} placeholder="vip, newsletter" @input={(e) => { tag_text = e.value }}/>
        </label>
        <CheckField label="Subscribed to email" field="subscribed" value={c.subscribed} {problems} on_change={change("subscribed")}/>
        {for f in fields_for("contact", ctx) => <DefinedField key={f.key} {f} record={c} {problems} on_change={on_field}/>}
        <FormProblems problems={server}/>
        <div.form-actions><button.primary disabled={busy}>{busy ? "Saving…" : "Save contact"}</button></div>
    </form>
}

component ContactPage(id: int, ws: map) {
    state c = live(get_contact, id)
    state tab = "timeline"
    state editing = false
    state note = ""
    state task = { title: "", due: "" }
    state task_problems = []
    state flows = list_flows() ?? []
    state flow_pick = ""
    state message = ""
    state linked = records_of_contact(id)
    if c == null { return <Loading/> }
    if is_err(c) { return <Empty title="No such contact"><p><a href="/app/contacts">All contacts</a></p></Empty> }
    let cur = ws.currency
    let defined = fields_for("contact", ctx_of(ws))
    let tabs = [["timeline", "Timeline"], ["deals", `Deals (${len(c.deals)})`], ["orders", `Orders (${len(c.orders)})`],
        ["tasks", `Tasks (${len(c.tasks)})`], ["notes", `Notes (${len(c.notes)})`], ["flows", `Flows (${len(c.runs)})`]]
    <div>
        <header.contact-head>
            <Avatar name={c.name} size="lg"/>
            <div>
                <h1>{c.name}</h1>
                <p.muted>{c.email}{c.company != null && <span> · <a href={`/app/companies/${c.company.id}`}>{c.company.name}</a></span>}</p>
                <p><Badge text={c.stage} tone={stage_tone(c.stage)}/>{c.subscribed && <Badge text="subscribed" tone="purple"/>}<Tags tags={c.tags}/></p>
            </div>
            <div.actions>
                <button @click={() => { editing = true }}>Edit</button>
                {ws.user.role != "member" && <button.danger @click={() => {
                    if ask(`Their timeline, notes and tasks go too.`, { title: `Delete ${c.name}?`, ok: "Delete", tone: "danger" }) { delete_contact(id); notify(`${c.name} deleted`); navigate("/app/contacts") }
                }}>Delete</button>}
            </div>
        </header>
        {message != "" && <div.notice>{message}</div>}
        <div.split>
            <section.card.details>
                <h2>Details</h2>
                <dl>
                    <dt>Email</dt><dd>{c.email != "" ? c.email : "—"}</dd>
                    <dt>Phone</dt><dd>{c.phone != "" ? c.phone : "—"}</dd>
                    <dt>Source</dt><dd>{c.source != "" ? c.source : "—"}</dd>
                    <dt>Added</dt><dd>{fmt_date(c.created_at)}</dd>
                    {for f in defined => [<dt>{f.label}</dt>, <dd>{str(c.fields[f.key] ?? "—")}</dd>]}
                </dl>
            </section>
            <section.card.tabs-card>
                <nav.tabs>{for t in tabs => <button type="button" class={tab == t[0] ? "tab on" : "tab"} @click={() => { tab = t[0] }}>{t[1]}</button>}</nav>
                {match tab {
                    "timeline" => <Timeline items={c.timeline}/>
                    "deals" => len(c.deals) == 0 ? <p.muted>No deals.</p>
                        : <ul.plain>{for d in c.deals => <li><b>{d.title}</b> · {fmt_money(d.value_cents, cur)} · <Badge text={d.stage}/></li>}</ul>
                    "orders" => len(c.orders) == 0 ? <p.muted>No orders.</p>
                        : <ul.plain>{for o in c.orders => <li><b>{o.number}</b> · {fmt_money(o.total_cents, cur)} · <Badge text={o.status} tone={status_tone(o.status)}/> · {fmt_date(o.created_at)}</li>}</ul>
                    "tasks" => <div>
                        <ul.plain>{for t in c.tasks => <li class={t.done == 1 && "done"}>
                            <input type="checkbox" checked={t.done == 1} @change={() => { toggle_task(t.id) }}/> {t.title}
                            {t.due != "" && <span.muted> · due {fmt_day(t.due)}</span>}</li>}</ul>
                        <form.inline @submit={() => {
                            let rec = set(task, "contact_id", id)
                            task_problems = validate("task", rec, ctx_of(ws))
                            if len(errors_of(task_problems)) == 0 {
                                let r = save_task(rec)
                                if is_err(r) { task_problems = refusal_problems(r) } else { task = { title: "", due: "" } }
                            }
                        }}>
                            <input placeholder="New task" value={task.title} @input={(e) => { task = set(task, "title", e.value) }}/>
                            <input type="date" value={task.due} @input={(e) => { task = set(task, "due", e.value) }}/>
                            <button>Add</button>
                        </form>
                        <Hints problems={task_problems} field="title"/>
                    </div>
                    "notes" => <div>
                        <form.stack @submit={() => {
                            let r = add_note(id, note)
                            if is_err(r) { message = r.error } else { note = ""; message = "" }
                        }}>
                            <textarea rows="3" placeholder="Write a note…" @input={(e) => { note = e.value }}>{note}</textarea>
                            <div.form-actions><button.primary>Add note</button></div>
                        </form>
                        <ul.notes>{for n in c.notes => <li><p>{n.body}</p><p.muted.small>{n.author ?? "Someone"} · {fmt_ago(n.created_at, now())}</p></li>}</ul>
                    </div>
                    _ => <div>
                        <div.inline>
                            <select aria-label="Flow to start" @change={(e) => { flow_pick = e.value }}>
                                <option value="">Start a flow for {c.name}…</option>
                                {for f in flows => <option value={str(f.id)}>{f.name}</option>}
                            </select>
                            <button disabled={flow_pick == ""} @click={() => {
                                let r = start_flow(int(flow_pick), id)
                                message = is_err(r) ? r.error : "Started. The flow's steps show on the timeline as they run."
                            }}>Start</button>
                        </div>
                        <ul.plain>{for r in c.runs => <li><a href={`/app/flows/${r.flow_id}`}><b>{r.flow}</b></a> <Badge text={r.status} tone={status_tone(r.status)}/></li>}</ul>
                    </div>
                }}
            </section>
        </div>
        {linked != null && !is_err(linked) && len(linked) > 0 && <LinkedRecords records={linked}/>}
        {editing && <Drawer title={`Edit ${c.name}`} on_close={() => { editing = false }}>
            <ContactForm contact={c} {ws} on_saved={(saved) => { editing = false }}/>
        </Drawer>}
    </div>
}

// ---- companies ------------------------------------------------------------------------------

component CompaniesPage(ws: map) {
    state q = ""
    state rows = list_companies("")
    state adding = false
    let cur = ws.currency
    <div>
        <PageHead title="Companies"><button.primary @click={() => { adding = true }}>New company</button></PageHead>
        <div.filters><input type="search" aria-label="Search companies" placeholder="Name or domain" value={q} @input={(e) => {
            q = e.value
            rows = list_companies(q)
        }}/></div>
        {rows == null ? <Loading/>
        : is_err(rows) || len(rows) == 0 ? <Empty title="No companies yet"/>
        : <table.table>
            <thead><tr><th>Name</th><th>Domain</th><th>Industry</th><th>People</th><th>Pipeline</th></tr></thead>
            <tbody>{for co in rows => <tr key={co.id}>
                <td><a href={`/app/companies/${co.id}`}><b>{co.name}</b></a></td><td>{co.domain}</td><td>{co.industry}</td>
                <td>{co.people}</td><td>{fmt_money(co.pipeline_cents, cur)}</td>
            </tr>}</tbody>
        </table>}
        {adding && <Drawer title="New company" on_close={() => { adding = false }}>
            <CompanyForm company={{ name: "", domain: "", industry: "", fields: {} }} {ws} on_saved={(co) => {
                adding = false
                rows = list_companies(q)
            }}/>
        </Drawer>}
    </div>
}

component CompanyForm(company: map, ws: map, on_saved) {
    state co = company
    state touched = company.id != null
    state server = []
    let ctx = ctx_of(ws)
    let problems = touched ? validate("company", co, ctx) + server : server
    let on_field = (path, v) => { co = put(co, path, v); touched = true; server = [] }
    let change = (path) => (v) => { on_field(path, v) }
    <form.stack @submit={() => {
        touched = true
        if len(errors_of(validate("company", co, ctx))) == 0 {
            let r = save_company(co)
            if is_err(r) { server = refusal_problems(r) } else { on_saved(r) }
        }
    }}>
        <TextField label="Name" field="name" value={co.name} {problems} on_change={change("name")}/>
        <TextField label="Domain" field="domain" value={co.domain} {problems} on_change={change("domain")} placeholder="example.com"/>
        <TextField label="Industry" field="industry" value={co.industry} {problems} on_change={change("industry")}/>
        {for f in fields_for("company", ctx) => <DefinedField key={f.key} {f} record={co} {problems} on_change={on_field}/>}
        <FormProblems problems={server}/>
        <div.form-actions><button.primary>Save company</button></div>
    </form>
}

component CompanyPage(id: int, ws: map) {
    state co = live(get_company, id)
    state editing = false
    state linked = records_of_company(id)
    if co == null { return <Loading/> }
    if is_err(co) { return <Empty title="No such company"/> }
    <div>
        <PageHead title={co.name} sub={co.domain}><button @click={() => { editing = true }}>Edit</button></PageHead>
        <div.grid2>
            <section.card><h2>People</h2>{len(co.people) == 0 ? <p.muted>No one yet.</p>
                : <ul.plain>{for p in co.people => <li><a.person href={`/app/contacts/${p.id}`}><Avatar name={p.name} size="sm"/>{p.name}</a> <span.muted>{p.email}</span></li>}</ul>}</section>
            <section.card><h2>Deals</h2>{len(co.deals) == 0 ? <p.muted>No deals.</p>
                : <ul.plain>{for d in co.deals => <li><b>{d.title}</b> · {fmt_money(d.value_cents, ws.currency)} · <Badge text={d.stage}/></li>}</ul>}</section>
        </div>
        {linked != null && !is_err(linked) && len(linked) > 0 && <LinkedRecords records={linked}/>}
        {editing && <Drawer title="Edit company" on_close={() => { editing = false }}>
            <CompanyForm company={co} {ws} on_saved={(saved) => { editing = false }}/>
        </Drawer>}
    </div>
}

// ---- deals ---------------------------------------------------------------------------------------

component DealsPage(ws: map) {
    state pipeline = (ws.pipelines[0] ?? {}).id ?? 0
    <div>
        <PageHead title="Deals" sub="Drag a card to move it along.">
            <select aria-label="Pipeline" @change={(e) => { pipeline = int(e.value) ?? pipeline }}>
                {for p in ws.pipelines => <option value={str(p.id)} selected={p.id == pipeline}>{p.name}</option>}
            </select>
        </PageHead>
        <DealBoard key={str(pipeline)} {pipeline} {ws}/>
    </div>
}

component DealBoard(pipeline: int, ws: map) {
    state board = live(load_board, pipeline)
    state dragging = null
    state over = null
    state editing = null
    state problems = []
    if board == null { return <Loading/> }
    if is_err(board) { return <Empty title="Could not load the board"/> }
    let cur = ws.currency
    let move = (deal_id, stage_id) => {
        let r = move_deal(deal_id, stage_id)
        problems = refusal_problems(r)
        if len(problems) > 0 { editing = find(board.deals, (d) => d.id == deal_id) }
    }
    <div>
        {len(problems) > 0 && <div.alert>{for p in problems => <p>{p.message}</p>}</div>}
        <div.board>{for s in board.stages => {
            let deals = board.deals | filter((d) => d.stage_id == s.id)
            <section key={s.id} class={over == s.id ? `column ${s.kind} over` : `column ${s.kind}`}
                @dragover={(e) => { e.preventDefault(); over = s.id }}
                @dragleave={() => { over = null }}
                @drop={(e) => {
                    e.preventDefault()
                    over = null
                    if dragging != null { move(dragging, s.id); dragging = null }
                }}>
                <header><b>{s.name}</b><span.muted>{len(deals)} · {fmt_money(deals | map((d) => d.value_cents) | sum, cur)}</span></header>
                {for d in deals => <article.deal key={d.id} draggable="true"
                    @dragstart={() => { dragging = d.id }} @click={() => { editing = d }}>
                    <b>{d.title}</b>
                    <p>{fmt_money(d.value_cents, cur)}</p>
                    <p.muted.small>{d.company ?? (d.contact_id != null ? full_name(d) : "")}</p>
                </article>}
                <button.ghost @click={() => { editing = { title: "", value_cents: 0, stage_id: s.id, fields: {}, close_date: "" } }}>+ Add deal</button>
            </section>
        }}</div>
        {editing != null && <Drawer title={editing.id == null ? "New deal" : editing.title} on_close={() => { editing = null; problems = [] }}>
            <DealForm deal={editing} {ws} stages={board.stages} on_saved={(saved) => { editing = null; problems = [] }}/>
        </Drawer>}
    </div>
}

component DealForm(deal: map, ws: map, stages: list, on_saved) {
    state d = deal
    state value_text = str((deal.value_cents ?? 0) / 100)
    state touched = deal.id != null
    state server = []
    state people = list_contacts({ q: "", stage: "", tag: "" }) ?? []
    let stage = find(stages, (s) => s.id == d.stage_id) ?? {}
    let ctx = ctx_of(ws, { stage_kind: stage.kind ?? "open" })
    let record = set(d, "value_cents", parse_money(value_text))
    let problems = touched ? validate("deal", record, ctx) + server : server
    let on_field = (path, v) => { d = put(d, path, v); touched = true; server = [] }
    let change = (path) => (v) => { on_field(path, v) }
    <form.stack @submit={() => {
        touched = true
        if len(errors_of(validate("deal", record, ctx))) == 0 {
            let r = save_deal(record)
            if is_err(r) { server = refusal_problems(r) } else { on_saved(r) }
        }
    }}>
        <TextField label="Title" field="title" value={d.title} {problems} on_change={change("title")}/>
        <div.row2>
            <TextField label={`Value (${ws.currency})`} field="value" value={value_text} {problems} on_change={(v) => { value_text = v; touched = true }}/>
            <SelectField label="Stage" field="stage_id" value={d.stage_id} options={stages | map((s) => { value: s.id, label: s.name })} {problems}
                on_change={(v) => { on_field("stage_id", int(v)) }}/>
        </div>
        <SelectField label="Contact" field="contact_id" value={d.contact_id} options={people | map((c) => { value: c.id, label: c.name })} {problems}
            on_change={(v) => { on_field("contact_id", v == "" ? null : int(v)) }} empty="None"/>
        <TextField label="Expected close" field="close_date" value={d.close_date} {problems} on_change={change("close_date")} type="date"/>
        {for f in fields_for("deal", ctx) => <DefinedField key={f.key} {f} record={d} {problems} on_change={on_field}/>}
        <FormProblems problems={server}/>
        <div.form-actions>
            <button.primary>Save deal</button>
            {d.id != null && <button.danger type="button" @click={() => { delete_deal(d.id); on_saved(null) }}>Delete</button>}
        </div>
    </form>
}

// ---- tasks -------------------------------------------------------------------------------------

component TasksPage(ws: map) {
    state show_done = false
    state t = { title: "", due: "" }
    state problems = []
    <div.stack>
        <RecordQueue/>
        <FlowDecisions/>
        <PageHead title="Tasks">
            <label.check-inline><input type="checkbox" checked={show_done} @change={(e) => { show_done = e.checked }}/> Show done</label>
        </PageHead>
        <form.card.inline @submit={() => {
            problems = validate("task", t, ctx_of(ws))
            if len(errors_of(problems)) == 0 {
                let r = save_task(t)
                if is_err(r) { problems = refusal_problems(r) } else { t = { title: "", due: "" }; problems = [] }
            }
        }}>
            <input placeholder="What needs doing?" value={t.title} @input={(e) => { t = set(t, "title", e.value) }}/>
            <input type="date" value={t.due} @input={(e) => { t = set(t, "due", e.value) }}/>
            <button.primary>Add task</button>
        </form>
        <Hints {problems} field="title"/>
        <TaskList key={str(show_done)} {show_done} today={ws.today}/>
    </div>
}

component TaskList(show_done: bool, today: str) {
    state rows = live(list_tasks, show_done)
    if rows == null { return <Loading/> }
    if is_err(rows) { return <Empty title="Could not load tasks"/> }
    len(rows) == 0 ? <Empty title="Nothing to do"><p>Flows and people add tasks here.</p></Empty>
    : <ul.tasks>{for r in rows => <li key={r.id} class={r.done == 1 ? "done" : r.due != "" && r.due < today ? "late" : ""}>
        <input type="checkbox" checked={r.done == 1} @change={() => { toggle_task(r.id) }}/>
        <span.task-title>{r.title}</span>
        {r.contact_id != null && <a href={`/app/contacts/${r.contact_id}`}>{full_name(r)}</a>}
        <span.muted>{r.due != "" ? fmt_day(r.due) : ""}</span>
    </li>}</ul>
}

// ---- products and orders ------------------------------------------------------------------------

component ProductsPage(ws: map) {
    state tab = "products"
    <div>
        <PageHead title="Products" sub="What your shop sells, at /shop.">
            <a.button href="/shop" target="_blank">Open the shop</a>
        </PageHead>
        <nav.tabs>{for t in [["products", "Products"], ["discounts", "Discount codes"], ["shipping", "Shipping"]] =>
            <button type="button" class={tab == t[0] ? "tab on" : "tab"} @click={() => { tab = t[0] }}>{t[1]}</button>}</nav>
        {match tab {
            "discounts" => <DiscountsPanel {ws}/>
            "shipping" => <ShippingPanel {ws}/>
            _ => <ProductList {ws}/>
        }}
    </div>
}

component ProductList(ws: map) {
    state rows = live(list_products)
    state editing = null
    let cur = ws.currency
    <div.stack>
        {ws.user.role != "member" && <div><button.primary @click={() => { editing = { name: "", sku: "", price_cents: 0, kind: "one_time", interval: "", description: "", stock: null, active: true, images: [], category: "", compare_at_cents: null, featured: false, digital: false } }}>New product</button></div>}
        {rows == null ? <Loading/>
        : is_err(rows) || len(rows) == 0 ? <Empty title="No products yet"/>
        : <table.table>
            <thead><tr><th></th><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Sold</th><th></th></tr></thead>
            <tbody>{for p in rows => <tr key={p.id} class={!p.active && "inactive"}>
                <td.thumb-cell>{len(p.images) > 0 ? <Picture v={p.images[0]} alt="" shown={160}/> : <span.thumb-none></span>}</td>
                <td><b>{p.name}</b> <code.muted>{p.sku}</code>{p.kind == "subscription" && <Badge text={`every ${p.interval}`} tone="purple"/>}{p.featured && <Badge text="featured" tone="green"/>}{!p.active && <Badge text="hidden"/>}</td>
                <td.muted>{p.category}</td>
                <td>{fmt_money(p.price_cents, cur)}{p.compare_at_cents != null && <s.muted> {fmt_money(p.compare_at_cents, cur)}</s>}</td>
                <td>{p.stock == null ? "—" : str(p.stock)}</td>
                <td>{p.sold}</td>
                <td>{ws.user.role != "member" && <button.ghost @click={() => { editing = p }}>Edit</button>} <a href={`/shop/${p.sku}`} target="_blank">View ↗</a></td>
            </tr>}</tbody>
        </table>}
        {editing != null && <Drawer title={editing.id == null ? "New product" : editing.name} on_close={() => { editing = null }}>
            <ProductForm product={editing} {ws} on_saved={(saved) => { editing = null }}/>
        </Drawer>}
    </div>
}

component ProductForm(product: map, ws: map, on_saved) {
    state p = product
    state price_text = str((product.price_cents ?? 0) / 100)
    state compare_text = product.compare_at_cents == null ? "" : str(product.compare_at_cents / 100)
    state stock_text = product.stock == null ? "" : str(product.stock)
    state touched = product.id != null
    state server = []
    let ctx = ctx_of(ws)
    let record = set(p, "price_cents", parse_money(price_text))
        | set("stock", stock_text == "" ? null : int(stock_text) ?? -1)
        | set("compare_at_cents", compare_text == "" ? null : parse_money(compare_text))
    let problems = touched ? validate("product", record, ctx) + server : server
    let change = (path) => (v) => { p = put(p, path, v); touched = true; server = [] }
    let images = p.images ?? []
    <form.stack @submit={() => {
        touched = true
        if len(errors_of(validate("product", record, ctx))) == 0 {
            let r = save_product(record)
            if is_err(r) { server = refusal_problems(r) } else { on_saved(r) }
        }
    }}>
        <TextField label="Name" field="name" value={p.name} {problems} on_change={change("name")}/>
        <div.row2>
            <TextField label="SKU" field="sku" value={p.sku} {problems} on_change={change("sku")} help="Its address in the shop"/>
            <TextField label="Category" field="category" value={p.category} {problems} on_change={change("category")} placeholder="t-shirts"/>
        </div>
        <div.row2>
            <TextField label={`Price (${ws.currency})`} field="price" value={price_text} {problems} on_change={(v) => { price_text = v; touched = true }}/>
            <TextField label="Price before (for a sale)" field="compare_at" value={compare_text} {problems} on_change={(v) => { compare_text = v; touched = true }}/>
        </div>
        <div.row2>
            <SelectField label="Kind" field="kind" value={p.kind} options={[{ value: "one_time", label: "One-time" }, { value: "subscription", label: "Subscription" }]} {problems} on_change={change("kind")}/>
            {p.kind == "subscription"
                ? <SelectField label="Renews every" field="interval" value={p.interval} options={["month", "year"]} {problems} on_change={change("interval")} empty="Choose"/>
                : len(p.variants ?? []) > 0 ? <p.muted.small>Stock is counted per variant, below.</p>
                : <TextField label="Stock (empty: not counted)" field="stock" value={stock_text} {problems} on_change={(v) => { stock_text = v; touched = true }} type="number"/>}
        </div>
        <AreaField label="Description (Markdown)" field="description" value={p.description} {problems} on_change={change("description")} rows={5}/>
        <div.field>
            <span.label>Variants (sizes, colours…; empty: none)</span>
            {len(p.variants ?? []) > 0 && <TextField label="What they are" field="variant_label" value={p.variant_label ?? ""} {problems} on_change={change("variant_label")} placeholder="Size"/>}
            {for [i, v] in enumerate(p.variants ?? []) => <div.variant-row key={i}>
                <input value={v.name} placeholder="M" aria-label="Variant" @input={(e) => { change("variants")((p.variants ?? []) | enumerate | map((x) => x[0] == i ? set(x[1], "name", e.value) : x[1])) }}/>
                <input value={v.stock == null ? "" : str(v.stock)} type="number" placeholder="Stock" aria-label="Stock" @input={(e) => { change("variants")((p.variants ?? []) | enumerate | map((x) => x[0] == i ? set(x[1], "stock", e.value == "" ? null : int(e.value) ?? 0) : x[1])) }}/>
                <input value={v.price_cents == null ? "" : str(v.price_cents / 100)} placeholder="Price (empty: the product's)" aria-label="Price" @input={(e) => { change("variants")((p.variants ?? []) | enumerate | map((x) => x[0] == i ? set(x[1], "price_cents", e.value == "" ? null : parse_money(e.value)) : x[1])) }}/>
                <button.icon type="button" title="Remove" @click={() => { change("variants")((p.variants ?? []) | enumerate | filter((x) => x[0] != i) | map((x) => x[1])) }}>✕</button>
            </div>}
            <div><button type="button" @click={() => { change("variants")((p.variants ?? []) + [{ name: "", stock: null, price_cents: null }]) }}>Add a variant</button></div>
            <Hints {problems} field="variants"/>
        </div>
        <div.field>
            <span.label>Pictures (the first is the main one)</span>
            {for [i, im] in enumerate(images) => <div.inline key={`${i}-${im.key}`}>
                <ImagePicker label="" value={im} on_change={(v) => { change("images")(v == null ? images | enumerate | filter((x) => x[0] != i) | map((x) => x[1]) : images | enumerate | map((x) => x[0] == i ? v : x[1])) }}/>
                {i > 0 && <button.icon type="button" title="Make it the main one" @click={() => { change("images")([im] + (images | enumerate | filter((x) => x[0] != i) | map((x) => x[1]))) }}>↑</button>}
            </div>}
            {len(images) < 8 && <ImagePicker key={`add-${len(images)}`} label="" value={null} on_change={(v) => { if v != null { change("images")(images + [v]) } }}/>}
            <Hints {problems} field="images"/>
        </div>
        {p.kind != "subscription" && <CheckField label="Digital (nothing to ship)" field="digital" value={p.digital} {problems} on_change={change("digital")}/>}
        <CheckField label="Featured (first in the shop)" field="featured" value={p.featured} {problems} on_change={change("featured")}/>
        <CheckField label="For sale in the shop" field="active" value={p.active} {problems} on_change={change("active")}/>
        <FormProblems problems={server}/>
        <div.form-actions><button.primary>Save product</button></div>
    </form>
}

component DiscountsPanel(ws: map) {
    state rows = live(list_discounts)
    state editing = null
    let cur = ws.currency
    <div.stack>
        {ws.user.role != "member" && <div><button.primary @click={() => { editing = { code: "", kind: "percent", value: 10, min_cents: 0, max_uses: null, active: true } }}>New code</button></div>}
        {rows == null ? <Loading/>
        : is_err(rows) || len(rows) == 0 ? <Empty title="No discount codes yet"><p>Buyers type a code in their cart.</p></Empty>
        : <table.table>
            <thead><tr><th>Code</th><th>Gives</th><th>Needs</th><th>Used</th><th></th></tr></thead>
            <tbody>{for d in rows => <tr key={d.id} class={!d.active && "inactive"}>
                <td><code>{d.code}</code>{!d.active && <Badge text="off"/>}</td>
                <td>{discount_label(d, cur)}</td>
                <td.muted>{d.min_cents > 0 ? `${fmt_money(d.min_cents, cur)} in the cart` : "—"}</td>
                <td>{d.uses}{d.max_uses != null && ` of ${d.max_uses}`}</td>
                <td>{ws.user.role != "member" && <button.ghost @click={() => { editing = d }}>Edit</button>}</td>
            </tr>}</tbody>
        </table>}
        {editing != null && <Drawer title={editing.id == null ? "New discount code" : editing.code} on_close={() => { editing = null }}>
            <DiscountForm discount={editing} {ws} on_saved={() => { editing = null }}/>
        </Drawer>}
    </div>
}

component DiscountForm(discount: map, ws: map, on_saved) {
    state d = discount
    state value_text = discount.kind == "amount" ? str(discount.value / 100) : str(discount.value)
    state min_text = str((discount.min_cents ?? 0) / 100)
    state max_text = discount.max_uses == null ? "" : str(discount.max_uses)
    state server = []
    let record = merge(d, {
        code: upper(d.code ?? ""),
        value: d.kind == "amount" ? parse_money(value_text) : int(value_text) ?? 0,
        min_cents: parse_money(min_text),
        max_uses: max_text == "" ? null : int(max_text) ?? 0,
    })
    let problems = validate("discount", record, ctx_of(ws)) + server
    let change = (k) => (v) => { d = set(d, k, v); server = [] }
    <form.stack @submit={() => {
        if len(errors_of(problems)) == 0 {
            let r = save_discount(record)
            if is_err(r) { server = refusal_problems(r) } else { on_saved() }
        }
    }}>
        <TextField label="Code" field="code" value={record.code} {problems} on_change={change("code")} placeholder="SPRING20"/>
        <SelectField label="Gives" field="kind" value={d.kind} options={[{ value: "percent", label: "A percentage off" }, { value: "amount", label: "An amount off" }, { value: "shipping", label: "Free shipping" }]} {problems} on_change={change("kind")}/>
        {d.kind != "shipping" && <TextField label={d.kind == "percent" ? "Percent off" : `Amount off (${ws.currency})`} field="value" value={value_text} {problems} on_change={(v) => { value_text = v }}/>}
        <div.row2>
            <TextField label={`Needs in the cart (${ws.currency})`} field="min" value={min_text} {problems} on_change={(v) => { min_text = v }}/>
            <TextField label="Uses (empty: no limit)" field="max_uses" value={max_text} {problems} on_change={(v) => { max_text = v }} type="number"/>
        </div>
        <CheckField label="Buyers can use it" field="active" value={d.active} {problems} on_change={change("active")}/>
        <FormProblems problems={server}/>
        <div.form-actions>
            <button.primary disabled={len(errors_of(problems)) > 0}>Save code</button>
            {d.id != null && <button.danger type="button" @click={() => { delete_discount(d.id); on_saved() }}>Delete</button>}
        </div>
    </form>
}

component ShippingPanel(ws: map) {
    state rate = str((int(ws.settings.shipping_cents) ?? 0) / 100)
    state free = str((int(ws.settings.free_shipping_over_cents) ?? 0) / 100)
    state saved = false
    state server = []
    <section.card.narrow.stack>
        <p.muted>One rate for every order with something to ship; digital products and subscriptions ship free.</p>
        <TextField label={`Shipping (${ws.currency}; 0: free)`} field="shipping" value={rate} problems={server} on_change={(v) => { rate = v; saved = false }}/>
        <TextField label={`Free over (${ws.currency}; 0: never)`} field="free" value={free} problems={server} on_change={(v) => { free = v; saved = false }}/>
        <FormProblems problems={server}/>
        <div.form-actions>
            <button.primary disabled={ws.user.role == "member"} @click={() => {
                let r = save_shipping(parse_money(rate), parse_money(free))
                if is_err(r) { server = refusal_problems(r) } else { saved = true; server = [] }
            }}>Save</button>
            {saved && <span.ok>Saved</span>}
        </div>
    </section>
}

component OrdersPage(ws: map) {
    state status = ""
    <div>
        <PageHead title="Orders">
            <select aria-label="Status" @change={(e) => { status = e.value }}>
                {for s in [["", "All"], ["paid", "Paid"], ["refunded", "Refunded"]] => <option value={s[0]} selected={status == s[0]}>{s[1]}</option>}
            </select>
        </PageHead>
        <OrderTable key={status} {status} {ws}/>
    </div>
}

component OrderTable(status: str, ws: map) {
    state rows = live(list_orders, status)
    if rows == null { return <Loading/> }
    if is_err(rows) || len(rows) == 0 { return <Empty title="No orders yet"><p>Share your shop: <a href="/shop" target="_blank">/shop</a></p></Empty> }
    let cur = ws.currency
    <table.table>
        <thead><tr><th>Order</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th><th>Date</th><th></th></tr></thead>
        <tbody>{for o in rows => <tr key={o.id}>
            <td><b>{o.number}</b></td>
            <td>{o.contact_id != null ? <a href={`/app/contacts/${o.contact_id}`}>{full_name(o)}</a> : "—"}</td>
            <td>{o.items | map((i) => `${i.qty} × ${i.name}`) | join(", ")}</td>
            <td>{fmt_money(o.total_cents, cur)}{o.tax_cents > 0 && <span.muted.small> incl. {fmt_money(o.tax_cents, cur)} tax</span>}</td>
            <td><Badge text={o.status} tone={status_tone(o.status)}/></td>
            <td.muted>{fmt_time(o.created_at)}</td>
            <td>{o.status == "paid" && ws.user.role != "member" && <button.ghost @click={() => {
                if ask("What was bought goes back on the shelf.", { title: `Refund ${o.number}?`, ok: "Refund", tone: "danger" }) { refund_order(o.id); notify(`${o.number} refunded`) }
            }}>Refund</button>}</td>
        </tr>}</tbody>
    </table>
}

// ---- forms, campaigns, outbox -------------------------------------------------------------------

component FormsPage(ws: map) {
    state rows = live(list_forms)
    state editing = null
    <div>
        <PageHead title="Forms" sub="Sign-up forms for your site, newsletter and landing pages.">
            {ws.user.role != "member" && <button.primary @click={() => { editing = { name: "", slug: "", headline: "", fields: ["email"], tags: [] } }}>New form</button>}
        </PageHead>
        {rows == null ? <Loading/>
        : is_err(rows) || len(rows) == 0 ? <Empty title="No forms yet"/>
        : <div.cards>{for f in rows => <section.card key={f.id}>
            <h3>{f.name}</h3>
            <p.muted>{f.headline}</p>
            <p><a href={`/f/${f.slug}`} target="_blank">/f/{f.slug} ↗</a></p>
            <p>{plural(f.submissions, "sign-up")} · gives <Tags tags={f.tags}/></p>
            {ws.user.role != "member" && <button.ghost @click={() => { editing = f }}>Edit</button>}
        </section>}</div>}
        {editing != null && <Drawer title={editing.id == null ? "New form" : editing.name} on_close={() => { editing = null }}>
            <FormEditor form={editing} on_saved={() => { editing = null }}/>
        </Drawer>}
    </div>
}

component FormEditor(form: map, on_saved) {
    state f = form
    state tag_text = join(form.tags ?? [], ", ")
    state problems = []
    let toggle = (field) => { f = set(f, "fields", contains(f.fields, field) ? f.fields | filter((x) => x != field) : f.fields + [field]) }
    <form.stack @submit={() => {
        let r = save_form(set(f, "tags", tag_list(tag_text)))
        if is_err(r) { problems = refusal_problems(r) } else { on_saved() }
    }}>
        <TextField label="Name" field="name" value={f.name} {problems} on_change={(v) => { f = set(f, "name", v) }}/>
        <TextField label="Address (/f/…)" field="slug" value={f.slug} {problems} on_change={(v) => { f = set(f, "slug", v) }} placeholder="from the name"/>
        <TextField label="Headline" field="headline" value={f.headline} {problems} on_change={(v) => { f = set(f, "headline", v) }}/>
        <div.field><span.label>Asks for</span>
            <label.check-inline><input type="checkbox" checked={true} disabled/> Email</label>
            <label.check-inline><input type="checkbox" checked={contains(f.fields, "first_name")} @change={() => { toggle("first_name") }}/> First name</label>
            <label.check-inline><input type="checkbox" checked={contains(f.fields, "last_name")} @change={() => { toggle("last_name") }}/> Last name</label>
        </div>
        <label.field><span.label>Tags for who signs up</span><input value={tag_text} @input={(e) => { tag_text = e.value }} placeholder="newsletter"/></label>
        <FormProblems {problems}/>
        <div.form-actions><button.primary>Save form</button></div>
    </form>
}

component CampaignsPage(ws: map) {
    state rows = live(list_campaigns)
    state editing = null
    <div>
        <PageHead title="Campaigns" sub="Newsletters and announcements to your subscribers.">
            <button.primary @click={() => { editing = { name: "", subject: "", body: "Hi {{first_name}},\n\n", audience: { tag: "" } } }}>New campaign</button>
        </PageHead>
        {rows == null ? <Loading/>
        : is_err(rows) || len(rows) == 0 ? <Empty title="No campaigns yet"/>
        : <table.table>
            <thead><tr><th>Campaign</th><th>Subject</th><th>Audience</th><th>Status</th><th>Sent</th></tr></thead>
            <tbody>{for c in rows => <tr key={c.id} @click={() => { editing = c }} class="clickable">
                <td><b>{c.name}</b></td><td>{c.subject}</td>
                <td>{c.audience.tag == "" ? "All subscribers" : `#${c.audience.tag}`}</td>
                <td><Badge text={c.status} tone={status_tone(c.status)}/></td>
                <td>{c.status == "sent" ? `${plural(c.sent_count, "person", "people")}, ${fmt_date(c.sent_at)}` : ""}</td>
            </tr>}</tbody>
        </table>}
        {editing != null && <Drawer title={editing.id == null ? "New campaign" : editing.name} on_close={() => { editing = null }}>
            <CampaignEditor campaign={editing} {ws} on_done={() => { editing = null }}/>
        </Drawer>}
    </div>
}

component CampaignEditor(campaign: map, ws: map, on_done) {
    state c = campaign
    state server = []
    state preview = null
    state size = audience_size(campaign.audience)
    state tags = all_tags() ?? []
    state sending = false
    let sent = c.status == "sent"
    let ctx = ctx_of(ws)
    let problems = validate("campaign", c, ctx) + server
    let change = (path) => (v) => { c = put(c, path, v); server = [] }
    <div.stack>
        <TextField label="Name (only you see it)" field="name" value={c.name} {problems} on_change={change("name")}/>
        <TextField label="Subject" field="subject" value={c.subject} {problems} on_change={change("subject")}/>
        <AreaField label="Message (Markdown; {{first_name}} fills in)" field="body" value={c.body} {problems} on_change={change("body")} rows={10}/>
        <label.field><span.label>Send to</span>
            <select disabled={sent} @change={(e) => {
                c = put(c, "audience.tag", e.value)
                size = audience_size(c.audience)
            }}>
                <option value="">All subscribers</option>
                {for t in tags => <option value={t.tag} selected={c.audience.tag == t.tag}>Subscribers tagged {t.tag}</option>}
            </select>
            <span.help>{is_err(size) ? "" : plural(size ?? 0, "subscriber")}</span>
        </label>
        <FormProblems problems={server}/>
        {sent ? <p.notice>Sent to {plural(c.sent_count, "person", "people")} on {fmt_time(c.sent_at)}.</p>
        : <div.form-actions>
            <button @click={() => { preview = preview_campaign(c.body) }}>Preview</button>
            <button @click={() => {
                let r = save_campaign(c)
                if is_err(r) { server = refusal_problems(r) } else { c = r }
            }}>Save draft</button>
            {ws.user.role != "member" && <button.primary disabled={sending || len(errors_of(problems)) > 0} @click={() => {
                let saved = save_campaign(c)
                if is_err(saved) { server = refusal_problems(saved) } else {
                    c = saved
                    if ask(`To ${plural(size ?? 0, "subscriber")}.`, { title: `Send “${c.subject}”?`, ok: "Send" }) {
                        sending = true
                        let r = send_campaign(c.id)
                        sending = false
                        if is_err(r) { server = refusal_problems(r) } else { on_done() }
                    }
                }
            }}>Send now</button>}
        </div>}
        {preview != null && !is_err(preview) && <div.mail-preview>{raw(preview)}</div>}
    </div>
}

component OutboxPage(ws: map) {
    state rows = live(list_outbox)
    state open = null
    <div>
        <PageHead title="Outbox" sub={ws.mail_live ? "Mail goes out through your mail webhook." : "Test mode: mail is kept here, not sent. Add a mail webhook in Settings."}/>
        {rows == null ? <Loading/>
        : is_err(rows) || len(rows) == 0 ? <Empty title="No mail yet"/>
        : <table.table>
            <thead><tr><th>To</th><th>Subject</th><th>Kind</th><th>Status</th><th>Queued</th></tr></thead>
            <tbody>{for m in rows => <tr key={m.id} class="clickable" @click={() => { open = get_mail(m.id) }}>
                <td>{m.to_email}</td><td>{m.subject}</td><td>{m.kind}</td>
                <td><Badge text={m.status} tone={status_tone(m.status)}/></td><td.muted>{fmt_ago(m.created_at, now())}</td>
            </tr>}</tbody>
        </table>}
        {open != null && !is_err(open) && <Drawer title={open.subject} on_close={() => { open = null }}>
            <p.muted>To {open.to_email} · {fmt_time(open.created_at)}</p>
            <div.mail-preview>{raw(open.body)}</div>
        </Drawer>}
    </div>
}

// ---- plugins and settings ----------------------------------------------------------------------

component PluginsPage(ws: map, on_change) {
    state enabled = ws.enabled
    state saving = false
    let admin = ws.user.role != "member"
    <div>
        <PageHead title="Plugins" sub="Each brings fields, rules that check your data, and flow steps. Switch on what fits."/>
        <div.plugins>{for p in plugins | filter((p) => p.id != "core") => {
            let on = contains(enabled, p.id)
            let rule_count = values(p.rules ?? {}) | map((rs) => len(rs)) | sum
            <section key={p.id} class={on ? "card plugin on" : "card plugin"}>
                <header>
                    <h3>{p.name}</h3>
                    <label class="switch"><input type="checkbox" checked={on} disabled={!admin || saving} @change={(e) => {
                        // Switching off: say first what it takes away.
                        let uses = on ? plugin_uses(p.id) : null
                        let lost = uses == null || is_err(uses) ? [] :
                            (len(uses.pages) > 0 ? [`its blocks on ${uses.pages | map((t) => `“${t}”`) | join(", ")}`] : [])
                            + (len(uses.flows) > 0 ? [`its steps in ${uses.flows | map((t) => `“${t}”`) | join(", ")} (those runs stop at them)`] : [])
                            + (uses.theme ? ["the site's theme (it goes back to Clean)"] : [])
                        if len(lost) == 0 || ask(`It takes away ${join(lost, "; ")}.`, { title: `Switch ${p.name} off?`, ok: "Switch off", tone: "danger" }) {
                            enabled = on ? enabled | filter((x) => x != p.id) : enabled + [p.id]
                            saving = true
                            set_plugins(enabled)
                            saving = false
                            on_change()
                        } else {
                            js("Reflect.set", e.target, "checked", true)
                        }
                    }}/><span></span></label>
                </header>
                <p>{p.description}</p>
                <p.muted.small>For {p.audience | map((a) => (find(INDUSTRIES, (i) => i.id == a) ?? {}).label ?? a) | join(", ")}
                    {contains(p.audience, ws.industry) && <Badge text="recommended" tone="green"/>}</p>
                <ul.adds>
                    {len(p.fields ?? []) > 0 && <li>Fields: {(p.fields ?? []) | map((f) => f.label) | join(", ")}</li>}
                    {rule_count > 0 && <li>{plural(rule_count, "rule")} for {keys(p.rules) | join(", ")}</li>}
                    {len(p.steps ?? []) > 0 && <li>Flow steps: {(p.steps ?? []) | map((s) => s.label) | join(", ")}</li>}
                    {len(p.blocks ?? []) > 0 && <li>Page blocks: {(p.blocks ?? []) | map((b) => b.label) | join(", ")}</li>}
                    {len(p.themes ?? []) > 0 && <li>Themes: {(p.themes ?? []) | map((t) => t.name) | join(", ")}</li>}
                    {p.model != null && <li>Objects: {(p.model.objects ?? []) | map((o) => o.plural) | join(", ")} (theirs to design further)</li>}
                    {p.model != null && len(p.model.groups ?? []) > 0 && <li>Groups: {p.model.groups | map((g) => g.name) | join(", ")}</li>}
                    {len(p.checkout_fields ?? []) > 0 && <li>Checkout asks for: {p.checkout_fields | join(", ")}</li>}
                    {p.version != null && <li>Version {p.version}, from the plugin studio</li>}
                    {p.taxes != null && <li>Adds tax at checkout</li>}
                </ul>
            </section>
        }}</div>
    </div>
}

component SettingsPage(ws: map, on_change) {
    state tab = "workspace"
    let tabs = [["workspace", "Workspace"], ["profile", "Your profile"], ["fields", "Custom fields"], ["pipelines", "Pipelines"], ["team", "Team"], ["groups", "Groups"], ["roles", "Roles"], ["desks", "Desks"]]
    <div>
        <PageHead title="Settings"/>
        <nav.tabs>{for t in tabs => <button type="button" class={tab == t[0] ? "tab on" : "tab"} @click={() => { tab = t[0] }}>{t[1]}</button>}</nav>
        {match tab {
            "workspace" => <div.stack><WorkspaceSettings {ws} {on_change}/><NoticeSettings {ws}/></div>
            "profile" => <ProfileSettings {ws} {on_change}/>
            "roles" => <RolesSettings {ws} {on_change}/>
            "groups" => <GroupsSettings {ws} {on_change}/>
            "desks" => <DesksSettings {ws}/>
            "fields" => <FieldSettings {ws} {on_change}/>
            "pipelines" => <PipelineSettings {ws} {on_change}/>
            _ => <TeamSettings {ws} {on_change}/>
        }}
    </div>
}

// Your name and a line about you: the blog shows them with your posts.
component ProfileSettings(ws: map, on_change) {
    state name = ws.user.name
    state bio = ws.user.bio ?? ""
    state problems = []
    state saved = false
    <form.card.stack.narrow @submit={() => {
        let r = save_profile(name, bio)
        if is_err(r) { problems = refusal_problems(r) } else { saved = true; on_change() }
    }}>
        <TextField label="Your name" field="name" value={name} {problems} on_change={(v) => { name = v; saved = false }}/>
        <AreaField label="About you (shown with your posts, and on your author page)" field="bio" value={bio} {problems} on_change={(v) => { bio = v; saved = false }} rows={3}/>
        <FormProblems {problems}/>
        <div.form-actions><button.primary>Save</button>{saved && <span.ok>Saved</span>}</div>
    </form>
}

component WorkspaceSettings(ws: map, on_change) {
    state s = merge(ws.settings, { mail_webhook: "" })
    state hook = mail_webhook_of() ?? ""
    state problems = []
    state saved = false
    let change = (k) => (v) => { s = set(s, k, v); saved = false; problems = [] }
    <form.card.stack.narrow @submit={() => {
        let r = save_settings(set(s, "mail_webhook", hook))
        if is_err(r) { problems = refusal_problems(r) } else { saved = true; on_change() }
    }}>
        <TextField label="Workspace name" field="name" value={s.name} {problems} on_change={change("name")}/>
        <div.row2>
            <SelectField label="Currency" field="currency" value={s.currency} options={keys(CURRENCIES)} {problems} on_change={change("currency")}/>
            <TextField label="Country (2 letters)" field="country" value={s.country} {problems} on_change={change("country")}/>
        </div>
        {contains(ws.enabled, "vat") && <TextField label="Tax rate (%)" field="vat_rate" value={str(s.vat_rate ?? "0")} {problems} on_change={change("vat_rate")} type="number"/>}
        <TextField label="Mail webhook (optional)" field="mail_webhook" value={is_err(hook) ? "" : hook} {problems} on_change={(v) => { hook = v; saved = false }}
            placeholder="https://…" help="Mail is POSTed here as { to, subject, html } (an email API). Empty: test mode."/>
        <FormProblems {problems}/>
        <div.form-actions><button.primary>Save</button>{saved && <span.ok>Saved</span>}</div>
    </form>
}

component FieldSettings(ws: map, on_change) {
    state f = { entity: "contact", label: "", type: "text", required: false, options: [] }
    state options_text = ""
    state problems = []
    // Contacts', companies' and deals' own fields; objects' are in their designer.
    let mine = ws.fields | filter((x) => contains(["contact", "company", "deal"], x.entity))
    <div.grid2>
        <section.card>
            <h2>Your fields</h2>
            <p.muted.small>Fields you add to contacts, companies and deals. Your objects' fields are in <a href="/app/objects">Objects</a>, each in its designer.</p>
            {len(mine) == 0 ? <p.muted>None yet. Fields from plugins are in the Plugins page.</p>
            : <table.table.compact><tbody>{for x in mine => <tr key={x.id}>
                <td><b>{x.label}</b> <code>{x.key}</code></td><td>{x.entity}</td><td>{x.type}{x.required && " · required"}</td>
                <td><button.ghost @click={() => { delete_field(x.id); on_change() }}>Remove</button></td>
            </tr>}</tbody></table>}
        </section>
        <form.card.stack @submit={() => {
            let r = save_field(set(f, "options", split(options_text, ",")))
            if is_err(r) { problems = refusal_problems(r) } else {
                f = { entity: f.entity, label: "", type: "text", required: false, options: [] }
                options_text = ""
                problems = []
                on_change()
            }
        }}>
            <h2>Add a field</h2>
            <SelectField label="On" field="entity" value={f.entity} options={[{ value: "contact", label: "Contacts" }, { value: "company", label: "Companies" }, { value: "deal", label: "Deals" }]} {problems} on_change={(v) => { f = set(f, "entity", v) }}/>
            <TextField label="Label" field="label" value={f.label} {problems} on_change={(v) => { f = set(f, "label", v) }}/>
            <SelectField label="Type" field="type" value={f.type} options={["text", "number", "date", "select", "checkbox", "url"]} {problems} on_change={(v) => { f = set(f, "type", v) }}/>
            {f.type == "select" && <TextField label="Choices (comma separated)" field="options" value={options_text} {problems} on_change={(v) => { options_text = v }}/>}
            <CheckField label="Required (a rule then checks it, on every form)" field="required" value={f.required} {problems} on_change={(v) => { f = set(f, "required", v) }}/>
            <FormProblems {problems}/>
            <div.form-actions><button.primary>Add field</button></div>
        </form>
    </div>
}

component PipelineSettings(ws: map, on_change) {
    state name = ""
    state stage = { pipeline_id: (ws.pipelines[0] ?? {}).id, name: "", probability: 50, kind: "open" }
    state problems = []
    <div.stack>
        {for p in ws.pipelines => <section.card key={p.id}>
            <h2>{p.name}</h2>
            <ol.stages>{for s in ws.stages | filter((s) => s.pipeline_id == p.id) => <li key={s.id}>
                <b>{s.name}</b> <span.muted>{s.probability}%</span> <Badge text={s.kind} tone={status_tone(s.kind)}/>
            </li>}</ol>
            <form.inline @submit={() => {
                let r = save_stage(set(stage, "pipeline_id", p.id))
                if is_err(r) { problems = refusal_problems(r) } else { stage = set(stage, "name", ""); on_change() }
            }}>
                <input placeholder="New stage" value={stage.name} @input={(e) => { stage = set(stage, "name", e.value) }}/>
                <select aria-label="Kind" @change={(e) => { stage = set(stage, "kind", e.value) }}>{for k in ["open", "won", "lost"] => <option value={k}>{k}</option>}</select>
                <button>Add stage</button>
            </form>
        </section>}
        <FormProblems {problems}/>
        <form.card.inline @submit={() => {
            let r = add_pipeline(name)
            if !is_err(r) { name = ""; on_change() }
        }}>
            <input placeholder="New pipeline" value={name} @input={(e) => { name = e.value }}/>
            <button.primary>Add pipeline</button>
        </form>
    </div>
}

component TeamSettings(ws: map, on_change) {
    state u = { name: "", email: "", password: "", role: "member" }
    state problems = []
    state added = false
    <div.grid2>
        <section.card>
            <h2>Team</h2>
            <ul.plain>{for x in ws.users => <li key={x.id}><Avatar name={x.name} size="sm"/> <b>{x.name}</b> <span.muted>{x.email}</span> <Badge text={x.role}/>
                {x.role == "member" && ws.user.role != "member" && len(ws.roles ?? []) > 0 && <select.role-pick aria-label={`${x.name}'s role`} @change={(e) => {
                    set_user_role(x.id, e.value == "" ? null : int(e.value))
                    on_change()
                }}>
                    <option value="" selected={x.role_id == null}>Every object (no role)</option>
                    {for r in ws.roles => <option value={str(r.id)} selected={x.role_id == r.id}>{r.name}</option>}
                </select>}
            </li>}</ul>
        </section>
        {ws.user.role != "member" && <form.card.stack @submit={() => {
            let r = add_user(u)
            if is_err(r) { problems = refusal_problems(r) } else { u = { name: "", email: "", password: "", role: "member" }; problems = []; added = true; on_change() }
        }}>
            <h2>Add someone</h2>
            <TextField label="Name" field="name" value={u.name} {problems} on_change={(v) => { u = set(u, "name", v) }}/>
            <TextField label="Email" field="email" value={u.email} {problems} on_change={(v) => { u = set(u, "email", v) }} type="email"/>
            <TextField label="Password (share it with them)" field="password" value={u.password} {problems} on_change={(v) => { u = set(u, "password", v) }} type="password"/>
            <SelectField label="Role" field="role" value={u.role} options={["member", "admin"]} {problems} on_change={(v) => { u = set(u, "role", v) }}/>
            <FormProblems {problems}/>
            <div.form-actions><button.primary>Add to team</button>{added && <span.ok>Added</span>}</div>
        </form>}
    </div>
}
