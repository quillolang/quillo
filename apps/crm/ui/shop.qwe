// The shop visitors see: the catalogue (by category, searched, sorted), a
// page per product with its pictures, the cart, and the checkout. All of it
// is in the workspace's theme (SiteLayout).

let SORTS = [["featured", "Featured"], ["new", "Newest"], ["price", "Price: low to high"], ["-price", "Price: high to low"]]

fn shop_page(category: str, q: str, theme = null, sort: str = "featured") {
    let s = settings()
    let cur = s.currency ?? "USD"
    let cat = slugify(category)
    let words = lower(trim(q))
    let all = shop_products()
        | filter((p) => cat == "" || p.category == cat)
        | filter((p) => words == "" || contains(lower(p.name), words) || contains(lower(p.description), words))
    let shown = match sort {
        "price" => sort_by(all, (p) => p.price_cents)
        "-price" => reverse(sort_by(all, (p) => p.price_cents))
        "new" => reverse(sort_by(all, (p) => p.id))
        _ => all
    }
    let cats = shop_categories()
    let link = (c) => c == "" ? "/shop" : `/shop?category=${c}`
    <SiteLayout title={cat == "" ? "Shop" : title_case(cat)} description={`What ${s.name ?? "we"} sell${cat == "" ? "" : `: ${cat}`}.`} {theme}>
        <section.shop-head>
            <h1>{cat == "" ? "Shop" : title_case(cat)}</h1>
            <form.shop-tools method="get" action="/shop">
                {cat != "" && <input type="hidden" name="category" value={cat}/>}
                <input type="search" name="q" value={q} placeholder="Search the shop" aria-label="Search the shop"/>
                <select name="sort" aria-label="Sort" onchange="this.form.submit()">{for o in SORTS => <option value={o[0]} selected={o[0] == sort}>{o[1]}</option>}</select>
            </form>
        </section>
        {len(cats) > 0 && <nav.shop-cats>
            <a href="/shop" class={cat == "" ? "on" : ""}>All</a>
            {for c in cats => <a href={link(c.category)} class={cat == c.category ? "on" : ""}>{title_case(c.category)} <span>{c.n}</span></a>}
        </nav>}
        {len(shown) == 0
            ? <p.shop-none>{words != "" ? `Nothing matches “${q}”.` : "Nothing for sale here yet."}</p>
            : <div.shop-grid>{for p in shown => <ShopCard {p} currency={cur}/>}</div>}
    </SiteLayout>
}

fn title_case(slug: str) = split(slug, "-") | map((w) => upper(slice(w, 0, 1)) + slice(w, 1)) | join(" ")

view Price(p: map, currency: str) =
    <span.shop-price>
        {price_from(p) != p.price_cents || any(p.variants ?? [], (v) => v.price_cents != null && v.price_cents != p.price_cents) ? "From " : ""}{fmt_money(price_from(p), currency)}{p.kind == "subscription" && <span> / {p.interval}</span>}
        {p.compare_at_cents != null && <s>{fmt_money(p.compare_at_cents, currency)}</s>}
    </span>

view ShopCard(p: map, currency: str) =
    <a.shop-card href={`/shop/${p.sku}`}>
        <div.shop-card-img>
            {len(p.images) > 0 ? <Picture v={p.images[0]} alt={p.name} shown={400}/> : <span.shop-noimg>{slice(p.name, 0, 1)}</span>}
            {sold_out(p) ? <span.shop-flag>Sold out</span> : p.compare_at_cents != null ? <span.shop-flag.sale>Sale</span> : null}
        </div>
        <h3>{p.name}</h3>
        <Price {p} {currency}/>
    </a>

fn product_page(p: map, choose: bool = false) {
    let s = settings()
    let cur = s.currency ?? "USD"
    let related = shop_products() | filter((x) => x.id != p.id && p.category != "" && x.category == p.category) | take(4)
    let image = len(p.images) > 0 ? media_src(p.images[0], crop_text(p.images[0]), 1280) : ""
    <SiteLayout title={p.name} description={slice(p.description, 0, 160)} {image} kind="product">
        <article.product>
            <Gallery images={p.images} name={p.name}/>
            <div.product-info>
                {p.category != "" && <a.product-cat href={`/shop?category=${p.category}`}>{title_case(p.category)}</a>}
                <h1>{p.name}</h1>
                <p.product-price><Price {p} currency={cur}/></p>
                <div.product-desc>{markdown(p.description)}</div>
                {sold_out(p)
                    ? <p.product-out>Sold out</p>
                    : <form method="post" action="/cart/add" class="product-buy">
                        <input type="hidden" name="sku" value={p.sku}/>
                        {len(p.variants) > 0 && <fieldset.product-variants>
                            <legend>{p.variant_label != "" ? p.variant_label : "Choose"}</legend>
                            {for v in p.variants => <label class={v.stock == 0 ? "variant out" : "variant"}>
                                <input type="radio" name="variant" value={v.name} disabled={v.stock == 0} required/>
                                <span>{v.name}{v.price_cents != null && v.price_cents != p.price_cents && ` · ${fmt_money(v.price_cents, cur)}`}{v.stock == 0 && " · sold out"}</span>
                            </label>}
                            {choose && <p.bad>Choose a {lower(p.variant_label != "" ? p.variant_label : "variant")} first.</p>}
                        </fieldset>}
                        {p.kind != "subscription" && <label>Quantity <input type="number" name="qty" value="1" min="1" max={str(p.stock ?? 99)}/></label>}
                        <button.pb-button name="then" value="cart">Add to cart</button>
                        <button.product-now name="then" value="checkout">Buy now</button>
                    </form>}
                {len(p.variants) == 0 && p.stock != null && p.stock > 0 && p.stock <= 5 && <p.product-low>Only {p.stock} left</p>}
                {!p.digital && p.kind != "subscription" && <p.muted.small>{shipping_note(s, cur)}</p>}
            </div>
        </article>
        {len(related) > 0 && <section.shop-related>
            <h2>You may also like</h2>
            <div.shop-grid>{for r in related => <ShopCard p={r} currency={cur}/>}</div>
        </section>}
    </SiteLayout>
}

fn shipping_note(s: map, cur: str) {
    let rate = int(s.shipping_cents) ?? 0
    let free = int(s.free_shipping_over_cents) ?? 0
    rate == 0 ? "Free shipping" : free > 0 ? `Shipping ${fmt_money(rate, cur)}, free over ${fmt_money(free, cur)}` : `Shipping ${fmt_money(rate, cur)}`
}

// The pictures of a product: one large, the others to choose from.
component Gallery(images: list, name: str) {
    state at = 0
    if len(images) == 0 { return <div.gallery><div.gallery-main.shop-noimg>{slice(name, 0, 1)}</div></div> }
    <div.gallery>
        <div.gallery-main><Picture v={images[min([at, len(images) - 1])]} alt={name} shown={640}/></div>
        {len(images) > 1 && <div.gallery-thumbs>{for [i, im] in enumerate(images) =>
            <button type="button" class={i == at ? "on" : ""} aria-label={`Picture ${i + 1}`} @click={() => { at = i }}><Picture v={im} alt="" shown={160}/></button>}</div>}
    </div>
}

fn cart_page() {
    let s = settings()
    let cur = s.currency ?? "USD"
    let lines = cart_lines(cart())
    let code = session().discount ?? ""
    let d = usable_discount(code)
    let discount = is_err(d) ? null : d
    let q = quote_lines({}, lines, discount, checkout_ctx(lines, discount))
    <SiteLayout title="Cart" description="">
        <section.cart>
            <h1>Your cart</h1>
            {len(lines) == 0
                ? <div.cart-empty><p>Your cart is empty.</p><p><a.pb-button href="/shop">Go shopping</a></p></div>
                : <div.cart-grid>
                    <div.cart-lines>{for l in lines => <div.cart-line>
                        <a href={`/shop/${l.product.sku}`} class="cart-img">{len(l.product.images) > 0 ? <Picture v={l.product.images[0]} alt="" shown={160}/> : <span.shop-noimg>{slice(l.product.name, 0, 1)}</span>}</a>
                        <div.cart-name><a href={`/shop/${l.product.sku}`}><b>{l.product.name}</b></a><span.muted>{fmt_money(l.product.price_cents, cur)}{l.product.kind == "subscription" && ` / ${l.product.interval}`}</span>
                            {l.product.stock != null && l.qty > l.product.stock && <span.bad>{l.product.stock == 0 ? "Sold out" : `Only ${l.product.stock} left`}</span>}</div>
                        <form method="post" action="/cart/update" class="cart-qty">
                            <input type="hidden" name="sku" value={l.product.key}/>
                            {l.product.kind == "subscription" ? <span>1</span> : <input type="number" name="qty" value={str(l.qty)} min="0" max="99" aria-label="Quantity" onchange="this.form.submit()"/>}
                            <button.link name="qty" value="0" aria-label={`Remove ${l.product.name}`}>Remove</button>
                        </form>
                        <b.cart-total>{fmt_money(l.product.price_cents * clamp_qty(l.qty), cur)}</b>
                    </div>}</div>
                    <aside.cart-sum>
                        <form method="post" action="/cart/discount" class="cart-code">
                            <input name="code" value={code} placeholder="Discount code" aria-label="Discount code"/>
                            <button>Apply</button>
                        </form>
                        {is_err(d) && code != "" && <p.bad>{d.error}</p>}
                        {discount != null && !q.discount_ok && <p.bad>{`${discount.code} needs ${fmt_money(discount.min_cents, cur)} in the cart`}</p>}
                        <div.lines>
                            <p><span>Subtotal</span><span>{fmt_money(q.subtotal_cents, cur)}</span></p>
                            {q.discount_cents > 0 && <p><span>{discount.code} ({discount_label(discount, cur)})</span><span>−{fmt_money(q.discount_cents, cur)}</span></p>}
                            {q.ships && <p><span>Shipping</span><span>{q.shipping_cents == 0 ? "Free" : fmt_money(q.shipping_cents, cur)}</span></p>}
                            <p.total><span>Total</span><span>{fmt_money(q.total_cents, cur)}</span></p>
                        </div>
                        <p.muted.small>Taxes, if any, are added at checkout.</p>
                        <a.pb-button.wide href="/checkout">Checkout</a>
                    </aside>
                </div>}
        </section>
    </SiteLayout>
}

view CheckoutPage() =
    <SiteLayout title="Checkout" description="">
        <div.checkout-wrap><Checkout/></div>
    </SiteLayout>

// The checkout: the rules (the core's, and those of the plugins the shop
// has on, such as tax) hint as you type and show the total the server will
// charge.
component Checkout() {
    state c = checkout_context()
    state o = { name: "", email: "", address: "", card: "", expiry: "", cvc: "", country: "", vat_id: "" }
    state touched = []
    state server = []
    state paid = null
    state busy = false
    if c == null { return <Loading/> }
    if is_err(c) { return <div.site-narrow><h1>The checkout did not load</h1></div> }
    if paid == null && len(c.lines) == 0 { return <div.site-narrow><h1>Your cart is empty</h1><p><a href="/shop">Go shopping</a></p></div> }
    let ctx = c.ctx
    let order = merge(o, { items: c.lines | map((l) => { sku: l.product.sku, name: l.product.name, qty: l.qty }) })
    let all = validate("checkout", order, ctx) + server
    let shown = all | filter((p) => contains(touched, p.field) || p.field == "qty" || p.field == "items")
    let q = quote_lines(order, c.lines, c.discount, ctx)
    let cur = c.currency
    let change = (field) => (v) => {
        o = set(o, field, v)
        touched = unique(touched + [field])
        server = []
    }
    paid != null
        ? <div.paid>
            <p.big-check>✓</p>
            <h1>Thank you!</h1>
            <p>Order <b>{paid.number}</b> for {paid.total} is paid. A receipt is on its way to {paid.email}.</p>
            <p><a href="/shop">Back to {c.shop}</a></p>
        </div>
        : <form.checkout @submit={() => {
            touched = ["name", "email", "address", "card", "expiry", "cvc", "country", "vat_id"]
            if len(errors_of(validate("checkout", order, ctx))) == 0 {
                busy = true
                let r = checkout(o)
                busy = false
                if is_err(r) { server = refusal_problems(r) } else { paid = r }
            }
        }}>
            <div.summary>
                <p.muted>{c.shop}</p>
                <h2>Your order</h2>
                <div.lines>
                    {for l in q.lines => <p><span>{l.qty} × {l.name}</span><span>{fmt_money(l.total_cents, cur)}</span></p>}
                    {q.discount_cents > 0 && <p><span>Discount ({c.discount.code})</span><span>−{fmt_money(q.discount_cents, cur)}</span></p>}
                    {q.ships && <p><span>Shipping</span><span>{q.shipping_cents == 0 ? "Free" : fmt_money(q.shipping_cents, cur)}</span></p>}
                    {q.tax_cents > 0 && <p><span>Tax</span><span>{fmt_money(q.tax_cents, cur)}</span></p>}
                    <p.total><span>Total</span><span>{fmt_money(q.total_cents, cur)}</span></p>
                </div>
                <p><a href="/cart">Change the cart</a></p>
                <Hints problems={shown} field="qty"/>
            </div>
            <div.pay>
                <TextField label="Name" field="name" value={o.name} problems={shown} on_change={change("name")}/>
                <TextField label="Email" field="email" value={o.email} problems={shown} on_change={change("email")} type="email"/>
                {q.ships && <AreaField label="Shipping address" field="address" value={o.address} problems={shown} on_change={change("address")} rows={3}/>}
                {contains(c.extra, "country") && <TextField label="Country (2 letters)" field="country" value={o.country} problems={shown} on_change={change("country")} placeholder="US"/>}
                {contains(c.extra, "vat_id") && <TextField label="VAT number (businesses)" field="vat_id" value={o.vat_id} problems={shown} on_change={change("vat_id")}/>}
                <TextField label="Card number" field="card" value={o.card} problems={shown} on_change={change("card")} placeholder="4242 4242 4242 4242"/>
                <div.row2>
                    <TextField label="Expiry" field="expiry" value={o.expiry} problems={shown} on_change={change("expiry")} placeholder="MM/YY"/>
                    <TextField label="CVC" field="cvc" value={o.cvc} problems={shown} on_change={change("cvc")} placeholder="123"/>
                </div>
                <FormProblems problems={server}/>
                <button.primary.wide disabled={busy}>{busy ? "Paying…" : `Pay ${fmt_money(q.total_cents, cur)}`}</button>
                <p.muted.small>Test mode: 4242 4242 4242 4242 pays; 4000 0000 0000 0002 is declined.</p>
            </div>
        </form>
}
