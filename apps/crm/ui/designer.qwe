// Flows: the list, and the designer, where a flow is drawn. Steps come from
// the core and the plugins switched on; the flow rules point at what is
// missing as you draw, and the server checks them again before a flow can
// be switched on.

component FlowsPage(ws: map) {
    state rows = live(list_flows)
    let templates = [
        ["purchase", "After a purchase", "Thank buyers, tag them, follow up big orders, ask for a review."],
        ["welcome", "Welcome, then offer", "Greet new subscribers, offer a product, wait for the purchase."],
        ["membership", "New member", "A subscription bought: grant membership, welcome, remind before renewal."],
        ["winback", "Win back", "When a contact is tagged lapsed, reach out, and wait for a purchase."],
        ["blank", "Start from scratch", "A trigger, and whatever you add."],
    ]
    <div>
        <PageHead title="Flows" sub="What happens on its own: after a sign-up, a purchase, a tag, a won deal."/>
        <div.templates>{for t in templates => <button.template @click={() => {
            let id = new_flow(t[0])
            if !is_err(id) { navigate(`/app/flows/${id}`) }
        }}><b>{t[1]}</b><span>{t[2]}</span></button>}</div>
        {rows == null ? <Loading/>
        : is_err(rows) || len(rows) == 0 ? <Empty title="No flows yet"><p>Start from a template above.</p></Empty>
        : <table.table>
            <thead><tr><th>Flow</th><th>Starts when</th><th>Steps</th><th>Runs</th><th>Status</th></tr></thead>
            <tbody>{for f in rows => {
                let trigger = find(f.graph.nodes ?? [], (n) => n.type == "trigger") ?? { config: {} }
                <tr key={f.id} class="clickable" @click={() => { navigate(`/app/flows/${f.id}`) }}>
                    <td><b>{f.name}</b></td>
                    <td>{trigger_label(trigger.config)}</td>
                    <td>{len(f.graph.nodes ?? []) - 1}</td>
                    <td>{f.runs}{f.active_runs > 0 && <span.muted> ({f.active_runs} in progress)</span>}</td>
                    <td><Badge text={f.active ? "on" : "off"} tone={f.active ? "green" : "gray"}/></td>
                </tr>
            }}</tbody>
        </table>}
    </div>
}

fn trigger_label(c: map) {
    let base = (find(TRIGGERS, (t) => t.event == c.event) ?? { label: "Not set" }).label
    match c.event {
        "form_submitted" => blank(c.form) ? base : `${base}: ${c.form}`
        "order_paid" => blank(c.product) ? base : `${base}: ${c.product}`
        "tag_added" => blank(c.tag) ? base : `${base}: #${c.tag}`
        "record_created" => blank(c.object) ? base : `${base}: ${c.object}`
        "record_updated" => blank(c.object) ? base : `${base}: ${c.object}`
        _ => base
    }
}

// ---- geometry -----------------------------------------------------------------------

let NODE_W = 200
let NODE_H = 64

// Where a node's output port is: one on the right, or yes above no.
fn port_at(n: map, port: str, ports: list) {
    let i = index_of(ports, port) ?? 0
    let k = len(ports)
    { x: n.x + NODE_W, y: n.y + (k <= 1 ? NODE_H / 2 : 18 + i * (NODE_H - 36)) }
}

fn input_at(n: map) = { x: n.x, y: n.y + NODE_H / 2 }

fn curve(a: map, b: map) {
    let bend = max([40, abs(b.x - a.x) / 2])
    `M ${a.x} ${a.y} C ${a.x + bend} ${a.y}, ${b.x - bend} ${b.y}, ${b.x} ${b.y}`
}

fn snap(v) = round(v / 10) * 10

// One line about what a step does, for its box.
fn step_summary(n: map) {
    let c = n.config ?? {}
    match n.type {
        "trigger" => trigger_label(c)
        "send_email" | "send_offer" => blank(c.subject) ? "No subject yet" : `“${c.subject}”`
        "wait" => blank(c.amount) ? "How long?" : `${c.amount} ${c.unit ?? "days"}`
        "wait_purchase" => `${blank(c.product) ? "any product" : c.product}, up to ${c.days ?? "?"} days`
        "condition" => blank(c.field) ? "Set a condition" : `${c.field} ${c.op ?? "equals"} ${c.value ?? ""}`
        "add_tag" | "remove_tag" => blank(c.tag) ? "Which tag?" : `#${c.tag}`
        "set_stage" => c.stage ?? "Which stage?"
        "create_task" | "create_deal" => c.title ?? ""
        "webhook" => c.url ?? ""
        "loyalty.award" => blank(c.points) ? "1 per unit spent" : `${c.points} points`
        _ => ""
    }
}

let GROUP_COLOR = { Start: "#0f766e", Message: "#2563eb", Sell: "#c2410c", Timing: "#7c3aed", Logic: "#b45309", Contact: "#0e7490", Team: "#4d7c0f", Connect: "#475569" }

// ---- the designer -----------------------------------------------------------------------

component FlowDesigner(id: int, ws: map) {
    state f = live(get_flow, id)
    state graph = null
    state name = null
    state active = null
    state selected = null
    state edge_on = null
    state drag = null
    state linking = null
    state mouse = { x: 0, y: 0 }
    state server = []
    state saved = ""
    state contacts = list_contacts({ q: "", stage: "", tag: "" }) ?? []
    state run_for = ""
    state zoom = 1
    if f == null { return <Loading/> }
    if is_err(f) { return <Empty title="No such flow"><p><a href="/app/flows">All flows</a></p></Empty> }
    let g = graph ?? f.graph
    let the_name = name ?? f.name
    let is_on = active ?? f.active
    let types = step_types(ws.enabled)
    let type_of_node = (n) => find(types, (t) => t.type == n.type) ?? { label: n.type, group: "Connect", outputs: ["out"], fields: [] }
    let problems = validate("flow", g, ctx_of(ws)) + server
    let errors = errors_of(problems)
    let node_problems = (nid) => problems | filter((p) => p.field == `node.${nid}`)
    let sel = selected == null ? null : flow_node(g, selected)
    let link_from = linking == null ? null : flow_node(g, linking.from)
    let edit = (next) => { graph = next; saved = ""; server = [] }
    let next_id = () => {
        let ids = (g.nodes ?? []) | map((n) => int(slice(n.id, 1)) ?? 0)
        `n${max(ids + [0]) + 1}`
    }
    // A new step goes after the selected one, joined to its first free
    // port; with none selected, below the others.
    let add_step = (t) => {
        let nid = next_id()
        let after = sel
        let ports = after == null ? [] : type_of_node(after).outputs ?? ["out"]
        let free = ports | filter((port) => !any(g.edges ?? [], (e) => e.from == after.id && e.port == port))
        let lowest = max((g.nodes ?? []) | map((n) => n.y)) ?? 0
        let spot = after == null || len(free) == 0
            ? { x: 40, y: lowest + 110 }
            : { x: after.x + 300, y: after.y + (len(ports) > 1 ? (index_of(ports, free[0]) == 0 ? -60 : 60) : 0) }
        let nodes = (g.nodes ?? []) + [{ id: nid, type: t.type, x: max([0, spot.x]), y: max([0, spot.y]), config: {} }]
        let edges = after == null || len(free) == 0 ? g.edges ?? [] : (g.edges ?? []) + [{ from: after.id, to: nid, port: free[0] }]
        edit(set(g, "nodes", nodes) | set("edges", edges))
        selected = nid
        edge_on = null
    }
    let connect = (from, port, to) => {
        let kept = (g.edges ?? []) | filter((e) => !(e.from == from && e.port == port))
        if from != to && (flow_node(g, to) ?? {}).type != "trigger" {
            edit(set(g, "edges", kept + [{ from, to, port }]))
        }
        linking = null
    }
    let save = (on) => {
        let r = save_flow({ id, name: the_name, graph: g, active: on })
        if is_err(r) {
            server = refusal_problems(r)
        } else {
            graph = r.graph
            active = r.active
            saved = on ? "Saved and switched on" : "Saved"
        }
    }
    <div.designer>
        <header.designer-bar>
            <a href="/app/flows">← Flows</a>
            <input.flow-name value={the_name} @input={(e) => { name = e.value; saved = "" }}/>
            <Badge text={is_on ? "on" : "off"} tone={is_on ? "green" : "gray"}/>
            <span.grow></span>
            {saved != "" && <span.ok>{saved}</span>}
            {len(errors) > 0 && <span.bad>{plural(len(errors), "problem")}</span>}
            <button @click={() => { save(is_on) }}>Save</button>
            {is_on
                ? <button @click={() => { save(false) }}>Switch off</button>
                : <button.primary disabled={len(errors) > 0} title={len(errors) > 0 ? "Fix the problems first" : ""} @click={() => { save(true) }}>Switch on</button>}
        </header>
        <div.designer-body>
            <aside.palette>
                <p.muted.small>Select a step on the canvas, then click one here to add it after. Join steps by clicking a dot on a step's right, then the next step.</p>
                {for group in unique(types | filter((t) => t.type != "trigger") | map((t) => t.group)) => <div.palette-group>
                    <p.palette-title>{group}</p>
                    {for t in types | filter((t) => t.group == group && t.type != "trigger") =>
                        <button.palette-item style={`border-left-color:${GROUP_COLOR[t.group] ?? "#475569"}`} @click={() => { add_step(t) }}>{t.label}</button>}
                </div>}
            </aside>
            <div.canvas-wrap @mount={(el) => {
                // Zoomed out enough to see the whole flow at first.
                let right = max((g.nodes ?? []) | map((n) => n.x + NODE_W + 40)) ?? 800
                let bottom = max((g.nodes ?? []) | map((n) => n.y + NODE_H + 40)) ?? 400
                zoom = max([0.6, min([1, el.clientWidth / right, el.clientHeight / bottom])])
            }}>
                <div.zoom>
                    <button.icon title="Zoom out" @click={() => { zoom = max([0.3, zoom - 0.1]) }}>−</button>
                    <span>{round(zoom * 100)}%</span>
                    <button.icon title="Zoom in" @click={() => { zoom = min([1.5, zoom + 0.1]) }}>+</button>
                </div>
                <svg.canvas width={1800 * zoom} height={900 * zoom} viewBox="0 0 1800 900"
                    @mousemove={(e) => {
                        let x = e.offsetX / zoom
                        let y = e.offsetY / zoom
                        mouse = { x, y }
                        if drag != null {
                            edit(set(g, "nodes", (g.nodes ?? []) | map((n) => n.id == drag.id ? set(n, "x", max([0, snap(x - drag.dx)])) | set("y", max([0, snap(y - drag.dy)])) : n)))
                        }
                    }}
                    @mouseup={() => { drag = null }}
                    @mouseleave={() => { drag = null }}
                    @click={(e) => {
                        if e.target.tagName == "svg" { selected = null; edge_on = null; linking = null }
                    }}>
                    <defs><pattern id="dots" width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="#d6dae1"/></pattern></defs>
                    <rect width="1800" height="900" fill="url(#dots)" pointer-events="none"/>
                    {for [i, e] in enumerate(g.edges ?? []) => {
                        let a = flow_node(g, e.from)
                        let b = flow_node(g, e.to)
                        if a == null || b == null { null } else {
                            let from = port_at(a, e.port, type_of_node(a).outputs ?? ["out"])
                            let to = input_at(b)
                            <g class={edge_on == i ? "edge on" : "edge"} @click={() => { edge_on = i; selected = null }}>
                                <path d={curve(from, to)} class="edge-hit"/>
                                <path d={curve(from, to)} class="edge-line"/>
                                {e.port != "out" && <text x={from.x + 12} y={from.y - 6} class="edge-label">{e.port}</text>}
                            </g>
                        }
                    }}
                    {link_from != null && <path d={curve(port_at(link_from, linking.port, type_of_node(link_from).outputs ?? ["out"]), mouse)} class="edge-line linking"/>}
                    {for n in g.nodes ?? [] => {
                        let t = type_of_node(n)
                        let bad = len(errors_of(node_problems(n.id))) > 0
                        let color = GROUP_COLOR[t.group] ?? "#475569"
                        <g key={n.id} class={selected == n.id ? "node on" : bad ? "node bad" : "node"} data-node={n.id}>
                            <rect x={n.x} y={n.y} width={NODE_W} height={NODE_H} rx="10" class="node-box"
                                @mousedown={(e) => {
                                    drag = { id: n.id, dx: e.offsetX / zoom - n.x, dy: e.offsetY / zoom - n.y }
                                    selected = n.id
                                    edge_on = null
                                }}
                                @click={() => { if linking != null { connect(linking.from, linking.port, n.id) } }}/>
                            <rect x={n.x} y={n.y} width="6" height={NODE_H} rx="3" fill={color} pointer-events="none"/>
                            <text x={n.x + 18} y={n.y + 26} class="node-title" pointer-events="none">{t.label}</text>
                            <text x={n.x + 18} y={n.y + 46} class="node-sub" pointer-events="none">{slice(step_summary(n), 0, 28)}</text>
                            {bad && <circle cx={n.x + NODE_W - 14} cy={n.y + 14} r="6" class="node-alert" pointer-events="none"/>}
                            {n.type != "trigger" && <circle cx={n.x} cy={n.y + NODE_H / 2} r="7" class={linking != null ? "port in ready" : "port in"}
                                @click={() => { if linking != null { connect(linking.from, linking.port, n.id) } }}/>}
                            {for port in t.outputs ?? ["out"] => {
                                let p = port_at(n, port, t.outputs ?? ["out"])
                                <circle cx={p.x} cy={p.y} r="7" class={`port out ${port}`} data-port={`${n.id}:${port}`}
                                    @mousedown={(e) => { e.stopPropagation() }}
                                    @click={() => { linking = { from: n.id, port }; mouse = p }}/>
                            }}
                        </g>
                    }}
                </svg>
            </div>
            <aside.inspector>
                {edge_on != null && <section>
                    <h3>Connection</h3>
                    <button.danger @click={() => {
                        edit(set(g, "edges", (g.edges ?? []) | enumerate | filter((p) => p[0] != edge_on) | map((p) => p[1])))
                        edge_on = null
                    }}>Remove connection</button>
                </section>}
                {sel != null && <StepEditor node={sel} type={type_of_node(sel)} {ws} problems={node_problems(sel.id)}
                    on_change={(config) => { edit(set(g, "nodes", (g.nodes ?? []) | map((n) => n.id == sel.id ? set(n, "config", config) : n))) }}
                    on_remove={() => {
                        edit(set(g, "nodes", (g.nodes ?? []) | filter((n) => n.id != sel.id))
                            | set("edges", (g.edges ?? []) | filter((e) => e.from != sel.id && e.to != sel.id)))
                        selected = null
                    }}/>}
                {sel == null && edge_on == null && <section>
                    <h3>Checks</h3>
                    {len(problems) == 0 ? <p.ok>Ready to switch on.</p>
                    : <ul.problems>{for p in problems => <li class={p.level == "warning" ? "warn" : ""}
                        @click={() => { if starts_with(p.field, "node.") { selected = slice(p.field, 5) } }}>{p.message}</li>}</ul>}
                    <h3>Try it</h3>
                    <div.inline>
                        <select aria-label="Contact to run it for" @change={(e) => { run_for = e.value }}>
                            <option value="">Run for a contact…</option>
                            {for c in contacts => <option value={str(c.id)}>{c.name}</option>}
                        </select>
                        <button disabled={run_for == ""} @click={() => {
                            let r = start_flow(id, int(run_for))
                            saved = is_err(r) ? r.error : "Started"
                        }}>Run</button>
                    </div>
                    <h3>Recent runs</h3>
                    {len(f.runs) == 0 ? <p.muted>None yet.</p>
                    : <ul.runs>{for r in f.runs => <li key={r.id}>
                        <p><b>{full_name(r)}</b> <Badge text={r.status} tone={status_tone(r.status)}/></p>
                        <ol>{for l in r.log => <li><span.muted>{(flow_node(g, l.node) ?? { type: "?" }).type}:</span> {l.text}</li>}</ol>
                    </li>}</ul>}
                </section>}
            </aside>
        </div>
    </div>
}

// The selected step's settings, from its type's fields.
view StepEditor(node: map, type: map, ws: map, problems: list, on_change, on_remove) {
    let c = node.config ?? {}
    let put_key = (k) => (v) => { on_change(set(c, k, v)) }
    <section>
        <h3>{type.label}</h3>
        <Hints {problems} field={`node.${node.id}`}/>
        {node.type == "trigger"
            ? <div.stack>
                <SelectField label="Starts when" field="event" value={c.event} options={TRIGGERS | map((t) => { value: t.event, label: t.label })} problems={[]} on_change={put_key("event")} empty="Choose"/>
                {c.event == "form_submitted" && <SelectField label="Form" field="form" value={c.form} options={ws.forms | map((x) => { value: x.slug, label: x.name })} problems={[]} on_change={put_key("form")} empty="Any form"/>}
                {c.event == "order_paid" && <SelectField label="Product" field="product" value={c.product} options={ws.skus | map((x) => { value: x.sku, label: x.name })} problems={[]} on_change={put_key("product")} empty="Any product"/>}
                {c.event == "tag_added" && <TextField label="Tag" field="tag" value={c.tag} problems={[]} on_change={put_key("tag")}/>}
                {(c.event == "record_created" || c.event == "record_updated" || c.event == "record_moved") && <PickOne label="Object" field="object" value={c.object} options={(ws.objects ?? []) | map((o) => { value: o.key, label: o.plural })} problems={[]} on_change={put_key("object")} empty="Any object"/>}
                {c.event == "record_moved" && <SelectField label="To state" field="to" value={c.to} options={((find(ws.objects ?? [], (o) => o.key == c.object) ?? {}).states ?? []) | map((st) => { value: st.key, label: st.label })} problems={[]} on_change={put_key("to")} empty="Any state"/>}
            </div>
            : <div.stack>{for fd in type.fields ?? [] => match fd.type {
                "textarea" => <AreaField label={fd.label} field={fd.key} value={c[fd.key]} problems={[]} on_change={put_key(fd.key)} rows={6}/>
                "select" => <SelectField label={fd.label} field={fd.key} value={c[fd.key]} options={fd.options ?? []} problems={[]} on_change={put_key(fd.key)} empty="Choose"/>
                "product" => <SelectField label={fd.label} field={fd.key} value={c[fd.key]} options={ws.skus | map((x) => { value: x.sku, label: x.name })} problems={[]} on_change={put_key(fd.key)} empty="Any / choose"/>
                "number" => <TextField label={fd.label} field={fd.key} value={c[fd.key]} problems={[]} on_change={put_key(fd.key)} type="number"/>
                "group" => <SelectField label={fd.label} field={fd.key} value={c[fd.key]} options={(ws.groups ?? []) | map((g) => { value: str(g.id), label: g.name })} problems={[]} on_change={put_key(fd.key)} empty="Choose a group"/>
                "role" => <SelectField label={fd.label} field={fd.key} value={c[fd.key]} options={(ws.roles ?? []) | map((r) => { value: str(r.id), label: r.name })} problems={[]} on_change={put_key(fd.key)} empty="Choose a role"/>
                _ => <TextField label={fd.label} field={fd.key} value={c[fd.key]} problems={[]} on_change={put_key(fd.key)}/>
            }}</div>}
        {node.type != "trigger" && <button.danger @click={() => { on_remove() }}>Remove step</button>}
    </section>
}
