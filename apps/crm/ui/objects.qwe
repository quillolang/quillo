// Custom objects in the app: the designer (fields, rules, and a form to try
// them on), and each object's records — a list, and a page per record with
// what links to it.

let TYPE_LABELS = {
    text: "Text", textarea: "Long text", number: "Number", money: "Amount", date: "Date", select: "Choice", checkbox: "Yes / no",
    url: "Web address", email: "Email", contact: "Contact", company: "Company", record: "Another object's record",
    markdown: "Formatted text (Markdown)", image: "Picture", person: "Someone on the team",
    lookup: "A field of a linked record",
}

// Many objects: searched, sorted, grouped in folders (folded as you like),
// as cards or a table; the pinned ones first, and in everyone's sidebar.
component ObjectsPage(ws: map, on_change) {
    state rows = list_objects()
    state templates = null
    state o = { name: "", plural: "", icon: "◆", table: "" }
    // The table's name follows the plural until it is typed.
    state table_typed = false
    state problems = []
    state making = false
    state q = ""
    state layout = ""
    state sort = "name"
    state folded = []
    let admin = ws.designer == true
    let open = (key) => { on_change(); navigate(`/app/objects/${key}`) }
    let table = table_typed ? o.table : table_name(blank(o.plural) ? (blank(o.name) ? "" : `${o.name}s`) : o.plural)
    let reload = () => { rows = list_objects() }
    let place = (key, m) => { set_object_place(key, m); reload() }
    if rows == null { return <Loading/> }
    if is_err(rows) { return <Empty title="Objects did not load"/> }
    let words = lower(trim(q))
    let found = rows | filter((x) => words == "" || contains(lower(`${x.plural} ${x.name} ${x.folder} ${x.description}`), words))
    let sorted = match sort {
        "records" => found | sort_by((x) => -x.count)
        "changed" => found | sort_by((x) => -(x.changed_at ?? 0))
        "opened" => found | sort_by((x) => -(x.opened_at ?? 0))
        _ => found | sort_by((x) => lower(x.plural))
    }
    let shown = layout != "" ? layout : len(rows) > 12 ? "table" : "cards"
    let folders = unique(rows | map((x) => x.folder) | filter((f) => f != "")) | sort_by(lower)
    let grouped = len(folders) > 0
    let groups = (words == "" && any(sorted, (x) => x.pinned) ? [{ id: "★", name: "Pinned", items: sorted | filter((x) => x.pinned) }] : [])
        + (grouped ? (folders + [""]) | map((f) => { id: f, name: f == "" ? "No folder" : f, items: sorted | filter((x) => x.folder == f) }) | filter((g) => len(g.items) > 0)
           : [{ id: "", name: "", items: sorted }])
    let star = (x) => admin ? <button type="button" class={x.pinned ? "pin on" : "pin"} aria-pressed={x.pinned} title={x.pinned ? "Unpin from the sidebar" : "Pin to the sidebar"}
        @click={() => { place(x.key, { pinned: !x.pinned }) }}>{x.pinned ? "★" : "☆"}</button> : null
    let folder_cell = (x) => admin
        ? <input.folder-input list="object-folders" aria-label={`${x.plural}: folder`} placeholder="No folder" value={x.folder} @change={(e) => { place(x.key, { folder: e.value }) }}/>
        : <span.muted>{x.folder}</span>
    <div.stack>
        <PageHead title="Objects" sub="Kinds of records of your own — vehicles, events, tickets — with their fields, links to contacts and companies, and rules that check them as you type and again when they are saved.">
            {admin && <button.primary @click={() => { making = true; problems = []; if templates == null { templates = object_templates() } }}>New object</button>}
        </PageHead>
        {len(rows) == 0 ? <Empty title="No objects yet"><p>{admin ? "Make the first: New object, or start from a template." : "Your workspace has none yet."}</p></Empty>
        : <div.stack>
            <div.toolbar>
                <input type="search" aria-label="Find an object" placeholder={`Find one of ${len(rows)} objects`} value={q} @input={(e) => { q = e.value }}/>
                <select aria-label="Sort" @change={(e) => { sort = e.value }}>
                    {for x in [["name", "By name"], ["records", "Most records"], ["changed", "Changed lately"], ["opened", "Opened lately"]] => <option value={x[0]} selected={sort == x[0]}>{x[1]}</option>}
                </select>
                <div.seg role="group" aria-label="View">
                    <button type="button" class={shown == "cards" ? "on" : ""} aria-pressed={shown == "cards"} @click={() => { layout = "cards" }}>Cards</button>
                    <button type="button" class={shown == "table" ? "on" : ""} aria-pressed={shown == "table"} @click={() => { layout = "table" }}>Table</button>
                </div>
            </div>
            <datalist id="object-folders">{for f in folders => <option value={f}></option>}</datalist>
            {len(found) == 0 && <p.muted>No object matches “{q}”.</p>}
            {for g in groups => <section.obj-group key={g.id}>
                {g.name != "" && <button type="button" class="group-head" aria-expanded={!contains(folded, g.id)}
                    @click={() => { folded = contains(folded, g.id) ? folded | filter((x) => x != g.id) : folded + [g.id] }}>
                    <span.chev aria-hidden="true">{contains(folded, g.id) ? "▸" : "▾"}</span>{g.name}<span.group-count>{len(g.items)}</span>
                </button>}
                {!contains(folded, g.id) && (shown == "table"
                    ? <div.table-scroll><table.table.objects-table>
                        <thead><tr>{admin && <th.pin-col><span.sr>Pinned</span></th>}<th>Object</th><th>Folder</th><th.num>Records</th><th.num>Fields</th><th>Last change</th><th></th></tr></thead>
                        <tbody>{for x in g.items => <tr key={x.key}>
                            {admin && <td.pin-col>{star(x)}</td>}
                            <td><a.obj-name href={`/app/o/${x.key}`}><span.object-icon.small>{x.icon}</span><span><b>{x.plural}</b><span.muted.small>{x.description}</span></span></a></td>
                            <td>{folder_cell(x)}</td>
                            <td.num>{x.count}</td>
                            <td.num>{x.fields}</td>
                            <td.muted>{x.changed_at == null ? "—" : fmt_ago(x.changed_at, now())}</td>
                            <td.actions>{admin && <a.button.ghost.small href={`/app/objects/${x.key}`}>Design</a>}</td>
                        </tr>}</tbody>
                    </table></div>
                    : <div.object-grid>{for x in g.items => <section.card.object-card key={x.key}>
                        <header><span.object-icon>{x.icon}</span><div.grow><h3><a href={`/app/o/${x.key}`}>{x.plural}</a></h3><p.muted.small>{plural(x.fields, "field")} · {plural(x.rules, "rule")} · {plural(x.count, "record")}</p></div>{star(x)}</header>
                        {x.description != "" && <p.muted>{x.description}</p>}
                        <div.inline>
                            <a.button href={`/app/o/${x.key}`}>Open</a>
                            {admin && <a.button.ghost href={`/app/objects/${x.key}`}>Design</a>}
                            {x.folder != "" && <span.folder-chip>{x.folder}</span>}
                        </div>
                    </section>}</div>)}
            </section>}
        </div>}
        {making && <Drawer title="New object" on_close={() => { making = false }}>
            <div.stack>
                <form.stack @submit={() => {
                    let r = save_object(set(o, "table", table))
                    if is_err(r) { problems = refusal_problems(r) } else { making = false; open(r) }
                }}>
                    <div.row2>
                        <TextField label="One of them" field="name" value={o.name} {problems} on_change={(v) => { o = set(o, "name", v) }} placeholder="Vehicle" autofocus={true}/>
                        <TextField label="Many" field="plural" value={o.plural} {problems} on_change={(v) => { o = set(o, "plural", v) }} placeholder="Vehicles"/>
                    </div>
                    <div.row2>
                        <TextField label="Icon (a character)" field="icon" value={o.icon} {problems} on_change={(v) => { o = set(o, "icon", v) }}/>
                        <TextField label="Its table" field="table" value={table} {problems} placeholder="o_vehicles"
                            help="Letters, digits and _, after o_; a column per field (f_…)" on_change={(v) => { o = set(o, "table", v); table_typed = true }}/>
                    </div>
                    <FormProblems {problems}/>
                    <div.form-actions><button.primary>Create and design it</button></div>
                </form>
                <h3>Or start from a template</h3>
                {templates == null || is_err(templates) ? <Loading/> : <div.templates.two>{for t in templates => <button.template key={t.name} @click={() => {
                    let r = create_from_template(t.name)
                    if is_err(r) { problems = refusal_problems(r) } else { making = false; open(r) }
                }}><b>{t.icon} {t.name}</b><span>{t.description}</span><span.muted.small>{join(t.fields, ", ")}</span></button>}</div>}
            </div>
        </Drawer>}
    </div>
}

// ---- the designer ------------------------------------------------------------------------

component ObjectDesigner(okey: str, ws: map, on_change) {
    let key = okey
    state o = get_object(key)
    state f = { label: "", type: "text", required: false, options: [] }
    state options_text = ""
    state target = ""
    state via = ""
    state via_field = ""
    state rule = { if: { field: "", op: "is", value: "" }, then: { field: "", op: "is filled", value: "" }, message: "", warning: false }
    state problems = []
    state saved = ""
    state sample = { fields: {} }
    state scripting = null
    state sample_scripts = []
    state typed_at = null
    state renaming = null
    if o == null { return <Loading/> }
    if is_err(o) { return <Empty title="No such object"><p><a href="/app/objects">Objects</a></p></Empty> }
    let reload = () => { o = get_object(key); on_change() }
    let save = (next) => {
        let r = save_object(next)
        if is_err(r) { problems = refusal_problems(r) } else { problems = []; saved = "Saved"; reload() }
    }
    let label_of = (k) => (find(o.fields, (x) => x.key == k) ?? { label: k }).label
    let field_options = o.fields | map((x) => { value: x.key, label: x.label })
    let no_value = (op) => contains(["is filled", "is empty"], op)
    // The rules as they are now, on the sample record: the designer's own try.
    let ctx = ctx_of(ws, { objects: (ws.objects ?? []) | map((x) => x.key == key ? merge(x, { rules: o.rules }) : x), fields: ws.fields + o.fields })
    <div.stack>
        <PageHead title={`${o.icon} ${o.plural}`} sub="Its fields, the rules its records follow, and a form to try them on.">
            <a.button href={`/app/o/${key}`}>Open {lower(o.plural)}</a>
            <button.danger @click={() => {
                if ask("Every record and field goes with it.", { title: `Delete ${o.plural}?`, ok: "Delete", tone: "danger" }) { delete_object(key); notify(`${o.plural} deleted`); on_change(); navigate("/app/objects") }
            }}>Delete object</button>
        </PageHead>
        <div.object-designer>
            <div.stack>
                <section.card.stack>
                    <h2>The object</h2>
                    <div.row2>
                        <TextField label="One of them" field="name" value={o.name} {problems} on_change={(v) => { o = set(o, "name", v); saved = "" }}/>
                        <TextField label="Many" field="plural" value={o.plural} {problems} on_change={(v) => { o = set(o, "plural", v); saved = "" }}/>
                    </div>
                    <div.row2>
                        <TextField label="Icon" field="icon" value={o.icon} {problems} on_change={(v) => { o = set(o, "icon", v); saved = "" }}/>
                        <SelectField label="Each record is named by" field="title_field" value={o.title_field} options={o.fields | filter((x) => contains(["text", "email", "date", "select", "number"], x.type)) | map((x) => { value: x.key, label: x.label })} {problems} on_change={(v) => { o = set(o, "title_field", v); saved = "" }} empty="The first text field"/>
                    </div>
                    <AreaField label="What it is for" field="description" value={o.description} {problems} on_change={(v) => { o = set(o, "description", v); saved = "" }} rows={2}/>
                    <div.row2>
                        <label.field>
                            <span.label>Folder</span>
                            <input list="designer-folders" name="folder" value={o.folder ?? ""} placeholder="No folder"
                                @change={(e) => { set_object_place(key, { folder: e.value }); o = set(o, "folder", e.value); on_change() }}/>
                            <datalist id="designer-folders">{for f in unique((ws.objects ?? []) | map((x) => x.folder ?? "") | filter((f) => f != "")) => <option value={f}></option>}</datalist>
                            <span.help>Where the Objects page groups it</span>
                        </label>
                        <label.field.check>
                            <span.switch><input type="checkbox" checked={o.pinned == 1} @change={(e) => { set_object_place(key, { pinned: e.checked }); o = set(o, "pinned", e.checked ? 1 : 0) }}/><span></span></span>
                            Pinned to the sidebar, for everyone
                        </label>
                    </div>
                    <div.form-actions><button.primary @click={() => { save(o) }}>Save</button>{saved != "" && <span.ok>{saved}</span>}</div>
                    <div.table-name>
                        <span.label>Its table</span>
                        {renaming == null ? <div.inline>
                            <code>{o.table}</code>
                            <button.ghost.small type="button" @click={() => { js("navigator.clipboard.writeText", o.table); notify(`${o.table} copied`) }}>Copy</button>
                            <button.ghost.small type="button" @click={() => { renaming = o.table }}>Rename</button>
                        </div>
                        : <form.inline @submit={() => {
                            if ask("Its records and links stay. SQL of your own that names the table (reports, scripts) needs the new name.", { title: `Rename ${o.table} to ${table_name(renaming)}?`, ok: "Rename" }) {
                                let r = rename_object_table(key, renaming)
                                if is_err(r) { problems = refusal_problems(r) } else { problems = []; renaming = null; notify(`The table is ${r} now`); reload() }
                            }
                        }}>
                            <input name="table" value={renaming} @input={(e) => { renaming = e.value }} class={invalid(problems, "table") && "invalid"}/>
                            <button.primary.small>Rename</button>
                            <button.ghost.small type="button" @click={() => { renaming = null; problems = [] }}>Cancel</button>
                        </form>}
                        <span.help>A column per field: {o.fields | take(3) | map((x) => `f_${x.key}`) | join(", ")}{len(o.fields) > 3 ? ", …" : ""}</span>
                        <Hints {problems} field="table"/>
                    </div>
                </section>
                <section.card.stack>
                    <h2>Fields</h2>
                    {len(o.fields) == 0 ? <p.muted>No fields yet: add the first below.</p>
                    : <table.table.compact><tbody>{for [i, x] in enumerate(o.fields) => <tr key={x.id}>
                        <td><b>{x.label}</b>{x.required && <span.bad> *</span>} <code>{x.key}</code>{x.is_unique == 1 && <Badge text="unique" tone="purple"/>}</td>
                        <td>{TYPE_LABELS[x.type] ?? x.type}{x.type == "select" && <span.muted> ({join(x.options, ", ")})</span>}{x.type == "record" && <span.muted> → {(find(ws.objects ?? [], (y) => y.key == x.options[0]) ?? { plural: x.options[0] }).plural}</span>}{x.type == "lookup" && <span.muted> ({(find(o.fields, (y) => y.key == x.options[0]) ?? { label: x.options[0] }).label} → {x.options[1]})</span>}</td>
                        <td.nowrap>
                            <button.icon title="Up" disabled={i == 0} @click={() => { move_field(x.id, -1); reload() }}>↑</button>
                            <button.icon title="Down" disabled={i == len(o.fields) - 1} @click={() => { move_field(x.id, 1); reload() }}>↓</button>
                            <button.ghost class={!blank(x.script) ? "has-script" : ""} @click={() => { scripting = scripting == x.id ? null : x.id }}>{blank(x.script) ? "Script" : "Script ✓"}</button>
                            <button.ghost @click={() => {
                                if ask("Records keep nothing of it.", { title: `Remove ${x.label}?`, ok: "Remove", tone: "danger" }) { delete_field(x.id); reload() }
                            }}>Remove</button>
                        </td>
                    </tr>}</tbody></table>}
                    {scripting != null && {
                        let x = find(o.fields, (y) => y.id == scripting)
                        x == null ? null : <div.stack>
                            <b>Rule script for {x.label}</b>
                            <FieldScript key={x.id} {okey} f={x} {sample} on_saved={() => { reload() }}/>
                        </div>
                    }}
                    <form.field-add @submit={() => {
                        let opts = f.type == "record" ? [target] : f.type == "lookup" ? [via, via_field] : split(options_text, ",")
                        let r = save_field(merge(f, { entity: `obj.${key}`, options: opts }))
                        if is_err(r) { problems = refusal_problems(r) } else {
                            f = { label: "", type: f.type, required: false, options: [] }
                            options_text = ""
                            problems = []
                            reload()
                        }
                    }}>
                        <TextField label="New field" field="label" value={f.label} {problems} on_change={(v) => { f = set(f, "label", v) }} placeholder="Licence plate"/>
                        <SelectField label="Type" field="type" value={f.type} options={FIELD_TYPES | map((t) => { value: t, label: TYPE_LABELS[t] })} {problems} on_change={(v) => { f = set(f, "type", v) }}/>
                        {f.type == "select" && <TextField label="Choices (comma separated)" field="options" value={options_text} {problems} on_change={(v) => { options_text = v }}/>}
                        {f.type == "record" && <PickOne label="Of which object" field="options" value={target} options={(ws.objects ?? []) | map((y) => { value: y.key, label: y.plural })} {problems} on_change={(v) => { target = v }}/>}
                        {f.type == "lookup" && {
                            let links = o.fields | filter((x) => contains(LINK_TYPES, x.type))
                            let chosen = find(links, (x) => x.key == via)
                            <div.stack>
                                {len(links) == 0 && <p.muted.small>Add a link field first (a contact, a company, or another object's record).</p>}
                                <SelectField label="Through the link" field="options" value={via} options={links | map((x) => { value: x.key, label: x.label })} {problems} on_change={(v) => { via = v; via_field = "" }} empty="Choose"/>
                                {chosen != null && <SelectField label="Its field" field="via_field" value={via_field} options={lookup_targets(chosen, ws.fields | map((x) => merge(x, { options: type_of(x.options) == "str" ? parsed(x.options, []) : x.options })))
                                    | map((t) => { value: t[0], label: t[1] })} {problems} on_change={(v) => { via_field = v }} empty="Choose"/>}
                            </div>
                        }}
                        <CheckField label="Required" field="required" value={f.required} {problems} on_change={(v) => { f = set(f, "required", v) }}/>
                        {!contains(["checkbox", "lookup", "textarea"], f.type) && <CheckField label="Unique (no two records share it)" field="is_unique" value={f.is_unique == true} {problems} on_change={(v) => { f = set(f, "is_unique", v) }}/>}
                        <div.form-actions><button.primary>Add field</button></div>
                    </form>
                </section>
                <StatesEditor {o} {ws} on_save={(next) => { save(next) }} {problems}/>
                <ObjectSiteEditor key={`site-${o.id}`} {o} on_save={(next) => { save(next) }} {problems}/>
                <section.card.stack>
                    <h2>Rules</h2>
                    <p.muted.small>Checked in the browser as people type, and again on the server when a record is saved. A value that starts with @ is another field's: “Ends after @starts”.</p>
                    {len(o.rules) == 0 ? <p.muted>No rules yet.</p>
                    : <ul.rule-list>{for [i, r] in enumerate(o.rules) => <li key={i}>
                        <div.rule-say>
                            <b>{rule_text(r, label_of)}</b>
                            <span.muted>“{r.message}”</span>
                        </div>
                        {r.warning && <Badge text="warning" tone="amber"/>}
                        <button.ghost @click={() => { save(set(o, "rules", o.rules | enumerate | filter((x) => x[0] != i) | map((x) => x[1]))) }}>Remove</button>
                    </li>}</ul>}
                    {len(o.fields) > 0 && <div.rule-builder>
                        <h3>New rule</h3>
                        <div.rule-row>
                            <span.rule-word>If</span>
                            <div.rule-controls>
                                <select aria-label="If field" @change={(e) => { rule = set(rule, "if", set(rule.if, "field", e.value)) }}>
                                    <option value="" selected={rule.if.field == ""}>Always</option>
                                    {for x in field_options => <option value={x.value} selected={rule.if.field == x.value}>{x.label}</option>}
                                </select>
                                {rule.if.field != "" && <select aria-label="If test" @change={(e) => { rule = set(rule, "if", set(rule.if, "op", e.value)) }}>{for op in RULE_OPS => <option value={op} selected={rule.if.op == op}>{op}</option>}</select>}
                                {rule.if.field != "" && !no_value(rule.if.op) && <input aria-label="If value" value={rule.if.value} placeholder="a value, or @field" @input={(e) => { rule = set(rule, "if", set(rule.if, "value", e.value)) }}/>}
                            </div>
                        </div>
                        <div.rule-row>
                            <span.rule-word>Then</span>
                            <div.rule-controls>
                                <select aria-label="Then field" @change={(e) => { rule = set(rule, "then", set(rule.then, "field", e.value)) }}>
                                    <option value="" selected={rule.then.field == ""}>Choose a field</option>
                                    {for x in field_options => <option value={x.value} selected={rule.then.field == x.value}>{x.label}</option>}
                                </select>
                                <select aria-label="Then test" @change={(e) => { rule = set(rule, "then", set(rule.then, "op", e.value)) }}>{for op in RULE_OPS => <option value={op} selected={rule.then.op == op}>{op}</option>}</select>
                                {!no_value(rule.then.op) && <input aria-label="Then value" value={rule.then.value} placeholder="a value, or @field" @input={(e) => { rule = set(rule, "then", set(rule.then, "value", e.value)) }}/>}
                            </div>
                        </div>
                        <div.rule-row>
                            <span.rule-word>Else say</span>
                            <div.rule-controls>
                                <input aria-label="Message" value={rule.message} placeholder="It ends after it starts" @input={(e) => { rule = set(rule, "message", e.value) }}/>
                                <label.rule-warn>
                                    <span.switch><input type="checkbox" checked={rule.warning} @change={() => { rule = set(rule, "warning", !rule.warning) }}/><span></span></span>
                                    Only warn
                                </label>
                            </div>
                        </div>
                        <Hints {problems} field="rules"/>
                        <div.rule-foot>
                            <button.primary disabled={rule.then.field == "" || blank(rule.message)} @click={() => {
                                let r = merge(rule, { if: rule.if.field == "" ? null : rule.if })
                                save(set(o, "rules", o.rules + [r]))
                                rule = { if: { field: "", op: "is", value: "" }, then: { field: "", op: "is filled", value: "" }, message: "", warning: false }
                            }}>Add rule</button>
                            <span.muted.small>{rule.then.field == "" ? "Choose the field it checks, and what to say."
                                : `${rule_text(merge(rule, { if: rule.if.field == "" ? null : rule.if }), label_of)}${blank(rule.message) ? " — and what to say?" : ""}`}</span>
                        </div>
                    </div>}
                </section>
            </div>
            <section.card.stack.object-try>
                <h2>Try it</h2>
                <p.muted.small>A record to try the fields and rules on; nothing is saved.</p>
                {len(o.fields) == 0 ? <p.muted>Add a field first.</p> : {
                    if typed_at != null {
                        every(250, () => {
                            if now() - typed_at > 500 {
                                typed_at = null
                                let r = check_record_scripts(key, sample)
                                sample_scripts = is_err(r) ? [] : r
                            }
                        })
                    }
                    let found = validate(`obj.${key}`, sample, ctx) + sample_scripts
                    <div.stack>
                        {for x in o.fields => <ObjField f={x} record={sample} problems={found} choices={null} on_change={(path, v) => { sample = put(sample, path, v); typed_at = now() }}/>}
                        {len(found) == 0 ? <p.ok>It passes every rule.</p> : <p.muted.small>{plural(len(errors_of(found)), "problem")}, {plural(len(found) - len(errors_of(found)), "warning")}</p>}
                    </div>
                }}
            </section>
        </div>
    </div>
}

// ---- records ---------------------------------------------------------------------------

// One of an object's fields, in a form: links choose from `choices`
// (link_choices), or, with none, take an id.
view ObjField(f: map, record: map, problems: list, on_change, choices) {
    let path = `fields.${f.key}`
    let v = pick(record, path)
    let set_to = (x) => { on_change(path, x) }
    let label = f.required == true ? `${f.label} *` : f.label
    let pick_from = (opts, empty) => <SelectField {label} field={path} value={v == null ? "" : str(v)} options={opts} {problems} on_change={set_to} {empty}/>
    match f.type {
        "lookup" => <div.field>
            <span.label>{f.label}</span>
            <p.lookup-value>{v == null || v == "" ? "—" : str(v)} <span.muted.small>from the link, kept up to date</span></p>
        </div>
        "textarea" => <AreaField {label} field={path} value={v} {problems} on_change={set_to} rows={4}/>
        "markdown" => <MarkdownField {label} field={path} value={v} {problems} on_change={set_to}/>
        "image" => <div.field><ImagePicker {label} value={v} on_change={set_to}/><Hints {problems} field={path}/></div>
        "person" => choices == null ? <TextField label={`${label} (their id)`} field={path} value={v} {problems} on_change={set_to}/> : pick_from(choices.person ?? [], "Choose someone")
        "money" => <TextField {label} field={path} value={v} {problems} on_change={set_to} type="number"/>
        "email" => <TextField {label} field={path} value={v} {problems} on_change={set_to} type="email"/>
        "contact" => choices == null ? <TextField label={`${label} (a contact's id)`} field={path} value={v} {problems} on_change={set_to}/> : pick_from(choices.contact, "Choose a contact")
        "company" => choices == null ? <TextField label={`${label} (a company's id)`} field={path} value={v} {problems} on_change={set_to}/> : pick_from(choices.company, "Choose a company")
        "record" => choices == null ? <TextField label={`${label} (a record's id)`} field={path} value={v} {problems} on_change={set_to}/> : pick_from(choices.records[(f.options ?? [])[0] ?? ""] ?? [], "Choose")
        _ => <DefinedField {f} {record} {problems} on_change={on_change}/>
    }
}

// A record's value as text, for lists (links by name).
fn shown_value(f: map, r: map) {
    let v = r.fields[f.key]
    v == null ? "" : contains(LINK_TYPES, f.type) ? (r.names ?? {})[f.key] ?? str(v)
        : f.type == "image" ? "a picture"
        : f.type == "markdown" ? (len(str(v)) > 80 ? `${slice(str(v), 0, 80)}…` : str(v))
        : f.type == "checkbox" ? (v == true ? "Yes" : "No")
        : str(v)
}

// Numbers line up on the right; text is cut short in a cell.
fn cell_class(f: map) = contains(["number", "money"], f.type) ? "num" : "cut"

// How much of a form's row a field takes: long text and pictures all of it.
fn field_span(f: map) = contains(["textarea", "markdown", "image"], f.type) ? "wide" : f.type == "checkbox" ? "low" : ""

let FIELD_GLYPHS = { text: "Aa", textarea: "¶", markdown: "M", number: "#", money: "¤", date: "◷", select: "▾", checkbox: "✓",
    url: "↗", email: "@", image: "▣", contact: "☺", person: "☺", company: "▦", record: "◆", lookup: "⤷" }

// The list's columns, for everyone, in a menu by its button: a switch per
// field, the shown ones first; Escape or a click outside closes it.
component ColumnsMenu(o: map, shown: list, on_set) {
    state open = false
    state q = ""
    let found = (f) => q == "" || contains(lower(f.label), lower(q))
    let on = o.fields | filter((f) => contains(shown, f.key) && found(f))
    let off = o.fields | filter((f) => !contains(shown, f.key) && found(f))
    let row = (f, is_on) => <label.col-row key={f.key}>
        <span.col-glyph aria-hidden="true">{FIELD_GLYPHS[f.type] ?? "·"}</span>
        <span.col-label>{f.label}</span>
        <span.switch><input type="checkbox" checked={is_on} @change={(e) => { on_set(e.checked ? shown + [f.key] : shown | filter((x) => x != f.key)) }}/><span></span></span>
    </label>
    <div.col-menu @keydown={(e) => { if e.key == "Escape" { open = false } }}>
        <button type="button" class={open ? "col-button on" : "col-button"} aria-expanded={open} aria-haspopup="dialog" @click={() => { open = !open }}>
            <span.col-icon aria-hidden="true"></span>Columns<span.col-count>{len(shown)}/{len(o.fields)}</span>
        </button>
        {open && <div.col-backdrop @click={() => { open = false }}></div>}
        {open && <div.col-pop role="dialog" aria-label="Columns">
            <input.col-find type="search" aria-label="Find a field" placeholder="Find a field" value={q} @input={(e) => { q = e.value }}/>
            <div.col-head><span>Shown in the list</span><button type="button" @click={() => { on_set([]) }}>Default</button></div>
            {len(on) == 0 ? <p.col-none>None</p> : <div>{for f in on => row(f, true)}</div>}
            <div.col-head><span>Hidden</span>{len(off) > 0 && <button type="button" @click={() => { on_set(shown + (off | map((f) => f.key))) }}>Show all</button>}</div>
            {len(off) == 0 ? <p.col-none>None</p> : <div>{for f in off => row(f, false)}</div>}
        </div>}
    </div>
}

component RecordsPage(okey: str, ws: map) {
    let key = okey
    state o = get_object(key)
    state q = ""
    state rows = list_records(key, "")
    state editing = null
    state state = ""
    if o == null { return <Loading/> }
    if is_err(o) { return <Empty title="No such object"><p><a href="/app/objects">Objects</a></p></Empty> }
    // The columns its designer chose; else the first short fields: not pictures,
    // long text, or the site's caption and summary.
    let chosen = o.list_fields ?? []
    let cols = len(chosen) > 0 ? o.fields | filter((f) => contains(chosen, f.key))
        : o.fields | filter((f) => f.key != o.title_field && !contains(["textarea", "markdown", "image"], f.type)
            && f.key != (o.site ?? {}).caption && f.key != (o.site ?? {}).summary) | take(8)
    let shown_keys = cols | map((f) => f.key)
    let choose = (keys) => {
        let next = set_list_fields(key, keys)
        if !is_err(next) { o = set(o, "list_fields", next) }
    }
    let has_states = len(o.states) > 0
    let shown_rows = rows == null || is_err(rows) ? rows : rows | filter((r) => state == "" || r.state == state)
    <div.stack>
        <PageHead title={`${o.icon} ${o.plural}`} sub={o.description}>
            <a.button href={`/app/export/objects/${key}`} data-reload>Export CSV</a>
            {ws.designer && <a.button.ghost href={`/app/objects/${key}`}>Design</a>}
            {o.can != "read" && <button.primary @click={() => { editing = { fields: {} } }}>New {lower(o.name)}</button>}
        </PageHead>
        <div.filters>
            <input type="search" aria-label={`Search ${lower(o.plural)}`} placeholder={`Search ${lower(o.plural)}`} value={q} @input={(e) => { q = e.value; rows = list_records(key, e.value) }}/>
            {has_states && <select aria-label="State" @change={(e) => { state = e.value }}>
                <option value="">Every state</option>
                {for st in o.states => <option value={st.key} selected={state == st.key}>{st.label}</option>}
            </select>}
            {ws.designer && <ColumnsMenu {o} shown={shown_keys} on_set={choose}/>}
        </div>
        {shown_rows == null ? <Loading/>
        : is_err(shown_rows) || len(shown_rows) == 0 ? <Empty title={`No ${lower(o.plural)} here`}><p>{state == "" ? "Add the first one." : "None in this state."}</p></Empty>
        : <div.table-scroll><table.table.records>
            <thead><tr><th>{o.name}</th>{has_states && <th>State</th>}{for f in cols => <th class={cell_class(f)}>{f.label}</th>}<th>Updated</th></tr></thead>
            <tbody>{for r in shown_rows => <tr key={r.id} class="clickable" @click={() => { navigate(`/app/o/${key}/${r.id}`) }}>
                <td><b>{r.title}</b></td>
                {has_states && <td><StateBadge {o} state={r.state}/></td>}
                {for f in cols => <td class={cell_class(f)} title={shown_value(f, r)}>{shown_value(f, r)}</td>}
                <td.muted>{fmt_ago(r.updated_at, now())}</td>
            </tr>}</tbody>
        </table></div>}
        {editing != null && <Drawer title={`New ${lower(o.name)}`} on_close={() => { editing = null }}>
            <RecordForm {o} record={editing} {ws} on_saved={(r) => { editing = null; navigate(`/app/o/${key}/${r.id}`) }}/>
        </Drawer>}
    </div>
}

// A record's form: the object's fields; its rules (and plugins' rules for
// it) hint as you type, and the server checks again.
component RecordForm(o: map, record: map, ws: map, on_saved) {
    state r = record
    state touched = record.id != null
    state server = []
    state choices = link_choices(o.key)
    state scripted = []
    state typed_at = null
    let ctx = ctx_of(ws, { fields: ws.fields + o.fields })
    // The fields' rule scripts run on the server: asked when typing pauses.
    if typed_at != null {
        every(250, () => {
            if now() - typed_at > 500 {
                typed_at = null
                let s = check_record_scripts(o.key, r)
                scripted = is_err(s) ? [] : s
            }
        })
    }
    let found = validate(`obj.${o.key}`, r, ctx) + scripted + server
    let shown = touched ? found : server
    <form.stack @submit={() => {
        touched = true
        if len(errors_of(validate(`obj.${o.key}`, r, ctx))) == 0 {
            let saved = save_record(o.key, r)
            if is_err(saved) { server = refusal_problems(saved) } else { server = []; on_saved(saved) }
        }
    }}>
        {choices == null ? <Loading/> : <div.record-fields>{for f in o.fields => <div key={f.key} class={field_span(f)}>{(o.levels ?? {})[f.key] == "read"
            ? <div.field><span.label>{f.label}</span><p.lookup-value>{shown_value(f, r) == "" ? "—" : shown_value(f, r)} <span.muted.small>(your role may read it)</span></p></div>
            : <ObjField {f} record={r} problems={shown} choices={is_err(choices) ? null : choices}
                on_change={(path, v) => { r = put(r, path, v); touched = true; server = []; typed_at = now() }}/>}</div>}</div>}
        {touched && len(found) > 0 && <ul.problems>{for x in found => <li class={x.level == "warning" ? "warn" : ""}>{x.message}</li>}</ul>}
        <FormProblems problems={server | filter((x) => x.field == "")}/>
        <div.form-actions.stuck><button.primary>Save {lower(o.name)}</button></div>
    </form>
}

component RecordPage(okey: str, id: int, ws: map) {
    let key = okey
    state o = get_object(key)
    state r = get_record(key, id)
    state message = ""
    state moving = null
    state tab = "fields"
    if o == null || r == null { return <Loading/> }
    if is_err(o) || is_err(r) { return <Empty title="No such record"><p><a href={`/app/o/${key}`}>Back</a></p></Empty> }
    <div.stack>
        <PageHead title={r.title} sub={`${o.icon} ${o.name} · added ${fmt_date(r.created_at)}`}>
            {len(o.states) > 0 && <StateBadge {o} state={r.state}/>}
            {for m in r.moves ?? [] => <button key={m.key} @click={() => { moving = m }}>{m.label} →</button>}
            {o.site.on == true && <a.button href={`/${o.site.path}/${r.id}-${slugify(blank(o.site.title) ? r.title : str(r.fields[o.site.title] ?? r.title))}?preview=1`} target="_blank" data-reload>{r.state == o.site.state || blank(o.site.state) ? "On the site ↗" : "Preview ↗"}</a>}
            <a.button href={`/app/o/${key}`}>All {lower(o.plural)}</a>
            {r.can == "delete" && <button.danger @click={() => {
                if ask("It cannot be brought back.", { title: `Delete ${r.title}?`, ok: "Delete", tone: "danger" }) { delete_record(key, id); notify(`${r.title} deleted`); navigate(`/app/o/${key}`) }
            }}>Delete</button>}
        </PageHead>
        <nav.tabs>
            <button type="button" class={tab == "fields" ? "tab on" : "tab"} @click={() => { tab = "fields" }}>Details</button>
            <button type="button" class={tab == "review" ? "tab on" : "tab"} @click={() => { tab = "review" }}>Review{(r.comments ?? 0) > 0 && ` (${r.comments})`}</button>
        </nav>
        {tab == "review" ? <ReviewPanel okey={key} {id} {ws}/> : <div.record-layout>
            <section.card>
                {r.can == "read" ? <dl.record-view>{for f in o.fields => <div key={f.key}><dt>{f.label}</dt><dd>{shown_value(f, r)}</dd></div>}</dl>
                : <RecordForm {o} record={r} {ws} on_saved={(saved) => { r = get_record(key, id); message = "Saved" }}/>}
                {message != "" && <p.ok>{message}</p>}
            </section>

            <div.stack>
                <section.card.stack>
                    <h2>Links</h2>
                    {len(keys(r.names)) == 0 ? <p.muted>It links to nothing yet.</p>
                    : <ul.plain>{for f in o.fields | filter((f) => r.names[f.key] != null) => <li>
                        <span.muted>{f.label}</span>
                        <a href={f.type == "contact" ? `/app/contacts/${r.fields[f.key]}` : f.type == "company" ? `/app/companies/${r.fields[f.key]}` : `/app/o/${f.options[0]}/${r.fields[f.key]}`}>{r.names[f.key]}</a>
                    </li>}</ul>}
                </section>
                <LinkedRecords records={r.linked} title="Linked to it"/>
            </div>
        </div>}
        {moving != null && <Drawer title={moving.label} on_close={() => { moving = null }}>
            <MoveForm {o} record={r} move={moving} {ws} on_moved={() => { let done = moving.label; moving = null; r = get_record(key, id); notify(`${done}: done`) }}/>
        </Drawer>}
    </div>
}

// Records that link to something (a contact, a company, a record).
view LinkedRecords(records: list, title: str = "Records") =
    <section.card.stack>
        <h2>{title}</h2>
        {len(records) == 0 ? <p.muted>None.</p>
        : <ul.plain>{for x in records => <li key={`${x.object}-${x.id}`}>
            <span>{x.icon}</span><a href={`/app/o/${x.object}/${x.id}`}><b>{x.title}</b></a><span.muted>{x.name}, as {lower(x.via)}</span>
        </li>}</ul>}
    </section>

// ---- roles ---------------------------------------------------------------------------------

let ACCESS_HELP = "A script that gives true for the records this role sees. It has record (the fields), owner_id, id and user (id, name, email): owner_id == user.id, or record.status != \"draft\"."

component RolesSettings(ws: map, on_change) {
    state rows = list_roles()
    state editing = null
    state problems = []
    state tried = {}
    state ofields = null
    state find = ""
    let admin = ws.user.role != "member"
    let objects = ws.objects ?? []
    let level_of = (r, o) => (r.access[o.key] ?? {}).level ?? "none"
    let edit_role = (r) => { editing = r; problems = []; find = ""; if ofields == null { ofields = objects_fields() } }
    <div.stack>
        <p.muted>Owners and admins may do anything. A member with a role may do with each object what the role allows, and sees the records its access script lets through; a member with no role edits every object.</p>
        {rows == null ? <Loading/> : is_err(rows) ? <Empty title="Roles did not load"/>
        : <div.object-grid>{for r in rows => <section.card.stack key={r.id}>
            <h3>{r.name}</h3>
            <p.muted.small>{plural(r.members, "member")}</p>
            {{
                let granted = objects | filter((o) => level_of(r, o) != "none")
                <div.stack>
                    <p.small>Sees {plural(len(granted), "object")} of {len(objects)} · edits {len(granted | filter((o) => allows(level_of(r, o), "edit")))}</p>
                    {len(granted) > 0 && <ul.plain>{for o in granted | take(6) => <li key={o.key}><span>{o.icon} {o.plural}</span><Badge text={level_of(r, o)}/>{!blank((r.access[o.key] ?? {}).script) && <code.small>script</code>}</li>}</ul>}
                    {len(granted) > 6 && <p.muted.small>and {len(granted) - 6} more</p>}
                </div>
            }}
            {admin && <div.inline>
                <button @click={() => { edit_role(r) }}>Edit</button>
                <button.ghost @click={() => {
                    if ask("Its members then edit every object.", { title: `Delete the role ${r.name}?`, ok: "Delete", tone: "danger" }) { delete_role(r.id); rows = list_roles(); on_change() }
                }}>Delete</button>
            </div>}
        </section>}</div>}
        {admin && <div><button.primary @click={() => { edit_role({ name: "", access: {} }) }}>New role</button></div>}
        {editing != null && <Drawer title={editing.id == null ? "New role" : editing.name} on_close={() => { editing = null }}>
            <form.stack @submit={() => {
                let r = save_role(editing)
                if is_err(r) { problems = refusal_problems(r) } else { editing = null; rows = list_roles(); on_change() }
            }}>
                <TextField label="Name" field="name" value={editing.name} {problems} on_change={(v) => { editing = set(editing, "name", v) }} placeholder="Support"/>
                {len(objects) == 0 && <p.muted>Make an object first (Objects): roles say what members may do with each.</p>}
                {len(objects) > 8 && <input type="search" aria-label="Find an object" placeholder={`Find one of ${len(objects)} objects`} value={find} @input={(e) => { find = e.value }}/>}
                {for o in objects | filter((o) => find == "" || contains(lower(`${o.plural} ${o.folder ?? ""}`), lower(find))) | sort_by((o) => level_of(editing, o) == "none" ? 1 : 0) => {
                    let a = merge({ level: "none", script: "" }, editing.access[o.key] ?? {})
                    let put_a = (k, v) => { editing = set(editing, "access", set(editing.access, o.key, set(a, k, v))) }
                    <section.role-object key={o.key}>
                        <div.inline><b.grow>{o.icon} {o.plural}</b>
                            <select aria-label={`${o.plural}: what they may do`} @change={(e) => { put_a("level", e.value) }}>
                                {for l in [["none", "Nothing"], ["read", "See"], ["edit", "See and edit"], ["delete", "See, edit and delete"]] => <option value={l[0]} selected={a.level == l[0]}>{l[1]}</option>}
                            </select>
                        </div>
                        {a.level != "none" && <div.stack>
                            {len((ofields ?? {})[o.key] ?? []) > 0 && <div.field-levels>
                                <span.label.small>Its fields</span>
                                {for f in (ofields ?? {})[o.key] ?? [] => <label.inline.small key={f.key}>
                                    <span.grow>{f.label}</span>
                                    <select aria-label={`${f.label}: what they may do`} @change={(e) => { put_a("fields", set(a.fields ?? {}, f.key, e.value)) }}>
                                        {for l in [["edit", "Edit"], ["read", "Read"], ["hidden", "Hidden"]] => <option value={l[0]} selected={((a.fields ?? {})[f.key] ?? (allows(a.level, "edit") ? "edit" : "read")) == l[0]}>{l[1]}</option>}
                                    </select>
                                </label>}
                            </div>}
                            <span.label.small>Which records (empty: all)</span>
                            <CodeEditor value={a.script} lang="qwe" rows={2} on_change={(v) => { put_a("script", v) }}/>
                            <p.muted.small>{ACCESS_HELP}</p>
                        </div>}
                    </section>
                }}
                <FormProblems {problems}/>
                <Hints {problems} field="access"/>
                <div.form-actions><button.primary>Save role</button></div>
            </form>
        </Drawer>}
    </div>
}

// A field's rule script, in the object designer: written, tried on the
// designer's sample record, saved.
let SCRIPT_HELP = "Runs on the server when a record is saved. It has value, record (every field), is_new, user, today, and others_with(field, value) (how many other records have it) and contact(id). Give true (or null) when it is fine, false or a message when it is not, or { message, warning: true }."

component FieldScript(okey: str, f: map, sample: map, on_saved) {
    state src = f.script ?? ""
    state result = null
    state problems = []
    state saved = false
    <div.field-script.stack>
        <CodeEditor value={src} lang="qwe" rows={4} {problems} on_change={(v) => { src = v; saved = false; result = null }}/>
        <p.muted.small>{SCRIPT_HELP}</p>
        <div.inline>
            <button type="button" @click={() => { result = try_field_script(okey, f.key, src, sample.fields ?? {}) }}>Try on the sample</button>
            <button.primary type="button" @click={() => {
                let r = save_field_script(f.id, src)
                if is_err(r) { problems = refusal_problems(r) } else { problems = []; saved = true; on_saved() }
            }}>Save script</button>
            {saved && <span.ok>Saved</span>}
        </div>
        <FormProblems {problems}/>
        {result != null && (is_err(result) ? <p.bad>{err_text(result)}</p>
            : result.error != null ? <p.bad>It failed: {result.error}</p>
            : len(result.problems) == 0 ? <p.ok>The sample passes (it gave {result.result == null ? "null" : str(result.result)}).</p>
            : <p.bad>The sample would be refused: {result.problems[0].message}</p>)}
    </div>
}

// ---- states -------------------------------------------------------------------------------

let STATE_COLORS = ["gray", "purple", "amber", "green", "red"]

view StateBadge(o: map, state: str) {
    let st = find(o.states ?? [], (x) => x.key == state)
    st == null ? <span.muted>—</span> : <Badge text={st.label} tone={st.color}/>
}

// A move's form: the fields it asks for; then the record's rules, in the
// state it goes to, decide (on the server).
component MoveForm(o: map, record: map, move: map, ws: map, on_moved) {
    state r = record
    state server = []
    state choices = link_choices(o.key)
    let asked = o.fields | filter((f) => contains(move.fields ?? [], f.key))
    let to = (find(o.states, (st) => st.key == move.to) ?? { label: move.to }).label
    <form.stack @submit={() => {
        let res = move_record(o.key, r.id, move.key, asked | reduce({}, (m, f) => set(m, f.key, r.fields[f.key])))
        if is_err(res) { server = refusal_problems(res) } else { on_moved() }
    }}>
        <p.muted>It goes from <StateBadge {o} state={r.state}/> to <b>{to}</b>.{len(asked) == 0 ? "" : " This move needs:"}</p>
        {choices == null ? <Loading/> : <div.stack>{for f in asked => <ObjField key={f.key} {f} record={r} problems={server} choices={is_err(choices) ? null : choices}
            on_change={(path, v) => { r = put(r, path, v); server = [] }}/>}</div>}
        {len(server) > 0 && <ul.problems>{for x in server => <li>{x.message}</li>}</ul>}
        <div.form-actions><button.primary>{move.label}</button></div>
    </form>
}

// The object designer's states, and the moves between them: who may make
// each, and the fields its form asks for.
component StatesEditor(o: map, ws: map, on_save, problems: list) {
    state states = o.states ?? []
    state m = { label: "", from: [], to: "", groups: [], roles: [], fields: [] }
    let toggle = (k, v) => { m = set(m, k, contains(m[k], v) ? m[k] | filter((x) => x != v) : m[k] + [v]) }
    let label_of = (k) => (find(states, (st) => st.key == k) ?? { label: k }).label
    let names = (ids, all) => ids | map((i) => (find(all, (x) => x.id == i) ?? { name: "?" }).name) | join(", ")
    <section.card.stack>
        <h2>States and moves</h2>
        <p.muted.small>A record starts in the first state, and changes state only by a move: its form, the people it is for, the rules in the state it goes to.</p>
        {len(states) > 0 && <div.state-rows>{for [i, st] in enumerate(states) => <div.state-row key={i}>
            <input aria-label="State" value={st.label} placeholder="Pitched" @input={(e) => { states = states | enumerate | map((x) => x[0] == i ? set(x[1], "label", e.value) : x[1]) }}/>
            <select aria-label="Colour" @change={(e) => { states = states | enumerate | map((x) => x[0] == i ? set(x[1], "color", e.value) : x[1]) }}>
                {for c in STATE_COLORS => <option value={c} selected={(st.color ?? "gray") == c}>{c}</option>}
            </select>
            <span.start>{i == 0 ? "start" : ""}</span>
            <button.icon type="button" title="Remove" @click={() => { states = states | enumerate | filter((x) => x[0] != i) | map((x) => x[1]) }}>✕</button>
        </div>}</div>}
        <div.inline>
            <button type="button" @click={() => { states = states + [{ key: "", label: "", color: "gray" }] }}>Add a state</button>
            <button.primary type="button" @click={() => { on_save(merge(o, { states })) }}>Save states</button>
        </div>
        <Hints {problems} field="states"/>
        {len(o.states ?? []) > 0 && <div.stack.moves>
            <h3>Moves</h3>
            {len(o.transitions ?? []) == 0 ? <p.muted>No moves yet: records stay where they start.</p>
            : <ul.rule-list>{for [i, t] in enumerate(o.transitions) => <li key={i}>
                <div><b>{t.label}</b>: {len(t.from) == 0 ? "any state" : t.from | map(label_of) | join(" or ")} → {label_of(t.to)}
                    <span.muted.small>{len(t.groups) + len(t.roles) == 0 ? " · anyone who may edit" : ` · ${join(([names(t.groups, ws.groups ?? []), names(t.roles, ws.roles ?? [])] | filter((x) => x != "")), ", ")}`}{len(t.fields) > 0 && ` · asks ${t.fields | join(", ")}`}</span></div>
                <button.ghost @click={() => { on_save(set(o, "transitions", o.transitions | enumerate | filter((x) => x[0] != i) | map((x) => x[1]))) }}>Remove</button>
            </li>}</ul>}
            <div.rule-builder.stack>
                <TextField label="Move" field="move" value={m.label} problems={[]} on_change={(v) => { m = set(m, "label", v) }} placeholder="Assign"/>
                <fieldset.people><legend>From (none: any state)</legend>{for st in o.states => <label.inline.small key={st.key}><input type="checkbox" checked={contains(m.from, st.key)} @change={() => { toggle("from", st.key) }}/> {st.label}</label>}</fieldset>
                <SelectField label="To" field="to" value={m.to} options={o.states | map((st) => { value: st.key, label: st.label })} problems={[]} on_change={(v) => { m = set(m, "to", v) }} empty="Choose"/>
                <fieldset.people><legend>Who (none: anyone who may edit)</legend>
                    {for g in ws.groups ?? [] => <label.inline.small key={`g${g.id}`}><input type="checkbox" checked={contains(m.groups, g.id)} @change={() => { toggle("groups", g.id) }}/> {g.name}</label>}
                    {for r in ws.roles ?? [] => <label.inline.small key={`r${r.id}`}><input type="checkbox" checked={contains(m.roles, r.id)} @change={() => { toggle("roles", r.id) }}/> role {r.name}</label>}
                </fieldset>
                <fieldset.people><legend>Its form asks for</legend>{for f in o.fields => <label.inline.small key={f.key}><input type="checkbox" checked={contains(m.fields, f.key)} @change={() => { toggle("fields", f.key) }}/> {f.label}</label>}</fieldset>
                <Hints {problems} field="transitions"/>
                <div><button.primary type="button" disabled={blank(m.label) || m.to == ""} @click={() => {
                    on_save(set(o, "transitions", (o.transitions ?? []) + [m]))
                    m = { label: "", from: [], to: "", groups: [], roles: [], fields: [] }
                }}>Add move</button></div>
            </div>
        </div>}
    </section>
}

// ---- groups -------------------------------------------------------------------------------

component GroupsSettings(ws: map, on_change) {
    state rows = list_groups()
    state editing = null
    state problems = []
    let admin = ws.user.role != "member"
    let toggle = (k, v) => { editing = set(editing, k, contains(editing[k] ?? [], v) ? editing[k] | filter((x) => x != v) : (editing[k] ?? []) + [v]) }
    let name_of = (uid) => (find(ws.users, (u) => u.id == uid) ?? { name: "?" }).name
    <div.stack>
        <p.muted>A group is people who work together: its members get its roles, and what it is on the team — designers (objects, the theme, pages), writers, reviewers, publishers (on desks that name no one, they are the desk's). Flows can ask a group to decide, and moves can be for a group.</p>
        {rows == null ? <Loading/> : is_err(rows) ? <Empty title="Groups did not load"/>
        : len(rows) == 0 ? <Empty title="No groups yet"/>
        : <div.object-grid>{for g in rows => <section.card.stack key={g.id}>
            <h3>{g.name}</h3>
            <p.small><b>Members:</b> {len(g.members) == 0 ? "none" : g.members | map(name_of) | join(", ")}</p>
            <p.small><b>Roles:</b> {len(g.roles) == 0 ? "none" : g.roles | map((rid) => (find(ws.roles ?? [], (r) => r.id == rid) ?? { name: "?" }).name) | join(", ")}</p>
            <p>{for c in g.capabilities => <Badge text={c} tone="purple"/>}</p>
            {admin && <div.inline>
                <button @click={() => { editing = g; problems = [] }}>Edit</button>
                <button.ghost @click={() => { delete_group(g.id); rows = list_groups(); on_change() }}>Delete</button>
            </div>}
        </section>}</div>}
        {admin && <div><button.primary @click={() => { editing = { name: "", members: [], roles: [], capabilities: [] }; problems = [] }}>New group</button></div>}
        {editing != null && <Drawer title={editing.id == null ? "New group" : editing.name} on_close={() => { editing = null }}>
            <form.stack @submit={() => {
                let r = save_group(editing)
                if is_err(r) { problems = refusal_problems(r) } else { editing = null; rows = list_groups(); on_change() }
            }}>
                <TextField label="Name" field="name" value={editing.name} {problems} on_change={(v) => { editing = set(editing, "name", v) }} placeholder="Politics desk"/>
                <fieldset.people><legend>Members</legend>{for u in ws.users => <label.inline.small key={u.id}><input type="checkbox" checked={contains(editing.members, u.id)} @change={() => { toggle("members", u.id) }}/> {u.name}</label>}</fieldset>
                <fieldset.people><legend>Roles its members get</legend>
                    {len(ws.roles ?? []) == 0 && <p.muted.small>Make roles in Roles first.</p>}
                    {for r in ws.roles ?? [] => <label.inline.small key={r.id}><input type="checkbox" checked={contains(editing.roles, r.id)} @change={() => { toggle("roles", r.id) }}/> {r.name}</label>}
                </fieldset>
                <fieldset.people><legend>On the team, they are</legend>{for c in CAPABILITIES => <label.inline.small key={c[0]}><input type="checkbox" checked={contains(editing.capabilities, c[0])} @change={() => { toggle("capabilities", c[0]) }}/> {c[1]}</label>}</fieldset>
                <FormProblems {problems}/>
                <div.form-actions><button.primary>Save group</button></div>
            </form>
        </Drawer>}
    </div>
}

// Decisions flows ask of this person's groups and roles.
component FlowDecisions() {
    state rows = my_flow_tasks()
    state notes = {}
    state message = ""
    rows == null || is_err(rows) || len(rows) == 0 ? null : <section.card.stack>
        <h2>Waiting for your decision</h2>
        {message != "" && <p.ok>{message}</p>}
        {for t in rows => <div.decision key={t.id}>
            <div><b>{t.title}</b> <span.muted.small>for {t.to} · {t.flow} · {fmt_ago(t.created_at, now())}</span></div>
            {t.details != "" && <p>{t.details}</p>}
            {t.record != null && <p.small><a href={`/app/o/${t.object}/${t.record_id}`}>{t.record.title}</a></p>}
            {t.contact != null && <p.small><a href={`/app/contacts/${t.contact_id}`}>{t.contact.name}</a></p>}
            <div.inline>
                <input aria-label="Note" placeholder="A note (optional)" value={notes[str(t.id)] ?? ""} @input={(e) => { notes = set(notes, str(t.id), e.value) }}/>
                <button.primary @click={() => { answer_flow_task(t.id, "approved", notes[str(t.id)] ?? ""); rows = my_flow_tasks(); message = "Approved" }}>Approve</button>
                <button @click={() => { answer_flow_task(t.id, "rejected", notes[str(t.id)] ?? ""); rows = my_flow_tasks(); message = "Rejected" }}>Reject</button>
            </div>
        </div>}
    </section>
}

// Formatted text: written in Markdown, shown as it will read.
component MarkdownField(label: str, field: str, value, problems: list, on_change) {
    state preview = null
    <div.field.md-field>
        <div.inline><span.label.grow>{label}</span>
            <button.tab type="button" class={preview == null ? "on" : ""} @click={() => { preview = null }}>Write</button>
            <button.tab type="button" class={preview != null ? "on" : ""} @click={() => { preview = preview_markdown(value ?? "") ?? "" }}>Preview</button>
        </div>
        {preview == null
            ? <textarea name={field} rows="12" placeholder="**bold**, _italic_, ## headings, > quotes, [links](https://…)" @input={(e) => { on_change(e.value) }}>{value ?? ""}</textarea>
            : <div.site.post-preview><section.post-body>{raw(is_err(preview) ? "" : preview)}</section></div>}
        <Hints {problems} field={field}/>
    </div>
}

// Where the object's records show on the site, and which field is what.
component ObjectSiteEditor(o: map, on_save, problems: list) {
    state s = merge(SITE_DEFAULT, o.site ?? {})
    let pick = (k, label, types) => <SelectField {label} field={k} value={s[k]} options={o.fields | filter((f) => types == null || contains(types, f.type)) | map((f) => { value: f.key, label: f.label })}
        problems={[]} on_change={(v) => { s = set(s, k, v) }} empty="—"/>
    <section.card.stack>
        <h2>On the site</h2>
        <p.muted.small>Its records as articles: a front page, a page per section, a page per record. Sections are another object's records (Categories, say), and may depend on one another.</p>
        <CheckField label="Show its records on the site" field="on" value={s.on == true} problems={[]} on_change={(v) => { s = set(s, "on", v) }}/>
        {s.on == true && <div.stack>
            <TextField label="At the address" field="path" value={s.path} {problems} on_change={(v) => { s = set(s, "path", lower(v)) }} placeholder="news" help={`/${slugify(s.path)}`}/>
            <SelectField label="In the state" field="state" value={s.state} options={(o.states ?? []) | map((st) => { value: st.key, label: st.label })} problems={[]} on_change={(v) => { s = set(s, "state", v) }} empty="Every state"/>
            <div.row2>{pick("title", "Headline", ["text"])}{pick("summary", "Summary", ["text", "textarea"])}</div>
            <div.row2>{pick("image", "Picture", ["image"])}{pick("caption", "Caption", ["text"])}</div>
            <div.row2>{pick("body", "Body", ["markdown", "textarea"])}{pick("group", "Section", ["record"])}</div>
            <div.row2>{pick("byline", "Byline (empty: who wrote it)", ["person"])}<span></span></div>
            <CheckField label="It is the site's front page" field="home" value={s.home == true} problems={[]} on_change={(v) => { s = set(s, "home", v) }}/>
        </div>}
        <Hints {problems} field="site"/>
        <div><button.primary type="button" @click={() => { on_save(merge(o, { site: s })) }}>Save</button></div>
    </section>
}
