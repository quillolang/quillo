// The app: one page, its parts chosen by the address (/app/contacts/12).
// The workspace (settings, plugins switched on, fields, pipelines) loads
// once; pages load their own data from server functions, live.

view AppPage() =
    <html lang="en">
        <head>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
            <title>{settings().name ?? "Relay"}</title>
            <meta name="description" content={`${settings().name ?? "Relay"}: the CRM`}/>
            <meta name="robots" content="noindex, nofollow"/>
            <link rel="stylesheet" href="/assets/app.css"/>
            <style>{notices_css()}</style>
            <script src="/assets/review.js" defer></script>
            <script src="/assets/keys.js" defer></script>
            <script src="/assets/editor.js" defer></script>
        </head>
        <body data-notices={notice_classes(notice_style())}><App/></body>
    </html>

// The menu: the app's own; under Objects and Pages, the pinned ones and
// what this person opened last (eight at most: the rest are a search away).
fn app_nav(ws: map, nav) {
    let nav = nav == null || is_err(nav) ? {} : nav
    NAV | map((g) => g.group != "Workspace" ? g : merge(g, { items: g.items | map((it) =>
        it.href == "/app/objects" ? merge(it, { subs: nav.objects ?? [], count: nav.object_count ?? 0 })
        : it.href == "/app/pages" ? merge(it, { subs: nav.pages ?? [], count: nav.page_count ?? 0 })
        : it) }))
}

// `/app/o/vehicle` is under `/app/o/vehicle`, not under `/app/o/vehicles`.
fn under(path: str, href: str) = path == href || starts_with(path, `${href}/`)

let NAV = [
    { group: "", items: [{ href: "/app", label: "Dashboard", icon: "◧" }, { href: "/app/tasks", label: "Tasks", icon: "☑" }] },
    { group: "People", items: [{ href: "/app/contacts", label: "Contacts", icon: "☺" }, { href: "/app/companies", label: "Companies", icon: "▦" }] },
    { group: "Sales", items: [{ href: "/app/deals", label: "Deals", icon: "◫" }, { href: "/app/products", label: "Products", icon: "◈" }, { href: "/app/orders", label: "Orders", icon: "≡" }] },
    { group: "Marketing", items: [{ href: "/app/site", label: "Theme", icon: "◐" }, { href: "/app/posts", label: "Posts", icon: "✍", needs: "blog" }, { href: "/app/media", label: "Media", icon: "▣" }, { href: "/app/forms", label: "Forms", icon: "✎" }, { href: "/app/campaigns", label: "Campaigns", icon: "✉" }, { href: "/app/outbox", label: "Outbox", icon: "⇪" }] },
    { group: "Automation", items: [{ href: "/app/flows", label: "Flows", icon: "⟶" }] },
    { group: "Workspace", items: [{ href: "/app/objects", label: "Objects", icon: "◇" }, { href: "/app/pages", label: "Pages", icon: "▤" },
        { href: "/app/plugins", label: "Plugins", icon: "⧉" }, { href: "/app/settings", label: "Settings", icon: "⚙" }] },
]

fn nav_active(href: str, path: str) = href == "/app" ? path == "/app" || path == "/app/" : starts_with(path, href)

component App() {
    state ws = load_workspace()
    state nav = live(sidebar_nav)
    state reloads = 0
    let path = url().path
    let segs = drop(split(path, "/") | filter((s) => s != ""), 1)
    if ws == null { return <Loading/> }
    if is_err(ws) { return <div.center-card><h1>Please sign in again</h1><p><a href="/login" data-reload>Sign in</a></p></div> }
    // Pages that change the workspace (plugins, fields) ask for it again.
    let refresh = () => { ws = load_workspace() }
    <div.shell>
        <aside.sidebar>
            <div.brand><span.logo-mark>◆</span><div><b>{ws.name}</b><span>{ws.slug}</span></div></div>
            <nav>{for g in app_nav(ws, nav) + (ws.developer ? [{ group: "Develop", items: [{ href: "/app/studio", label: "Plugin studio", icon: "⌘" }] }] : []) => <div.nav-group>
                {g.group != "" && <p.nav-title>{g.group}</p>}
                {for it in g.items | filter((it) => it.needs == null || any(active_plugins(ws.enabled), (p) => p.id == it.needs)) => {
                    let subs = it.subs ?? []
                    let sub_on = any(subs, (x) => under(path, x.href))
                    <div.nav-item>
                        <a href={it.href} class={nav_active(it.href, path) && !sub_on && "active"}><span.icon>{it.icon}</span>{it.label}{(it.count ?? 0) > 0 && <span.nav-count>{it.count}</span>}</a>
                        {len(subs) > 0 && <div.nav-subs>{for x in subs => <a key={x.href} href={x.href} class={under(path, x.href) && "active"} title={x.label}>
                            <span.icon>{x.icon}</span><span.nav-label>{x.label}</span>{x.pinned && <span.nav-pin aria-label="pinned">•</span>}
                        </a>}</div>}
                    </div>
                }}
            </div>}</nav>
            <div.me>
                <Avatar name={ws.user.name}/>
                <div><b>{ws.user.name}</b><span>{ws.user.role}</span></div>
                <form method="post" action="/logout"><button.icon title="Sign out">⎋</button></form>
            </div>
        </aside>
        <main.main>
            <Search/>
            <div.page>{match segs {
                [] => <Dashboard {ws}/>
                ["tasks"] => <TasksPage {ws}/>
                ["contacts"] => <ContactsPage {ws} query={url().query}/>
                ["contacts", id] => <ContactPage key={id} id={int(id) ?? 0} {ws}/>
                ["companies"] => <CompaniesPage {ws}/>
                ["companies", id] => <CompanyPage key={id} id={int(id) ?? 0} {ws}/>
                ["deals"] => <DealsPage {ws}/>
                ["products"] => <ProductsPage {ws}/>
                ["orders"] => <OrdersPage {ws}/>
                ["forms"] => <FormsPage {ws}/>
                ["pages"] => <PagesPage {ws} on_change={refresh}/>
                ["objects"] => <ObjectsPage {ws} on_change={refresh}/>
                ["objects", k] => <ObjectDesigner key={k} okey={k} {ws} on_change={refresh}/>
                ["o", k] => <RecordsPage key={k} okey={k} {ws}/>
                ["o", k, rid] => <RecordPage key={`${k}-${rid}`} okey={k} id={int(rid) ?? 0} {ws}/>
                ["site"] => <div><PageHead title="Theme" sub="How your site looks: the theme, its colour and type, the menu and the footer."/><SiteEditor {ws} on_change={refresh}/></div>
                ["media"] => <MediaPage {ws}/>
                ["posts"] => <PostsPage {ws}/>
                ["posts", pid] => <PostEditor key={pid} id={int(pid) ?? 0} {ws}/>
                ["studio"] => <StudioPage {ws} on_change={refresh}/>
                ["studio", pid] => <PluginEditor key={pid} id={pid} {ws}/>
                ["pages", id] => <PageDesigner key={id} id={int(id) ?? 0} {ws}/>
                ["campaigns"] => <CampaignsPage {ws}/>
                ["outbox"] => <OutboxPage {ws}/>
                ["flows"] => <FlowsPage {ws}/>
                ["flows", id] => <FlowDesigner key={id} id={int(id) ?? 0} {ws}/>
                ["plugins"] => <PluginsPage {ws} on_change={refresh}/>
                ["settings"] => <SettingsPage {ws} on_change={refresh}/>
                _ => <Empty title="Nothing here"><p><a href="/app">Back to the dashboard</a></p></Empty>
            }}</div>
        </main>
    </div>
}

// Everything, found as you type.
// Everything, from one box (⌘K): objects, pages, records, contacts,
// companies, deals, products. The arrows choose, Enter opens.
component Search() {
    state q = ""
    state found = []
    state at = 0
    let close = () => { q = ""; found = []; at = 0 }
    <div.search>
        <input type="search" aria-label="Search" placeholder="Search everything…  ⌘K" value={q} role="combobox" aria-expanded={len(found) > 0}
            aria-controls="search-results" aria-activedescendant={len(found) > 0 ? `found-${at}` : ""} @input={(e) => {
            q = e.value
            at = 0
            found = len(trim(q)) >= 2 ? search(q) ?? [] : []
        }} @keydown={(e) => {
            if e.key == "Escape" { close() }
            if e.key == "ArrowDown" && len(found) > 0 { at = (at + 1) % len(found) }
            if e.key == "ArrowUp" && len(found) > 0 { at = (at + len(found) - 1) % len(found) }
            if e.key == "Enter" && len(found) > 0 { let href = found[at].href; close(); navigate(href) }
        }}/>
        {len(found) > 0 && <div.search-results id="search-results" role="listbox">
            {for [i, f] in enumerate(found) => <a id={`found-${i}`} role="option" aria-selected={i == at} class={i == at ? "on" : ""} href={f.href} @click={() => { close() }}>
                <Badge text={f.kind}/><b>{f.label}</b><span.muted>{f.sub}</span></a>}
            <p.search-keys>↑ ↓ to choose · Enter to open · Esc to close</p>
        </div>}
    </div>
}
