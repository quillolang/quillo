// Review: the record as it reads, with its comments painted on it. Mark
// some text (select it) or a picture (click it), then comment; answer and
// resolve threads. public/review.js does the marking and the painting.

component ReviewPanel(okey: str, id: int, ws: map) {
    let key = okey
    state doc = review_view(key, id)
    state notes = list_annotations(key, id)
    state picked = null
    state draft = ""
    state replies = {}
    state show_resolved = false
    state painted = 0
    state problems = []
    if doc == null || notes == null { return <Loading/> }
    if is_err(doc) || is_err(notes) { return <Empty title="The review did not load"/> }
    let refresh = () => { notes = list_annotations(key, id); painted = painted + 1 }
    let marks = notes | filter((n) => show_resolved || !n.resolved) | map((n) => { id: n.id, field: n.field, quote: n.quote, prefix: n.prefix, image: n.image, resolved: n.resolved })
    let label_of = (k) => (find(doc, (f) => f.key == k) ?? { label: k }).label
    let open = len(notes | filter((n) => !n.resolved))
    <div.review>
        <div.rv-doc key={`doc-${painted}-${show_resolved}`} @mount={(el) => { js("relayReview.paint", el, marks) }}>
            {for f in doc => <section key={f.key} class={`rv-section rv-${f.role == "" ? f.type : f.role}`}>
                <p.rv-label>{f.label}</p>
                {f.html == "" ? <p.muted.small>Empty</p> : <div data-rv-field={f.key} class="rv-text">{raw(f.html)}</div>}
            </section>}
        </div>
        <aside.rv-side>
            <section.rv-compose>
                {picked == null
                    ? <div.stack>
                        <p.muted.small>Select a few words (the headline, the body, any text), or click a picture, then:</p>
                        <button.primary @click={() => {
                            let s = js("relayReview.last")
                            if s == null { notify("Select some text, or click a picture, first.") } else { picked = s; problems = [] }
                        }}>Comment on what you marked</button>
                    </div>
                    : <div.stack>
                        <p.rv-quote>{picked.image != "" ? <span>A picture, in {label_of(picked.field)}</span> : <span>“{picked.quote}”</span>}<span.muted.small> · {label_of(picked.field)}</span></p>
                        <textarea name="comment" rows="3" placeholder="What should change, and why?" value={draft} @input={(e) => { draft = e.value }}></textarea>
                        <Hints {problems} field="body"/>
                        <div.inline>
                            <button.primary @click={() => {
                                let r = add_annotation(key, id, merge(picked, { body: draft }))
                                if is_err(r) { problems = refusal_problems(r) } else { picked = null; draft = ""; js("relayReview.clear"); refresh(); notify("Comment added") }
                            }}>Comment</button>
                            <button.ghost @click={() => { picked = null; draft = ""; js("relayReview.clear") }}>Cancel</button>
                        </div>
                    </div>}
            </section>
            <div.rv-threads-head>
                <b>{open == 0 ? "No open comments" : plural(open, "open comment")}</b>
                <label.inline.small><input type="checkbox" checked={show_resolved} @change={() => { show_resolved = !show_resolved }}/> resolved too</label>
            </div>
            {for n in notes | filter((n) => show_resolved || !n.resolved) => <article key={n.id} id={`rv-thread-${n.id}`} data-id={str(n.id)} class={n.resolved ? "rv-thread rv-done" : "rv-thread"}>
                <p.rv-where>{n.image != "" ? "A picture" : n.quote == "" ? label_of(n.field) : `“${n.quote}”`} <span.muted>· {label_of(n.field)}</span></p>
                <div.rv-note><b>{n.author ?? "Someone"}</b> <span.muted.small>{fmt_ago(n.created_at, now())}</span><p>{n.body}</p></div>
                {for x in n.replies => <div.rv-note.rv-reply key={x.id}><b>{x.author ?? "Someone"}</b> <span.muted.small>{fmt_ago(x.created_at, now())}</span><p>{x.body}</p></div>}
                {n.resolved
                    ? <p.muted.small>Resolved by {n.resolver ?? "someone"} · <button.link @click={() => { resolve_annotation(n.id, false); refresh() }}>Reopen</button></p>
                    : <div.rv-actions>
                        <input aria-label="Reply" placeholder="Reply…" value={replies[str(n.id)] ?? ""} @input={(e) => { replies = set(replies, str(n.id), e.value) }}/>
                        <button @click={() => {
                            let r = reply_annotation(n.id, replies[str(n.id)] ?? "")
                            if !is_err(r) { replies = set(replies, str(n.id), ""); refresh() }
                        }}>Reply</button>
                        <button.ghost @click={() => { resolve_annotation(n.id, true); refresh(); notify("Resolved") }}>Resolve</button>
                    </div>}
            </article>}
        </aside>
    </div>
}

// What waits for this person: records their groups and roles move next.
component RecordQueue() {
    state rows = my_records_queue()
    rows == null || is_err(rows) || len(rows) == 0 ? null : <section.card.stack>
        <h2>Waiting for you</h2>
        <table.table.compact><tbody>{for x in rows => <tr key={`${x.object}-${x.id}`} class="clickable" @click={() => { navigate(`/app/o/${x.object}/${x.id}`) }}>
            <td>{x.icon} <b>{x.title}</b></td>
            <td><Badge text={x.state}/></td>
            <td.muted>{join(x.moves, ", ")}</td>
            <td.muted>{x.comments > 0 && plural(x.comments, "open comment")}</td>
        </tr>}</tbody></table>
    </section>
}
