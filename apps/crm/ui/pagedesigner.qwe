// Pages: the list, the theme, and the designer. The designer's palette is
// the blocks the plugins switched on bring; its preview is each block as
// the server renders it; the page rules hint as you edit and decide when
// you publish. Sections are made in the same designer, and pages put
// them in with the Section block.

// Many pages: pages and sections apart, searched, sorted, grouped in
// folders (folded as you like); the pinned ones first, and in the sidebar.
component PagesPage(ws: map, on_change) {
    state rows = live(list_pages)
    state making = false
    state kind = "page"
    state q = ""
    state sort = "changed"
    state folded = []
    let templates = [
        ["launch", "Product launch", "A hero, a product to buy, a testimonial, a sign-up."],
        ["membership", "Membership", "Why become a member, the plans, a free newsletter."],
        ["blank", "Simple page", "A headline and a sign-up form."],
    ]
    let make = (t) => {
        let id = new_page(t)
        if !is_err(id) { making = false; navigate(`/app/pages/${id}`) }
    }
    <div.stack>
        <PageHead title="Pages" sub="Landing pages and your home page, made of blocks; sections, put on many pages at once. Plugins bring more blocks.">
            <a.button href="/app/site">Theme</a>
            <button.primary @click={() => { making = true }}>New page</button>
        </PageHead>
        {rows == null ? <Loading/>
        : is_err(rows) ? <Empty title="Pages did not load"><p>{err_text(rows)}</p></Empty>
        : {
            let of_kind = rows | filter((p) => (p.kind == "section") == (kind == "section"))
            let words = lower(trim(q))
            let found = of_kind | filter((p) => words == "" || contains(lower(`${p.title} ${p.slug} ${p.folder} ${p.description ?? ""}`), words))
            let sorted = match sort {
                "name" => found | sort_by((p) => lower(p.title))
                "opened" => found | sort_by((p) => -(p.opened_at ?? 0))
                _ => {
                    // The home page first, then the latest.
                    let latest = found | sort_by((p) => -(p.updated_at ?? 0))
                    (latest | filter((p) => p.home)) + (latest | filter((p) => !p.home))
                }
            }
            let folders = unique(of_kind | map((p) => p.folder) | filter((f) => f != "")) | sort_by(lower)
            let groups = (words == "" && any(sorted, (p) => p.pinned) ? [{ id: "★", name: "Pinned", items: sorted | filter((p) => p.pinned) }] : [])
                + (len(folders) > 0 ? (folders + [""]) | map((f) => { id: f, name: f == "" ? "No folder" : f, items: sorted | filter((p) => p.folder == f) }) | filter((g) => len(g.items) > 0)
                   : [{ id: "", name: "", items: sorted }])
            let n_pages = len(rows | filter((p) => p.kind != "section"))
            <div.stack>
                <div.toolbar>
                    <div.seg role="group" aria-label="Pages or sections">
                        <button type="button" class={kind == "page" ? "on" : ""} aria-pressed={kind == "page"} @click={() => { kind = "page"; folded = [] }}>Pages {n_pages}</button>
                        <button type="button" class={kind == "section" ? "on" : ""} aria-pressed={kind == "section"} @click={() => { kind = "section"; folded = [] }}>Sections {len(rows) - n_pages}</button>
                    </div>
                    <input type="search" aria-label={kind == "section" ? "Find a section" : "Find a page"} placeholder={`Find one of ${len(of_kind)} ${kind == "section" ? "sections" : "pages"}`} value={q} @input={(e) => { q = e.value }}/>
                    <select aria-label="Sort" @change={(e) => { sort = e.value }}>
                        {for x in [["changed", "Changed lately"], ["name", "By name"], ["opened", "Opened lately"]] => <option value={x[0]} selected={sort == x[0]}>{x[1]}</option>}
                    </select>
                </div>
                <datalist id="page-folders">{for f in folders => <option value={f}></option>}</datalist>
                {len(of_kind) == 0 ? <Empty title={kind == "section" ? "No sections yet" : "No pages yet"}><p>{kind == "section" ? "Sections are pieces you put on many pages with the Section block: a sign-up, a pitch, a footer." : "New page: start from a template."}</p></Empty>
                : len(found) == 0 ? <p.muted>Nothing matches “{q}”.</p>
                : <div.stack>{for g in groups => <section.obj-group key={g.id}>
                    {g.name != "" && <button type="button" class="group-head" aria-expanded={!contains(folded, g.id)}
                        @click={() => { folded = contains(folded, g.id) ? folded | filter((x) => x != g.id) : folded + [g.id] }}>
                        <span.chev aria-hidden="true">{contains(folded, g.id) ? "▸" : "▾"}</span>{g.name}<span.group-count>{len(g.items)}</span>
                    </button>}
                    {!contains(folded, g.id) && <div.table-scroll><table.table.objects-table>
                        <thead><tr><th.pin-col><span.sr>Pinned</span></th><th>{kind == "section" ? "Section" : "Page"}</th><th>{kind == "section" ? "Used on" : "Address"}</th><th>Folder</th><th>Status</th><th>Updated</th></tr></thead>
                        <tbody>{for p in g.items => <tr key={p.id}>
                            <td.pin-col><button type="button" class={p.pinned ? "pin on" : "pin"} aria-pressed={p.pinned} title={p.pinned ? "Unpin from the sidebar" : "Pin to the sidebar"}
                                @click={() => { set_page_place(p.id, { pinned: !p.pinned }) }}>{p.pinned ? "★" : "☆"}</button></td>
                            <td><a.obj-name href={`/app/pages/${p.id}`}><span><b>{p.title != "" ? p.title : "Untitled"}</b>{p.home && <Badge text="home" tone="purple"/>}</span></a></td>
                            <td>{kind == "section" ? <span.muted>{len(p.used_on ?? []) == 0 ? "No pages yet" : plural(len(p.used_on), "page")}</span> : <code>{p.home ? "/" : `/p/${p.slug}`}</code>}</td>
                            <td><input.folder-input list="page-folders" aria-label={`${p.title}: folder`} placeholder="No folder" value={p.folder} @change={(e) => { set_page_place(p.id, { folder: e.value }) }}/></td>
                            <td><PageStatus {p}/></td>
                            <td.muted>{fmt_ago(p.updated_at, now())}</td>
                        </tr>}</tbody>
                    </table></div>}
                </section>}</div>}
            </div>
        }}
        {making && <Drawer title="New page" on_close={() => { making = false }}>
            <div.stack>
                <div.templates.two>{for t in templates => <button.template key={t[0]} @click={() => { make(t[0]) }}><b>{t[1]}</b><span>{t[2]}</span></button>}</div>
                <h3>Or a section</h3>
                <p.muted>A piece you put on many pages with the Section block: a sign-up, a pitch, a footer. Change it, and every page with it changes.</p>
                <div><button @click={() => { make("section") }}>New section</button></div>
            </div>
        </Drawer>}
    </div>
}

view PageStatus(p: map) =
    p.published == null ? <Badge text="draft"/> : p.changed ? <Badge text="changes not published" tone="amber"/> : <Badge text="published" tone="green"/>

let BLOCK_ICONS = { hero: "▭", text: "¶", image: "▣", columns: "◫", quote: "❝", button: "⬭", spacer: "↕", product: "◈", products: "▦",
    form: "✉", section: "▤" }

fn block_icon(t: str) = BLOCK_ICONS[t] ?? "◆"

// A block's first words, for the outline.
fn block_summary(b: map) {
    let c = b.config ?? {}
    let words = [c.headline, c.body, c.quote, c.text, c.heading, c.caption, c.left] | filter((x) => !blank(x))
    len(words) == 0 ? (b.type == "columns" ? `${len(inner_lists(b))} columns` : "") : {
        let w = replace(replace(str(words[0]), "\n", " "), "*", "")
        len(w) > 42 ? `${slice(w, 0, 42)}…` : w
    }
}

// ---- blocks in blocks -------------------------------------------------------------
// A list of blocks is found by its parent (a columns block's id, or null:
// the page) and its column; a block, by its id, anywhere.


// Where a block is: { parent, col, index }, or null.
fn place_in(bs: list, id: str, parent, col: int) {
    let i = index_of(bs | map((b) => b.id), id)
    i != null ? { parent, col, index: i }
        : bs | map((b) => inner_lists(b) | enumerate | map((x) => place_in(x[1], id, b.id, x[0]))) | flatten | find((x) => x != null)
}

fn list_at(bs: list, parent, col: int) = parent == null ? bs : inner_lists(find(flat_blocks(bs), (b) => b.id == parent))[col] ?? []

// The blocks with one list changed by `f`.
fn with_list(bs: list, parent, col: int, f) = parent == null ? f(bs)
    : bs | map((b) => b.id == parent ? set_columns(b, inner_lists(b) | enumerate | map((x) => x[0] == col ? f(x[1]) : x[1]))
        : len(inner_lists(b)) == 0 ? b : set_columns(b, inner_lists(b) | map((l) => with_list(l, parent, col, f))))

fn map_block(bs: list, id: str, f) = bs | map((b) => b.id == id ? f(b)
    : len(inner_lists(b)) == 0 ? b : set_columns(b, inner_lists(b) | map((l) => map_block(l, id, f))))

fn drop_block(bs: list, id: str) = bs | filter((b) => b.id != id)
    | map((b) => len(inner_lists(b)) == 0 ? b : set_columns(b, inner_lists(b) | map((l) => drop_block(l, id))))

fn insert_into(bs: list, where: map, b: map) = with_list(bs, where.parent, where.col, (l) => take(l, where.at) + [b] + drop(l, where.at))

// A copy, its blocks too, with ids of its own.
fn fresh_ids(b: map) {
    let c = set(b, "id", `b${slice(replace(uuid(), "-", ""), 0, 10)}`)
    len(inner_lists(b)) == 0 ? c : set_columns(c, inner_lists(b) | map((l) => l | map(fresh_ids)))
}

// The outline: every block, and how deep.
fn outline_rows(bs: list, depth: int) = bs | map((b) => [{ b, depth }] + (inner_lists(b) | map((l) => outline_rows(l, depth + 1)) | flatten)) | flatten

// The fields a block's HTML marks optional: empty, they show only once added.
fn optional_fields(markup: str, keys: list) = keys | filter((k) => {
    let parts = split(markup, `data-edit="${k}"`)
    len(parts) > 1 && contains(split(parts[1], ">")[0], "data-optional")
})

// What an empty column suggests first.
let COLUMN_SUGGESTS = ["text", "image", "button", "quote"]

// The page designer, as Gutenberg is: the page is edited where it shows —
// text typed into in place, a block added with + between blocks or / in an
// empty one, a toolbar on the chosen one; blocks
// in columns, each column suggesting what to add; the blocks' library and
// the outline on the left, the page's or the block's settings on the right.
component PageDesigner(id: int, ws: map) {
    state p = get_page(id)
    state preview = preview_of(id)
    state blocks = null
    state meta = null
    state selected = null
    state dragging = null
    state server = []
    state saved = ""
    state rctx = page_rule_ctx()
    state adding = null
    // Where a drop would go: { parent, col, at }.
    state drop_to = null
    // The blocks as they were before each change, latest first (⌘Z), and
    // the changes undone (⌘⇧Z).
    state history = []
    state future = []
    // The blocks before the typing in place now going on.
    state typing_from = null
    state left = "blocks"
    state side = "block"
    state lib_q = ""
    // Choosing a block to add: { parent, col, at } (a place in a list) or { replace } (an empty one).
    state inserting = null
    state ins_q = ""
    state ins_at = 0
    // Typing reaches the live preview at most every 300 ms, and once more when it pauses.
    state pushed_at = 0
    state dirty = false
    // Optional fields added while empty ("block:key"): shown, to be typed into.
    state reveal = []
    // Feedback from the live preview: the team's to-dos, as they come.
    state fb = live(page_feedback, id)
    state fb_drafts = {}
    state fb_resolved = false
    if p == null { return <Loading/> }
    if is_err(p) { return <Empty title="No such page"><p><a href="/app/pages">All pages</a></p></Empty> }
    let bs = upgrade_blocks(blocks ?? p.draft.blocks ?? [])
    let all = flat_blocks(bs)
    let m = meta ?? { title: p.title, slug: p.slug, description: p.description }
    let theme = merge(DEFAULT_THEME, ws.settings.theme ?? {})
    let tdef = theme_def(theme.id, ws.enabled)
    let types = block_types(ws.enabled)
    let type_of_block = (b) => find(types, (t) => t.type == b.type) ?? { label: b.type, fields: [] }
    let known = is_err(rctx) || rctx == null ? {} : rctx
    let section = p.kind == "section"
    let problems = validate("page", merge(m, { id: str(id), kind: p.kind, blocks: all }), ctx_of(ws, { skus: known.skus ?? [], forms: known.forms ?? [], sections: known.sections ?? [] })) + server
    let errors = errors_of(problems)
    let block_problems = (bid) => problems | filter((x) => x.field == `block.${bid}`)
    let sel = selected == null ? null : find(all, (b) => b.id == selected)
    let html_of = (bid) => (find(preview ?? [], (x) => x.id == bid) ?? {}).html
    // Every change shows at once, rendered by the server as visitors will see it.
    let show = (next) => {
        blocks = next
        saved = ""
        server = []
        let r = preview_live(id, next, selected)
        if !is_err(r) { preview = r }
    }
    let change = (next) => {
        history = take([typing_from ?? bs] + history, 50)
        typing_from = null
        future = []
        show(next)
    }
    let undo = () => {
        if len(history) > 0 {
            let back = history[0]
            history = drop(history, 1)
            future = take([bs] + future, 50)
            show(back)
            if selected != null && find(flat_blocks(back), (b) => b.id == selected) == null { selected = null }
        }
    }
    let redo = () => {
        if len(future) > 0 {
            let again = future[0]
            future = drop(future, 1)
            history = take([bs] + history, 50)
            show(again)
        }
    }
    // Typed in place: kept as it is typed (no drawing again, or the caret
    // would jump); drawn again, and undoable, when the typing is done.
    let typed = (bid, key, v) => {
        if typing_from == null { typing_from = bs }
        let next = map_block(bs, bid, (x) => set(x, "config", set(x.config ?? {}, key, v)))
        blocks = next
        saved = ""
        if now() - pushed_at > 300 { pushed_at = now(); dirty = false; live_draft(id, next, bid) } else { dirty = true }
    }
    let commit = () => {
        if typing_from != null {
            history = take([typing_from] + history, 50)
            typing_from = null
            future = []
            let r = preview_live(id, bs, selected)
            if !is_err(r) { preview = r }
        }
    }
    let next_id = () => `b${max((all | map((b) => int(slice(b.id, 1)) ?? 0)) + [0]) + 1}`
    let place = (bid) => place_in(bs, bid, null, 0)
    let after = (bid) => {
        let pl = place(bid)
        { parent: pl.parent, col: pl.col, at: pl.index + 1 }
    }
    // A columns block goes in the page, not in a column: after the columns it was to go in.
    let fit = (t, where) => t.type == "columns" && where.parent != null ? after(where.parent) : where
    let shift = (bid, by) => {
        let pl = place(bid)
        let l = list_at(bs, pl.parent, pl.col)
        let i = pl.index
        let j = i + by
        if j >= 0 && j < len(l) {
            change(with_list(bs, pl.parent, pl.col, (x) => x | enumerate | map((y) => y[0] == i ? x[j] : y[0] == j ? x[i] : y[1])))
        }
    }
    // The keyboard stays on the blocks: the one chosen gets the focus once drawn.
    let choose = (bid) => {
        selected = bid
        side = "block"
        live_focus(id, bid)
        js("relayFocus", bid == null ? ".page-canvas" : `[data-block="${bid}"]`)
    }
    // A block with text of its own is typed into at once.
    let enter = (bid, where) => {
        selected = bid
        side = "block"
        js("pbEditor.focus", bid, where)
    }
    let remove = (bid) => {
        let pl = place(bid)
        let rest = list_at(bs, pl.parent, pl.col) | filter((x) => x.id != bid)
        change(drop_block(bs, bid))
        choose(len(rest) > 0 ? rest[min([pl.index, len(rest) - 1])].id : pl.parent)
    }
    let duplicate = (b) => {
        let copy = fresh_ids(b)
        change(insert_into(bs, after(b.id), copy))
        choose(copy.id)
    }
    let new_block = (t) => t.type == "columns" ? { id: next_id(), type: "columns", config: { count: "2", columns: [[], []] } } : { id: next_id(), type: t.type, config: {} }
    let add_at = (t, where) => {
        let b = new_block(t)
        change(insert_into(bs, fit(t, where), b))
        enter(b.id, "start")
    }
    let add = (t) => { add_at(t, sel == null ? { parent: null, col: 0, at: len(bs) } : after(sel.id)) }
    // Backspace in an empty block: it goes, and the caret to the end of the one before.
    let back = (b) => {
        let pl = place(b.id)
        let l = list_at(bs, pl.parent, pl.col)
        change(drop_block(bs, b.id))
        if pl.index > 0 { enter(l[pl.index - 1].id, "end") } else if len(l) > 1 { enter(l[1].id, "start") } else { choose(pl.parent) }
    }
    let open_inserter = (where) => {
        inserting = where
        ins_q = ""
        ins_at = 0
        js("relayFocus", ".pb-inserter input")
    }
    let nested = inserting != null && (inserting.parent != null || (inserting.replace != null && (place(inserting.replace) ?? {}).parent != null))
    let found = types | filter((t) => (blank(ins_q) || contains(lower(`${t.label} ${t.group ?? ""}`), lower(trim(ins_q)))) && !(nested && t.type == "columns"))
    let insert = (t) => {
        let where = inserting
        inserting = null
        if where.replace != null {
            let b = new_block(t)
            change(map_block(bs, where.replace, (_) => b))
            enter(b.id, "start")
        } else { add_at(t, where) }
    }
    let ins_keys = (e) => {
        if e.key == "ArrowDown" && len(found) > 0 { e.preventDefault(); ins_at = (ins_at + 1) % len(found) }
        if e.key == "ArrowUp" && len(found) > 0 { e.preventDefault(); ins_at = (ins_at + len(found) - 1) % len(found) }
        if e.key == "Enter" && len(found) > 0 { e.preventDefault(); insert(found[ins_at]) }
        if e.key == "Escape" { inserting = null }
    }
    // Delete or Backspace removes the chosen block, ⌘Z brings it back (⌘⇧Z
    // again), the arrows choose another (with ⌥, move it), ⌘D copies it,
    // Enter types into it, / adds one after it, Esc lets go. Not while typing.
    let on_keys = (e) => {
        let t = e.target
        let typing = contains(["INPUT", "TEXTAREA", "SELECT"], str(t.tagName)) || t.isContentEditable == true
        let cmd = e.metaKey == true || e.ctrlKey == true
        if !typing {
            if cmd && lower(e.key) == "z" { e.preventDefault(); if e.shiftKey == true { redo() } else { undo() } }
            else if sel != null && (e.key == "Delete" || e.key == "Backspace") { e.preventDefault(); remove(sel.id) }
            else if sel != null && cmd && lower(e.key) == "d" { e.preventDefault(); duplicate(sel) }
            else if sel != null && e.key == "Enter" { e.preventDefault(); enter(sel.id, "end") }
            else if e.key == "/" { e.preventDefault(); open_inserter(sel == null ? { parent: null, col: 0, at: len(bs) } : after(sel.id)) }
            else if sel != null && (e.key == "ArrowUp" || e.key == "ArrowDown") {
                e.preventDefault()
                let by = e.key == "ArrowUp" ? -1 : 1
                if e.altKey == true { shift(sel.id, by); choose(sel.id) }
                else {
                    let j = (index_of(all | map((b) => b.id), sel.id) ?? 0) + by
                    if j >= 0 && j < len(all) { choose(all[j].id) }
                }
            }
            else if e.key == "Escape" { selected = null; inserting = null }
        }
    }
    // Dragging: a block from the library, or one moved by its handle, to a
    // place in the page or in a column.
    let dropped = (where) => {
        if where != null && adding != null {
            add_at(adding, where)
        } else if where != null && dragging != null {
            let item = find(all, (b) => b.id == dragging)
            let target = fit(item, where)
            let inside = target.parent != null && (target.parent == item.id || any(flat_blocks([item]), (x) => x.id == target.parent))
            if item != null && !inside {
                let pl = place(item.id)
                let same = pl.parent == target.parent && pl.col == target.col
                let at = same && pl.index < target.at ? target.at - 1 : target.at
                if !(same && at == pl.index) { change(insert_into(drop_block(bs, item.id), merge(target, { at }), item)) }
            }
        }
        adding = null
        dragging = null
        drop_to = null
    }
    let moving = adding != null || dragging != null
    // Over a block: the place above its middle, or below it.
    let over = (e, pl) => {
        if moving {
            e.preventDefault()
            let r = e.currentTarget.getBoundingClientRect()
            drop_to = { parent: pl.parent, col: pl.col, at: e.clientY < r.top + r.height / 2 ? pl.index : pl.index + 1 }
        }
    }
    // The progress since the last save: blocks changed, added or gone, the
    // order, the page's settings.
    let base = upgrade_blocks(p.draft.blocks ?? [])
    let same = (a, b) => json.stringify(a) == json.stringify(b)
    let changed = bs | filter((b) => !same(find(base, (x) => x.id == b.id), b))
    let gone = base | filter((x) => find(bs, (b) => b.id == x.id) == null)
    let moved = !same(base | map((b) => b.id) | filter((i) => find(bs, (b) => b.id == i) != null), bs | map((b) => b.id) | filter((i) => find(base, (b) => b.id == i) != null))
    let meta_changed = meta != null && (m.title != p.title || m.slug != p.slug || m.description != p.description)
    let unsaved = len(changed) + len(gone) + (moved ? 1 : 0) + (meta_changed ? 1 : 0)
    // Saving sends the progress, not the page; the designer stays as it is
    // (the block chosen, the caret, the undo history).
    let save = () => {
        commit()
        if unsaved == 0 { saved = "Saved"; true } else {
            let progress = { order: bs | map((b) => b.id), blocks: changed | reduce({}, (acc, b) => set(acc, b.id, b)), meta: meta_changed ? m : null }
            let first = save_changes(id, progress)
            let r = is_err(first) && first.error.stale == true ? save_page(merge(m, { id, blocks: bs })) : first
            if is_err(r) { server = refusal_problems(r); false } else {
                // The page as saved: with what others saved meanwhile, shown.
                let fresh = upgrade_blocks(r.draft.blocks ?? [])
                p = r
                meta = null
                if !same(fresh, bs) { show(fresh) }
                saved = "Saved"
                true
            }
        }
    }
    let status = p.published == null ? "draft" : p.changed || unsaved > 0 ? "changes not published" : "published"
    let inserter = () => <div.pb-inserter @keydown={ins_keys}>
        <input type="search" aria-label="Find a block" placeholder="Find a block" value={ins_q} @input={(e) => { ins_q = e.value; ins_at = 0 }}/>
        {len(found) == 0 ? <p.muted.small>No block is called that.</p>
        : <div.pb-ins-grid role="listbox">{for [i, t] in enumerate(found) => <button type="button" role="option" aria-selected={i == ins_at} class={i == ins_at ? "on" : ""}
            @click={() => { insert(t) }}><span.pb-ins-icon>{block_icon(t.type)}</span>{t.label}</button>}</div>}
        <button.ghost.small type="button" @click={() => { inserting = null }}>Close</button>
    </div>
    let same_place = (a, w) => a != null && a.replace == null && a.parent == w.parent && a.col == w.col && a.at == w.at
    let gap = (where) => same_place(inserting, where) ? inserter()
        : <div.pb-gap><button type="button" class="pb-plus" title="Add a block here" aria-label="Add a block here" @click={() => { open_inserter(where) }}>+</button></div>
    let showing = sel != null && side == "block" ? "block" : "page"
    let feedback = fb == null || is_err(fb) ? [] : fb
    let fb_open = feedback | filter((f) => f.status != "resolved")
    let fb_counts = fb_open | reduce({}, (acc, f) => set(acc, f.block_id, (acc[f.block_id] ?? 0) + 1))
    let fb_reply = (f) => {
        let text = fb_drafts[str(f.id)] ?? ""
        let r = team_reply(f.id, text)
        if !is_err(r) { fb_drafts = set(fb_drafts, str(f.id), "") }
    }
    if dirty { every(350, () => { dirty = false; pushed_at = now(); live_draft(id, bs, selected) }) }
    let live_url = `/preview/${p.preview_token ?? ""}`
    // Events from a block in a block reach both: each handles its own.
    let mine = (e, b) => (e.target.closest("[data-block]") ?? {}).dataset.block == b.id
    // A block where it is (pl: { parent, col, index, size }), and what it shows.
    let wrap = (b, pl, body) => {
        let bad = len(errors_of(block_problems(b.id))) > 0
        let line = same_place(drop_to, { parent: pl.parent, col: pl.col, at: pl.index }) ? " drop-before"
            : pl.index == pl.size - 1 && same_place(drop_to, { parent: pl.parent, col: pl.col, at: pl.index + 1 }) ? " drop-after" : ""
        <div class={(selected == b.id ? "pb-wrap on" : bad ? "pb-wrap bad" : "pb-wrap") + line + (b.type == "columns" ? " is-columns" : "")} data-block={b.id}
            tabindex="0" aria-label={`${type_of_block(b).label} block`} aria-pressed={selected == b.id}
            @pointerdown={(e) => { if mine(e, b) && selected != b.id { selected = b.id; side = "block"; live_focus(id, b.id) } }} @click={(e) => { if mine(e, b) { selected = b.id } }}
            @focusin={(e) => { if e.target == e.currentTarget { selected = b.id } }}
            @input={(e) => { if mine(e, b) && e.target.dataset != null && e.target.dataset.edit != null { typed(b.id, e.target.dataset.edit, js("pbEditor.value", e.target)) } }}
            @focusout={(e) => { if mine(e, b) && e.target.dataset != null && e.target.dataset.edit != null && (e.relatedTarget == null || e.relatedTarget.closest(".pb-format") == null) { commit() } }}
            @pbback={(e) => { if mine(e, b) { back(b) } }}
            @pbslash={(e) => { if mine(e, b) { open_inserter({ replace: b.id }) } }}
            @dragover={(e) => { if mine(e, b) && (b.type != "columns" || e.target.closest(".pb-col") == null) { over(e, pl) } }}>
            {selected == b.id ? <div.pb-toolbar @pointerdown={() => { commit() }}>
                <span.pb-handle draggable="true" title="Drag to move" aria-label="Drag to move"
                    @dragstart={() => { dragging = b.id; adding = null }} @dragend={() => { dragging = null; drop_to = null }}>⠿</span>
                <span.pb-ins-icon>{block_icon(b.type)}</span><b>{type_of_block(b).label}</b>
                {pl.parent != null && <button.icon type="button" title="Choose the columns it is in" aria-label="Choose the columns" @click={() => { choose(pl.parent) }}>⬑</button>}
                <span.pb-sep></span>
                <button.icon type="button" title="Move up (⌥↑)" aria-label="Move up" disabled={pl.index == 0} @click={() => { shift(b.id, -1); choose(b.id) }}>↑</button>
                <button.icon type="button" title="Move down (⌥↓)" aria-label="Move down" disabled={pl.index == pl.size - 1} @click={() => { shift(b.id, 1); choose(b.id) }}>↓</button>
                <span.pb-sep></span>
                <button.icon type="button" title="Add a block before" aria-label="Add a block before" @click={() => { open_inserter({ parent: pl.parent, col: pl.col, at: pl.index }) }}>⤒</button>
                <button.icon type="button" title="Add a block after (/)" aria-label="Add a block after" @click={() => { open_inserter({ parent: pl.parent, col: pl.col, at: pl.index + 1 }) }}>⤓</button>
                <button.icon type="button" title="Duplicate (⌘D)" aria-label="Duplicate" @click={() => { duplicate(b) }}>⧉</button>
                <button.icon type="button" title="Remove (Delete)" aria-label="Remove" @click={() => { remove(b.id) }}>✕</button>
                {{
                    let t = type_of_block(b)
                    let c = b.config ?? {}
                    let open = optional_fields(html_of(b.id) ?? "", (t.fields ?? []) | filter((f) => blank(c[f.key]) && !contains(reveal, `${b.id}:${f.key}`)) | map((f) => f.key))
                    len(open) == 0 ? null : <span.pb-adds>
                        <span.pb-sep></span>
                        {for k in open | take(3) => <button type="button" class="pb-add-field" title={`Add ${lower((find(t.fields, (f) => f.key == k) ?? { label: k }).label)}`}
                            @click={() => { reveal = reveal + [`${b.id}:${k}`]; js("pbEditor.focusField", b.id, k) }}>+ {(find(t.fields, (f) => f.key == k) ?? { label: k }).label}</button>}
                    </span>
                }}
            </div> : <span.pb-tag>{type_of_block(b).label}</span>}
            {body}
        </div>
    }
    let shown = (b) => {
        let markup = html_of(b.id)
        markup == null ? <div.pb-missing>Rendering…</div> : <div.pb-html>{raw(markup)}</div>
    }
    // A list of blocks: in the page, or in a column. Each with + after it;
    // `body` draws a block (columns draw their columns).
    let slots = (l, parent, col, body) => <div.pb-list>
        {len(l) > 0 && gap({ parent, col, at: 0 })}
        {for [i, b] in enumerate(l) => <div key={b.id} class="pb-slot">
            {wrap(b, { parent, col, index: i, size: len(l) }, body(b))}
            {inserting != null && inserting.replace == b.id && inserter()}
            {gap({ parent, col, at: i + 1 })}
        </div>}
    </div>
    // A columns block's columns, each a list; an empty one suggests blocks.
    let columns_of = (b) => <section.pb-columns.pb-columns-edit style={`--cols:${max([1, len(inner_lists(b))])}`}>
        {for [ci, col] in enumerate(inner_lists(b)) => {
            let here = { parent: b.id, col: ci, at: len(col) }
            let over_me = drop_to != null && drop_to.parent == b.id && drop_to.col == ci
            <div class={over_me && len(col) == 0 ? "pb-col over" : "pb-col"} key={ci}
                @dragover={(e) => { if moving && (e.target.closest("[data-block]") ?? {}).dataset.block == b.id { e.preventDefault(); drop_to = here } }}>
                {len(col) > 0 ? slots(col, b.id, ci, shown)
                : same_place(inserting, { parent: b.id, col: ci, at: 0 }) ? inserter()
                : <div.pb-col-empty>
                    <p>Column {ci + 1}: add a block</p>
                    <div.pb-suggest>
                        {for t in types | filter((t) => contains(COLUMN_SUGGESTS, t.type)) => <button type="button" title={`Add ${t.label}`}
                            @click={() => { add_at(t, { parent: b.id, col: ci, at: 0 }) }}><span.pb-ins-icon>{block_icon(t.type)}</span>{t.label}</button>}
                        <button type="button" class="more" title="All blocks" aria-label="All blocks" @click={() => { open_inserter({ parent: b.id, col: ci, at: 0 }) }}>+</button>
                    </div>
                </div>}
            </div>
        }}
    </section>
    <div.designer.gutenberg @keydown={(e) => { if (e.metaKey == true || e.ctrlKey == true) && lower(e.key) == "s" { e.preventDefault(); save() } }}>
        <header.designer-bar>
            <a href="/app/pages">← Pages</a>
            <div.seg role="group" aria-label="Left panel">
                <button type="button" class={left == "blocks" ? "on" : ""} aria-pressed={left == "blocks"} title="The blocks you can add" @click={() => { left = left == "blocks" ? "" : "blocks" }}>+ Blocks</button>
                <button type="button" class={left == "outline" ? "on" : ""} aria-pressed={left == "outline"} title="The page's blocks, in order" @click={() => { left = left == "outline" ? "" : "outline" }}>☰ Outline</button>
                <button type="button" class={left == "feedback" ? "on" : ""} aria-pressed={left == "feedback"} title="Feedback from the live preview: your to-dos" @click={() => { left = left == "feedback" ? "" : "feedback" }}>
                    Feedback{len(fb_open) > 0 && <span.fb-count>{len(fb_open)}</span>}</button>
            </div>
            <button.icon type="button" title="Undo (⌘Z)" aria-label="Undo" disabled={len(history) == 0 && typing_from == null} @click={() => { commit(); undo() }}><Icon name="undo"/></button>
            <button.icon type="button" title="Redo (⌘⇧Z)" aria-label="Redo" disabled={len(future) == 0} @click={() => { redo() }}><Icon name="redo"/></button>
            <b.page-title>{m.title != "" ? m.title : "Untitled"}</b>
            <span title={status == "changes not published" ? "Changed since it was published: publish to show the changes" : status == "draft" ? "Not published yet" : "Visitors see this"}>
                <Badge text={status == "changes not published" ? "edited" : status} tone={status == "published" ? "green" : status == "draft" ? "gray" : "amber"}/>
            </span>
            {p.home && <Badge text="home page" tone="purple"/>}
            {section && <Badge text="section" tone="purple"/>}
            <span.grow></span>
            {saved != "" && <span.ok>{saved}</span>}
            {len(errors) > 0 && <button.ghost type="button" @click={() => { side = "page"; selected = null }}><span.bad>{plural(len(errors), "problem")}</span></button>}
            <a.button href={live_url} target="_blank" rel="noopener" data-reload title="This page as you edit it, in another tab, browser or phone: it follows each change">Live preview ↗</a>
            {p.published != null && !section && <a.button href={p.home ? "/" : `/p/${p.slug}`} target="_blank" data-reload>View ↗</a>}
            {ws.user.role != "member" && <button.danger @click={() => {
                if ask(section ? "Pages that show it will not." : "Visitors will no longer find it.", { title: `Delete “${m.title != "" ? m.title : "Untitled"}”?`, ok: "Delete", tone: "danger" }) {
                    let r = delete_page(id)
                    if is_err(r) { notify(err_text(r), { title: "Not deleted", tone: "danger", seconds: 8 }) } else { notify("Deleted"); navigate("/app/pages") }
                }
            }}>Delete</button>}
            <button title="Save what changed (⌘S)" disabled={unsaved == 0} @click={() => { save() }}>{unsaved == 0 ? "Saved" : `Save ${plural(unsaved, "change")}`}</button>
            <button.primary disabled={len(errors) > 0} title={len(errors) > 0 ? "Fix the problems first" : ""} @click={() => {
                if save() {
                    let r = publish_page(id)
                    if is_err(r) { server = refusal_problems(r) } else { p = r; saved = "Published" }
                }
            }}>Publish</button>
        </header>
        <div class={left == "" ? "designer-body pages no-left" : "designer-body pages"}>
            {left == "blocks" && <aside.palette>
                <input type="search" aria-label="Find a block" placeholder="Find a block" value={lib_q} @input={(e) => { lib_q = e.value }}/>
                {for group in unique(types | map((t) => t.group ?? "Content")) => {
                    let mine_t = types | filter((t) => (t.group ?? "Content") == group && (blank(lib_q) || contains(lower(t.label), lower(trim(lib_q)))))
                    len(mine_t) == 0 ? null : <div.palette-group>
                        <p.palette-title>{group}</p>
                        <div.lib-grid>{for t in mine_t => <button.lib-item draggable="true" data-type={t.type} title={`Add ${t.label} ${sel == null ? "at the end" : "after the chosen block"}, or drag it into the page or a column`}
                            @click={() => { add(t) }} @dragstart={() => { adding = t; dragging = null }} @dragend={() => { adding = null; drop_to = null }}>
                            <span.pb-ins-icon>{block_icon(t.type)}</span>{t.label}</button>}</div>
                    </div>
                }}
                <p.muted.small.pb-keys><kbd>/</kbd> adds a block · <kbd>Enter</kbd> types into the chosen one (in a text, the next paragraph) · <kbd>Delete</kbd> removes it, <kbd>⌘Z</kbd> brings it back · <kbd>↑</kbd> <kbd>↓</kbd> choose, with <kbd>⌥</kbd> move · <kbd>⌘D</kbd> copies.</p>
            </aside>}
            {left == "outline" && <aside.palette.outline>
                <p.palette-title>{plural(len(all), "block")}</p>
                {len(bs) == 0 ? <p.muted.small>None yet.</p>
                : <ol.outline-list>{for row in outline_rows(bs, 0) => <li key={row.b.id} style={`padding-left:${row.depth * 16}px`}>
                    <button type="button" class={selected == row.b.id ? "on" : ""} @click={() => { choose(row.b.id); js("pbEditor.show", row.b.id) }}>
                        <span.pb-ins-icon>{block_icon(row.b.type)}</span><span.outline-text><b>{type_of_block(row.b).label}</b><span.muted>{block_summary(row.b)}</span></span>
                        {len(errors_of(block_problems(row.b.id))) > 0 && <span.bad>!</span>}
                    </button>
                </li>}</ol>}
            </aside>}
            {left == "feedback" && <aside.palette.fb-todos>
                <div.inline>
                    <p.palette-title.grow>{len(fb_open) == 0 ? "Nothing to do" : plural(len(fb_open), "to-do")}</p>
                    <label.inline.small><input type="checkbox" checked={fb_resolved} @change={(e) => { fb_resolved = e.checked }}/> resolved too</label>
                </div>
                {len(feedback) == 0 ? <p.muted.small>Feedback from the live preview shows here: whoever has its link (Live preview ↗) chooses a block, draws on it and says what they think.</p>
                : <div.fb-list>{for f in feedback | filter((f) => fb_resolved || f.status != "resolved") => <FeedbackThread key={f.id} {f} shown={232}>
                    <div.fb-actions>
                        {find(all, (b) => b.id == f.block_id) != null && <button.small type="button" @click={() => { choose(f.block_id); js("pbEditor.show", f.block_id) }}>Show block</button>}
                        {f.status == "open" && <button.primary.small type="button" @click={() => { acknowledge_feedback(f.id) }}>Acknowledge</button>}
                    </div>
                    <div.fb-reply>
                        <input placeholder="Reply…" aria-label="Reply" value={fb_drafts[str(f.id)] ?? ""} @input={(e) => { fb_drafts = set(fb_drafts, str(f.id), e.value) }}
                            @keydown={(e) => { if e.key == "Enter" { fb_reply(f) } }}/>
                        <button.small type="button" @click={() => { fb_reply(f) }}>Send</button>
                    </div>
                </FeedbackThread>}</div>}
            </aside>}
            <div.page-canvas tabindex="-1" @keydown={on_keys} @click={(e) => { if e.target.className == "page-canvas" { selected = null } }}
                @drop={(e) => { e.preventDefault(); dropped(drop_to) }}>
                <div class={site_classes(theme, tdef) + " site-preview" + (section ? " is-section" : "")}>
                    <style>{theme_css(theme, tdef)}</style>
                    {len(fb_counts) > 0 && <style>{join(keys(fb_counts) | map((k) => `[data-block=${k}] > .pb-html::after { content: "${fb_counts[k]}"; }`), "\n")}</style>}
                    {len(reveal) > 0 && <style>{reveal | map((r) => {
                        let at = split(r, ":")
                        `[data-block=${at[0]}] .pb-html [data-edit=${at[1]}]:empty { display: revert !important; }`
                    }) | join("
")}</style>}
                    {!section && <SiteHeader t={theme} def={tdef} site={ws.name} menu={theme.menu ?? []} cart={0} shop={false}/>}
                    {len(bs) == 0 && inserting == null && <div class={drop_to != null ? "pb-empty over" : "pb-empty"} @dragover={(e) => { if moving { e.preventDefault(); drop_to = { parent: null, col: 0, at: 0 } } }}>
                        <p>An empty page.</p>
                        <button.primary type="button" @click={() => { open_inserter({ parent: null, col: 0, at: 0 }) }}>+ Add a block</button>
                    </div>}
                    {len(bs) == 0 && same_place(inserting, { parent: null, col: 0, at: 0 }) && inserter()}
                    {slots(bs, null, 0, (b) => b.type == "columns" ? columns_of(b) : shown(b))}
                    {len(bs) > 0 && inserting == null && <div.pb-append><button.ghost type="button" @click={() => { open_inserter({ parent: null, col: 0, at: len(bs) }) }}>+ Add a block</button></div>}
                    {!section && <SiteFooter t={theme} site={ws.name} rss={false} year={slice(ws.today, 0, 4)}/>}
                </div>
            </div>
            <aside.inspector>
                <div.seg.side-tabs role="group" aria-label="Settings">
                    <button type="button" class={showing == "page" ? "on" : ""} aria-pressed={showing == "page"} @click={() => { side = "page" }}>{section ? "Section" : "Page"}</button>
                    <button type="button" class={showing == "block" ? "on" : ""} aria-pressed={showing == "block"} disabled={sel == null} @click={() => { side = "block" }}>Block</button>
                </div>
                {showing == "block"
                    ? <BlockEditor block={sel} type={type_of_block(sel)} {ws} problems={block_problems(sel.id)}
                        sections={(known.sections ?? []) | filter((x) => x.id != str(id))}
                        on_change={(config) => { change(map_block(bs, sel.id, (b) => set(b, "config", b.type == "columns" ? fit_columns(config) : config))) }}/>
                    : <section.stack>
                        <TextField label="Title" field="title" value={m.title} {problems} on_change={(v) => { meta = set(m, "title", v); saved = "" }}/>
                        {section
                            ? <div.stack>
                                <p.muted.small>Pages show what is published here, wherever they put this section in.</p>
                                <b.small>Used on</b>
                                {len(p.used_on ?? []) == 0 ? <p.muted.small>No pages yet: add a Section block to a page and choose this one.</p>
                                : <ul.plain>{for u in p.used_on => <li><a href={`/app/pages/${u.id}`}>{u.title != "" ? u.title : "Untitled"}</a>{u.kind == "section" && <span.muted> (section)</span>}</li>}</ul>}
                            </div>
                            : <div.stack>
                                <TextField label="Address" field="slug" value={m.slug} {problems} on_change={(v) => { meta = set(m, "slug", lower(v)); saved = "" }} help={`/p/${m.slug}`}/>
                                <AreaField label="Description (for search results)" field="description" value={m.description} {problems} on_change={(v) => { meta = set(m, "description", v); saved = "" }} rows={3}/>
                            </div>}
                        <label.field>
                            <span.label>Folder</span>
                            <input name="folder" value={p.folder ?? ""} placeholder="No folder" @change={(e) => { set_page_place(id, { folder: e.value }); p = set(p, "folder", e.value) }}/>
                            <span.help>Where the Pages page groups it</span>
                        </label>
                        <label.field.check>
                            <span.switch><input type="checkbox" checked={p.pinned == 1} @change={(e) => { set_page_place(id, { pinned: e.checked }); p = set(p, "pinned", e.checked ? 1 : 0) }}/><span></span></span>
                            Pinned to the sidebar, for everyone
                        </label>
                        <div.field>
                            <span.label>Live preview</span>
                            <p.muted.small>The page as you edit it, saved or not, following each change: open it in another browser, on a phone, or send it to someone. No sign-in; a new link stops the old one.</p>
                            <div.inline>
                                <a.button.small href={live_url} target="_blank" rel="noopener" data-reload>Open ↗</a>
                                <button.ghost.small type="button" @click={() => { js("navigator.clipboard.writeText", `${js("location.origin")}${live_url}`); notify("Live preview link copied") }}>Copy link</button>
                                <button.ghost.small type="button" @click={() => {
                                    if ask("Whoever has the link now will no longer see the page.", { title: "Make a new link?", ok: "New link" }) {
                                        let t = new_preview_link(id)
                                        if !is_err(t) { p = set(p, "preview_token", t); notify("A new link: the old one stopped working") }
                                    }
                                }}>New link</button>
                            </div>
                        </div>
                        {p.published != null && !p.home && !section && ws.user.role != "member" && <button @click={() => {
                            set_home(id)
                            p = set(p, "home", true)
                        }}>Make it the home page</button>}
                        {p.published != null && <button.danger @click={() => {
                            let r = unpublish_page(id)
                            if is_err(r) { server = [{ field: "", message: err_text(r) }] } else { p = set(set(p, "published", null), "home", false) }
                        }}>Unpublish</button>}
                        <h3>Checks</h3>
                        {len(problems) == 0 ? <p.ok>Ready to publish.</p>
                        : <ul.problems>{for x in problems => <li class={x.level == "warning" ? "warn" : ""}
                            @click={() => { if starts_with(x.field, "block.") { choose(slice(x.field, 6)) } }}>{x.message}</li>}</ul>}
                    </section>}
            </aside>
        </div>
    </div>
}

// The selected block's settings, from its plugin's description of it.
view BlockEditor(block: map, type: map, ws: map, problems: list, on_change, sections: list = []) {
    let c = block.config ?? {}
    let put_key = (k) => (v) => { on_change(set(c, k, v)) }
    <section>
        <h3>{type.label}</h3>
        <Hints {problems} field={`block.${block.id}`}/>
        <div.stack>{for f in type.fields ?? [] => match f.type {
            "image" => <ImagePicker label={f.label} value={c[f.key]} on_change={put_key(f.key)}/>
            "textarea" => <AreaField label={f.label} field={f.key} value={c[f.key]} problems={[]} on_change={put_key(f.key)} rows={6}/>
            "select" => <SelectField label={f.label} field={f.key} value={c[f.key]} options={f.options ?? []} problems={[]} on_change={put_key(f.key)} empty="Choose"/>
            "product" => <SelectField label={f.label} field={f.key} value={c[f.key]} options={ws.skus | map((x) => { value: x.sku, label: x.name })} problems={[]} on_change={put_key(f.key)} empty="Choose a product"/>
            "form" => <SelectField label={f.label} field={f.key} value={c[f.key]} options={ws.forms | map((x) => { value: x.slug, label: x.name })} problems={[]} on_change={put_key(f.key)} empty="Choose a form"/>
            "section" => <div.stack>
                <SelectField label={f.label} field={f.key} value={c[f.key]} options={sections | map((x) => { value: x.id, label: x.published ? x.title : `${x.title} (not published)` })} problems={[]} on_change={put_key(f.key)} empty="Choose a section"/>
                {len(sections) == 0 && <p.muted.small>No sections yet: make one under Pages → Sections.</p>}
                {!blank(c[f.key]) && <a href={`/app/pages/${c[f.key]}`}>Edit this section →</a>}
            </div>
            _ => <TextField label={f.label} field={f.key} value={c[f.key]} problems={[]} on_change={put_key(f.key)}
                placeholder={f.type == "url" ? "https://…" : f.type == "link" ? "/shop, https://…" : ""}/>
        }}</div>
    </section>
}
