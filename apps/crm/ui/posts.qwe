// Posts (the Blog plugin): the list, and the editor. The post rules (the
// Blog plugin's, and any other plugin's) hint as you write, and decide
// when you publish.

let STAGE_LABELS = { draft: "draft", review: "in review", changes: "changes asked", approved: "approved", published: "published" }
let REVIEW_WORDS = { submitted: "sent it for review", approved: "approved it", changes: "asked for changes", published: "published it" }

fn stage_tone(stage: str) = match stage {
    "review" => "amber"
    "changes" => "red"
    "approved" => "purple"
    "published" => "green"
    _ => "gray"
}

component PostsPage(ws: map) {
    state tab = "posts"
    <div>
        <PageHead title="Posts" sub="Your blog, at /blog, with an RSS feed.">
            <a.button href="/blog" target="_blank" data-reload>View the blog ↗</a>
            <button.primary @click={() => {
                let id = new_post()
                if !is_err(id) { navigate(`/app/posts/${id}`) }
            }}>New post</button>
        </PageHead>
        <nav.tabs>{for t in [["posts", "Posts"], ["mine", "For me"], ["comments", "Comments"]] =>
            <button type="button" class={tab == t[0] ? "tab on" : "tab"} @click={() => { tab = t[0] }}>{t[1]}</button>}</nav>
        {match tab {
            "comments" => <CommentsPanel moderates={ws.designer == true}/>
            "mine" => <MyQueue/>
            _ => <PostList/>
        }}
    </div>
}

component PostList() {
    state rows = live(list_posts)
    rows == null ? <Loading/>
    : is_err(rows) || len(rows) == 0 ? <Empty title="No posts yet"><p>Write the first one.</p></Empty>
    : <table.table>
        <thead><tr><th>Post</th><th>Category</th><th>Tags</th><th>Read</th><th>Status</th><th>Date</th></tr></thead>
        <tbody>{for p in rows => <tr key={p.id} class="clickable" @click={() => { navigate(`/app/posts/${p.id}`) }}>
            <td><b>{p.title != "" ? p.title : "Untitled"}</b>{p.members_only && <Badge text="members" tone="purple"/>}{p.featured && <Badge text="featured" tone="green"/>}</td>
            <td.muted>{p.category}</td>
            <td><Tags tags={p.tags}/></td>
            <td.muted>{p.views}</td>
            <td><Badge text={p.status == "published" ? "published" : STAGE_LABELS[p.stage ?? "draft"] ?? "draft"} tone={p.status == "published" ? "green" : stage_tone(p.stage ?? "draft")}/></td>
            <td.muted>{p.published_at != null ? fmt_date(p.published_at) : fmt_ago(p.updated_at, now())}</td>
        </tr>}</tbody>
    </table>
}

// What waits for me: posts to review, and approved posts to publish.
component MyQueue() {
    state rows = my_queue()
    rows == null ? <Loading/>
    : is_err(rows) || len(rows) == 0 ? <Empty title="Nothing waits for you"><p>Posts sent for review on your desks show here.</p></Empty>
    : <table.table>
        <thead><tr><th>Post</th><th>Category</th><th>Waiting for</th><th>Sent</th></tr></thead>
        <tbody>{for p in rows => <tr key={p.id} class="clickable" @click={() => { navigate(`/app/posts/${p.id}`) }}>
            <td><b>{p.title != "" ? p.title : "Untitled"}</b></td>
            <td.muted>{p.category}</td>
            <td><Badge text={p.waiting == "review" ? "your review" : "publishing"} tone={p.waiting == "review" ? "amber" : "purple"}/></td>
            <td.muted>{p.submitted_at == null ? "" : fmt_ago(p.submitted_at, now())}</td>
        </tr>}</tbody>
    </table>
}

// Readers' comments: each waits here until a designer or an admin approves it.
component CommentsPanel(moderates: bool) {
    state status = "pending"
    state rows = live(list_comments, status)
    <div.stack>
        <div.inline>{for s in [["pending", "Waiting"], ["approved", "Approved"], ["spam", "Spam"]] =>
            <button type="button" class={status == s[0] ? "choice on" : "choice"} @click={() => { status = s[0]; rows = list_comments(s[0]) }}>{s[1]}</button>}</div>
        {rows == null ? <Loading/>
        : is_err(rows) || len(rows) == 0 ? <Empty title={status == "pending" ? "Nothing waiting" : "None"}/>
        : <div.stack>{for c in rows => <section.card.comment-mod key={c.id}>
            <p.muted.small><b>{c.name}</b> ({c.email}) on <a href={`/blog/${c.slug}#comments`} target="_blank">{c.post}</a> · {fmt_ago(c.created_at, now())}</p>
            <p.comment-body>{c.body}</p>
            {moderates && <div.inline>
                {status != "approved" && <button.primary @click={() => { moderate_comment(c.id, "approved"); rows = list_comments(status) }}>Approve</button>}
                {status != "spam" && <button @click={() => { moderate_comment(c.id, "spam"); rows = list_comments(status) }}>Spam</button>}
                <button.ghost @click={() => { moderate_comment(c.id, "delete"); rows = list_comments(status) }}>Delete</button>
            </div>}
        </section>}</div>}
    </div>
}

component PostEditor(id: int, ws: map) {
    state p = get_post(id)
    state draft = null
    state tag_text = null
    state preview = null
    state server = []
    state saved = ""
    state cats = post_categories_all()
    state flow = post_workflow(id)
    state note = ""
    if p == null { return <Loading/> }
    if is_err(p) { return <Empty title="No such post"><p><a href="/app/posts">All posts</a></p></Empty> }
    let d = draft ?? p
    let tags_now = tag_text ?? join(p.tags, ", ")
    let record = set(d, "tags", tag_list(tags_now))
    let problems = validate("post", record, ctx_of(ws)) + server
    let errors = errors_of(problems)
    let change = (k) => (v) => { draft = set(d, k, v); saved = ""; server = [] }
    let save = () => {
        let r = save_post(record)
        if is_err(r) { server = refusal_problems(r); false } else { p = r; draft = null; tag_text = null; saved = "Saved"; true }
    }
    let published = p.status == "published"
    let wf = flow == null || is_err(flow) ? null : flow
    let refresh_flow = () => { flow = post_workflow(id); p = get_post(id) }
    <div.post-editor>
        <header.designer-bar>
            <a href="/app/posts">← Posts</a>
            <b.page-title>{d.title != "" ? d.title : "Untitled"}</b>
            <Badge text={published ? (draft != null || tag_text != null ? "changes not saved" : "published") : STAGE_LABELS[p.stage ?? "draft"] ?? "draft"} tone={published ? "green" : stage_tone(p.stage ?? "draft")}/>
            <span.grow></span>
            {saved != "" && <span.ok>{saved}</span>}
            {len(errors) > 0 && <span.bad>{plural(len(errors), "problem")}</span>}
            {published && <a.button href={`/blog/${p.slug}`} target="_blank" data-reload>View ↗</a>}
            {ws.user.role != "member" && <button.danger @click={() => {
                if ask("Its comments and reviews go too.", { title: `Delete “${d.title != "" ? d.title : "Untitled"}”?`, ok: "Delete", tone: "danger" }) { delete_post(id); notify("Post deleted"); navigate("/app/posts") }
            }}>Delete</button>}
            <button @click={() => { save() }}>Save</button>
            {wf != null && wf.submit && !published && <button disabled={len(errors) > 0} @click={() => {
                if save() {
                    let r = submit_post(id)
                    if is_err(r) { server = refusal_problems(r) } else { saved = "Sent for review"; refresh_flow() }
                }
            }}>Send for review</button>}
            {published
                ? <button @click={() => {
                    let r = unpublish_post(id)
                    if is_err(r) { server = refusal_problems(r) } else { refresh_flow() }
                }}>Unpublish</button>
                : <button.primary disabled={len(errors) > 0 || (wf != null && !wf.publish)} title={wf != null && !wf.publish ? (wf.why != "" ? wf.why : "Send it for review first") : ""} @click={() => {
                    if save() {
                        let r = publish_post(id)
                        if is_err(r) { server = refusal_problems(r) } else { p = r; saved = "Published"; refresh_flow() }
                    }
                }}>Publish</button>}
        </header>
        <div.post-body-grid>
            <div.post-write>
                <input.post-title name="title" placeholder="Title" value={d.title} @input={(e) => { change("title")(e.value) }}/>
                <Hints {problems} field="title"/>
                <div.write-tabs>
                    <button type="button" class={preview == null ? "tab on" : "tab"} @click={() => { preview = null }}>Write</button>
                    <button type="button" class={preview != null ? "tab on" : "tab"} @click={() => { preview = preview_markdown(d.body) ?? "" }}>Preview</button>
                </div>
                {preview == null
                    ? <textarea.post-text name="body" placeholder="Write in Markdown: **bold**, _italic_, ## headings, [links](https://…), lists…" @input={(e) => { change("body")(e.value) }}>{d.body}</textarea>
                    : <div.site.post-preview><section.post-body>{raw(is_err(preview) ? "" : preview)}</section></div>}
                <Hints {problems} field="body"/>
            </div>
            <aside.inspector>
                {wf != null && wf.desk != null && <section.workflow>
                    <h3>Review</h3>
                    <p.muted.small>{desk_name(wf.desk)}: {wf.desk.approvals == 0 ? "no approvals needed" : `${plural(wf.desk.approvals, "approval")} needed`} · {wf.approved} so far</p>
                    <ol.stage-steps>{for st in ["draft", "review", "approved", "published"] =>
                        <li class={(published ? "published" : p.stage ?? "draft") == st || (st == "draft" && p.stage == "changes" && !published) ? "on" : ""}>{st == "draft" && p.stage == "changes" ? "changes asked" : STAGE_LABELS[st]}</li>}</ol>
                    {wf.review && <div.stack>
                        <AreaField label="Note (needed to ask for changes)" field="note" value={note} problems={server} on_change={(v) => { note = v }} rows={2}/>
                        <div.inline>
                            <button.primary @click={() => {
                                let r = review_post(id, "approved", note)
                                if is_err(r) { server = refusal_problems(r) } else { note = ""; saved = "Approved"; refresh_flow() }
                            }}>Approve</button>
                            <button @click={() => {
                                let r = review_post(id, "changes", note)
                                if is_err(r) { server = refusal_problems(r) } else { note = ""; saved = "Changes asked"; refresh_flow() }
                            }}>Ask for changes</button>
                        </div>
                    </div>}
                    {len(wf.reviews) > 0 && <ul.review-log>{for r in wf.reviews => <li key={r.id}>
                        <b>{r.name ?? "Someone"}</b> {REVIEW_WORDS[r.decision] ?? r.decision} <span.muted>{fmt_ago(r.created_at, now())}</span>
                        {r.note != "" && <p>{r.note}</p>}
                    </li>}</ul>}
                </section>}
                <h3>Post</h3>
                <TextField label="Address" field="slug" value={d.slug} {problems} on_change={(v) => { change("slug")(lower(v)) }} help={`/blog/${d.slug}`}/>
                <AreaField label="Excerpt (lists and the newsletter)" field="excerpt" value={d.excerpt} {problems} on_change={change("excerpt")} rows={3}/>
                <label.field>
                    <span.label>Category (a section of the site)</span>
                    <input name="category" value={d.category ?? ""} list="post-categories" placeholder="politics" @input={(e) => { change("category")(e.value) }}/>
                    <datalist id="post-categories">{for c in (is_err(cats) || cats == null ? [] : cats) => <option value={c}></option>}</datalist>
                </label>
                <CheckField label="Featured (the top story)" field="featured" value={d.featured} {problems} on_change={change("featured")}/>
                <ImagePicker label="Cover" value={d.cover} on_change={change("cover")}/>
                <Hints {problems} field="cover"/>
                <label.field><span.label>Tags</span><input name="tags" value={tags_now} placeholder="news, recipes" @input={(e) => { tag_text = e.value; saved = "" }}/></label>
                <AreaField label="Description (search results)" field="description" value={d.description} {problems} on_change={change("description")} rows={2}/>
                <CheckField label="Members only (Memberships)" field="members_only" value={d.members_only} {problems} on_change={change("members_only")}/>
                {published && <button @click={() => {
                    let c = post_to_campaign(id)
                    if !is_err(c) { navigate("/app/campaigns") }
                }}>Send to subscribers…</button>}
                <h3>Checks</h3>
                {len(problems) == 0 ? <p.ok>Ready to publish.</p>
                : <ul.problems>{for x in problems => <li class={x.level == "warning" ? "warn" : ""}>{x.message}</li>}</ul>}
            </aside>
        </div>
    </div>
}

// Desks (Settings): who writes, reviews and publishes each category's posts.
component DesksSettings(ws: map) {
    state rows = list_desks()
    state cats = post_categories_all()
    state editing = null
    state problems = []
    let admin = ws.user.role != "member"
    let name_of = (uid) => (find(ws.users, (u) => u.id == uid) ?? { name: "?" }).name
    let people = (ids) => len(ids) == 0 ? "no one (owners and admins only)" : ids | map(name_of) | join(", ")
    let toggle = (part, uid) => {
        let ids = editing[part] ?? []
        editing = set(editing, part, contains(ids, uid) ? ids | filter((x) => x != uid) : ids + [uid])
    }
    <div.stack>
        <p.muted>A desk says, for a category of posts, who writes and edits them, who reviews them and who publishes them, and how many approvals a post needs. The default desk covers every category without its own; with no desk, whoever writes a post publishes it. Owners and admins act on every desk.</p>
        {rows == null ? <Loading/> : is_err(rows) ? <Empty title="Desks did not load"/>
        : len(rows) == 0 ? <Empty title="No desks yet"><p>Posts are published by whoever writes them.</p></Empty>
        : <div.object-grid>{for d in rows => <section.card.stack key={d.id}>
            <h3>{desk_name(d)}</h3>
            <p.small><b>Editors:</b> {people(d.editors)}</p>
            <p.small><b>Reviewers:</b> {people(d.reviewers)}</p>
            <p.small><b>Publishers:</b> {people(d.publishers)}</p>
            <p.small><b>Approvals needed:</b> {d.approvals}</p>
            {admin && <div.inline>
                <button @click={() => { editing = d; problems = [] }}>Edit</button>
                <button.ghost @click={() => { delete_desk(d.id); rows = list_desks() }}>Delete</button>
            </div>}
        </section>}</div>}
        {admin && <div><button.primary @click={() => { editing = { category: "", editors: [], reviewers: [], publishers: [], approvals: 1 }; problems = [] }}>New desk</button></div>}
        {editing != null && <Drawer title={editing.id == null ? "New desk" : desk_name(editing)} on_close={() => { editing = null }}>
            <form.stack @submit={() => {
                let r = save_desk(editing)
                if is_err(r) { problems = refusal_problems(r) } else { editing = null; rows = list_desks() }
            }}>
                <label.field>
                    <span.label>Category (empty: the default desk)</span>
                    <input name="category" value={editing.category} list="desk-categories" placeholder="politics" @input={(e) => { editing = set(editing, "category", e.value) }}/>
                    <datalist id="desk-categories">{for c in (cats == null || is_err(cats) ? [] : cats) => <option value={c}></option>}</datalist>
                    <Hints {problems} field="category"/>
                </label>
                {for part in [["editors", "Editors (write and edit)", "editor_groups", "writers"], ["reviewers", "Reviewers (approve, or ask for changes)", "reviewer_groups", "reviewers"], ["publishers", "Publishers", "publisher_groups", "publishers"]] => <fieldset.people key={part[0]}>
                    <legend>{part[1]}</legend>
                    {for g in ws.groups ?? [] => <label.inline.small key={`g${g.id}`}>
                        <input type="checkbox" checked={contains(editing[part[2]] ?? [], g.id)} @change={() => { toggle(part[2], g.id) }}/> <b>{g.name}</b>
                    </label>}
                    <p.muted.small>Naming no one, the groups that are {part[3]} fill it.</p>
                    {for u in ws.users | filter((u) => u.role == "member") => <label.inline.small key={u.id}>
                        <input type="checkbox" checked={contains(editing[part[0]] ?? [], u.id)} @change={() => { toggle(part[0], u.id) }}/> {u.name}
                    </label>}
                    {len(ws.users | filter((u) => u.role == "member")) == 0 && <p.muted.small>Add members in Team first; owners and admins are on every desk.</p>}
                    <Hints {problems} field={part[0]}/>
                </fieldset>}
                <TextField label="Approvals a post needs (0: none)" field="approvals" value={str(editing.approvals)} {problems} on_change={(v) => { editing = set(editing, "approvals", int(v) ?? 0) }} type="number"/>
                <FormProblems problems={problems | filter((x) => x.field == "")}/>
                <div.form-actions><button.primary>Save desk</button></div>
            </form>
        </Drawer>}
    </div>
}
